+std::shared_ptr<SyntaxTree> SyntaxTree::withCachedPrefixOwnedSuffix(
+    const std::shared_ptr<SyntaxTree>& prefix, std::shared_ptr<SyntaxTree> suffix) {
+    const bool capturedOwner = prefix && suffix && suffix->prefixState &&
+                               suffix->prefixState->checkpoint &&
+                               suffix->prefixState->inheritedMacroOwner == prefix &&
+                               !suffix->prefixState->namespaceOwner &&
+                               suffix->prefixState->extraBytes == prefix->getRetainedSyntaxBytes();
