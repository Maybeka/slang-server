+TEST_CASE("Initial namespace transfer preserves raw reads and requires fresh witnesses",
+          "[source-initial-transfer]") {
+    SnapshotFixture files;
+    fs::current_path(files.dir);
+    files.write("first/top.sv", "`include \"header.svh\"\nmodule top; int n=`VALUE; endmodule\n");
+    files.write("first/header.svh", "`define VALUE 19\n");
+    SourceManager original;
+    original.enableSnapshotRecording();
+    auto root = original.readSource("first/top.sv");
+    REQUIRE(root);
+    auto tree = syntax::SyntaxTree::fromBuffers(std::vector{*root}, original);
+    REQUIRE(tree->diagnostics().empty());
+    CHECK_FALSE(original.readSource("first/missing.svh"));
+    const auto graph = tree->getSourceBufferIds();
+    const auto before = original.captureSnapshot(graph);
+    auto prefix = original.captureImmutablePrefix(graph);
+    // Native document registration can open an existing captured file again.
+    // It gets a distinct location ID, but must retain the exact captured bytes.
+    auto alias = original.readSource("first/top.sv");
+    REQUIRE(alias);
+    CHECK(alias->id != root->id);
+    SourceManager consumer;
+    consumer.inheritImmutablePrefix(prefix);
+    consumer.enableSnapshotRecording(true);
+    REQUIRE(consumer.tryInheritInitialRecordedNamespace(original));
+    CHECK(consumer.getSourceText(alias->id) == original.getSourceText(root->id));
+    auto view = syntax::SyntaxTree::sharedPrefixView(tree, consumer);
+    CHECK(&view->root() == &tree->root());
+    CHECK(&view->sourceManager() == &consumer);
+    const auto copied = consumer.captureSnapshot(graph);
+    CHECK(copied.files.size() == before.files.size());
+    CHECK(copied.lookups.size() == before.lookups.size());
+    CHECK(copied.headerRequests == before.headerRequests);
+    CHECK_FALSE(consumer.sourceWitnessFailure({}));
+    // No successful physical witness is transferred or remembered.
+    files.write("first/header.svh", "`define VALUE 27\n");
+    CHECK(consumer.sourceWitnessFailure({}).has_value());
+    files.write("first/header.svh", "`define VALUE 19\n");
+    CHECK_FALSE(consumer.sourceWitnessFailure({}));
+    files.write("first/missing.svh", "new negative lookup target\n");
+    CHECK(consumer.sourceWitnessFailure({}).has_value());
+    // A recipient that already observed inputs cannot overwrite that evidence.
+    CHECK_FALSE(consumer.tryInheritInitialRecordedNamespace(original));
+    SourceManager later;
+    later.inheritImmutablePrefix(prefix);
+    later.enableSnapshotRecording(true);
+    original.assignText("later.sv", "module later; endmodule\n");
+    CHECK_FALSE(later.tryInheritInitialRecordedNamespace(original));
+    CHECK(later.captureSnapshot({}).lookups.empty());
+}
