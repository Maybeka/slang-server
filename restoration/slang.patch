+bool SourceManager::tryInheritInitialRecordedNamespace(const SourceManager& original) {
+    if (this == &original)
+        return false;
+    const auto ownIncludes = getIncludeConfiguration();
+    const auto sourceIncludes = original.getIncludeConfiguration();
+    if (ownIncludes.userDirectories != sourceIncludes.userDirectories ||
+        ownIncludes.systemDirectories != sourceIncludes.systemDirectories ||
+        ownIncludes.disableProximatePaths != sourceIncludes.disableProximatePaths ||
+        ownIncludes.disableLocalIncludes != sourceIncludes.disableLocalIncludes ||
+        ownIncludes.incDirFirst != sourceIncludes.incDirFirst)
+        return false;
+    std::shared_lock sourceLock(original.mutex);
+    std::unique_lock lock(mutex);
+    // Only this initialization handoff can transfer raw input history.
+    if (!immutablePrefix || immutablePrefix != original.immutablePrefix ||
+        original.bufferEntries.size() < immutablePrefix->entries.size() || !snapshotRecording ||
+        !original.snapshotRecording || snapshotReplay || original.snapshotReplay ||
+        snapshotConflict || original.snapshotConflict || snapshotIncompleteFlag ||
+        original.snapshotIncompleteFlag || snapshotCwd != original.snapshotCwd ||
+        fastCwdPhaseDepth || original.fastCwdPhaseDepth || fastCwdInvalid ||
+        original.fastCwdInvalid || !snapshotLookups.empty() || !snapshotHeaderRequests.empty() ||
+        !snapshotGeneratedPaths.empty() || snapshotGeneratedSequenceActive ||
+        original.snapshotGeneratedSequenceActive || !queryLeases.empty() ||
+        !original.queryLeases.empty())
+        return false;
+    for (const auto& entry : original.bufferEntries)
+        if (auto file = std::get_if<FileInfo>(&entry); file && file->data && file->data->queryText)
+            return false;
+    if (original.bufferEntries.size() > immutablePrefix->entries.size()) {
+        // Registering native documents can reopen an already captured file and
+        // append a new location ID. Permit only aliases of that same FileData;
+        // new text, query buffers and macro expansions remain ineligible.
+        flat_hash_set<const FileData*> capturedFiles;
+        for (const auto& entry : immutablePrefix->entries)
+            if (auto file = std::get_if<FileInfo>(&entry); file && file->data)
+                capturedFiles.emplace(file->data.get());
+        for (size_t i = immutablePrefix->entries.size(); i < original.bufferEntries.size(); ++i) {
+            auto file = std::get_if<FileInfo>(&original.bufferEntries[i]);
+            if (!file || !file->data || !capturedFiles.contains(file->data.get()))
+                return false;
+        }
+    }
+    bufferEntries = original.bufferEntries;
+    lookupCache = original.lookupCache;
+    unnamedBufferCount.store(original.unnamedBufferCount.load());
+    diagDirectives = original.diagDirectives;
+    sourceEntryAuxBytes = 0;
+    for (const auto& entry : bufferEntries)
+        if (auto file = std::get_if<FileInfo>(&entry)) {
+            trackSourceData(file->data);
+            sourceEntryAuxBytes += file->metadataBytes();
+        }
+    for (const auto& [_, value] : lookupCache)
+        trackSourceData(value.first);
+    snapshotLookups = original.snapshotLookups;
+    snapshotLookupTargets = original.snapshotLookupTargets;
+    snapshotHeaderRequests = original.snapshotHeaderRequests;
+    snapshotGeneratedPaths = original.snapshotGeneratedPaths;
+    snapshotFiles = original.snapshotFiles;
+    for (auto& [_, directives] : diagDirectives)
+        for (auto& directive : directives)
+            directive.name = *retainedSourceNames.emplace(directive.name).first;
+    return true;
+}
+
+void SourceManager::retainSourceNames() {
+    std::unique_lock lock(mutex);
+    if (retainingSourceNames)
+        return;
+    const size_t start = immutablePrefix ? immutablePrefix->entries.size() : 0;
+    for (size_t index = start; index < bufferEntries.size(); ++index)
+        if (auto expansion = std::get_if<ExpansionInfo>(&bufferEntries[index]);
+            expansion && !expansion->macroName.empty())
+            expansion->macroName = *retainedSourceNames.emplace(expansion->macroName).first;
+    retainingSourceNames = true;
+}
