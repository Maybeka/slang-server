+void SyntaxTree::writeParseArchive(std::ostream& stream, const std::filesystem::path& rootPath,
+                                   bool allowExternalPaths) const {
+    if (std::ranges::any_of(diagnosticsBuffer, [](const auto& d) { return d.isError(); }) ||
+        !prefixState || !isPrefixResumeSafe().value_or(false))
+        throw std::runtime_error("parse archives require a prepared error-free prefix");
+    ArchiveWriter out(stream, &sourceMan);
+    out.allowExternalPaths = allowExternalPaths;
+    out.text("slang-uvm-cst-2");
+    sourceMan.writeParseArchive(out, rootPath);
+    out.node(rootNode);
+    auto writeDiag = [&](auto&& self, const Diagnostic& d) -> void {
+        if (d.symbol || d.coalesceCount)
+            throw std::runtime_error("unsupported archive diagnostic context");
+        out.number(uint64_t(d.code.getSubsystem()));
+        out.number(d.code.getCode());
+        out.location(d.location);
+        out.number(d.args.size());
+        for (auto& arg : d.args) {
+            out.number(arg.index());
+            std::visit(
+                [&](const auto& value) {
+                    using T = std::decay_t<decltype(value)>;
+                    if constexpr (std::is_same_v<T, std::string>)
+                        out.text(value);
+                    else if constexpr (std::is_integral_v<T>)
+                        out.number(uint64_t(value));
+                    else
+                        throw std::runtime_error("unsupported archive diagnostic argument");
+                },
+                arg);
+        }
+        out.number(d.ranges.size());
+        for (auto& range : d.ranges) {
+            out.location(range.start());
+            out.location(range.end());
+        }
+        out.number(d.notes.size());
+        for (auto& note : d.notes)
+            self(self, note);
+    };
+    out.number(diagnosticsBuffer.size());
+    for (auto& d : diagnosticsBuffer)
+        writeDiag(writeDiag, d);
+    const auto& pp = preprocessorMetadata;
+    auto nodes = [&](const auto& list) {
+        out.number(list.size());
+        for (auto node : list)
+            out.node(node);
+    };
+    nodes(pp.definedMacros);
+    out.number(pp.includeDirectives.size());
+    for (const auto& inc : pp.includeDirectives) {
+        out.node(inc.syntax);
+        out.text(inc.path);
+        out.number(inc.buffer.id.getId());
+        out.number(inc.isSystem);
+    }
+    out.number(pp.macroRefs.size());
+    for (const auto& ref : pp.macroRefs) {
+        out.node(ref.syntax);
+        out.node(ref.definition);
+    }
+    auto buffers = [&](const auto& list) {
+        out.number(list.size());
+        for (auto id : list)
+            out.number(id.getId());
+    };
+    buffers(pp.sourceBufferIds);
+    buffers(pp.predefineBufferIds);
+    // Store guards as physical-file indices rather than process-local char pointers.
+    out.number(prefixState->guards.size());
+    for (const auto& [key, value] : prefixState->guards) {
+        BufferID match;
+        for (auto id : pp.sourceBufferIds)
+            if (sourceMan.getSourceText(id).data() == key) {
+                match = id;
+                break;
+            }
+        if (!match)
+            throw std::runtime_error("unmapped archive header guard");
+        out.number(match.getId());
+        out.text(value);
+    }
+    // Persist the metadata and parent identities already established by parsing.
+    // Restoring must not walk the full expanded tree to rediscover either one.
+    out.number(metadata.nodeMeta.size());
+    for (const auto& [node, value] : metadata.nodeMeta) {
+        out.node(node);
+        out.number(uint64_t(value.defaultNetType));
+        out.number(uint64_t(value.unconnectedDrive));
+        out.number(value.cellDefine);
+        out.number(value.timeScale.has_value());
+        if (value.timeScale) {
+            out.number(uint64_t(value.timeScale->base.unit));
+            out.number(uint64_t(value.timeScale->base.magnitude));
+            out.number(uint64_t(value.timeScale->precision.unit));
+            out.number(uint64_t(value.timeScale->precision.magnitude));
+        }
+    }
+    nodes(metadata.globalInstances);
+    nodes(metadata.classPackageNames);
+    nodes(metadata.packageImports);
+    nodes(metadata.classDecls);
+    nodes(metadata.interfacePorts);
+    nodes(metadata.virtualInterfaceTypes);
+    nodes(metadata.namedPortTypes);
+    out.token(metadata.eofToken);
+    out.number(metadata.hasDefparams);
+    out.number(metadata.hasBindDirectives);
+    out.writeParents();
+    const auto& summary = *prefixState->wholeTreeDirectives;
+    out.number(summary.sourceEffects | (summary.resumeSafe << 1) | (summary.defparams << 2) |
+               (summary.binds << 3));
+}
