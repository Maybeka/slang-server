+TEST_CASE("Imported package flow diagnostics follow current consumer references",
+          "[trusted-package]") {
+    const std::string libraryText = R"(
+package uvm_pkg;
+    class Object;
+        function int used(); return 1; endfunction
+        function int other(); return 2; endfunction
+    endclass
+    class Box #(type T = int);
+        function int used(); return 1; endfunction
+        function int other(); return 2; endfunction
+    endclass
+    function automatic int library_call();
+        Box#(int) box = new;
+        return box.used();
+    endfunction
+endpackage
+)";
+    SourceManager librarySources;
