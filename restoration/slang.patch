+// A fragment has immutable physical ancestry. Compilation consumes the view's ordered
+// members and exact metadata to create a single logical compilation unit.
+std::shared_ptr<SyntaxTree> SyntaxTree::withCachedPrefix(
+    const std::shared_ptr<SyntaxTree>& prefix, const std::shared_ptr<SyntaxTree>& suffix) {
+    if (!prefix || !suffix || !prefix->prefixState || !prefix->prefixState->wholeTreeDirectives ||
+        !prefix->prefixState->wholeTreeDirectives->resumeSafe)
+        SLANG_THROW(std::invalid_argument("a prepared, resumable prefix is required"));
+    if (&prefix->sourceMan != &suffix->sourceMan || prefix->library != suffix->library)
+        SLANG_THROW(std::invalid_argument("prefix source manager / library mismatch"));
+    auto& sm = prefix->sourceMan;
+    BumpAllocator alloc;
+    auto& left = prefix->root().as<CompilationUnitSyntax>();
+    auto& right = suffix->root().as<CompilationUnitSyntax>();
+    SmallVector<MemberSyntax*> members;
+    for (auto* member : left.members)
+        members.push_back(member); // Borrow immutable prefix; deleter pins its arena.
+    for (auto* member : right.members)
+        members.push_back(deepClone(*member, alloc));
+    SyntaxFactory factory(alloc);
+    // Construct an empty composition root first: its normal constructor reparents children.
+    // Prefix nodes keep physical ancestry in the immutable prefix root; suffix clones belong here.
+    auto& root = factory.compilationUnit({}, right.endOfFile.deepClone(alloc));
+    root.members = SyntaxList<MemberSyntax>(alloc, members);
+    // Retain end-of-prefix directives on the first suffix token for metadata reconstruction.
+    if (!right.members.empty() && !left.endOfFile.trivia().empty()) {
+        auto* token = members[left.members.size()]->getFirstTokenPtr();
+        SmallVector<Trivia> trivia;
+        for (auto t : left.endOfFile.trivia())
+            trivia.push_back(t.clone(alloc, true));
+        for (auto t : token->trivia())
+            trivia.push_back(t.clone(alloc, true));
+        *token = token->withTrivia(alloc, trivia);
+    }
+    // Generated deepClone omits parser preview links (notably enum injection).
+    // Rebuild those links against cloned nodes; never point the new tree at old parents.
+    flat_hash_map<const SyntaxNode*, SyntaxNode*> mapped;
+    std::vector<std::pair<const SyntaxNode*, SyntaxNode*>> paired;
+    auto pairNodes = [&](auto&& self, const SyntaxNode& old, SyntaxNode& fresh,
+                         SyntaxNode* parent) -> void {
+        if (old.kind != fresh.kind || old.getChildCount() != fresh.getChildCount())
+            SLANG_THROW(std::runtime_error("clone shape mismatch"));
+        fresh.parent = SyntaxNode::ParentRef(parent);
+        mapped.emplace(&old, &fresh);
+        paired.emplace_back(&old, &fresh);
+        for (size_t i = 0; i < old.getChildCount(); ++i)
+            if (auto child = old.childNode(i))
+                self(self, *child, *fresh.childNode(i), &fresh);
+    };
+    // Prefix nodes and preview links are retained verbatim; map only cloned user syntax.
+    for (size_t i = 0; i < right.members.size(); ++i)
+        pairNodes(pairNodes, *right.members[i], *members[left.members.size() + i], &root);
+    for (size_t i = 0; i < paired.size(); ++i) {
+        auto [old, fresh] = paired[i];
+        if (auto preview = old->previewNode()) {
+            auto it = mapped.find(preview);
+            if (it == mapped.end()) {
+                auto extra = deepClone(*preview, alloc);
+                auto parent = mapped.find(preview->parent);
+                pairNodes(pairNodes, *preview, *extra,
+                          parent == mapped.end() ? nullptr : parent->second);
+                it = mapped.find(preview);
+            }
+            fresh->setPreviewNode(alloc, it->second);
+        }
+    }
+    // Preserve parser metadata exactly, including default net type and time scale.
+    ParserMetadata metadata;
+    auto appendMetadata = [&](const ParserMetadata& source) {
+        for (auto& [node, info] : source.nodeMeta)
+            metadata.nodeMeta.emplace_back(&mapped.at(node)->as<ModuleDeclarationSyntax>(), info);
+        for (auto node : source.globalInstances)
+            metadata.globalInstances.push_back(
+                &mapped.at(node)->as<HierarchyInstantiationSyntax>());
+        for (auto node : source.classPackageNames)
+            metadata.classPackageNames.push_back(&mapped.at(node)->as<IdentifierNameSyntax>());
+        for (auto node : source.packageImports)
+            metadata.packageImports.push_back(
+                &mapped.at(node)->as<PackageImportDeclarationSyntax>());
+        for (auto node : source.classDecls)
+            metadata.classDecls.push_back(&mapped.at(node)->as<ClassDeclarationSyntax>());
+        for (auto node : source.interfacePorts)
+            metadata.interfacePorts.push_back(&mapped.at(node)->as<InterfacePortHeaderSyntax>());
+        for (auto node : source.virtualInterfaceTypes)
+            metadata.virtualInterfaceTypes.push_back(
+                &mapped.at(node)->as<VirtualInterfaceTypeSyntax>());
+        for (auto node : source.namedPortTypes)
+            metadata.namedPortTypes.push_back(&mapped.at(node)->as<IdentifierNameSyntax>());
+        metadata.hasDefparams |= source.hasDefparams;
+        metadata.hasBindDirectives |= source.hasBindDirectives;
+    };
+    metadata = prefix->metadata;
+    appendMetadata(suffix->metadata);
+    metadata.eofToken = root.endOfFile;
+    auto pp = suffix->preprocessorMetadata;
+    pp.includeDirectives.insert(pp.includeDirectives.begin(),
+                                prefix->preprocessorMetadata.includeDirectives.begin(),
+                                prefix->preprocessorMetadata.includeDirectives.end());
+    pp.macroRefs.insert(pp.macroRefs.begin(), prefix->preprocessorMetadata.macroRefs.begin(),
+                        prefix->preprocessorMetadata.macroRefs.end());
+    if (!suffix->getPredefineBufferIds().empty() && !suffix->options_.get<PrecompiledUvmSyntax>())
+        SLANG_THROW(std::runtime_error("suffix unexpectedly created command line macros"));
+    pp.predefineBufferIds = prefix->preprocessorMetadata.predefineBufferIds;
+    pp.predefineBufferIds.insert(pp.predefineBufferIds.end(),
+                                 suffix->getPredefineBufferIds().begin(),
+                                 suffix->getPredefineBufferIds().end());
