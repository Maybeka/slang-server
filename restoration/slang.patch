+    const std::shared_ptr<SyntaxTree>& native) {
+    if (!native || native->root().kind != SyntaxKind::CompilationUnit)
+        return {};
+    const auto& unit = native->root().as<CompilationUnitSyntax>();
+    if (unit.members.empty() || unit.members[0]->kind != SyntaxKind::PackageDeclaration ||
+        unit.members[0]->as<ModuleDeclarationSyntax>().header->name.valueText() != "uvm_pkg" ||
+        !native->prefixState || !native->prefixState->checkpoint ||
