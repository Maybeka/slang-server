+TEST_CASE("Disposable outer semantic checkpoints discard canceled candidates",
+          "[semantic-checkpoint]") {
+    SourceManager sources;
+    auto tree = SyntaxTree::fromText(disposableSemanticSource(), sources);
+    CompilationOptions options;
+    options.flags = CompilationFlags::PackageAnalysis;
+    for (size_t cancelAt : {1, 3, 5}) {
+        auto candidate = std::make_unique<Compilation>(options);
+        candidate->addSyntaxTree(tree);
+        size_t visits = 0;
+        CHECK_THROWS_AS(candidate->getDisposableSemanticDiagnostics([&] {
+            if (++visits == cancelAt)
+                throw SemanticTraversalCancelled{};
+        }),
+                        SemanticTraversalCancelled);
+        CHECK(visits == cancelAt);
+        CHECK_FALSE(candidate->isElaborated());
+        // No attempt to resume a potentially interrupted candidate.
+        candidate.reset();
+        Compilation retry(options);
+        retry.addSyntaxTree(tree);
+        CHECK(retry.getSemanticDiagnostics().empty());
+    }
+}
