+TEST_CASE("Semantic views bind the current edited body in a new specialization",
+          "[body-class-semantic-view]") {
+    const bool task = GENERATE(false, true);
+    const bool external = GENERATE(false, true);
+    CAPTURE(task, external);
+    CompilationOptions options;
+    options.flags |= CompilationFlags::TrackSubroutineBodyDependencies;
+    const std::string kind = task ? "task" : "function void";
+    const std::string close = task ? "endtask" : "endfunction";
+    const auto method = [&](std::string_view parameter) {
+        return kind + (external ? " Box::work" : " work") + "(input T arg); " + "Box#(" +
+               std::string(parameter) + ") other; " + "T local_value; local_value = arg; " + close +
+               "\n";
+    };
+    const auto design = [&](std::string_view parameter) {
+        return "package p; class Box #(type T=int); " +
+               (external ? "extern " + kind + " work(input T arg); endclass\n" + method(parameter)
+                         : method(parameter) + "endclass\n") +
+               "Box#(int) first; endpackage\n";
+    };
+    auto owner = std::make_shared<Compilation>(options);
+    owner->addSyntaxTree(SyntaxTree::fromText(design("byte")));
+    const auto expected = report(owner->getSemanticDiagnostics());
+    const auto& box =
+        owner->getPackage("p")->find<VariableSymbol>("first").getType().as<ClassType>();
+    INFO(expected);
+    const auto* work = &box.find<SubroutineSymbol>("work");
+    REQUIRE(work);
+    const auto bytes = owner->getTotalBytesAllocated();
+    auto body = SyntaxTree::fromText(method("shortint"));
+    const FunctionDeclarationSyntax* syntax = nullptr;
+    auto find = [&](auto&& self, const SyntaxNode& node) -> void {
+        if (auto fn = node.as_if<FunctionDeclarationSyntax>()) {
+            syntax = fn;
+            return;
+        }
+        for (uint32_t i = 0; i < node.getChildCount(); ++i)
+            if (auto child = node.childNode(i))
+                self(self, *child);
+    };
+    find(find, body->root());
+    REQUIRE(syntax);
+    Compilation edited(options);
+    edited.setBodyQueryContext(owner, body);
+    const SubroutineSymbol* replacement;
+    {
+        BodyQueryReferenceGuard references(edited);
+        replacement = &SubroutineSymbol::createBodyQuery(edited, *syntax, *work);
+        edited.forceElaborate(*replacement);
+    }
+    const SubroutineSymbol* originals[] = {work};
+    auto view = edited.getBodyQuerySemanticView(*replacement, originals, {});
+    Compilation fresh(options);
+    fresh.addSyntaxTree(SyntaxTree::fromText(design("shortint")));
+    CHECK(report(view.diagnostics) == report(fresh.getSemanticDiagnostics()));
+    bool found = false;
+    for (auto type : edited.getImportedClassSpecializations()) {
+        auto& cls = type->as<ClassType>();
+        if (&cls.getCompilation() != &edited)
+            continue;
+        found = true;
+        const auto* fn = &cls.find<SubroutineSymbol>("work");
+        REQUIRE(fn);
+        CHECK(fn->getSyntax() == syntax);
+        REQUIRE(fn->getArguments().size() == 1);
+        CHECK(fn->find<VariableSymbol>("local_value")
+                  .getType()
+                  .isMatching(fn->getArguments()[0]->getType()));
+    }
+    CHECK(found);
+    CHECK(owner->getTotalBytesAllocated() == bytes);
+    CHECK(report(owner->getSemanticDiagnostics()) == expected);
+}
