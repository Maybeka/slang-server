+def generateSyntaxArchive(builddir, alltypes, kindmap):
+    out = ['#include "slang/syntax/ParseArchive.h"', 'namespace slang::syntax {',
+           'void ArchiveWriter::node(const SyntaxNode* n) {',
+           'if (!n) { number(0); return; }',
+           'auto [it, inserted] = nodes.emplace(n, nodes.size()+1); number(it->second); number(inserted); if (!inserted) return;',
+           'number(uint64_t(n->kind)); switch(n->kind) {']
+    for kind, name in sorted(kindmap.items()):
+        v=alltypes[name]
+        out += [f'case SyntaxKind::{kind}: {{ auto& node=n->as<{name}>();']
+        for m in v.combinedMembers:
+            out += [f'field(node.{m[1]});']
+        out += ['break; }']
+    out += ['default: throw std::runtime_error("unsupported archive syntax kind"); }',
+            'node(n->previewNode()); }',
+            'SyntaxNode* ArchiveReader::node() {',
+            'auto id=number(); if(!id) return nullptr; auto fresh=number();',
+            'if(!fresh) { if(id>nodes.size() || !nodes[id-1]) throw std::runtime_error("invalid archive reference"); return nodes[id-1]; }',
+            'if(id!=nodes.size()+1 || id>16000000) throw std::runtime_error("invalid archive node id"); nodes.push_back(nullptr);',
+            'auto kind=SyntaxKind(number()); SyntaxNode* result=nullptr; switch(kind) {']
+    for kind,name in sorted(kindmap.items()):
+        v=alltypes[name];out += [f'case SyntaxKind::{kind}: {{']
+        args=['kind'] if 'kind' in v.argNames else []
+        for m in v.combinedMembers:
+            t=m[0]
+            if m[1] in v.notNullMembers or m[1] in v.optionalMembers:
+                t=m[2]+'*'
+            out += [f'auto {m[1]}=this->field<{t}>();']
+            arg=m[1]
+            if m[1] in v.notNullMembers:
+                out += [f'if(!{arg}) throw std::runtime_error("missing required archive child");']
+                arg='*'+arg
+            args.append(arg)
+        out += [f'result=arena.emplace<{name}>({", ".join(args)}); break; }}']
+    out += ['default: throw std::runtime_error("invalid archive syntax kind"); }',
+            'nodes[id-1]=result; if(auto preview=node()) result->setPreviewNode(arena, preview); return result; }', '}']
+    with open(os.path.join(builddir,'SyntaxArchive.cpp'),'w') as f: f.write('\n'.join(out)+'\n')
+
 if __name__ == "__main__":
     main()
