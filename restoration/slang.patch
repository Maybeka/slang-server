+TEST_CASE("Declaration member views validate selection and filter parse warning ownership",
+          "[trusted-package][scope-member-view]") {
+    SourceManager sources;
+    auto owner = SyntaxTree::fromText(R"(
+package kept; localparam int K=32'd4294967297; endpackage
+package other; localparam int O=32'd4294967297; endpackage
+)",
+                                      sources, "warnings.sv");
+    REQUIRE(owner->diagnostics().size() == 2);
+    REQUIRE_FALSE(owner->diagnostics()[0].isError());
+    const auto& unit = owner->root().as<CompilationUnitSyntax>();
+    std::array<const MemberSyntax*, 1> selected{unit.members[0]};
+    auto view = SyntaxTree::selectCompilationUnitMembers(owner, selected);
+    REQUIRE(view->diagnostics().size() == 1);
+    CHECK(view->diagnostics()[0].location == owner->diagnostics()[0].location);
+    std::array<const MemberSyntax*, 2> duplicate{unit.members[0], unit.members[0]};
+    CHECK_THROWS(SyntaxTree::selectCompilationUnitMembers(owner, duplicate));
+    CHECK_THROWS(SyntaxTree::selectCompilationUnitMembers(owner, {}));
+    auto other = SyntaxTree::fromText("package foreign; endpackage\nmodule m; endmodule", sources);
+    selected[0] = other->root().as<CompilationUnitSyntax>().members[0];
+    CHECK_THROWS(SyntaxTree::selectCompilationUnitMembers(owner, selected));
+    auto invalid = SyntaxTree::fromText("package bad; ? endpackage\nmodule m; endmodule", sources);
+    selected[0] = unit.members[0];
+    CHECK_THROWS(SyntaxTree::selectCompilationUnitMembers(invalid, selected));
+}
