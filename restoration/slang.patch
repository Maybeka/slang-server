+std::shared_ptr<SyntaxTree> SyntaxTree::extendCachedPrefix(
+    const std::shared_ptr<SyntaxTree>& prefix, std::span<const SourceBuffer> sources,
+    const Bag& options) {
+    if (!prefix || !prefix->prefixState || !prefix->isPrefixResumeSafe().value_or(false) ||
+        sources.empty())
+        SLANG_THROW(std::invalid_argument("a prepared prefix and extension roots are required"));
+    auto pp = options.getOrDefault<PreprocessorOptions>();
+    if (pp.bufferChangeCB || !pp.keywordMapping.empty())
+        SLANG_THROW(std::invalid_argument("callbacks and keyword mappings cannot be checkpointed"));
+    auto extensionOptions = options;
+    pp.predefines.clear();
+    pp.captureUvmPrefix = false;
+    extensionOptions.set(pp);
+    auto suffix = create(prefix->sourceMan, sources, extensionOptions, prefix->getDefinedMacros(),
+                         false, prefix.get(), true);
+    auto result = withCachedPrefix(prefix, suffix);
+    auto summary = *prefix->prefixState->wholeTreeDirectives;
+    const auto& added = *suffix->prefixState->wholeTreeDirectives;
+    summary.resumeSafe &= added.resumeSafe;
+    summary.sourceEffects |= added.sourceEffects;
+    summary.binds |= added.binds;
+    summary.defparams |= added.defparams;
+    result->prefixState->wholeTreeDirectives = summary;
+    result->prefixState->guards = suffix->prefixState->guards;
+    result->prefixState->cwd = suffix->prefixState->cwd;
+    result->options_ = options;
+    if (result->prefixState->cwd != prefix->prefixState->cwd)
+        SLANG_THROW(std::runtime_error("prefix cwd changed during extension"));
+    return result;
+}
