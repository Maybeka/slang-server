+    const auto& value = owner.getRootNoFinalize().lookupName<VariableSymbol>("top.result");
+    const auto drivers = original.getDrivers(value);
+    const auto allocated = owner.getTotalBytesAllocated();
+    unsigned completed = 0, polls = 0;
+    AnalysisManager cancelled;
+    cancelled.setCheckpoint([&] {
+        if (++polls == 3)
+            throw std::runtime_error("cancel inside dataflow");
+    });
+    cancelled.addListener([&](const AnalyzedProcedure&) { ++completed; });
+    CHECK_THROWS_AS(cancelled.analyze(owner), std::runtime_error);
