+std::optional<std::string> SourceLoader::inputWitnessFailure(
+    std::span<const fs::path> overlayPaths, function_ref<void()> checkCancelled) const {
+    for (const auto& witness : inputGlobWitnesses) {
+        if (checkCancelled)
+            checkCancelled();
+        if (witness.base.empty())
+            return "source context cannot witness its original source pattern base";
+        SmallVector<fs::path> matches;
+        std::error_code error;
+        svGlob(witness.base, witness.pattern,
+               witness.directories ? GlobMode::Directories : GlobMode::Files, matches,
+               witness.expandEnvVars, error);
+        if (witness.exact && matches.empty() && error == std::errc::no_such_file_or_directory &&
+            witness.matches.size() == 1 &&
+            std::find(overlayPaths.begin(), overlayPaths.end(), witness.matches[0]) !=
+                overlayPaths.end())
+            continue; // An open editor root remains an input after disk deletion.
+        if (error != witness.error || !std::ranges::equal(matches, witness.matches))
+            return "source input pattern changed: " + witness.pattern;
+    }
+    return std::nullopt;
+}
