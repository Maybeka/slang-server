+        (void)library->getSemanticDiagnostics();
+        owner->importPackage(library, "lib", libraryTree->sourceManager());
+    }
+    owner->addSyntaxTree(SyntaxTree::fromText(prefix + initial + "endpackage\n"));
+    const auto before = report(owner->getSemanticDiagnostics());
+    REQUIRE_FALSE(before.empty());
+    const auto* late = owner->getRoot().lookupName(qualified);
+    REQUIRE(late);
+    REQUIRE(late->kind == SymbolKind::ClassType);
+    CHECK(late->as<ClassType>().hasCompletedSemanticAnalysis() == (completed || providerReady));
+    const auto& work = owner->getPackage("p")->find<SubroutineSymbol>("work");
+    const auto bytes = owner->getTotalBytesAllocated();
+    auto tree = SyntaxTree::fromText(current);
+    const FunctionDeclarationSyntax* syntax = nullptr;
+    auto find = [&](auto&& self, const SyntaxNode& node) -> void {
+        if (auto fn = node.as_if<FunctionDeclarationSyntax>()) {
+            syntax = fn;
+            return;
+        }
+        for (uint32_t i = 0; i < node.getChildCount(); ++i)
+            if (auto child = node.childNode(i))
+                self(self, *child);
+    };
+    find(find, tree->root());
+    REQUIRE(syntax);
+    Compilation edited(options);
+    edited.setBodyQueryContext(owner, tree);
+    BodyQueryReferenceGuard references(edited);
+    const auto& replacement = SubroutineSymbol::createBodyQuery(edited, *syntax, work);
+    edited.forceElaborate(replacement);
+    const auto& currentType = replacement.find<VariableSymbol>("local_box").getType();
+    CHECK((&currentType.getCanonicalType() == late) == (completed || providerReady));
+    const SubroutineSymbol* originals[] = {&work};
+    const auto view = edited.getBodyQuerySemanticView(replacement, originals, {});
+    Compilation fresh(options);
+    fresh.addSyntaxTree(SyntaxTree::fromText(libraryText + prefix + current + "endpackage\n"));
+    const auto expected = report(fresh.getSemanticDiagnostics());
+    REQUIRE_FALSE(expected.empty());
+    CHECK(report(view.diagnostics) == expected);
+    CHECK(owner->getTotalBytesAllocated() == bytes);
+    CHECK(report(owner->getSemanticDiagnostics()) == before);
+}
