+void freezeDirectiveAncestry(SyntaxNode& node, DirectiveSummary& summary) {
+    summary.sourceEffects |= node.kind == SyntaxKind::LineDirective ||
+                             node.kind == SyntaxKind::PragmaDirective;
+    switch (node.kind) {
+        case SyntaxKind::BeginKeywordsDirective:
+        case SyntaxKind::EndKeywordsDirective:
+            summary.resumeSafe = false;
+            break;
+        case SyntaxKind::PragmaDirective: {
+            // Plain begin/end only change the encrypt nesting depth. A complete
+            // balanced region has no terminal state to restore. Encoding,
+            // protected data, reset/diagnostic state and malformed arguments
+            // still require the full native preprocessor.
+            const auto& pragma = node.as<PragmaDirectiveSyntax>();
+            if (pragma.name.valueText() != "protect" || pragma.args.size() != 1 ||
+                pragma.args[0]->kind != SyntaxKind::SimplePragmaExpression) {
+                summary.resumeSafe = false;
+                break;
+            }
+            const auto& value = pragma.args[0]->as<SimplePragmaExpressionSyntax>().value;
+            if (value.kind == TokenKind::StringLiteral) {
+                summary.resumeSafe = false;
+                break;
+            }
+            if (value.valueText() == "begin") {
+                if (summary.plainProtectDepth)
+                    summary.resumeSafe = false;
+                ++summary.plainProtectDepth;
+            }
+            else if (value.valueText() == "end" && summary.plainProtectDepth) {
+                --summary.plainProtectDepth;
+            }
+            else {
+                summary.resumeSafe = false;
+            }
+            break;
+        }
+        default:
+            break;
+    }
+    summary.defparams |= node.kind == SyntaxKind::DefParam;
+    summary.binds |= node.kind == SyntaxKind::BindDirective;
+    for (size_t i = 0; i < node.getChildCount(); ++i) {
+        if (auto child = node.childNode(i))
+            freezeDirectiveAncestry(*child, summary);
+        else if (auto token = node.childTokenPtr(i); token && *token)
+            freezeDirectiveTrivia(token->trivia(), node, summary);
+    }
+}
