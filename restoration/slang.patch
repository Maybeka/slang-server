+namespace {
+void readMacroAccessTrace(ArchiveReader& in, PreprocessorMetadata& pp,
+                          const PreprocessorOptions& traceOptions) {
+    const auto traceFlags = in.number();
+    if (traceFlags > 3)
+        throw std::runtime_error("invalid archive macro trace flags");
+    const auto count = in.count();
+    if (!(traceFlags & 1) && count)
+        throw std::runtime_error("incomplete archive macro trace has names");
+    pp.macroAccessNames.clear();
+    pp.macroAccessStorageBytes = 0;
+    pp.macroAccessTrackingComplete = traceOptions.trackMacroAccesses && (traceFlags & 1);
+    pp.macroAccessEndedAtEof = traceOptions.trackMacroAccesses && (traceFlags & 2);
+    const auto budget = traceOptions.maxTrackedMacroAccessBytes;
+    constexpr size_t nodeBytes = sizeof(std::string) + 4 * sizeof(void*);
+    std::string_view previous;
+    for (size_t i = 0; i < count; ++i) {
+        const auto name = in.textView();
+        if (name.empty() || (i && previous >= name))
+            throw std::runtime_error("noncanonical archive macro trace names");
+        previous = name;
+        if (!pp.macroAccessTrackingComplete)
+            continue;
+        const auto remaining = budget - pp.macroAccessStorageBytes;
+        if (name.size() < remaining && nodeBytes < remaining - name.size()) {
+            // Canonical order permits linear hint insertion. Surviving names
+            // own their strings; none borrow the reader's temporary input.
+            auto it = pp.macroAccessNames.emplace_hint(pp.macroAccessNames.end(), name);
+            const auto bytes = nodeBytes + it->capacity() + 1;
+            if (bytes <= remaining) {
+                pp.macroAccessStorageBytes += bytes;
+                continue;
+            }
+        }
+        // A smaller proof budget must not invalidate an otherwise usable CST.
+        pp.macroAccessTrackingComplete = false;
+        pp.macroAccessNames.clear();
+        pp.macroAccessStorageBytes = 0;
+    }
+}
