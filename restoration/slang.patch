diff --git a/include/slang/util/CwdCoordinator.h b/include/slang/util/CwdCoordinator.h
new file mode 100644
index 0000000000000000000000000000000000000000..9e2d67cfc61d06f5bbe33ce83e43ae566efd7555
--- /dev/null
+++ b/include/slang/util/CwdCoordinator.h
@@ -0,0 +1,33 @@
+// SPDX-License-Identifier: MIT
+#pragma once
+#include <atomic>
+#include <filesystem>
+#include <mutex>
+#include "slang/util/Util.h"
+namespace slang {
+/// Coordinates internal command-file cwd writers with trusted analysis phases.
+/// Does not protect the filesystem namespace against other processes.
+class SLANG_EXPORT CwdCoordinator {
+public:
+    class SLANG_EXPORT WriteLease {
+    public:
+        WriteLease();
+    private:
+        std::unique_lock<std::recursive_mutex> lock;
+    };
+    class SLANG_EXPORT AnalysisLease {
+    public:
+        AnalysisLease();
+        ~AnalysisLease();
+        AnalysisLease(const AnalysisLease&) = delete;
+        AnalysisLease& operator=(const AnalysisLease&) = delete;
+    private:
+        std::unique_lock<std::recursive_mutex> lock;
+    };
+    static void setCurrentPath(const std::filesystem::path& path, std::error_code& ec);
+private:
+    static std::recursive_mutex mutex;
+    static std::atomic<unsigned> activeAnalyses;
+    static thread_local unsigned localAnalyses;
+};
+} // namespace slang
