+TEST_CASE("Generic specialization provenance excludes body-only dependency cycles",
+          "[body-specialization-origin]") {
+    const auto independent = GENERATE("none", "global", "peer", "signature");
+    const bool defaultParams = GENERATE(false, true);
+    CAPTURE(independent, defaultParams);
+    const std::string spec = defaultParams ? "Box" : "Box#(byte)";
+    const std::string text =
+        "package p;\n"
+        "class Leaf #(type T=int); T value; endclass\n"
+        "class Box #(type T=int); Leaf#(T) child; Box#(T) self_ref;\n"
+        "function void touch(); Leaf#(T) method_child; endfunction endclass\n" +
+        (std::string_view(independent) == "global" ? spec + " fixed_ref;\n" : "") +
+        "function automatic void work(" +
+        (std::string_view(independent) == "signature" ? "input " + spec + " arg" : "") + "); " +
+        spec + " local_box; endfunction\n" +
+        (std::string_view(independent) == "peer"
+             ? "function automatic void peer(); " + spec + " peer_box; endfunction\n"
+             : "") +
+        "endpackage\nmodule top; initial p::work(" +
+        (std::string_view(independent) == "signature" ? "null" : "") + "); endmodule\n";
+    auto tree = SyntaxTree::fromText(text);
+    CompilationOptions options;
+    options.flags |= CompilationFlags::TrackSubroutineBodyDependencies;
+    Compilation compilation(options);
+    compilation.addSyntaxTree(tree);
+    NO_COMPILATION_ERRORS;
+    const auto& work = compilation.getPackage("p")->find<SubroutineSymbol>("work");
+    const SubroutineSymbol* bodies[] = {&work};
+    auto unchanged = compilation.getUnusedClassSpecializationsExcludingBodies({});
+    REQUIRE(unchanged);
+    CHECK(unchanged->empty());
+    const auto bytes = compilation.getTotalBytesAllocated();
+    const auto& box = work.find<VariableSymbol>("local_box").getType().as<ClassType>();
+    const ClassType* roots[] = {&box};
+    auto retained = compilation.getUnusedClassSpecializationsExcludingBodies(bodies, {}, roots);
+    REQUIRE(retained);
+    CHECK(retained->empty()); // One Box root retains Leaf and the self-reference cycle.
+    const ClassType* invalidRoots[] = {nullptr};
+    CHECK_FALSE(compilation.getUnusedClassSpecializationsExcludingBodies(bodies, {}, invalidRoots));
+    auto unused = compilation.getUnusedClassSpecializationsExcludingBodies(bodies);
+    REQUIRE(unused);
+    if (std::string_view(independent) == "none") {
+        REQUIRE(unused->size() == 2);
+        CHECK(std::ranges::count_if(*unused, [](auto cls) { return cls->name == "Box"; }) == 1);
+        CHECK(std::ranges::count_if(*unused, [](auto cls) { return cls->name == "Leaf"; }) == 1);
+    }
+    else {
+        CHECK(unused->empty());
+    }
+    unsigned polls = 0;
+    CHECK_THROWS_AS(compilation.getUnusedClassSpecializationsExcludingBodies(
+                        bodies,
+                        [&] {
+                            if (++polls == 2)
+                                throw std::runtime_error("cancel specialization snapshot");
+                        }),
+                    std::runtime_error);
+    CHECK(polls == 2);
+    auto retry = compilation.getUnusedClassSpecializationsExcludingBodies(bodies);
+    REQUIRE(retry);
+    CHECK(retry->size() == unused->size());
+    CHECK(compilation.getTotalBytesAllocated() == bytes);
+    CHECK(compilation.getUnusedClassSpecializationsExcludingBodies({})->empty());
+    Compilation ordinary;
+    CHECK_FALSE(ordinary.getUnusedClassSpecializationsExcludingBodies({}));
+    CHECK_FALSE(ordinary.getClassSpecializationUses());
+    Compilation foreign(options);
+    CHECK_FALSE(foreign.getUnusedClassSpecializationsExcludingBodies(bodies));
+}
