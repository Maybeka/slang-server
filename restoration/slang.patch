+
+void SourceManager::FastCwdPhase::finish() {
+    if (!manager)
+        return;
+    auto& sm = *manager;
+    manager = nullptr;
+    try {
+        if (outer)
+            sm.validateFastCwd();
+    }
+    catch (...) {
+        --sm.fastCwdPhaseDepth;
+        lease.reset();
+        throw;
+    }
+    --sm.fastCwdPhaseDepth;
+    lease.reset();
