+size_t Compilation::getInstanceBodyReuseMemoryUsage() const {
+    // Charge reserved hash slots and control / alignment space, not just live entries.
+    auto mapBytes = [](const auto& map) {
+        using Map = std::remove_cvref_t<decltype(map)>;
+        return map.bucket_count() * (sizeof(typename Map::value_type) + 16);
+    };
+    size_t result = mapBytes(bodyReferenceStatus) + mapBytes(bodyCrossReferences) +
+                    mapBytes(bodyReuseCertificates) + mapBytes(importedBodyCanonicalInstances) +
+                    mapBytes(fixedBodyTypeOrigins) + mapBytes(importedBodyTypeIdentities) +
+                    mapBytes(fixedBodyTypePresentations);
+    for (const auto& [_, display] : fixedBodyTypePresentations)
+        result += display.name.capacity() + display.scope.capacity() + 2;
+    for (const auto& [_, origin] : fixedBodyTypeOrigins)
+        result += origin.capacity() + 1;
+    result += bodyDefinitionSites.capacity() * sizeof(decltype(bodyDefinitionSites)::value_type);
+    result += bodyElaborationControls.capacity() *
+              sizeof(decltype(bodyElaborationControls)::value_type);
+    result += bodyReuseCertificates.size() * sizeof(BodyReuseCertificate);
+    for (const auto& [_, certificate] : bodyReuseCertificates) {
+        result += mapBytes(certificate->references);
+        result += certificate->constantStorageBytes;
+        result += certificate->descendants.capacity() * sizeof(const InstanceBodySymbol*);
+        result += certificate->classes.capacity() * sizeof(const Type*);
+        result += certificate->instantiationSites.capacity() * sizeof(const DefinitionSymbol*);
+        result += certificate->diagnostics.capacity() * sizeof(const Diagnostic*);
+    }
+    result += importedBodyClasses.capacity() * sizeof(const Type*);
+    return result;
+}
