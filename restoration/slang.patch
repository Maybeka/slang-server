+void replaceSource(SourceManager& manager, BufferID id, std::string_view contents) {
+    SmallVector<char> bytes;
+    bytes.insert(bytes.end(), contents.begin(), contents.end());
+    bytes.push_back('\0');
+    manager.replaceBuffer(id, std::move(bytes));
