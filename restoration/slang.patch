+struct SourceManager::ImmutablePrefix {
+    std::vector<std::variant<FileInfo, ExpansionInfo>> entries;
+    decltype(lookupCache) files;
+    uint32_t unnamedCount = 0;
+};
+
+std::shared_ptr<const SourceManager::ImmutablePrefix> SourceManager::captureImmutablePrefix(
+    std::span<const BufferID> graph) {
+    std::unique_lock lock(mutex);
+    if (immutablePrefix)
+        SLANG_THROW(std::logic_error("immutable source prefix already captured"));
+    auto prefix = std::make_shared<ImmutablePrefix>();
+    prefix->entries = bufferEntries;
+    prefix->unnamedCount = unnamedBufferCount.load();
+    flat_hash_set<const FileData*> retained;
+    for (auto id : graph) {
+        if (id.getId() >= bufferEntries.size())
+            SLANG_THROW(std::invalid_argument("invalid immutable source graph"));
+        if (auto file = std::get_if<FileInfo>(&bufferEntries[id.getId()]); file && file->data)
+            retained.emplace(file->data.get());
+    }
+    for (const auto& [path, value] : lookupCache)
+        if (value.first && retained.contains(value.first.get()))
+            prefix->files.emplace(path, value);
+    immutablePrefix = prefix;
+    return prefix;
+}
+
+void SourceManager::inheritImmutablePrefix(std::shared_ptr<const ImmutablePrefix> prefix) {
+    std::unique_lock lock(mutex);
+    if (!prefix || bufferEntries.size() != 1 || !lookupCache.empty() || snapshotRecording ||
+        snapshotReplay || immutablePrefix)
+        SLANG_THROW(std::logic_error("immutable prefix requires a fresh source manager"));
+    bufferEntries = prefix->entries;
+    lookupCache = prefix->files;
+    unnamedBufferCount.store(prefix->unnamedCount);
+    immutablePrefix = std::move(prefix);
+}
+
+bool SourceManager::sharesImmutablePrefix(const SourceManager& other) const {
+    return this == &other || (immutablePrefix && immutablePrefix == other.immutablePrefix);
