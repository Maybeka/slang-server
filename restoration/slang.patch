+TEST_CASE("Macro absence traces own positive negative and mutation names",
+          "[preprocessor][macro-access]") {
+    for (bool enabled : {false, true}) {
+        PreprocessorOptions options;
+        options.trackMacroAccesses = enabled;
+        options.predefines = {"COMMAND=42"};
+        Preprocessor pp(getSourceManager(), alloc, diagnostics, Bag{options});
+        CHECK_FALSE(pp.isDefined("API_MISS"));
+        CHECK_FALSE(pp.undefine("API_UNDEF_MISS"));
+        pp.pushSource(R"(
+`define PRESENT 1
+`define USE(X) `X
+`define GET_NAME(A) `A``_FLAG
+`define KNOWN_FLAG 8
+`GET_NAME(KNOWN)
+`GET_NAME(UNKNOWN)
+`USE(PRESENT)
+`USE(EXPANSION_MISS)
+`ifdef CONDITIONAL_MISS
+ignored
+`elsif PRESENT
+42
+`endif
+`ifndef IFNDEF_MISS
+42
+`endif
+`undef UNDEF_MISS
+`undef PRESENT
+`define PRESENT 2
+)");
+        while (pp.next().kind != TokenKind::EndOfFile) {}
+        auto metadata = pp.getMetadata();
+        CHECK(metadata.macroAccessEndedAtEof == enabled);
+        CHECK(metadata.macroAccessTrackingComplete == enabled);
+        if (!enabled) {
+            CHECK(metadata.macroAccessNames.empty());
+            CHECK(metadata.macroAccessStorageBytes == 0);
+            continue;
+        }
+        for (auto name : {"API_MISS", "API_UNDEF_MISS", "COMMAND", "PRESENT", "USE",
+                          "EXPANSION_MISS", "CONDITIONAL_MISS", "IFNDEF_MISS", "UNDEF_MISS",
+                          "KNOWN_FLAG", "UNKNOWN_FLAG"})
+            CHECK(metadata.macroAccessNames.contains(name));
+        CHECK_FALSE(metadata.macroAccessNames.contains("UNOBSERVED"));
+        CHECK(metadata.macroAccessStorageBytes > 0);
+        CHECK(metadata.macroAccessStorageBytes <= options.maxTrackedMacroAccessBytes);
+    }
+}
