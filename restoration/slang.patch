+            REQUIRE_FALSE(syntax);
+            syntax = fn;
+            return;
+        }
+        for (uint32_t i = 0; i < node.getChildCount(); ++i)
+            if (auto child = node.childNode(i))
+                self(self, *child);
+    };
+    find(find, bodyTree->root());
+    REQUIRE(syntax);
+    Compilation edited(options);
+    edited.setBodyQueryContext(owner, bodyTree);
+    const SubroutineSymbol* replacement;
+    {
+        BodyQueryReferenceGuard references(edited);
+        replacement = &SubroutineSymbol::createBodyQuery(edited, *syntax, work);
+        edited.forceElaborate(*replacement);
+        (void)edited.getBodyQueryDiagnostics();
+    }
+    const SubroutineSymbol* originals[] = {&work};
+    auto roots = edited.getClassSpecializationUses();
+    REQUIRE(roots);
+    auto unused = owner->getUnusedClassSpecializationsExcludingBodies(originals, {}, *roots);
+    REQUIRE(unused);
+    auto view = edited.getBodyQuerySemanticView(*replacement, originals, *unused);
+    Compilation fresh(options);
+    if (imported)
+        fresh.importPackage(library, "lib", libraryTree->sourceManager());
+    fresh.addSyntaxTree(SyntaxTree::fromText(prefix + function(newShape) + "endpackage\n"));
+    const auto expected = report(fresh.getSemanticDiagnostics());
+    CHECK(report(view.diagnostics) == expected);
+    REQUIRE_FALSE(view.diagnostics.empty());
+    CHECK(owner->getTotalBytesAllocated() == originalBytes);
+    CHECK(report(owner->getSemanticDiagnostics()) == originalReport);
+    CHECK(library->getTotalBytesAllocated() == libraryBytes);
+    if (std::string_view(oldShape) == "none" && std::string_view(newShape) != "none")
+        CHECK(std::ranges::any_of(view.excludedClassScopes,
+                                  [](auto cls) { return cls->isUninstantiated; }));
+    if (!imported && std::string_view(oldShape) != "none" && std::string_view(newShape) == "none")
+        CHECK(std::ranges::any_of(view.diagnostics, [&](const Diagnostic& diagnostic) {
+            for (auto symbol = diagnostic.symbol; symbol;) {
+                if (auto cls = symbol->as_if<ClassType>();
+                    cls && cls->isUninstantiated && &cls->getCompilation() == &edited)
+                    return true;
+                auto scope = symbol->getParentScope();
+                symbol = scope ? &scope->asSymbol() : nullptr;
+            }
+            return false;
+        }));
+    Compilation cancelled(options);
+    cancelled.setBodyQueryContext(owner, bodyTree);
+    const SubroutineSymbol* candidate;
+    {
+        BodyQueryReferenceGuard references(cancelled);
+        candidate = &SubroutineSymbol::createBodyQuery(cancelled, *syntax, work);
+        cancelled.forceElaborate(*candidate);
+    }
+    unsigned polls = 0;
+    CHECK_THROWS_AS(cancelled.getBodyQuerySemanticView(*candidate, originals, *unused,
+                                                       [&] {
+                                                           if (++polls == 2)
+                                                               throw std::runtime_error(
+                                                                   "cancel raw semantic view");
+                                                       }),
+                    std::runtime_error);
+    CHECK(polls == 2);
+    CHECK(owner->getTotalBytesAllocated() == originalBytes);
+    CHECK(report(owner->getSemanticDiagnostics()) == originalReport);
+}
