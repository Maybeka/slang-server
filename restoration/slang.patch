+`define LIB_NARROW(value) begin byte narrow; narrow = value; end
+`define LIB_NESTED(value) `LIB_NARROW(value)
+`define LIB_ERROR(value) value.missing_member = 1;
+)"),
+                       sm.assignText("caller.sv", R"(
+`define USER_CASE begin int user_value; case(user_value) 1: ; endcase end
+module top;
