+    // retaining a chain of wrappers across context retirement.
+    result->prefixState->namespaceOwner = owner->prefixState && owner->prefixState->namespaceOwner
+                                              ? owner->prefixState->namespaceOwner
+                                              : owner;
+    result->prefixState->extraBytes = result->prefixState->namespaceOwner->getRetainedSyntaxBytes();
+    return std::shared_ptr<SyntaxTree>(result);
+}
