+                out.text(data.name.starts_with("<unnamed_buffer") ? std::string_view(data.name)
+                                                                  : std::string_view{});
+                out.text({data.mem.data(), data.mem.size()});
+            }
+            out.location(file->includedFrom);
+            out.number(file->sortKey);
+            out.number(uint64_t(file->bufferKind));
+            out.number(file->lineDirectives.size());
+            for (auto& line : file->lineDirectives) {
+                out.text(line.name);
+                out.number(line.lineInFile);
+                out.number(line.lineOfDirective);
+                out.number(line.level);
+            }
+            out.number(file->hasExternalDirectives);
+        }
