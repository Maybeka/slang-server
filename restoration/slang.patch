+
+void SourceManager::FastCwdPhase::finish() {
+    if (!manager)
+        return;
+    auto& sm = *manager;
+    manager = nullptr;
+    try {
+        if (outer)
+            sm.validateFastCwd();
+    }
+    catch (...) {
+        --sm.fastCwdPhaseDepth;
+        lease.reset();
+        throw;
+    }
+    --sm.fastCwdPhaseDepth;
+    lease.reset();
+}
+
+SourceManager::FastCwdPhase::~FastCwdPhase() noexcept {
+    // Unwinding must release the phase, preserving the original cancellation /
+    // failure. A boundary failure still poisons the manager for later attempts.
+    try {
+        finish();
+    }
+    catch (...) {
+    }
