+            };
+            baseline->analyzedSubroutines.cvisit_all([&](const auto& item) { add(*item.second); });
+            baseline->analyzedScopes.cvisit_all([&](const auto& item) {
+                if (item.second) {
+                    snapshot->scopes.emplace(item.first, *item.second);
