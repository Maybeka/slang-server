+TEST_CASE("Driver source lease preserves libraries without retaining driver syntax") {
+    auto driver = std::make_shared<Driver>();
+    driver->addStandardArgs();
+    REQUIRE(driver->parseCommandLine("slang --threads 1 --top m"));
+    REQUIRE(driver->processOptions(false));
+    std::weak_ptr<Driver> original = driver;
+    auto lease = driver->getSourceOwner();
+    std::weak_ptr<const void> lifetime = lease;
+    auto& sources = driver->sourceManager;
+    auto tree = SyntaxTree::fromText("module m; logic value; endmodule", sources);
+    driver->syntaxTrees.push_back(tree);
+    tree.reset();
+    auto compilation = driver->createCompilation();
+    compilation->retainSourceOwner(lease);
+    REQUIRE(compilation->getSemanticDiagnostics().empty());
+    REQUIRE(compilation->getRoot().topInstances.size() == 1);
+    // Both libraries are created after obtaining the lease; it must retain the
+    // library store, not just a copy of its earlier empty list.
+    auto vendor = driver->sourceLoader.getOrAddLibrary("vendor");
+    vendor->includeDirs.emplace_back("retained/include");
+    auto buffer = sources.assignText("vendor.sv", "wire x;", {}, vendor);
+    auto unrelated = SyntaxTree::fromText("module spare; endmodule", sources);
+    std::weak_ptr<SyntaxTree> unusedTree = unrelated;
+    driver->syntaxTrees.push_back(unrelated);
+    unrelated.reset();
+    lease.reset();
+    driver.reset();
+    CHECK(original.expired());
+    CHECK(unusedTree.expired());
+    CHECK_FALSE(lifetime.expired());
+    CHECK(sources.getSourceText(buffer.id) == "wire x;\0"sv);
+    CHECK(sources.getLibraryFor(buffer.id)->name == "vendor");
+    CHECK(sources.getLibraryFor(buffer.id)->includeDirs.front() == "retained/include");
+    const auto& definition = compilation->getRoot().topInstances.front()->getDefinition();
+    CHECK(definition.sourceLibrary.name == "work");
+    CHECK(definition.sourceLibrary.isDefault);
+    REQUIRE(compilation->getRoot().topInstances.front()->body.find("value"));
+    compilation.reset();
+    CHECK(lifetime.expired());
