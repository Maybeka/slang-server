+TEST_CASE("Declaration member warning ownership follows native root order across files",
+          "[trusted-package][scope-member-view]") {
+    SourceManager sources;
+    // Allocate in a different order from the actual compilation input sequence.
+    auto second = sources.assignText(
+        "second.sv", "localparam int B=32'd4294967297; endpackage\n"
+                     "package other; localparam int C=32'd4294967297; endpackage\n");
+    auto first = sources.assignText("first.sv", "package kept; localparam int A=32'd4294967297;\n");
+    std::vector roots{first, second};
+    auto owner = SyntaxTree::fromBuffers(roots, sources);
+    REQUIRE(owner->diagnostics().size() == 3);
+    const auto& unit = owner->root().as<CompilationUnitSyntax>();
+    REQUIRE(unit.members.size() == 2);
+    std::array<const MemberSyntax*, 1> selected{unit.members[0]};
+    auto view = SyntaxTree::selectCompilationUnitMembers(owner, selected);
+    REQUIRE(view->diagnostics().size() == 2);
+    CHECK(view->diagnostics()[0].location == owner->diagnostics()[0].location);
+    CHECK(view->diagnostics()[1].location == owner->diagnostics()[1].location);
+}
