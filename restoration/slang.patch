+static bool sameSemanticLocation(const SourceManager& sources, SourceLocation a, SourceLocation b,
+                                 unsigned depth = 0) {
+    if (a == b)
+        return true;
+    if (!a || !b || depth >= 128)
+        return false;
+    const bool am = sources.isMacroLoc(a), bm = sources.isMacroLoc(b);
+    if (am || bm) {
+        if (!am || !bm || sources.isMacroArgLoc(a) != sources.isMacroArgLoc(b) ||
+            sources.getMacroName(a) != sources.getMacroName(b))
+            return false;
+        auto ar = sources.getExpansionRange(a), br = sources.getExpansionRange(b);
+        return sameSemanticLocation(sources, sources.getOriginalLoc(a), sources.getOriginalLoc(b),
+                                    depth + 1) &&
+               sameSemanticLocation(sources, ar.start(), br.start(), depth + 1) &&
+               sameSemanticLocation(sources, ar.end(), br.end(), depth + 1);
+    }
+    if (sources.getFullPath(a.buffer()).empty() || a.offset() != b.offset() ||
+        sources.getFullPath(a.buffer()) != sources.getFullPath(b.buffer()) ||
+        sources.getSourceText(a.buffer()) != sources.getSourceText(b.buffer()))
+        return false;
+    return sameSemanticLocation(sources, sources.getIncludedFrom(a.buffer()),
+                                sources.getIncludedFrom(b.buffer()), depth + 1);
+}
+
+static bool sameSemanticDiagnostic(const SourceManager& sources, const Diagnostic& a,
+                                   const Diagnostic& b) {
+    if (!sameSemanticLocation(sources, a.location, b.location) ||
+        a.ranges.size() != b.ranges.size() || a.notes.size() != b.notes.size() ||
+        a.coalesceCount != b.coalesceCount)
+        return false;
+    Diagnostic normalized = b;
+    normalized.location = a.location;
+    if (a != normalized)
+        return false;
+    for (size_t i = 0; i < a.ranges.size(); ++i)
+        if (!sameSemanticLocation(sources, a.ranges[i].start(), b.ranges[i].start()) ||
+            !sameSemanticLocation(sources, a.ranges[i].end(), b.ranges[i].end()))
+            return false;
+    for (size_t i = 0; i < a.notes.size(); ++i)
+        if (!sameSemanticDiagnostic(sources, a.notes[i], b.notes[i]))
+            return false;
+    return true;
