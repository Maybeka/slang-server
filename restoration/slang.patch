+Token ArchiveReader::token() {
+    auto kind = TokenKind(number());
+    auto valid = number();
+    if (!valid)
+        return {};
+    auto missing = number();
+    auto loc = location();
+    auto raw = string();
+    auto fileIntrinsic = number();
+    SmallVector<Trivia> trivia;
+    auto n = count();
+    for (size_t i = 0; i < n; ++i) {
+        auto k = TriviaKind(number());
+        if (k == TriviaKind::Directive || k == TriviaKind::SkippedSyntax)
+            trivia.emplace_back(k, node());
+        else if (k == TriviaKind::SkippedTokens) {
+            SmallVector<Token> list;
+            auto size = count();
+            for (size_t j = 0; j < size; ++j)
+                list.push_back(token());
+            trivia.emplace_back(k, arena.copyFrom<Token>(list));
+        }
+        else {
+            auto text = string();
+            auto explicitLoc = number();
+            Trivia t(k, text);
+            if (explicitLoc)
+                t = t.withLocation(arena, location());
+            trivia.push_back(t);
+        }
+    }
+    Token result;
+    switch (kind) {
+        case TokenKind::StringLiteral:
+        case TokenKind::IncludeFileName: {
+            auto value = string();
+            if (fileIntrinsic) {
+                if (!sources)
+                    throw std::runtime_error("missing archive source manager");
+                value = copy(sources->getFileName(loc));
+                raw = copy("\"" + std::string(value) + "\"");
+            }
+            result = Token(arena, kind, trivia, raw, loc, value);
+            break;
+        }
+        case TokenKind::IntegerLiteral: {
+            auto bits = number();
+            auto sign = number();
+            auto unknown = number();
+            if (!bits || bits > SVInt::MAX_BITS || sign > 1 || unknown > 1)
+                throw std::runtime_error("invalid archive integer literal");
+            SmallVector<uint64_t> words;
+            const size_t count = ((bits + 63) / 64) * (unknown ? 2 : 1);
+            for (size_t i = 0; i < count; ++i)
+                words.push_back(number());
+            SVIntStorage storage{bitwidth_t(bits), bool(sign), bool(unknown)};
+            if (bits <= 64 && !unknown)
+                storage.val = words[0];
+            else
+                storage.pVal = words.data();
+            result = Token(arena, kind, trivia, raw, loc, SVInt(storage));
+            break;
+        }
+        case TokenKind::RealLiteral:
+        case TokenKind::TimeLiteral: {
+            auto value = std::bit_cast<double>(number());
+            NumericTokenFlags flags;
+            flags.raw = uint8_t(number());
+            result = Token(arena, kind, trivia, raw, loc, value, flags.outOfRange(),
+                           kind == TokenKind::TimeLiteral ? std::optional(flags.unit())
+                                                          : std::nullopt);
+            break;
+        }
+        case TokenKind::IntegerBase: {
+            NumericTokenFlags flags;
+            flags.raw = uint8_t(number());
+            result = Token(arena, kind, trivia, raw, loc, flags.base(), flags.isSigned());
+            break;
+        }
+        case TokenKind::UnbasedUnsizedLiteral:
+            result = Token(arena, kind, trivia, raw, loc, logic_t(uint8_t(number())));
+            break;
+        case TokenKind::Directive:
+            result = Token(arena, kind, trivia, raw, loc, SyntaxKind(number()));
+            break;
+        case TokenKind::SystemIdentifier:
+            result = Token(arena, kind, trivia, raw, loc, KnownSystemName(number()));
+            break;
+        default:
+            result = Token(arena, kind, trivia, raw, loc);
+            break;
+    }
+    result.missing = bool(missing);
+    return result;
+}
