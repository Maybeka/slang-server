new file mode 100644
index 0000000000000000000000000000000000000000..f5fd85238ecea8f0ea25dc2a58b622c00b6c9745
--- /dev/null
+++ b/source/util/CwdCoordinator.cpp
@@ -0,0 +1,34 @@
+// SPDX-License-Identifier: MIT
+#include "slang/util/CwdCoordinator.h"
+#include <stdexcept>
+namespace slang {
+std::recursive_mutex CwdCoordinator::mutex;
+std::atomic<unsigned> CwdCoordinator::activeAnalyses{0};
+thread_local unsigned CwdCoordinator::localAnalyses = 0;
+CwdCoordinator::WriteLease::WriteLease() : lock(mutex, std::defer_lock) {
+    // Fail before waiting: a parser callback can run on a pool worker while the
+    // phase owner is waiting for that worker. Waiting here would deadlock.
+    if (activeAnalyses.load())
+        SLANG_THROW(std::runtime_error("internal cwd mutation during fast analysis is forbidden"));
+    lock.lock();
+    if (activeAnalyses.load())
+        SLANG_THROW(std::runtime_error("internal cwd mutation during fast analysis is forbidden"));
+}
+CwdCoordinator::AnalysisLease::AnalysisLease() : lock(mutex, std::defer_lock) {
+    // Workers borrow an existing phase, never recursively acquire it. Reject
+    // accidental acquisition before locking so owner->pool waits cannot cycle.
+    if (activeAnalyses.load() && !localAnalyses)
+        SLANG_THROW(std::runtime_error("fast analysis phases must be owned by one state thread; workers borrow the phase"));
+    lock.lock();
+    ++localAnalyses;
+    ++activeAnalyses;
+}
+CwdCoordinator::AnalysisLease::~AnalysisLease() {
+    --localAnalyses;
+    --activeAnalyses;
+}
+void CwdCoordinator::setCurrentPath(const std::filesystem::path& path, std::error_code& ec) {
+    WriteLease lease;
+    std::filesystem::current_path(path, ec);
+}
+} // namespace slang
