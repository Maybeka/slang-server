+        SourceManager original;
+        auto buffer = original.assignText("prefix-names.sv", "x");
+        const SourceLocation location(buffer.id, 0);
+        std::string temporary = expected;
+        expansion = original.createExpansionLoc(location, {location, location + 1}, temporary);
+        prefix = original.captureImmutablePrefix(std::vector{buffer.id});
+        temporary.assign(170, 'z');
+        CHECK(original.getMacroName(expansion) == expected);
+        original.retainSourceNames();
+        CHECK(original.getMacroName(expansion) == expected);
+    }
