+std::string Compilation::instanceBodyTypeOrigin(const Type& type) const {
+    if (auto found = fixedBodyTypeOrigins.find(&type); found != fixedBodyTypeOrigins.end())
+        return found->second;
+    if (!sourceManager || !type.getParentScope())
+        return {};
+    const auto location = type.getSyntax() ? type.getSyntax()->getFirstToken().location()
+                                           : type.location;
+    const auto original = sourceManager->getFullyOriginalLoc(location);
+    const auto expanded = sourceManager->getFullyExpandedLoc(location);
+    if (!original || !expanded)
+        return {};
+    return fmt::format("{}:{}:{}:{}:{}:{}:{}:{}:{}:{}:{}:{}", int(type.kind),
+                       sourceManager->getFullPath(original.buffer()).generic_string(),
+                       original.offset(), sourceManager->getLineNumber(original),
+                       sourceManager->getColumnNumber(original),
+                       sourceManager->getFullPath(expanded.buffer()).generic_string(),
+                       expanded.offset(), sourceManager->getLineNumber(expanded),
+                       sourceManager->getColumnNumber(expanded),
+                       type.getParentScope()->asSymbol().getHierarchicalPath(), type.name,
+                       type.getSyntax() ? type.getSyntax()->toString() : std::string());
