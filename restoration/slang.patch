+    std::vector<const AnalyzedProcedure*> roots;
+    for (const auto& state : workerStates)
+        state.scopeAlloc.visitAll([&](const AnalyzedScope& scope) {
+            for (const auto& procedure : scope.procedures) {
+                checkpoint();
+                if (procedure.hasTaskTimingChecks() &&
+                    procedure.analyzedSymbol->as<ProceduralBlockSymbol>().procedureKind !=
+                        ProceduralBlockKind::Initial)
