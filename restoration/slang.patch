+    // FileData directory pointers must refer to this manager's stable path set,
+    // not the temporary validation manager. Immutable retained files share their
+    // existing storage; only other files need newly owned bytes here.
+    flat_hash_map<const FileData*, std::shared_ptr<FileData>> replacements;
+    flat_hash_set<const FileData*> retainedData;
+    for (auto& [_, data] : keep)
+        retainedData.insert(data.get());
+    for (size_t i = 1; i < next.snapshotFiles.size(); ++i) {
+        auto& data = next.snapshotFiles[i];
+        auto original = data.get();
+        auto it = keep.find(getU8Str(data->fullPath));
+        std::shared_ptr<FileData> replacement;
+        if (it != keep.end())
+            replacement = it->second;
+        else {
+            auto directory = &*directories.insert(*data->directory).first;
+            SmallVector<char> bytes;
+            bytes.insert(bytes.end(), data->mem.begin(), data->mem.end());
+            replacement = std::make_shared<FileData>(directory, data->name, std::move(bytes),
+                                                     data->fullPath);
+        }
+        replacements.emplace(original, replacement);
+        data = std::move(replacement);
+    }
+    for (auto& [_, value] : next.lookupCache)
+        if (value.first)
+            value.first = replacements.at(value.first.get());
+    for (auto& [_, value] : next.snapshotLookups)
+        if (value.first)
+            value.first = replacements.at(value.first.get());
+    // All potentially throwing preparation precedes invalidating live file IDs.
+    for (auto& entry : bufferEntries)
+        if (auto* info = std::get_if<FileInfo>(&entry);
+            info && info->data && !retainedData.contains(info->data.get())) {
+            info->data->isStale = true;
+            info->data.reset();
+        }
+    lookupCache.swap(next.lookupCache);
+    snapshotLookups.swap(next.snapshotLookups);
+    snapshotFiles.swap(next.snapshotFiles);
+    snapshotHeaderRequests.swap(next.snapshotHeaderRequests);
+    snapshotGeneratedPaths.swap(next.snapshotGeneratedPaths);
+    return true;
+}
