+TEST_CASE("Immutable package semantics retain identity across mutable consumers",
+          "[trusted-package]") {
+    SourceManager sources;
+    auto tree = SyntaxTree::fromText(R"(
+package uvm_pkg;
+    class uvm_object;
+        int tag;
+        process running;
+        virtual function int get_tag(); return tag; endfunction
+    endclass
+    class box #(type T);
+        T value;
+        extern function int read_field();
+    endclass
+    function int box::read_field(); return value.field; endfunction
+endpackage
+)",
+                                     sources, "uvm_pkg.sv");
+    CompilationOptions options;
+    options.flags = CompilationFlags::PackageAnalysis;
+    auto library = std::make_shared<Compilation>(options);
+    library->addSyntaxTree(tree);
+    REQUIRE(library->getAllDiagnostics().empty());
+    auto package = library->getPackage("uvm_pkg");
+    REQUIRE(package);
+    auto object = package->find("uvm_object");
+    auto& generic = package->find("box")->as<GenericClassDefSymbol>();
+    auto fixedSpecializations = generic.numSpecializations();
+    const auto fixedAstBytes = library->getTotalBytesAllocated();
+    auto prefix = sources.captureImmutablePrefix(tree->getSourceBufferIds());
+
+    for (int version = 0; version < 3; ++version) {
+        SourceManager consumerSources;
+        consumerSources.inheritImmutablePrefix(prefix);
+        Compilation consumer(options);
+        consumer.importPackage(library, "uvm_pkg", consumerSources);
+        auto text = version == 1 ? R"(
+package user_pkg;
+    import uvm_pkg::*;
+    class Packet; int other; endclass
+    class Test extends uvm_object;
+        box#(Packet) payload;
+    endclass
+endpackage
+)"
+                                 : R"(
+package user_pkg;
+    import uvm_pkg::*;
+    class Packet; int field; endclass
+    class Test extends uvm_object;
+        box#(Packet) payload;
+        function int check(); return get_tag(); endfunction
+        function process get_process(); return running; endfunction
+    endclass
+endpackage
+)";
+        consumer.addSyntaxTree(SyntaxTree::fromText(text, consumerSources, "user.sv"));
+        auto& diagnostics = consumer.getAllDiagnostics();
+        CHECK(diagnostics.empty() == (version != 1));
+        REQUIRE(consumer.getPackage("uvm_pkg") == package);
+        auto test = consumer.getPackage("user_pkg")->find("Test");
+        REQUIRE(test);
+        CHECK(test->as<ClassType>().getBaseClass() == object);
+        CHECK_FALSE(consumer.getImportedClassSpecializations().empty());
+        CHECK(generic.numSpecializations() == fixedSpecializations);
+        CHECK(library->getSemanticDiagnostics().empty());
+        CHECK(library->getTotalBytesAllocated() == fixedAstBytes);
+        CHECK(consumerSources.getSourceText(package->location.buffer()) ==
+              sources.getSourceText(package->location.buffer()));
+    }
+}
