+
+void SourceManager::setSnapshotGeneratedSequence(std::span<const uint32_t> fileIds) {
+    std::unique_lock<std::shared_mutex> lock(mutex);
+    if (!snapshotReplay || snapshotGeneratedSequenceActive)
+        failSnapshot("generated parse sequence requires an idle replay manager");
+    for (auto id : fileIds) {
+        if (!id || id >= snapshotFiles.size() ||
+            !snapshotGeneratedPaths.contains(getU8Str(snapshotFiles[id]->fullPath)))
+            failSnapshot("invalid generated source file ID");
+    }
+    snapshotGeneratedSequence.assign(fileIds.begin(), fileIds.end());
+    snapshotGeneratedIndex = 0;
+    snapshotGeneratedSequenceActive = true;
+}
+
+void SourceManager::finishSnapshotGeneratedSequence() {
+    std::unique_lock<std::shared_mutex> lock(mutex);
+    if (!snapshotReplay || !snapshotGeneratedSequenceActive ||
+        snapshotGeneratedIndex != snapshotGeneratedSequence.size())
+        failSnapshot("generated parse sequence was not fully consumed");
+    snapshotGeneratedSequence.clear();
+    snapshotGeneratedIndex = 0;
+    snapshotGeneratedSequenceActive = false;
+}
