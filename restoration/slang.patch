+TEST_CASE("Macro entry journal preserves use environments and intrinsic uses",
+          "[preprocessor][macro-entry-journal]") {
+    for (bool enabled : {false, true}) {
+        DYNAMIC_SECTION("history=" << enabled) {
+            PreprocessorOptions options;
+            options.trackMacroHistory = enabled;
+            Preprocessor pp(getSourceManager(), alloc, diagnostics, Bag{options});
+            pp.pushSource("`define VALUE 7\n"
+                          "`define PICK(X) X\n"
+                          "`PICK(`VALUE)\n"
+                          "`undef VALUE\n"
+                          "`define VALUE 9\n"
+                          "`begin_keywords \"1800-2005\"\n"
+                          "`VALUE\n"
+                          "`__LINE__\n"
+                          "`end_keywords\n");
+            std::vector<int> values, versions;
+            while (true) {
+                auto token = pp.next();
+                if (token.kind == TokenKind::EndOfFile)
+                    break;
+                REQUIRE(token.kind == TokenKind::IntegerLiteral);
+                values.push_back(token.intValue().as<int>().value());
+                versions.push_back(int(pp.getCurrentKeywordVersion()));
+            }
+            CHECK(values == std::vector<int>{7, 9, 8});
+            const auto metadata = pp.getMetadata();
+            if (!enabled) {
+                CHECK(metadata.macroEntries.empty());
+                CHECK(metadata.macroChanges.empty());
+                continue;
+            }
+            REQUIRE(metadata.macroEntries.size() == 3);
+            const std::vector<std::string> names = {"`PICK", "`VALUE", "`__LINE__"};
+            for (size_t i = 0; i < metadata.macroEntries.size(); ++i) {
+                const auto& entry = metadata.macroEntries[i];
+                CHECK(entry.syntax->directive.rawText() == names[i]);
+                CHECK(entry.keywordVersion == versions[i]);
+                REQUIRE(entry.changes <= metadata.macroChanges.size());
+                std::map<std::string_view, const DefineDirectiveSyntax*> environment;
+                for (size_t j = 0; j < entry.changes; ++j) {
+                    const auto& change = metadata.macroChanges[j];
+                    if (change.name.empty())
+                        environment.clear();
+                    else if (change.definition)
+                        environment[change.name] = change.definition;
+                    else
+                        environment.erase(change.name);
+                }
+                REQUIRE(environment.contains("VALUE"));
+                CHECK(environment.at("VALUE")->body.front().intValue().as<int>() ==
+                      (i == 0 ? 7 : 9));
+            }
+        }
+    }
+}
