+    auto tree = SyntaxTree::fromBuffers(buffers, sm);
+    Compilation compilation;
+    compilation.addSyntaxTree(tree);
+    const auto& diags = compilation.getAllDiagnostics();
+    struct Collector : DiagnosticClient {
+        std::vector<DiagCode> codes;
+        void report(const ReportedDiagnostic& diagnostic) override {
+            codes.push_back(diagnostic.originalDiagnostic.code);
+        }
+    };
+    auto run = [&](bool suppress, bool replay) {
+        DiagnosticEngine engine(sm);
+        auto client = std::make_shared<Collector>();
+        engine.setSeverity(diag::CaseDefault, DiagnosticSeverity::Warning);
+        engine.setSeverity(diag::IntBoolConv, DiagnosticSeverity::Warning);
+        engine.setSeverity(diag::WidthTruncate, DiagnosticSeverity::Warning);
+        if (suppress)
+            REQUIRE(!engine.addIgnoreMacroPaths(".../vendor/..."));
+        if (replay) {
+            DiagnosticEngine restored(sm);
+            restored.applySettings(engine.captureSettings());
+            restored.addClient(client);
+            restored.issue(diags);
+        }
+        else {
+            engine.addClient(client);
+            engine.issue(diags);
+        }
+        return client->codes;
+    };
+    auto original = run(false, false);
+    auto filtered = run(true, false);
+    CHECK(std::count(original.begin(), original.end(), diag::CaseDefault) == 2);
+    CHECK(std::count(filtered.begin(), filtered.end(), diag::CaseDefault) == 1);
+    CHECK(std::count(filtered.begin(), filtered.end(), diag::WidthTruncate) == 2);
+    CHECK(std::count(filtered.begin(), filtered.end(), diag::IntBoolConv) == 2);
+    CHECK(std::count(filtered.begin(), filtered.end(), diag::UnknownMember) == 1);
+    CHECK(run(true, true) == filtered);
+}
