+        for (auto node : source.packageImports)
+            metadata.packageImports.push_back(mapNode(node));
+        for (auto node : source.classDecls)
+            metadata.classDecls.push_back(mapNode(node));
+        for (auto node : source.interfacePorts)
+            metadata.interfacePorts.push_back(mapNode(node));
+        for (auto node : source.virtualInterfaceTypes)
+            metadata.virtualInterfaceTypes.push_back(mapNode(node));
+        for (auto node : source.namedPortTypes)
+            metadata.namedPortTypes.push_back(mapNode(node));
