+TEST_CASE("Detached generic scopes reuse retained types and replay complete new class flow",
+          "[body-specialization-view]") {
+    const bool changed = GENERATE(false, true);
+    const bool defaults = GENERATE(false, true);
+    const bool reuse = GENERATE(false, true);
+    const bool calls = GENERATE(false, true);
+    CAPTURE(changed, defaults, reuse, calls);
+    CompilationOptions compilationOptions;
+    compilationOptions.flags |= CompilationFlags::TrackSubroutineBodyDependencies;
+    AnalysisOptions options;
+    options.flags |= AnalysisFlags::RetainProcedureSummaries;
+    auto library = std::make_shared<Compilation>(compilationOptions);
+    auto libraryTree = SyntaxTree::fromText(R"(
+package lib;
+  int shared_value;
+  class Leaf #(type T=int); T value; endclass
+  class Box #(type T=int);
+    Leaf#(T) child;
+    function T read(input int arg); if ($bits(T)==32) return arg; endfunction
+    function T narrow(input int arg); return arg; endfunction
+    static function void drive(input int arg); shared_value=arg; endfunction
+  endclass
+endpackage
+)");
+    library->addSyntaxTree(libraryTree);
+    for (const auto& diagnostic : library->getAllDiagnostics())
+        CHECK_FALSE(diagnostic.isError());
+    library->freeze();
+    const auto libraryBytes = library->getTotalBytesAllocated();
+    const std::string prefix = "package p;\n";
+    auto function = [&](std::string_view parameters) {
+        return "function automatic int work(input int arg);\n"
+               "lib::Box" +
+               std::string(parameters) + " local_box; " +
+               (calls ? "lib::Box" +
+                            (parameters.empty() ? std::string("#()") : std::string(parameters)) +
+                            "::drive(arg); "
+                      : "") +
+               "return arg;\nendfunction\n";
+    };
+    const std::string beforeParameters = defaults ? "" : "#(int)";
+    const std::string suffix = "endpackage\nmodule top; initial void'(p::work(1)); endmodule\n";
+    const auto oldText = prefix + function(beforeParameters) + suffix;
+    const auto newText = prefix + function(changed ? "#(byte)" : beforeParameters) + suffix;
+    auto owner = std::make_shared<Compilation>(compilationOptions);
+    owner->importPackage(library, "lib", libraryTree->sourceManager());
+    auto original = std::make_shared<AnalysisManager>(options);
+    const auto before = analyze(oldText, *owner, *original);
+    const auto& work = owner->getPackage("p")->find<SubroutineSymbol>("work");
+    const auto& oldBox = work.find<VariableSymbol>("local_box").getType().as<ClassType>();
+    const auto& shared = library->getPackage("lib")->find<VariableSymbol>("shared_value");
+    const auto oldDrivers = original->getDrivers(shared);
+    REQUIRE_FALSE(oldDrivers.empty());
+    const auto nativeBytes = owner->getTotalBytesAllocated();
+    const auto originalReport = report(before);
+    auto padding = prefix;
+    for (auto& c : padding)
+        if (c != '\n')
+            c = ' ';
+    auto bodyTree = SyntaxTree::fromText(padding +
+                                         function(changed ? "#(byte)" : beforeParameters));
+    const syntax::FunctionDeclarationSyntax* syntax = nullptr;
+    auto find = [&](auto&& self, const syntax::SyntaxNode& node) -> void {
+        if (auto fn = node.as_if<syntax::FunctionDeclarationSyntax>()) {
+            REQUIRE_FALSE(syntax);
+            syntax = fn;
+            return;
+        }
+        for (uint32_t i = 0; i < node.getChildCount(); ++i)
+            if (auto child = node.childNode(i))
+                self(self, *child);
+    };
+    find(find, bodyTree->root());
+    REQUIRE(syntax);
+    Compilation edited(compilationOptions);
+    edited.setBodyQueryContext(owner, bodyTree);
+    std::vector<const ClassType*> additional;
+    const ClassType* currentBox;
+    SubroutineSymbol* changedWork;
+    Diagnostics semantic;
+    {
+        BodyQueryReferenceGuard references(edited);
+        auto& replacement = SubroutineSymbol::createBodyQuery(edited, *syntax, work);
+        changedWork = &replacement;
+        edited.forceElaborate(replacement);
+        semantic = edited.getBodyQueryDiagnostics();
+        currentBox = &replacement.find<VariableSymbol>("local_box").getType().as<ClassType>();
+        for (auto type : edited.getImportedClassSpecializations())
+            if (&type->as<ClassType>().getCompilation() == &edited)
+                additional.push_back(&type->as<ClassType>());
+    }
+    if (changed) {
+        CHECK(currentBox != &oldBox);
+        REQUIRE(additional.size() == 2);
+        CHECK_FALSE(semantic.empty());
+        CHECK_FALSE(currentBox->find<SubroutineSymbol>("read").getBody().bad());
+    }
+    else {
+        CHECK(currentBox == &oldBox);
+        CHECK(additional.empty());
+        CHECK(semantic.empty());
+    }
+    const SubroutineSymbol* bodies[] = {&work};
+    auto obsolete = owner->getUnusedClassSpecializationsExcludingBodies(bodies);
+    REQUIRE(obsolete);
+    REQUIRE(obsolete->size() == 2);
+    const auto lookupRoots = edited.getClassSpecializationUses();
+    REQUIRE(lookupRoots);
+    if (!changed) {
+        REQUIRE(lookupRoots->size() == 1);
+        CHECK(lookupRoots->front() == &oldBox);
+    }
+    auto retained = owner->getUnusedClassSpecializationsExcludingBodies(bodies, {}, *lookupRoots);
+    REQUIRE(retained);
+    CHECK(retained->size() == (changed ? 2 : 0));
+    obsolete = std::move(retained);
+    unsigned rootPolls = 0;
+    CHECK_THROWS_AS(edited.getClassSpecializationUses([&] {
+        if (++rootPolls == 2)
+            throw std::runtime_error("cancel class roots");
+    }),
+                    std::runtime_error);
+    CHECK(rootPolls == 2);
+    CHECK(edited.getClassSpecializationUses()->size() == lookupRoots->size());
+    edited.freeze();
+    AnalysisManager replay(options);
+    const AnalysisManager::SubroutineReplacement replacements[] = {{&work, changedWork}};
+    replay.setSubroutineReplacements(replacements);
+    replay.setClassSpecializationView(*obsolete, additional);
+    if (reuse)
+        replay.setProcedureReuse(original);
+    replay.analyze(*owner);
+    const auto actual = replay.getDiagnostics();
+    Compilation fresh(compilationOptions);
+    fresh.importPackage(library, "lib", libraryTree->sourceManager());
+    AnalysisManager native(options);
+    const auto expected = analyze(newText, fresh, native);
+    CHECK(report(actual) == report(expected));
+    CHECK(report(semantic) == report(fresh.getSemanticDiagnostics()));
+    if (changed) {
+        REQUIRE_FALSE(expected.empty());
+        CHECK(report(expected) != originalReport);
+    }
+    const auto& newDrive = currentBox->find<SubroutineSymbol>("drive");
+    CHECK(replay.getAnalyzedSubroutine(newDrive));
+    const auto drivers = replay.getDrivers(shared);
+    REQUIRE(drivers.size() == native.getDrivers(shared).size());
+    CHECK(std::ranges::any_of(drivers, [&](auto driver) {
+        return driver->containingSymbol.get() == &newDrive;
+    }));
+    if (changed) {
+        CHECK_FALSE(replay.getAnalyzedScope(oldBox));
+        CHECK_FALSE(replay.getAnalyzedSubroutine(oldBox.find<SubroutineSymbol>("drive")));
+        CHECK(replay.getAnalyzedScope(*currentBox));
+    }
+    if (reuse && !changed)
+        CHECK(replay.getProcedureReuseCounts().first >= 2);
+    CHECK(report(original->getDiagnostics()) == originalReport);
+    CHECK(original->getDrivers(shared) == oldDrivers);
+    CHECK(owner->getTotalBytesAllocated() == nativeBytes);
+    CHECK(library->getTotalBytesAllocated() == libraryBytes);
+    CHECK_THROWS_AS(replay.setClassSpecializationView({}, {}), std::logic_error);
+
+    AnalysisManager mini(options);
+    mini.setClassSpecializationView({}, additional);
+    mini.analyzeBody(edited, *changedWork);
+    if (changed) {
+        CHECK(mini.getAnalyzedSubroutine(newDrive));
+        CHECK_FALSE(mini.getDrivers(shared).empty());
+        CHECK_FALSE(mini.getDiagnostics().empty());
+    }
+    else if (!calls) {
+        CHECK_FALSE(mini.getAnalyzedSubroutine(newDrive));
+        CHECK(mini.getDrivers(shared).empty());
+    }
+
+    AnalysisManager cancelled(options);
+    unsigned polls = 0;
+    cancelled.setCheckpoint([&] {
+        if (++polls == 2)
+            throw std::runtime_error("cancel class view");
+    });
+    const ClassType* one[] = {&oldBox};
+    CHECK_THROWS_AS(cancelled.setClassSpecializationView(one, {}), std::runtime_error);
+    CHECK(polls == 2);
+    cancelled.setCheckpoint({});
+    cancelled.setSubroutineReplacements(replacements);
+    cancelled.setClassSpecializationView(*obsolete, additional);
+    cancelled.analyze(*owner);
+    CHECK(report(cancelled.getDiagnostics()) == report(expected));
+
+    AnalysisManager invalid(options);
+    const ClassType* duplicates[] = {&oldBox, &oldBox};
+    CHECK_THROWS_AS(invalid.setClassSpecializationView(duplicates, {}), std::invalid_argument);
+    invalid.setClassSpecializationView({}, {});
+    invalid.analyze(*owner);
+    CHECK(report(invalid.getDiagnostics()) == originalReport);
+    AnalysisManager invalidMini(options);
+    invalidMini.setClassSpecializationView({}, one);
+    CHECK_THROWS_AS(invalidMini.analyzeBody(edited, *changedWork), std::invalid_argument);
+    AnalysisManager chained(options);
+    CHECK_THROWS_AS(chained.setProcedureReuse(
+                        std::shared_ptr<const AnalysisManager>(&replay, [](auto*) {})),
+                    std::invalid_argument);
+}
