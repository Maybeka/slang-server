+TEST_CASE("Body reference provenance preserves signatures and independent uses",
+          "[body-reference-origin]") {
+    auto tree = SyntaxTree::fromText(R"(
+package p;
+  typedef int signature_t;
+  typedef int local_t;
+  int header_ref, init_ref, body_ref, fixed_ref, outside_ref;
+  function automatic int helper(input int arg); return arg; endfunction
+  function automatic signature_t work(input signature_t arg=header_ref);
+    local_t local_value=init_ref+header_ref;
+    body_ref=arg;
+    outside_ref=arg;
+    return helper(local_value);
+  endfunction
+  function automatic int peer(); return fixed_ref+body_ref; endfunction
+endpackage
+module top;
+  int result;
+  initial result=p::outside_ref+p::work();
+endmodule
+)");
+    CompilationOptions options;
+    options.flags |= CompilationFlags::TrackSubroutineBodyDependencies;
+    Compilation compilation(options);
+    compilation.addSyntaxTree(tree);
+    NO_COMPILATION_ERRORS;
+    const auto& package = *compilation.getPackage("p");
+    const auto& work = package.find<SubroutineSymbol>("work");
+    const auto& peer = package.find<SubroutineSymbol>("peer");
+    const SubroutineSymbol* bodies[] = {&work};
+    auto outside = compilation.getReferenceUsageExcludingBodies(bodies);
+    REQUIRE(outside);
+    auto usage = [&](const Compilation::ReferenceUsageMap& profile, std::string_view name) {
+        const auto* syntax = package.find(name)->getSyntax();
+        auto found = profile.find(syntax);
+        return found == profile.end() ? std::pair<bool, bool>{} : found->second;
+    };
+    CHECK(usage(*outside, "header_ref") == std::pair{true, false});
+    CHECK(usage(*outside, "signature_t") == std::pair{true, false});
+    CHECK(usage(*outside, "init_ref") == std::pair{false, false});
+    CHECK(usage(*outside, "helper") == std::pair{false, false});
+    CHECK(usage(*outside, "local_t") == std::pair{false, false});
+    CHECK(usage(*outside, "outside_ref") == std::pair{true, false});
+    CHECK(usage(*outside, "body_ref") == std::pair{true, false});
+    CHECK(usage(*outside, "fixed_ref") == std::pair{true, false});
+    CHECK(compilation.isReferenced(*package.find("body_ref")->getSyntax()) ==
+          std::pair{true, true});
+    const SubroutineSymbol* both[] = {&work, &peer};
+    auto remainder = compilation.getReferenceUsageExcludingBodies(both);
+    REQUIRE(remainder);
+    CHECK(usage(*remainder, "body_ref") == std::pair{false, false});
+    CHECK(usage(*remainder, "fixed_ref") == std::pair{false, false});
+    CHECK(usage(*remainder, "header_ref") == std::pair{true, false});
+    CHECK(usage(*remainder, "outside_ref") == std::pair{true, false});
+    size_t checkpoints = 0;
+    CHECK_THROWS_AS(compilation.getReferenceUsageExcludingBodies(
+                        bodies,
+                        [&] {
+                            if (++checkpoints == 2)
+                                throw std::runtime_error("cancel reference snapshot");
+                        }),
+                    std::runtime_error);
+    CHECK(checkpoints == 2);
+    auto retried = compilation.getReferenceUsageExcludingBodies(bodies);
+    REQUIRE(retried);
+    CHECK(usage(*retried, "body_ref") == std::pair{true, false});
+    CHECK(compilation.isReferenced(*package.find("body_ref")->getSyntax()) ==
+          std::pair{true, true});
+    compilation.freeze();
+    Compilation consumer;
+    consumer.importPackage(std::shared_ptr<Compilation>(&compilation, [](Compilation*) {}), "p",
+                           tree->sourceManager());
+    auto exportedRemainder = compilation.getReferenceUsageExcludingBodies(bodies);
+    REQUIRE(exportedRemainder);
+    CHECK(usage(*exportedRemainder, "helper") == std::pair{false, false});
+    CHECK(usage(*exportedRemainder, "init_ref") == std::pair{false, false});
+    CHECK(usage(*exportedRemainder, "header_ref") == std::pair{true, false});
+    auto inherited = consumer.getReferenceUsageExcludingBodies({});
+    REQUIRE(inherited);
+    CHECK(usage(*inherited, "body_ref") == std::pair{true, true});
+    compilation.unfreeze();
+    Compilation ordinary;
+    ordinary.addSyntaxTree(tree);
+    for (const auto& diagnostic : ordinary.getAllDiagnostics())
+        CHECK_FALSE(diagnostic.isError());
+    const auto& otherWork = ordinary.getPackage("p")->find<SubroutineSymbol>("work");
+    const SubroutineSymbol* untracked[] = {&otherWork};
+    CHECK_FALSE(ordinary.getReferenceUsageExcludingBodies(untracked));
+    CHECK_FALSE(compilation.getReferenceUsageExcludingBodies(untracked));
+}
