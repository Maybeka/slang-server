+TEST_CASE("Repeated immutable namespace views release intermediate wrappers and retain CST charges",
+          "[source-namespace]") {
+    SourceLibrary library("fixed", 1);
+    SourceManager sources;
+    auto buffer = sources.assignText("named.sv", "package stable; int value; endpackage\n", {},
+                                     &library);
+    auto owner = syntax::SyntaxTree::fromBuffer(buffer, sources);
+    owner->isLibraryUnit = true;
+    const auto charged = owner->getRetainedSyntaxBytes();
+    REQUIRE(charged > 0);
+    SourceManager retained;
+    retained.inheritImmutablePrefix(sources.captureImmutablePrefix({}));
+    auto view = syntax::SyntaxTree::sharedPrefixView(owner, retained);
+    const auto viewCharge = view->getRetainedSyntaxBytes();
+    CHECK(viewCharge >= charged);
+    for (size_t iteration = 0; iteration < 128; ++iteration) {
+        CHECK(&view->root() == &owner->root());
+        CHECK(&view->sourceManager() == &retained);
+        CHECK(view->getSourceLibrary() == &library);
+        CHECK(view->isLibraryUnit);
+        CHECK(view->getRetainedSyntaxBytes() == viewCharge);
+        CHECK_FALSE(view->isPrefixResumeSafe().has_value());
+        std::weak_ptr<syntax::SyntaxTree> previous = view;
+        auto next = syntax::SyntaxTree::sharedPrefixView(view, retained);
+        view.reset();
+        CHECK(previous.expired());
+        view = std::move(next);
+    }
+    std::weak_ptr<syntax::SyntaxTree> root = owner;
+    owner.reset();
+    CHECK_FALSE(root.expired());
+    CHECK(view->root().toString().find("stable") != std::string::npos);
+    view.reset();
+    CHECK(root.expired());
+}
