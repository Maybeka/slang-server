+TEST_CASE("Imported package flow diagnostics follow current consumer references",
+          "[trusted-package]") {
+    const std::string libraryText = R"(
+package uvm_pkg;
+    class Object;
+        function int used(); return 1; endfunction
+        function int other(); return 2; endfunction
+    endclass
+    class Box #(type T = int);
+        function int used(); return 1; endfunction
+        function int other(); return 2; endfunction
+    endclass
+    function automatic int library_call();
+        Box#(int) box = new;
+        return box.used();
+    endfunction
+endpackage
+)";
+    SourceManager librarySources;
+    auto libraryTree = SyntaxTree::fromText(libraryText, librarySources, "uvm_pkg.sv");
+    auto library = std::make_shared<Compilation>();
+    library->addSyntaxTree(libraryTree);
+    REQUIRE(library->getAllDiagnostics().empty());
+    auto prefix = librarySources.captureImmutablePrefix(libraryTree->getSourceBufferIds());
+    const auto fixedBytes = library->getTotalBytesAllocated();
+    auto report = [](Compilation& compilation) {
+        auto diagnostics = compilation.getSemanticDiagnostics();
+        analysis::AnalysisOptions options;
+        options.flags = analysis::AnalysisFlags::CheckUnused;
+        analysis::AnalysisManager manager(options);
+        compilation.freeze();
+        manager.analyze(compilation);
+        compilation.unfreeze();
+        diagnostics.append_range(manager.getDiagnostics());
+        diagnostics.sort(*compilation.getSourceManager());
+        return DiagnosticEngine::reportAll(*compilation.getSourceManager(), diagnostics);
+    };
+    for (auto method : {"used", "other", "used"}) {
+        std::string text = "package user_pkg; class Test extends uvm_pkg::Object; "
+                           "function int check(); return " +
+                           std::string(method) + "(); endfunction endclass endpackage";
+        SourceManager nativeSources;
+        Compilation native;
+        native.addSyntaxTree(SyntaxTree::fromText(libraryText, nativeSources, "uvm_pkg.sv"));
+        native.addSyntaxTree(SyntaxTree::fromText(text, nativeSources, "user.sv"));
+        SourceManager consumerSources;
+        consumerSources.inheritImmutablePrefix(prefix);
+        Compilation consumer;
+        consumer.importPackage(library, "uvm_pkg", consumerSources);
+        consumer.addSyntaxTree(SyntaxTree::fromText(text, consumerSources, "user.sv"));
+        CHECK(report(consumer) == report(native));
+        CHECK(library->getTotalBytesAllocated() == fixedBytes);
+    }
+}
