+        CHECK(sources.getMacroName(before) == first);
+        temporary = second;
+        after = sources.createExpansionLoc(location, {location, location + 5}, temporary);
+        temporary.assign(190, 'y');
+        CHECK(sources.getMacroName(after) == second);
+        prefix = sources.captureImmutablePrefix(std::vector{buffer.id});
+    }
+    SourceManager replacement;
+    replacement.inheritImmutablePrefix(prefix);
+    CHECK(replacement.getMacroName(before) == first);
+    CHECK(replacement.getMacroName(after) == second);
+    CHECK(replacement.getMemoryUsage() >= first.size() + second.size());
+}
