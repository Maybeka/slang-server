+SourceManager::FastCwdPhase::FastCwdPhase(SourceManager& sm) {
+    if (!sm.fastCwdSnapshotChecks || !sm.snapshotRecording || sm.snapshotReplay)
+        return;
+    lease.emplace(); // Coordinator first, then SourceManager locks.
+    outer = sm.fastCwdPhaseDepth.load() == 0;
