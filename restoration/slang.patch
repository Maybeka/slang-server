+TEST_CASE("Subroutine entry journal matches the live macro environment", "[preprocessor]") {
+    auto check = [&](bool enabled) {
+        PreprocessorOptions options;
+        options.trackMacroHistory = enabled;
+        options.predefines = {"COMMAND=42", "REMOVED=2"};
+        options.undefines = {"REMOVED"};
+        Preprocessor pp(getSourceManager(), alloc, diagnostics, Bag{options});
+        pp.pushSource(R"(
+`define BEFORE 1
+function int first(); return `BEFORE; endfunction
+`undef BEFORE
+`define BEFORE 2
+`ifdef COMMAND
+  `define SELECTED 3
+`else
+  `define SELECTED 4
+`endif
+`begin_keywords "1800-2012"
+task second(); endtask
+`end_keywords
+`undefineall
+function int third(); return `COMMAND; endfunction
+`define BEFORE 99
+)");
+        std::vector<std::vector<const DefineDirectiveSyntax*>> expected;
+        std::vector<SourceLocation> locations;
+        std::vector<int> versions;
+        for (;;) {
+            auto token = pp.next();
+            if (token.kind == TokenKind::EndOfFile)
+                break;
+            if (token.kind == TokenKind::FunctionKeyword || token.kind == TokenKind::TaskKeyword) {
+                expected.push_back(pp.getDefinedMacros());
+                locations.push_back(token.location());
+                versions.push_back(int(pp.getCurrentKeywordVersion()));
+            }
+        }
+        auto metadata = pp.getMetadata();
+        if (!enabled) {
+            CHECK(metadata.macroChanges.empty());
+            CHECK(metadata.subroutineEntries.empty());
+            return;
+        }
+        REQUIRE(expected.size() == 3);
+        REQUIRE(metadata.subroutineEntries.size() == expected.size());
+        for (size_t i = 0; i < expected.size(); ++i) {
+            const auto& entry = metadata.subroutineEntries[i];
+            CHECK(entry.location == locations[i]);
+            CHECK(entry.keywordVersion == versions[i]);
+            std::map<std::string_view, const DefineDirectiveSyntax*> macros;
+            for (size_t j = 0; j < entry.changes; ++j) {
+                const auto& change = metadata.macroChanges[j];
+                if (change.name.empty())
+                    macros.clear();
+                else if (change.definition)
+                    macros[change.name] = change.definition;
+                else
+                    macros.erase(change.name);
+            }
+            std::vector<const DefineDirectiveSyntax*> actual;
+            for (const auto& [_, definition] : macros)
+                actual.push_back(definition);
+            CHECK(actual == expected[i]);
+        }
+    };
+    check(false);
+    check(true);
+}
