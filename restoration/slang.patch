+    const std::string prefix = "package p;\n" + (imported ? "" : definition) +
+                               (completed ? qualified + " external_box;\n" : "");
+    const std::string initial = "function automatic void work(); endfunction\n";
+    const std::string current = "function automatic void work(); " + qualified +
+                                " local_box; endfunction\n";
+    const std::string libraryText = imported ? "package lib;\n" + definition +
+                                                   (providerReady ? name + " fixed_box;\n" : "") +
+                                                   "endpackage\n"
+                                             : "";
