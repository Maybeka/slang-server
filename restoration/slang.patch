+TEST_CASE("Class semantic reference views match an unfrozen independent compilation",
+          "[body-class-reference-view]") {
+    const auto beforeShape = GENERATE("none", "int", "byte", "both");
+    const auto afterShape = GENERATE("none", "int", "byte");
+    const bool imported = GENERATE(false, true);
+    const bool independent = GENERATE(false, true);
+    CAPTURE(beforeShape, afterShape, imported, independent);
+    CompilationOptions options;
+    options.flags |= CompilationFlags::TrackSubroutineBodyDependencies;
+    const std::string members =
+        "int int_ref, byte_ref;\n"
+        "class Box #(type T=int); function void read(); "
+        "if($bits(T)==8) byte_ref++; else int_ref++; endfunction endclass\n" +
+        std::string(independent ? "function automatic void hold(); byte_ref++; endfunction\n" : "");
+    const std::string libraryText = "package lib;\n" + members + "endpackage\n";
+    auto library = std::make_shared<Compilation>(options);
+    auto libraryTree = SyntaxTree::fromText(libraryText);
+    if (imported) {
+        library->addSyntaxTree(libraryTree);
+        (void)library->getSemanticDiagnostics();
+    }
+    const std::string prefix = "package p;\n" + (imported ? "" : members);
+    const std::string box = imported ? "lib::Box" : "Box";
+    auto body = [&](std::string_view shape) {
+        std::string text = "function automatic void work();\n";
+        if (shape == "int" || shape == "both")
+            text += box + "#(int) first;\n";
+        if (shape == "byte" || shape == "both")
+            text += box + "#(byte) second;\n";
+        return text + "endfunction\n";
+    };
+    auto owner = std::make_shared<Compilation>(options);
+    if (imported)
+        owner->importPackage(library, "lib", libraryTree->sourceManager());
+    owner->addSyntaxTree(SyntaxTree::fromText(prefix + body(beforeShape) + "endpackage\n"));
+    (void)owner->getSemanticDiagnostics();
+    const auto& original = owner->getPackage("p")->find<SubroutineSymbol>("work");
+    auto padding = prefix;
+    for (auto& c : padding)
+        if (c != '\n')
+            c = ' ';
+    auto tree = SyntaxTree::fromText(padding + body(afterShape));
+    const FunctionDeclarationSyntax* syntax = nullptr;
+    auto find = [&](auto&& self, const SyntaxNode& node) -> void {
+        if (auto fn = node.as_if<FunctionDeclarationSyntax>()) {
+            syntax = fn;
+            return;
+        }
+        for (uint32_t i = 0; i < node.getChildCount(); ++i)
+            if (auto child = node.childNode(i))
+                self(self, *child);
+    };
+    find(find, tree->root());
+    REQUIRE(syntax);
+    Compilation edited(options);
+    edited.setBodyQueryContext(owner, tree);
+    const SubroutineSymbol* replacement;
+    {
+        BodyQueryReferenceGuard guard(edited);
+        replacement = &SubroutineSymbol::createBodyQuery(edited, *syntax, original);
+        edited.forceElaborate(*replacement);
+        (void)edited.getBodyQueryDiagnostics();
+    }
+    const SubroutineSymbol* replaced[] = {&original};
+    auto roots = edited.getClassSpecializationUses();
+    REQUIRE(roots);
+    auto unused = owner->getUnusedClassSpecializationsExcludingBodies(replaced, {}, *roots);
+    REQUIRE(unused);
+    const auto view = edited.getBodyQuerySemanticView(*replacement, replaced, *unused);
+    REQUIRE(view.references);
+    Compilation fresh(options);
+    fresh.addSyntaxTree(SyntaxTree::fromText((imported ? libraryText : "") + prefix +
+                                             body(afterShape) + "endpackage\n"));
+    (void)fresh.getSemanticDiagnostics();
+    for (const auto* name : {"int_ref", "byte_ref"}) {
+        CAPTURE(name);
+        const auto* syntax1 = owner->getPackage(imported ? "lib" : "p")->find(name)->getSyntax();
+        const auto* syntax2 = fresh.getPackage(imported ? "lib" : "p")->find(name)->getSyntax();
+        const auto found = view.references->find(syntax1);
+        const auto actual = found == view.references->end() ? std::pair<bool, bool>{}
+                                                            : found->second;
+        CHECK(actual == fresh.isReferenced(*syntax2));
+    }
+}
