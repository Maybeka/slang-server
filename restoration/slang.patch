+TEST_CASE("Diagnostic settings snapshots reject unsupported policies") {
+    Compilation initializeBuiltins;
+    SourceManager sourceManager;
+    DiagnosticEngine engine(sourceManager);
+
+    SECTION("waiver manager") {
+        engine.setWaiverManager(std::make_shared<WaiverManager>());
+        CHECK_THROWS_WITH(engine.captureSettings(),
+                          "Diagnostic settings snapshot does not support waiver managers");
+    }
+    SECTION("per-buffer warnings") {
+        auto buffer = sourceManager.assignText("snapshot.sv", "");
+        flat_hash_map<BufferID, std::vector<std::string>> options;
+        options[buffer.id] = {"none"s};
+        REQUIRE(engine.setBufferWarningOptions(options).empty());
+        CHECK_THROWS_WITH(
+            engine.captureSettings(),
+            "Diagnostic settings snapshot does not support per-buffer warning options");
+    }
+    SECTION("custom symbol callback") {
+        engine.setSymbolPathCB([](const Symbol&) { return "custom"s; });
+        CHECK_THROWS_WITH(
+            engine.captureSettings(),
+            "Diagnostic settings snapshot does not support custom symbol path callbacks");
+    }
+    SECTION("custom formatter") {
+        engine.setFormatter<const Type*>(std::make_shared<TypeArgFormatter>());
+        CHECK_THROWS_WITH(
+            engine.captureSettings(),
+            "Diagnostic settings snapshot does not support custom argument formatters");
+    }
+    SECTION("modified builtin formatter") {
+        // First detach from the process-wide default formatter.
+        engine.applySettings(engine.captureSettings());
+        auto formatter = std::static_pointer_cast<TypeArgFormatter>(
+            engine.getFormatters().at(SLANG_TYPEOF(const Type*)));
+        formatter->setOptions(TypePrintingOptions{});
+        CHECK_THROWS_WITH(
+            engine.captureSettings(),
+            "Diagnostic settings snapshot does not support custom type formatter options");
+    }
+}
