+std::optional<std::vector<const ClassType*>> Compilation::getClassSpecializationUses(
+    const std::function<void()>& checkpoint) const {
+    if (!hasFlag(CompilationFlags::TrackSubroutineBodyDependencies))
+        return std::nullopt;
