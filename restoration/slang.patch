+SourceBuffer SourceManager::createRootBuffer(uint32_t fileId, uint64_t sortKey) {
+    std::unique_lock<std::shared_mutex> lock(mutex);
+    if (!snapshotReplay || !fileId || fileId >= snapshotFiles.size())
+        failSnapshot("invalid root file ID");
