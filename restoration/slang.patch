+TEST_CASE("Package analysis does not create design instances") {
+    auto tree = SyntaxTree::fromText(R"(
+package p;
+    typedef logic [12:0] word_t;
+    class Packet;
+        word_t data;
+    endclass
+endpackage
+
+module broken;
+    missing_module child();
+    initial missing_variable = 1;
+endmodule
+
+module recursive;
+    recursive child();
+endmodule
+
+module top;
+    recursive child();
+endmodule
+
+program invalid_program;
+    initial missing_program_variable = 1;
+endprogram
+
+interface unused_interface;
+    initial missing_interface_variable = 1;
+endinterface
+)");
+
+    CompilationOptions options;
+    // Also cover strict no-top checks and the opt-in check-uninstantiated mode.
+    options.flags = CompilationFlags::PackageAnalysis | CompilationFlags::CheckUninstantiated;
+    options.paramOverrides = {"malformed", "top.parameter=missing_value"};
+
+    SECTION("Automatic tops") {
+    }
+    SECTION("Explicit top") {
+        options.topModules.insert("top");
+    }
+    SECTION("Invalid explicit top") {
+        options.topModules.insert("missing_top");
+    }
+
+    Compilation compilation(options);
+    compilation.addSyntaxTree(tree);
+    auto& root = compilation.getRoot();
+    CHECK(root.topInstances.empty());
+    REQUIRE(root.compilationUnits.size() == 1);
+    for (auto& member : root.members())
+        CHECK(member.kind != SymbolKind::Instance);
+
+    // Wildcard import resolution can force elaboration before full diagnostics.
+    compilation.forceElaborate(root);
+    NO_COMPILATION_ERRORS;
+    CHECK(root.topInstances.empty());
+    CHECK_FALSE(tree->isLibraryUnit);
+
+    auto package = compilation.getPackage("p");
+    REQUIRE(package);
+    auto packet = package->find("Packet");
+    REQUIRE(packet);
+    REQUIRE(packet->kind == SymbolKind::ClassType);
+    auto data = packet->as<ClassType>().find("data");
+    REQUIRE(data);
+    REQUIRE(data->kind == SymbolKind::ClassProperty);
+    CHECK(data->as<ClassPropertySymbol>().getType().getBitWidth() == 13);
+
+    // Reusing the same tree in an ordinary compilation must still elaborate RTL.
+    CompilationOptions ordinaryOptions;
+    ordinaryOptions.maxInstanceDepth = 8;
+    Compilation ordinary(ordinaryOptions);
+    ordinary.addSyntaxTree(tree);
+    CHECK_FALSE(ordinary.getRoot().topInstances.empty());
+    auto& diagnostics = ordinary.getSemanticDiagnostics();
+    CHECK(std::ranges::any_of(diagnostics, [](auto& d) { return d.code == diag::UnknownModule; }));
+    CHECK(std::ranges::any_of(diagnostics, [](auto& d) {
+        return d.code == diag::InfinitelyRecursiveHierarchy ||
+               d.code == diag::MaxInstanceDepthExceeded;
+    }));
+}
+
+TEST_CASE("Package analysis retains package and class errors") {
+    auto tree = SyntaxTree::fromText(R"(
+package p;
+    localparam int bad = missing_package_name;
+    class C;
+        function int f();
+            return missing_class_name;
+        endfunction
+    endclass
+    class Generic #(int N = 1);
+        localparam int bad = missing_generic_name;
+    endclass
+endpackage
+
+class UnitClass;
+    int bad = missing_unit_class_name;
+endclass
+
+module ignored;
+    initial missing_rtl_name = 1;
+endmodule
+)");
+
+    CompilationOptions options;
+    options.flags |= CompilationFlags::PackageAnalysis;
+    Compilation compilation(options);
+    compilation.addSyntaxTree(tree);
+
+    auto& diagnostics = compilation.getSemanticDiagnostics();
+    REQUIRE(diagnostics.size() == 4);
+    for (auto& diagnostic : diagnostics)
+        CHECK(diagnostic.code == diag::UndeclaredIdentifier);
+    CHECK(compilation.getRoot().topInstances.empty());
+}
+
+TEST_CASE("Package analysis preserves imports and virtual interface member types") {
+    auto tree = SyntaxTree::fromText(R"(
+package source_pkg;
+    parameter int WIDTH = 17;
+    typedef logic [WIDTH-1:0] word_t;
+endpackage
+
+interface bus #(parameter int WIDTH = 1);
+    logic [WIDTH-1:0] data;
+    initial missing_interface_body_name = 1;
+    recursive child();
+endinterface
+
+package facade;
+    import source_pkg::*;
+    export *::*;
+    word_t reference_value;
+endpackage
+
+package consumer;
+    import facade::*;
+    class Packet;
+        word_t data;
+        virtual bus #($bits(word_t)) vif;
+        function word_t read();
+            return vif.data;
+        endfunction
+    endclass
+endpackage
+
+interface recursive;
+    recursive child();
+endinterface
+)");
+
+    CompilationOptions options;
+    options.flags |= CompilationFlags::PackageAnalysis;
+    Compilation compilation(options);
+    compilation.addSyntaxTree(tree);
+    auto package = compilation.getPackage("consumer");
+    REQUIRE(package);
+    compilation.forceElaborate(*package);
+
+    auto packet = package->find("Packet");
+    REQUIRE(packet);
+    REQUIRE(packet->kind == SymbolKind::ClassType);
+    auto data = packet->as<ClassType>().find("data");
+    REQUIRE(data);
+    REQUIRE(data->kind == SymbolKind::ClassProperty);
+    CHECK(data->as<ClassPropertySymbol>().getType().getBitWidth() == 17);
+    auto vif = packet->as<ClassType>().find("vif");
+    REQUIRE(vif);
+    REQUIRE(vif->kind == SymbolKind::ClassProperty);
+    auto& type = vif->as<ClassPropertySymbol>().getType().getCanonicalType();
+    REQUIRE(type.isVirtualInterface());
+    auto& vifType = type.as<VirtualInterfaceType>();
+    auto member = vifType.iface.body.find("data");
+    REQUIRE(member);
+    REQUIRE(member->kind == SymbolKind::Variable);
+    CHECK(member->as<VariableSymbol>().getType().getBitWidth() == 17);
+    compilation.forceElaborate(vifType.iface.body);
+    NO_COMPILATION_ERRORS;
+
+    size_t memberAccesses = 0;
+    package->visit(makeVisitor([&](auto&, const MemberAccessExpression& expr) {
+        if (expr.value().type->isVirtualInterface()) {
+            memberAccesses++;
+            CHECK(expr.member.name == "data");
+            CHECK(expr.type->getBitWidth() == 17);
+        }
+    }));
+    CHECK(memberAccesses == 1);
+    CHECK(compilation.getRoot().topInstances.empty());
+}
