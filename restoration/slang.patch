+std::error_code SourceManager::addUserDirectory(fs::path path) {
+    if (snapshotReplay)
+        failSnapshot("include directories cannot change during replay");
+    std::error_code ec;
+    auto requested = fs::absolute(path, ec);
+    if (ec)
+        return ec;
+    if (!fs::is_directory(path, ec))
+        return ec ? ec : std::make_error_code(std::errc::not_a_directory);
+    path = fs::canonical(path, ec);
+    if (ec)
+        return ec;
+    std::unique_lock<std::shared_mutex> lock(includeDirMutex);
+    std::unique_lock<std::shared_mutex> sourceLock(mutex);
+    if (snapshotRecording && bufferEntries.size() != 1)
+        snapshotConflict = true;
+    includeDirectoryWitnesses.push_back({{}, requested.string(), {path}, {}, true});
+    userDirectories.push_back(std::move(path));
+    return {};
+}
