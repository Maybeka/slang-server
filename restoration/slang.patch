+TEST_CASE("Strict source snapshot bounds captured file bytes before copying") {
+    constexpr size_t limit = 64 * 1024 * 1024;
+    SourceManager original;
+    original.setDisableProximatePaths(true);
+    original.enableSnapshotRecording();
+    auto addBuffer = [&](std::string_view name, size_t size) {
+        SmallVector<char> bytes;
+        bytes.resize(size, 'x');
+        bytes.back() = '\0';
+        return original.assignBuffer(name, std::move(bytes));
+    };
+
+    SECTION("exact limit counts shared file data once") {
+        auto root = addBuffer("large.sv", limit);
+        auto alias = original.readSource("large.sv");
+        REQUIRE(alias);
+        std::vector graph{root.id, alias->id};
+        auto snapshot = original.captureSnapshot(graph);
+        REQUIRE(snapshot.files.size() == 1);
+        CHECK(snapshot.files.front().bytes.size() == limit);
+        CHECK(snapshot.graphFileIds[0] == snapshot.graphFileIds[1]);
+    }
+    SECTION("single oversized file") {
+        auto root = addBuffer("large.sv", limit + 1);
+        std::vector graph{root.id};
+        CHECK_THROWS_WITH(original.captureSnapshot(graph),
+                          "source snapshot exceeds 64 MiB file-byte limit");
+    }
+    SECTION("aggregate limit includes terminating sentinels") {
+        auto first = addBuffer("first.sv", limit / 2);
+        auto second = addBuffer("second.sv", limit / 2 + 1);
+        std::vector graph{first.id, second.id};
+        CHECK_THROWS_WITH(original.captureSnapshot(graph),
+                          "source snapshot exceeds 64 MiB file-byte limit");
+    }
+}
