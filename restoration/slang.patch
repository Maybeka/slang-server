+    Compilation compilation(options);
+    compilation.addSyntaxTree(tree);
+    auto package = compilation.getPackage("p");
+    REQUIRE(package);
+    auto method = [&](std::string_view name, std::string_view member) -> const SubroutineSymbol& {
+        auto alias = package->find(name);
+        REQUIRE(alias);
+        const auto& cls = alias->as<TypeAliasType>().getCanonicalType().as<ClassType>();
+        auto symbol = cls.find(member);
+        REQUIRE(symbol);
+        return symbol->as<SubroutineSymbol>();
+    };
+    const auto& first = method("first_t", "f");
+    const auto& second = method("second_t", "f");
+    REQUIRE(&first != &second);
+    REQUIRE(first.getSyntax() == second.getSyntax());
+    const SyntaxNode* blocked[] = {first.getSyntax()};
+    {
+        BodyQueryEvaluationGuard outer({}, blocked);
+        CHECK_THROWS_AS(BodyQueryEvaluationGuard::check(first), std::runtime_error);
+        CHECK_THROWS_AS(BodyQueryEvaluationGuard::check(second), std::runtime_error);
+        {
+            const auto& other = method("first_t", "other");
+            const SubroutineSymbol* innerBodies[] = {&other};
+            BodyQueryEvaluationGuard inner(innerBodies);
+            CHECK_THROWS_AS(BodyQueryEvaluationGuard::check(first), std::runtime_error);
+            CHECK_THROWS_AS(BodyQueryEvaluationGuard::check(other), std::runtime_error);
+        }
+        CHECK_THROWS_AS(BodyQueryEvaluationGuard::check(first), std::runtime_error);
+        // This specialization is instantiated after guard construction.
+        const auto& late = method("late_t", "f");
