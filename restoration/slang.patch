+TEST_CASE("Package analysis does not create design instances") {
+    auto tree = SyntaxTree::fromText(R"(
+package p;
+    typedef logic [12:0] word_t;
+    class Packet;
+        word_t data;
+    endclass
+endpackage
+
+module broken;
+    missing_module child();
+    initial missing_variable = 1;
+endmodule
+
+module recursive;
+    recursive child();
+endmodule
+
+module top;
+    recursive child();
+endmodule
+
+program invalid_program;
+    initial missing_program_variable = 1;
+endprogram
+
+interface unused_interface;
+    initial missing_interface_variable = 1;
+endinterface
+)");
+
+    CompilationOptions options;
+    // Also cover strict no-top checks and the opt-in check-uninstantiated mode.
+    options.flags = CompilationFlags::PackageAnalysis | CompilationFlags::CheckUninstantiated;
+    options.paramOverrides = {"malformed", "top.parameter=missing_value"};
+
+    SECTION("Automatic tops") {
+    }
+    SECTION("Explicit top") {
+        options.topModules.insert("top");
+    }
+    SECTION("Invalid explicit top") {
+        options.topModules.insert("missing_top");
+    }
+
+    Compilation compilation(options);
+    compilation.addSyntaxTree(tree);
+    auto& root = compilation.getRoot();
+    CHECK(root.topInstances.empty());
+    REQUIRE(root.compilationUnits.size() == 1);
+    for (auto& member : root.members())
+        CHECK(member.kind != SymbolKind::Instance);
+
+    // Wildcard import resolution can force elaboration before full diagnostics.
+    compilation.forceElaborate(root);
+    NO_COMPILATION_ERRORS;
+    CHECK(root.topInstances.empty());
+    CHECK_FALSE(tree->isLibraryUnit);
+
+    auto package = compilation.getPackage("p");
+    REQUIRE(package);
+    auto packet = package->find("Packet");
+    REQUIRE(packet);
+    REQUIRE(packet->kind == SymbolKind::ClassType);
+    auto data = packet->as<ClassType>().find("data");
+    REQUIRE(data);
+    REQUIRE(data->kind == SymbolKind::ClassProperty);
+    CHECK(data->as<ClassPropertySymbol>().getType().getBitWidth() == 13);
+
+    // Reusing the same tree in an ordinary compilation must still elaborate RTL.
+    CompilationOptions ordinaryOptions;
+    ordinaryOptions.maxInstanceDepth = 8;
+    Compilation ordinary(ordinaryOptions);
+    ordinary.addSyntaxTree(tree);
+    CHECK_FALSE(ordinary.getRoot().topInstances.empty());
+    auto& diagnostics = ordinary.getSemanticDiagnostics();
+    CHECK(std::ranges::any_of(diagnostics, [](auto& d) { return d.code == diag::UnknownModule; }));
+    CHECK(std::ranges::any_of(diagnostics, [](auto& d) {
+        return d.code == diag::InfinitelyRecursiveHierarchy ||
+               d.code == diag::MaxInstanceDepthExceeded;
+    }));
+}
