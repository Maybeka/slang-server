+TEST_CASE("Diagnostic settings snapshots rebuild pragma mappings") {
+    constexpr auto text = R"(
+`pragma diagnostic ignore="empty-member"
+module m;
+    ;
+endmodule
+)";
+    DiagnosticEngine::SettingsSnapshot snapshot;
+    {
+        SourceManager sourceManager;
+        auto buffer = sourceManager.assignText("source", text);
+        auto tree = SyntaxTree::fromBuffer(buffer, sourceManager);
+        DiagnosticEngine engine(sourceManager);
+        REQUIRE(engine.setMappingsFromPragmas().empty());
+        REQUIRE(tree->diagnostics().empty());
+        SourceLocation location(buffer.id, std::string_view(text).find("    ;") + 4);
+        CHECK(engine.getSeverity(diag::EmptyMember, location) == DiagnosticSeverity::Ignored);
+        snapshot = engine.captureSettings();
+    }
+
+    SourceManager freshSourceManager;
+    freshSourceManager.assignText("shift-buffer-id.sv", "");
+    auto buffer = freshSourceManager.assignText("source", text);
+    auto tree = SyntaxTree::fromBuffer(buffer, freshSourceManager);
+    DiagnosticEngine replay(freshSourceManager);
+    replay.applySettings(snapshot);
+    REQUIRE(tree->diagnostics().empty());
+    SourceLocation location(buffer.id, std::string_view(text).find("    ;") + 4);
+    CHECK(replay.getSeverity(diag::EmptyMember, location) == DiagnosticSeverity::Warning);
+    REQUIRE(replay.setMappingsFromPragmas().empty());
+    CHECK(replay.getSeverity(diag::EmptyMember, location) == DiagnosticSeverity::Ignored);
+
+    // Applying again clears previous mappings even when reusing an engine.
+    replay.applySettings(snapshot);
+    CHECK(replay.getSeverity(diag::EmptyMember, location) == DiagnosticSeverity::Warning);
+}
