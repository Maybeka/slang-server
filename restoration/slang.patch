+struct SourceManager::ImmutablePrefix {
+    std::vector<std::variant<FileInfo, ExpansionInfo>> entries;
+    decltype(lookupCache) files;
+    uint32_t unnamedCount = 0;
+    std::set<std::string> names;
+};
+
+std::shared_ptr<const SourceManager::ImmutablePrefix> SourceManager::captureImmutablePrefix(
+    std::span<const BufferID> graph) {
+    std::unique_lock lock(mutex);
+    if (immutablePrefix)
+        SLANG_THROW(std::logic_error("immutable source prefix already captured"));
+    auto prefix = std::make_shared<ImmutablePrefix>();
+    prefix->entries = bufferEntries;
+    for (size_t index = 0; index < prefix->entries.size(); ++index) {
+        if (auto expansion = std::get_if<ExpansionInfo>(&prefix->entries[index]);
+            expansion && !expansion->macroName.empty()) {
+            expansion->macroName = *prefix->names.emplace(expansion->macroName).first;
+            // This manager also owns the prefix. Redirect existing views so a
+            // later source-only lease need not copy the immutable names again.
+            std::get<ExpansionInfo>(bufferEntries[index]).macroName = expansion->macroName;
+        }
+    }
+    prefix->unnamedCount = unnamedBufferCount.load();
+    flat_hash_set<const FileData*> retained;
+    for (auto id : graph) {
+        if (id.getId() >= bufferEntries.size())
+            SLANG_THROW(std::invalid_argument("invalid immutable source graph"));
+        if (auto file = std::get_if<FileInfo>(&bufferEntries[id.getId()]); file && file->data)
+            retained.emplace(file->data.get());
+    }
+    for (const auto& [path, value] : lookupCache)
+        if (value.first && retained.contains(value.first.get()))
+            prefix->files.emplace(path, value);
+    immutablePrefix = prefix;
+    return prefix;
+}
+
+std::optional<SourceLocation> SourceManager::projectImmutableOriginalLocation(
+    SourceLocation location) const {
+    std::shared_lock lock(mutex);
+    if (!immutablePrefix || !location || location.buffer().getId() >= bufferEntries.size())
+        return std::nullopt;
+    // Existing prefix expansion entries retain the original macro ancestry.
+    // A recyclable tail expansion cannot be projected without its full graph.
+    if (location.buffer().getId() < immutablePrefix->entries.size())
+        return location;
+    auto file = std::get_if<FileInfo>(&bufferEntries[location.buffer().getId()]);
+    if (!file || !file->data)
+        return std::nullopt;
+    for (size_t i = 1; i < immutablePrefix->entries.size(); ++i) {
+        auto previous = std::get_if<FileInfo>(&immutablePrefix->entries[i]);
+        if (previous && previous->data && previous->data->fullPath == file->data->fullPath &&
+            previous->data->mem.size() == file->data->mem.size() &&
+            std::ranges::equal(previous->data->mem, file->data->mem))
+            return SourceLocation(BufferID(uint32_t(i), previous->data->name), location.offset());
+    }
+    return std::nullopt;
+}
+
+void SourceManager::inheritImmutablePrefix(std::shared_ptr<const ImmutablePrefix> prefix) {
+    std::unique_lock lock(mutex);
+    if (!prefix || bufferEntries.size() != 1 || !lookupCache.empty() || snapshotRecording ||
+        snapshotReplay || immutablePrefix)
+        SLANG_THROW(std::logic_error("immutable prefix requires a fresh source manager"));
+    bufferEntries = prefix->entries;
+    lookupCache = prefix->files;
+    unnamedBufferCount.store(prefix->unnamedCount);
+    immutablePrefix = std::move(prefix);
+}
+
+bool SourceManager::sharesImmutablePrefix(const SourceManager& other) const {
+    return this == &other || (immutablePrefix && immutablePrefix == other.immutablePrefix);
+}
+
+void SourceManager::retainSourceNames() {
+    std::unique_lock lock(mutex);
+    if (retainingSourceNames)
+        return;
+    const size_t start = immutablePrefix ? immutablePrefix->entries.size() : 0;
+    for (size_t index = start; index < bufferEntries.size(); ++index)
+        if (auto expansion = std::get_if<ExpansionInfo>(&bufferEntries[index]);
+            expansion && !expansion->macroName.empty())
+            expansion->macroName = *retainedSourceNames.emplace(expansion->macroName).first;
+    retainingSourceNames = true;
+}
