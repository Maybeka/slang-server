+TEST_CASE("Declaration member views isolate sibling semantics and preserve native parser context",
+          "[trusted-package][scope-member-view]") {
+    SourceManager sources;
+    auto owner = SyntaxTree::fromText(R"(
+`timescale 10ns/1ns
+`default_nettype tri
+`define STABLE_FIELD state_t state=Ready;
+module unrelated; missing_module invalid(); endmodule
+package dependency;
+  typedef enum logic [1:0] {Ready=1, Busy=2} state_t;
+endpackage
+package stable;
+  import dependency::*;
+  class Item;
+    `STABLE_FIELD
+    function state_t get(); return state; endfunction
+  endclass
+endpackage
+package mutable;
+  missing_type bad;
+endpackage
+)",
+                                      sources, "mixed.sv");
+    REQUIRE(owner->diagnostics().empty());
+    auto& unit = owner->root().as<CompilationUnitSyntax>();
+    REQUIRE(unit.members.size() == 4);
+    std::array<const MemberSyntax*, 2> selected{unit.members[2], unit.members[1]};
+    auto view = SyntaxTree::selectCompilationUnitMembers(owner, selected);
+    const auto& projected = view->root().as<CompilationUnitSyntax>();
+    REQUIRE(projected.members.size() == 2);
+    CHECK(projected.members[0] == unit.members[1]);
+    CHECK(projected.members[1] == unit.members[2]);
+    CHECK(projected.members[0]->parent == &owner->root());
+    CHECK(projected.members[1]->parent == &owner->root());
+    REQUIRE(view->getMetadata().nodeMeta.size() == 2);
+    for (const auto& [node, context] : view->getMetadata().nodeMeta) {
+        auto original = std::ranges::find_if(owner->getMetadata().nodeMeta, [&](const auto& entry) {
+            return entry.first == node;
+        });
+        REQUIRE(original != owner->getMetadata().nodeMeta.end());
+        CHECK(context.defaultNetType == TokenKind::TriKeyword);
+        CHECK(context.defaultNetType == original->second.defaultNetType);
+        CHECK(context.timeScale == original->second.timeScale);
+        CHECK(context.timeScale.has_value());
+    }
+    CHECK(view->getMetadata().globalInstances.empty());
+    REQUIRE(view->getMetadata().classDecls.size() == 1);
+    CHECK_FALSE(view->isPrefixResumeSafe().value_or(false));
+    CHECK(view->getRetainedSyntaxBytes() >= owner->getRetainedSyntaxBytes());
+    auto location = projected.members[1]->getFirstToken().location();
+    const auto line = sources.getLineNumber(location);
+    CompilationOptions options;
+    options.flags = CompilationFlags::PackageAnalysis;
+    {
+        Compilation full(options);
+        full.addSyntaxTree(owner);
+        CHECK(std::ranges::any_of(full.getAllDiagnostics(),
+                                  [](const auto& d) { return d.isError(); }));
+    }
+    auto library = std::make_shared<Compilation>(options);
+    library->addSyntaxTree(view);
+    REQUIRE(library->getAllDiagnostics().empty());
+    CHECK_FALSE(library->getPackage("mutable"));
+    REQUIRE(library->getPackage("stable"));
+    CHECK(library->getPackage("stable")->find("Item"));
+    auto prefix = sources.captureImmutablePrefix(owner->getSourceBufferIds());
+    SourceManager currentSources;
+    currentSources.inheritImmutablePrefix(prefix);
+    Compilation consumer;
+    consumer.importPackage(library, "dependency", currentSources);
+    consumer.importPackage(library, "stable", currentSources);
+    consumer.addSyntaxTree(SyntaxTree::fromText(R"(
+package mutable; typedef int missing_type; missing_type repaired; endpackage
+module top; stable::Item handle; dependency::state_t value=dependency::Ready; endmodule
+)",
+                                                currentSources, "current.sv"));
+    REQUIRE(consumer.getAllDiagnostics().empty());
+    CHECK(consumer.getPackage("stable") == library->getPackage("stable"));
+    CHECK(consumer.getPackage("mutable") != nullptr);
+    CHECK(sources.getLineNumber(location) == line);
+    std::weak_ptr<SyntaxTree> weak = owner;
+    owner.reset();
+    CHECK_FALSE(weak.expired());
+    CHECK(view->root().as<CompilationUnitSyntax>().members[1]->getFirstToken().location() ==
+          location);
+}
