+TEST_CASE("Isolated package dependency probes observe lookups even with suppressed diagnostics",
+          "[trusted-package][package-query-tracking]") {
+    const bool generic = GENERATE(false, true);
+    SourceManager sources;
+    CompilationOptions options;
+    options.flags = CompilationFlags::PackageAnalysis | CompilationFlags::LintMode;
+    Compilation compilation(options);
+    CHECK(compilation.getPackage("before_tracking") == nullptr);
+    CHECK_THROWS(compilation.endTrackingMissingPackageLookups());
+    compilation.beginTrackingMissingPackageLookups();
+    CHECK_THROWS(compilation.beginTrackingMissingPackageLookups());
+    const auto text =
+        generic
+            ? "package selected; class Deferred #(type T); missing::Type value; endclass endpackage"
+            : "package selected; import missing::*; import missing::Type; "
+              "class Local; localparam int VALUE=7; endclass localparam int V=Local::VALUE; "
+              "endpackage";
+    compilation.addSyntaxTree(SyntaxTree::fromText(text, sources));
+    const auto& diagnostics = compilation.getSemanticDiagnostics();
+    CHECK_FALSE(std::ranges::any_of(diagnostics, [](const auto& d) {
+        return d.code == diag::UnknownPackage || d.code == diag::UnknownClassOrPackage;
+    }));
+    auto names = compilation.endTrackingMissingPackageLookups();
+    CHECK(std::ranges::count(names, "missing") == 1);
+    CHECK(std::ranges::find(names, "before_tracking") == names.end());
+    CHECK(std::ranges::find(names, "Local") == names.end());
+    CHECK(std::ranges::find(names, "selected") == names.end());
+    CHECK(std::ranges::find(names, "std") == names.end());
+    CHECK(compilation.getPackage("after_tracking") == nullptr);
+    CHECK_THROWS(compilation.endTrackingMissingPackageLookups());
+    CHECK_THROWS(compilation.beginTrackingMissingPackageLookups());
+}
