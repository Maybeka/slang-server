+std::shared_ptr<SyntaxTree> SyntaxTree::selectCompilationUnitMembers(
+    const std::shared_ptr<SyntaxTree>& owner, std::span<const MemberSyntax* const> selection) {
+    if (!owner || owner->root().kind != SyntaxKind::CompilationUnit || selection.empty() ||
+        std::ranges::any_of(owner->diagnosticsBuffer, [](const auto& d) { return d.isError(); }))
+        SLANG_THROW(std::invalid_argument("member views require an error-free compilation unit"));
+    flat_hash_set<const MemberSyntax*> wanted;
+    for (auto member : selection)
+        if (!member || !wanted.emplace(member).second)
+            SLANG_THROW(std::invalid_argument("member view selection is null or duplicated"));
+    SmallVector<MemberSyntax*> members;
+    for (auto member : owner->root().as<CompilationUnitSyntax>().members)
+        if (wanted.contains(member))
+            members.push_back(member);
+    if (members.size() != wanted.size())
+        SLANG_THROW(std::invalid_argument("member view selection is not a direct unit member"));
+
+    BumpAllocator arena;
+    SyntaxFactory factory(arena);
+    auto& unit = factory.compilationUnit(
+        {}, owner->root().as<CompilationUnitSyntax>().endOfFile.deepClone(arena));
+    // Borrow immutable nodes without reparenting their original lexical ancestry.
+    unit.members = SyntaxList<MemberSyntax>(arena, members);
+    auto metadata = ParserMetadata::fromSyntax(unit);
+    // Re-walking a subset cannot reconstruct directives carried by preceding
+    // unselected siblings. Copy the exact original per-declaration context.
+    for (auto& [node, context] : metadata.nodeMeta) {
+        auto original = std::ranges::find_if(owner->metadata.nodeMeta, [&](const auto& entry) {
+            return entry.first == node;
+        });
+        if (original == owner->metadata.nodeMeta.end())
+            SLANG_THROW(std::invalid_argument("member view lacks native parser metadata"));
+        context = original->second;
+    }
+    auto& sources = owner->sourceMan;
+    // The preprocessor pushes root buffers in reverse input order. Includes and
+    // macro expansions are ordered by their native ancestry; unrelated roots in
+    // the same parsed unit need the explicit input order, not BufferID order.
+    flat_hash_map<BufferID, size_t> rootOrder;
+    for (auto it = owner->preprocessorMetadata.sourceBufferIds.rbegin();
+         it != owner->preprocessorMetadata.sourceBufferIds.rend(); ++it)
+        if (!sources.getIncludedFrom(*it))
+            rootOrder.emplace(*it, rootOrder.size());
+    auto rootPosition = [&](SourceLocation location) -> std::optional<std::pair<size_t, size_t>> {
+        location = sources.getFullyExpandedLoc(location);
+        while (auto parent = sources.getIncludedFrom(location.buffer()))
+            location = sources.getFullyExpandedLoc(parent);
+        if (auto found = rootOrder.find(location.buffer()); found != rootOrder.end())
+            return std::pair{found->second, location.offset()};
+        return std::nullopt;
+    };
+    auto beforeOrEqual = [&](SourceLocation left, SourceLocation right) {
+        if (left == right)
+            return true;
+        if (auto order = sources.isBeforeInCompilationUnit(left, right))
+            return *order;
+        auto a = rootPosition(left), b = rootPosition(right);
+        return a && b && *a <= *b;
+    };
+    auto selectedLocation = [&](SourceLocation location) {
+        if (!location)
+            return true; // Unit-wide command-line / preprocessing diagnostics.
+        for (auto member : members) {
+            const auto range = member->sourceRange();
+            if (range.start() && range.end() && beforeOrEqual(range.start(), location) &&
+                beforeOrEqual(location, range.end()))
+                return true;
+        }
+        return false;
+    };
+    Diagnostics diagnostics;
+    for (const auto& diagnostic : owner->diagnosticsBuffer)
+        if (selectedLocation(diagnostic.location))
+            diagnostics.push_back(diagnostic);
+    auto* result = new SyntaxTree(&unit, owner->library, owner->sourceMan, std::move(arena),
+                                  std::move(diagnostics), std::move(metadata),
+                                  PreprocessorMetadata(owner->preprocessorMetadata),
+                                  owner->options_);
+    result->isLibraryUnit = owner->isLibraryUnit;
+    result->prefixState = std::make_unique<PrefixState>();
+    result->prefixState->extraBytes = owner->getRetainedSyntaxBytes();
+    result->prefixState->extraSourceBytes = owner->getRetainedSourceBytes();
+    auto pins = owner->sourceMan.retainBuffers(result->getSourceBufferIds());
+    auto macroPins = owner->sourceMan.retainBuffers(result->getPredefineBufferIds());
+    return std::shared_ptr<SyntaxTree>(result, [owner, pins = std::move(pins),
+                                                macroPins = std::move(macroPins)](
+                                                   SyntaxTree* tree) { delete tree; });
+}
