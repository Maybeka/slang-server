+TEST_CASE("Package analysis ignores defparams and binds only when requested") {
+    auto tree = SyntaxTree::fromText(R"(
+package p;
+    typedef int value_t;
+endpackage
+
+module target;
+    parameter int P = 1;
+endmodule
+
+module bound;
+endmodule
+
+bind target bound attached();
+)");
+    auto defparam = SyntaxTree::fromText("defparam target.P = 3;");
+
+    SECTION("Declaration analysis") {
+        CompilationOptions options;
+        options.flags |= CompilationFlags::PackageAnalysis;
+        Compilation compilation(options);
+        compilation.addSyntaxTree(tree);
+        compilation.addSyntaxTree(defparam);
+        compilation.forceElaborate(compilation.getRoot());
+        NO_COMPILATION_ERRORS;
+        CHECK(compilation.getRoot().topInstances.empty());
+    }
+
+    SECTION("Ordinary compilation") {
+        Compilation compilation;
+        compilation.addSyntaxTree(tree);
+        compilation.addSyntaxTree(defparam);
+        NO_COMPILATION_ERRORS;
+        auto& root = compilation.getRoot();
+        CHECK(root.lookupName<ParameterSymbol>("target.P").getValue().integer().as<int>() == 3);
+        CHECK(root.lookupName<InstanceSymbol>("target.attached").getDefinition().name == "bound");
+    }
+}
