+void Compilation::noteDefinitionInstantiated(const DefinitionSymbol& definition,
+                                             const Scope* scope) {
+    if (trackBodyReferences && scope)
+        bodyDefinitionSites.emplace_back(scope, &definition);
+    if (importedDefinitions.contains(&definition))
+        ++importedDefinitionInstanceCounts[&definition];
+    else
+        definition.noteInstantiated();
+}
+
+size_t Compilation::getDefinitionInstanceCount(const DefinitionSymbol& definition) const {
+    if (importedDefinitions.contains(&definition)) {
+        auto it = importedDefinitionInstanceCounts.find(&definition);
+        return it == importedDefinitionInstanceCounts.end() ? 0 : it->second;
+    }
+    return definition.getInstanceCount();
+}
+
+void Compilation::noteDefinitionBind(const DefinitionSymbol& definition,
+                                     const BindDirectiveInfo& info) {
+    SLANG_ASSERT(!isFrozen());
+    if (!importedDefinitions.contains(&definition)) {
+        const_cast<DefinitionSymbol&>(definition).bindDirectives.push_back(info);
+        return;
+    }
+    auto [it, inserted] = importedDefinitionBinds.try_emplace(&definition);
+    if (inserted)
+        it->second = definition.bindDirectives;
+    it->second.push_back(info);
+}
+
+std::span<const BindDirectiveInfo> Compilation::getDefinitionBinds(
+    const DefinitionSymbol& definition) const {
+    if (auto it = importedDefinitionBinds.find(&definition); it != importedDefinitionBinds.end())
+        return it->second;
+    return definition.bindDirectives;
+}
