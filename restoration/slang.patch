+class SourceLoaderTestFiles {
+    TempFile marker;
+
+public:
+    SourceLoaderTestFiles() : marker(""), root(marker.path.string() + ".dir") {
+        fs::create_directory(root);
+    }
+
+    ~SourceLoaderTestFiles() {
+        std::error_code ec;
+        fs::remove_all(root, ec);
+    }
+
+    fs::path write(std::string_view name, std::string_view contents) const {
+        auto path = root / name;
+        fs::create_directories(path.parent_path());
+        std::ofstream out(path);
+        REQUIRE(out.good());
+        out << contents;
+        return path;
+    }
+
+    fs::path root;
+};
+
+void replaceSource(SourceManager& manager, BufferID id, std::string_view contents) {
+    SmallVector<char> bytes;
+    bytes.insert(bytes.end(), contents.begin(), contents.end());
+    bytes.push_back('\0');
+    manager.replaceBuffer(id, std::move(bytes));
+}
