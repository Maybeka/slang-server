+void SourceManager::writeParseArchive(syntax::ArchiveWriter& out, const fs::path& root) const {
+    std::shared_lock lock(mutex);
+    if (!diagDirectives.empty())
+        throw std::runtime_error("diagnostic pragmas are unsupported in parse archives");
