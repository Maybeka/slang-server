+    CompilationOptions options;
+    options.flags = CompilationFlags::PackageAnalysis;
+    auto library = std::make_shared<Compilation>(options);
+    library->addSyntaxTree(tree);
+    REQUIRE(library->getAllDiagnostics().empty());
+    SourceManager unrelated;
+    Compilation invalid(options);
+    CHECK_THROWS(invalid.importPackage(library, "uvm_pkg", unrelated));
+    sources.captureImmutablePrefix(tree->getSourceBufferIds());
+    Compilation consumer(options);
+    consumer.importPackage(library, "uvm_pkg", sources);
+    // An actual occurrence of the fixed package is omitted without creating
+    // duplicate symbols, but a user declaration in a different file is an error.
+    consumer.addSyntaxTree(tree, true);
+    consumer.addSyntaxTree(
+        SyntaxTree::fromText("package uvm_pkg; endpackage", sources, "duplicate.sv"), true);
+    CHECK_FALSE(consumer.getAllDiagnostics().empty());
+    CHECK_THROWS(consumer.importPackage(library, "uvm_pkg", sources));
+    CHECK_THROWS(unrelated.inheritImmutablePrefix({}));
+}
