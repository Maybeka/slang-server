+TEST_CASE("Shared package navigation does not become a later consumer semantic use",
+          "[trusted-package][scope-reference-snapshot]") {
+    SourceManager sources;
+    auto tree = SyntaxTree::fromText(
+        "package fixed; typedef logic used_t; typedef logic unused_t; used_t a; endpackage",
+        sources);
+    CompilationOptions options;
+    options.flags = CompilationFlags::PackageAnalysis;
+    auto owner = std::make_shared<Compilation>(options);
+    owner->addSyntaxTree(tree);
+    REQUIRE(owner->getSemanticDiagnostics().empty());
+    auto used = owner->getPackage("fixed")->find("used_t")->getSyntax();
+    auto unused = owner->getPackage("fixed")->find("unused_t")->getSyntax();
+    REQUIRE(used);
+    REQUIRE(unused);
+    REQUIRE(owner->isReferenced(*used).first);
+    REQUIRE_FALSE(owner->isReferenced(*unused).first);
+    auto prefix = sources.captureImmutablePrefix(tree->getSourceBufferIds());
+    SourceManager currentSources;
+    currentSources.inheritImmutablePrefix(prefix);
+    Compilation first(options);
+    first.importPackage(owner, "fixed", currentSources);
+    REQUIRE(first.isReferenced(*used).first);
+    REQUIRE_FALSE(first.isReferenced(*unused).first);
+    owner->noteReference(*unused); // e.g. completion / hover in the immutable library
+    REQUIRE(owner->isReferenced(*unused).first);
+    CHECK_FALSE(first.isReferenced(*unused).first);
+    Compilation next(options);
+    next.importPackage(owner, "fixed", currentSources);
+    CHECK_FALSE(next.isReferenced(*unused).first);
+    next.noteReference(*unused);
+    CHECK(next.isReferenced(*unused).first);
+    Compilation later(options);
+    later.importPackage(owner, "fixed", currentSources);
+    CHECK(later.isReferenced(*used).first);
+    CHECK_FALSE(later.isReferenced(*unused).first);
+    later.getSemanticDiagnostics();
+    analysis::AnalysisOptions analysisOptions{.flags = analysis::AnalysisFlags::CheckUnused};
+    analysis::AnalysisManager manager(analysisOptions);
+    later.freeze();
+    manager.analyze(later);
+    later.unfreeze();
+    const auto diagnostics = manager.getDiagnostics();
+    CHECK(std::ranges::any_of(diagnostics, [&](const auto& diagnostic) {
+        return diagnostic.code == diag::UnusedPackageTypedef && diagnostic.symbol &&
+               diagnostic.symbol->name == "unused_t";
+    }));
+}
