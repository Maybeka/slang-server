+void SourceManager::readParseArchive(syntax::ArchiveReader& in, const fs::path& root) {
+    std::unique_lock lock(mutex);
+    if (snapshotReplay || snapshotRecording)
+        throw std::runtime_error("load parse archive before source recording");
+    std::vector<std::shared_ptr<FileData>> files;
+    const auto n = in.count();
+    for (size_t i = 0; i < n; ++i) {
+        auto kind = in.number();
+        if (kind == 0) {
+            auto id = in.number();
+            auto fresh = in.number();
+            if (fresh) {
+                if (id != files.size() + 1)
+                    throw std::runtime_error("invalid archive file identity");
+                auto relative = fs::path(in.text());
+                auto name = in.text();
+                auto bytes = in.text();
+                if ((!in.allowExternalPaths && relative.is_absolute()) ||
+                    (!relative.empty() && *relative.begin() == ".."))
+                    throw std::runtime_error("invalid archive source path");
+                auto path = relative.empty() ? fs::path{} : (root / relative).lexically_normal();
+                if (!path.empty())
+                    name = getBufferName(path, disableProximatePaths);
+                auto directory = &*directories.insert(path.parent_path()).first;
+                SmallVector<char> mem;
+                mem.append(bytes.begin(), bytes.end());
+                auto data = std::make_shared<FileData>(directory, std::move(name), std::move(mem),
+                                                       path);
+                files.push_back(data);
+                if (!path.empty())
+                    lookupCache.insert_or_assign(getU8Str(path),
+                                                 std::pair{data, std::error_code{}});
+            }
+            if (!id || id > files.size())
+                throw std::runtime_error("invalid archive file reference");
+            auto included = in.location();
+            auto sort = in.number();
+            auto bufferKind = BufferKind(in.number());
+            FileInfo file(files[id - 1], nullptr, included, sort);
+            file.bufferKind = bufferKind;
+            auto lineCount = in.count();
+            for (size_t j = 0; j < lineCount; ++j) {
+                auto name = in.text();
+                auto actual = in.number();
+                auto directive = in.number();
+                auto level = in.number();
+                file.lineDirectives.emplace_back(std::move(name), actual, directive,
+                                                 uint8_t(level));
+            }
+            file.hasExternalDirectives = bool(in.number());
+            bufferEntries.emplace_back(std::move(file));
+        }
+        else if (kind == 1) {
+            auto original = in.location();
+            auto start = in.location();
+            auto end = in.location();
+            auto arg = in.number();
+            auto name = in.string();
