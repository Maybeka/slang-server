+    auto b = original.assignText("second.sv", "module b; localparam P = `CMD; endmodule\n");
+    PreprocessorOptions pp;
+    pp.predefines.emplace_back("CMD=7");
+    auto first = SyntaxTree::fromBuffer(a, original, Bag{pp});
+    auto second = SyntaxTree::fromBuffer(b, original, Bag{pp});
+    REQUIRE(first->getPredefineBufferIds().size() == 1);
+    REQUIRE(second->getPredefineBufferIds().size() == 1);
+    std::vector graph{a.id, b.id, first->getPredefineBufferIds()[0],
+                      second->getPredefineBufferIds()[0]};
+    auto snapshot = original.captureSnapshot(graph);
+    SourceManager replay;
+    replay.loadSnapshot(snapshot);
+    auto root = replay.createRootBuffer(snapshot.graphFileIds[1]);
+    replay.setSnapshotGeneratedSequence(std::span(snapshot.graphFileIds).subspan(3, 1));
+    auto restored = SyntaxTree::fromBuffer(root, replay, Bag{pp});
+    replay.finishSnapshotGeneratedSequence();
+    REQUIRE(restored->getPredefineBufferIds().size() == 1);
+    CHECK(replay.getFullPath(restored->getPredefineBufferIds()[0]) ==
+          original.getFullPath(second->getPredefineBufferIds()[0]));
+    CHECK(restored->root().toString() == second->root().toString());
+    // The same immutable tree can be replayed again without consuming global identities.
+    replay.setSnapshotGeneratedSequence(std::span(snapshot.graphFileIds).subspan(3, 1));
+    CHECK(SyntaxTree::fromBuffer(root, replay, Bag{pp}));
+    replay.finishSnapshotGeneratedSequence();
+    CHECK(!replay.snapshotIncomplete());
+
+    SourceManager incomplete;
+    incomplete.loadSnapshot(snapshot);
+    incomplete.setSnapshotGeneratedSequence(std::span(snapshot.graphFileIds).subspan(3, 1));
+    CHECK_THROWS_AS(incomplete.finishSnapshotGeneratedSequence(),
+                    SourceManager::SnapshotIncompleteError);
+}
