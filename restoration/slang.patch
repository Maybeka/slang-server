+TEST_CASE("Disposable source parsing propagates cancellation after joining parallel workers") {
+    struct Cancelled : std::runtime_error {
+        Cancelled() : std::runtime_error("cancel disposable parse") {}
+    };
+    for (bool singleUnit : {false, true}) {
+        Driver driver;
+        driver.addStandardArgs();
+#if defined(SLANG_USE_THREADS)
+        REQUIRE(driver.parseCommandLine("test --threads 2"));
+#else
+        REQUIRE(driver.parseCommandLine("test --threads 1"));
+#endif
+        REQUIRE(driver.processOptions(false));
+        driver.options.singleUnit = singleUnit;
+        for (unsigned i = 0; i < 12; ++i) {
+            std::string text = "module m" + std::to_string(i) + ";\n";
+            for (unsigned n = 0; n < 400; ++n)
+                text += "int v" + std::to_string(n) + ";\n";
+            text += "endmodule\n";
+            driver.sourceLoader.addBuffer(driver.sourceManager.assignText(text));
+        }
+        std::atomic<unsigned> checks{0};
+        driver.options.parseCheckpoint = [&] {
+            if (++checks >= 2)
+                throw Cancelled();
+        };
+        CHECK_THROWS_AS(driver.parseAllSources(), Cancelled);
+        CHECK(checks >= 2);
+        CHECK(driver.syntaxTrees.empty());
+        // No worker can still hold stack captures after the throwing call returns.
+        const auto joinedChecks = checks.load();
+        driver.options.parseCheckpoint = {};
+        REQUIRE(driver.parseAllSources());
+        CHECK(checks == joinedChecks);
+        CHECK(driver.syntaxTrees.size() == (singleUnit ? 1 : 12));
+        CHECK(driver.createCompilation()->getAllDiagnostics().empty());
+    }
+}
