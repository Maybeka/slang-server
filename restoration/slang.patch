+std::shared_ptr<SyntaxTree> SyntaxTree::preparedUvmPrefix(
+    const std::shared_ptr<SyntaxTree>& native) {
+    if (!native->prefixState || !native->prefixState->checkpoint)
+        return {};
+    // Checkpoints belong to the original parse generation. Buffer pins protect
+    // token storage; they do not make replaced SourceManager IDs current again.
+    for (auto id : native->getSourceBufferIds())
+        if (!native->sourceMan.isLatestData(id))
+            return {};
+    for (auto id : native->getPredefineBufferIds())
+        if (!native->sourceMan.isLatestData(id))
+            return {};
+    auto checkpoint = *native->prefixState->checkpoint;
+    auto& sm = native->sourceMan;
+    auto sourceRoot = [&](SourceLocation loc) {
+        if (!loc.valid() || loc == SourceLocation::NoLocation)
+            return BufferID{};
+        auto id = sm.getFullyExpandedLoc(loc).buffer();
+        while (auto from = sm.getIncludedFrom(id))
+            id = sm.getFullyExpandedLoc(from).buffer();
+        return id;
+    };
+    if (native->root().kind != SyntaxKind::CompilationUnit)
+        return {};
+    auto& all = native->root().as<CompilationUnitSyntax>();
+    if (all.members.empty() || all.members[0]->kind != SyntaxKind::PackageDeclaration)
+        return {};
+    auto* package = all.members[0];
+    if (package->as<ModuleDeclarationSyntax>().header->name.valueText() != "uvm_pkg" ||
+        sourceRoot(package->getFirstToken().location()) != checkpoint.root ||
+        sourceRoot(package->getLastToken().location()) != checkpoint.root)
+        return {};
+    for (size_t i = 1; i < all.members.size(); ++i)
+        if (sourceRoot(all.members[i]->getFirstToken().location()) == checkpoint.root)
+            return {};
+    BumpAllocator arena;
+    SmallVector<Trivia> trailing;
+    flat_hash_map<const SyntaxNode*, SyntaxNode*> tailAliases;
+    auto mapNodes = [&](auto&& self, const SyntaxNode& old, SyntaxNode& fresh) -> void {
+        tailAliases.emplace(&old, &fresh);
+        auto mapTrivia = [&](auto&& rec, std::span<const Trivia> a,
+                             std::span<const Trivia> b) -> void {
+            if (a.size() != b.size())
+                SLANG_THROW(std::runtime_error("tail trivia clone shape mismatch"));
+            for (size_t i = 0; i < a.size(); ++i) {
+                if (a[i].kind == TriviaKind::Directive)
+                    self(self, *a[i].syntax(), *b[i].syntax());
+                else if (a[i].kind == TriviaKind::SkippedTokens) {
+                    auto x = a[i].getSkippedTokens(), y = b[i].getSkippedTokens();
+                    if (x.size() != y.size())
+                        SLANG_THROW(std::runtime_error("tail skipped token clone mismatch"));
+                    for (size_t j = 0; j < x.size(); ++j)
+                        rec(rec, x[j].trivia(), y[j].trivia());
+                }
+            }
+        };
+        if (old.getChildCount() != fresh.getChildCount())
+            SLANG_THROW(std::runtime_error("tail node clone mismatch"));
+        for (size_t i = 0; i < old.getChildCount(); ++i)
+            if (auto child = old.childNode(i))
+                self(self, *child, *fresh.childNode(i));
+            else
+                mapTrivia(mapTrivia, old.childToken(i).trivia(), fresh.childToken(i).trivia());
+    };
+    // Prefix-ending directives move to the first suffix token in a native combined parse.
+    // Include only explicit prefix-origin trivia; implicit raw whitespace is immaterial.
+    auto pending = all.members.size() > 1 ? all.members[1]->getFirstToken() : all.endOfFile;
+    for (auto t : pending.trivia()) {
+        auto loc = t.getExplicitLocation();
+        if (t.kind == TriviaKind::Directive)
+            loc = t.syntax()->getFirstToken().location();
+        if (loc && sourceRoot(*loc) == checkpoint.root) {
+            auto clone = t.clone(arena, true);
+            if (t.kind == TriviaKind::Directive) {
+                auto last = t.syntax()->getLastToken().location();
+                if (sourceRoot(last) != checkpoint.root)
+                    SLANG_THROW(
+                        std::runtime_error("prefix directive crosses source root boundary"));
+                mapNodes(mapNodes, *t.syntax(), *clone.syntax());
+            }
+            trailing.push_back(clone);
+        }
+        else if (t.kind == TriviaKind::SkippedTokens) {
+            // Do not guess the origin of mixed skipped source during error recovery.
+            return {};
+        }
+    }
+    auto text = sm.getSourceText(checkpoint.root);
+    auto eof = Token(arena, TokenKind::EndOfFile, trailing, "",
+                     SourceLocation(checkpoint.root, text.empty() ? 0 : text.size() - 1));
+    SyntaxFactory factory(arena);
+    auto& root = factory.compilationUnit({}, eof);
+    MemberSyntax* memberList[] = {package};
+    root.members = SyntaxList<MemberSyntax>(arena,
+                                            memberList); // Immutable physical ancestry retained.
+    ParserMetadata metadata;
+    auto inPackage = [&](const SyntaxNode* n) {
+        for (; n; n = n->parent)
+            if (n == package)
+                return true;
+        return false;
+    };
+    for (auto& pair : native->metadata.nodeMeta)
+        if (inPackage(pair.first))
+            metadata.nodeMeta.push_back(pair);
+    auto filter = [&](const auto& input, auto& output) {
+        for (auto n : input)
+            if (inPackage(n))
+                output.push_back(n);
+    };
+    filter(native->metadata.globalInstances, metadata.globalInstances);
+    filter(native->metadata.classPackageNames, metadata.classPackageNames);
+    filter(native->metadata.packageImports, metadata.packageImports);
+    filter(native->metadata.classDecls, metadata.classDecls);
+    filter(native->metadata.interfacePorts, metadata.interfacePorts);
+    filter(native->metadata.virtualInterfaceTypes, metadata.virtualInterfaceTypes);
+    filter(native->metadata.namedPortTypes, metadata.namedPortTypes);
+    metadata.eofToken = eof;
+    // The package was frozen before the native tree was published. Only the new EOF
+    // trivia belongs to this view, so creating views never writes borrowed nodes.
+    if (!native->prefixState->capturedPackageDirectives)
+        return {};
+    auto summary = *native->prefixState->capturedPackageDirectives;
+    freezeDirectiveTrivia(root.endOfFile.trivia(), root, summary);
+    metadata.hasDefparams = summary.defparams;
+    metadata.hasBindDirectives = summary.binds;
+    Diagnostics diagnostics;
+    for (auto& d : native->diagnosticsBuffer) {
+        if (!d.location.valid() || d.location == SourceLocation::NoLocation)
+            return {};
+        if (sourceRoot(d.location) == checkpoint.root)
+            diagnostics.push_back(d);
+    }
+    // Checkpoint includes all top-level roots pushed in reverse order: retain only UVM.
+    auto& ids = checkpoint.pp.sourceBufferIds;
+    std::erase_if(ids, [&](BufferID id) {
+        return sourceRoot(SourceLocation(id, 0)) != checkpoint.root;
+    });
+    for (auto& d : checkpoint.pp.definedMacros)
+        if (auto it = tailAliases.find(d); it != tailAliases.end())
+            d = &it->second->as<DefineDirectiveSyntax>();
+    for (auto& ref : checkpoint.pp.macroRefs) {
+        if (auto it = tailAliases.find(ref.syntax); it != tailAliases.end())
+            ref.syntax = it->second;
+        if (auto it = tailAliases.find(ref.definition); it != tailAliases.end())
+            ref.definition = &it->second->as<DefineDirectiveSyntax>();
+    }
+    for (auto& include : checkpoint.pp.includeDirectives)
+        if (auto it = tailAliases.find(include.syntax); it != tailAliases.end())
+            include.syntax = &it->second->as<IncludeDirectiveSyntax>();
+    auto* result = new SyntaxTree(&root, native->library, sm, std::move(arena),
+                                  std::move(diagnostics), std::move(metadata),
+                                  std::move(checkpoint.pp), native->options_);
+    result->isLibraryUnit = native->isLibraryUnit;
+    auto ownerBytes = native->getRetainedSyntaxBytes();
+    auto ownerSources = native->getRetainedSourceBytes();
+    result->prefixState = std::make_unique<PrefixState>();
+    result->prefixState->wholeTreeDirectives = summary;
+    result->prefixState->guards = std::move(checkpoint.guards);
+    result->prefixState->extraBytes = ownerBytes;
+    result->prefixState->extraSourceBytes = ownerSources;
+    result->prefixState->cwd = std::move(checkpoint.cwd);
+    auto buffers = native->getSourceBufferIds();
+    auto pins = sm.retainBuffers(buffers);
+    auto macroPins = sm.retainBuffers(native->getPredefineBufferIds());
+    return std::shared_ptr<SyntaxTree>(result, [native, pins = std::move(pins),
+                                                macroPins = std::move(macroPins)](SyntaxTree* p) {
+        delete p;
+    });
+}
