+TEST_CASE("Owned prefix composition donates only an exclusive parsed suffix",
+          "[source-snapshot][owned-suffix]") {
+    for (int mode = 0; mode < 3; ++mode) {
+        INFO("donor mode " << mode); // exclusive parser result, shared result, declaration view
+        SourceManager sm;
+        auto fixed = sm.assignText("owned-fixed.sv",
+                                   "`define VALUE 3\npackage p; typedef int T; endpackage\n");
+        auto user = sm.assignText("owned-user.sv",
+                                  "`timescale 1ns/1ps\n`default_nettype wire\n"
+                                  "module m; import p::*;\n"
+                                  "typedef enum { First, Last=`VALUE } e_t; e_t x=Last;\n"
+                                  "localparam int V=Last; endmodule\n");
+        auto prefix = SyntaxTree::fromBuffersWithCheckpoint(std::vector{fixed}, sm, {});
+        auto suffix = SyntaxTree::afterCachedPrefix(prefix, std::vector{user}, {});
+        const auto* prefixMember = prefix->root().as<syntax::CompilationUnitSyntax>().members[0];
+        const auto* suffixRoot = &suffix->root();
+        const auto* suffixMember = suffix->root().as<syntax::CompilationUnitSyntax>().members[0];
+        REQUIRE(!suffix->getMacroRefs().empty());
+        const auto* macroUse = suffix->getMacroRefs().back().syntax;
+        auto copy = SyntaxTree::withCachedPrefix(prefix, suffix);
+        const auto copiedBytes = copy->getRetainedSyntaxBytes();
+        copy.reset();
+        std::shared_ptr<SyntaxTree> alias;
+        if (mode == 1)
+            alias = suffix;
+        else if (mode == 2) {
+            auto view = SyntaxTree::selectCompilationUnitMembers(
+                suffix, std::vector<const syntax::MemberSyntax*>{suffixMember});
+            suffix = std::move(view);
+        }
+        auto combined = SyntaxTree::withCachedPrefixOwnedSuffix(prefix, std::move(suffix));
+        CHECK_FALSE(suffix);
+        const auto& unit = combined->root().as<syntax::CompilationUnitSyntax>();
+        REQUIRE(unit.members.size() == 2);
+        CHECK(unit.members[0] == prefixMember);
+        CHECK(prefixMember->parent == &prefix->root());
+        if (mode == 0) {
+            CHECK(&combined->root() == suffixRoot);
+            CHECK(unit.members[1] == suffixMember);
+            CHECK(combined->getRetainedSyntaxBytes() < copiedBytes);
+        }
+        else {
+            CHECK(&combined->root() != suffixRoot);
+            CHECK(unit.members[1] != suffixMember);
+            CHECK(suffixMember->parent == suffixRoot);
+        }
+        CHECK(unit.members[1]->parent == &combined->root());
+        CHECK(combined->getMacroRefs().back().syntax == macroUse);
+        auto native = SyntaxTree::fromBuffers(std::vector{fixed, user}, sm, {});
+        const auto& a = combined->getMetadata();
+        const auto& b = native->getMetadata();
+        REQUIRE(a.nodeMeta.size() == b.nodeMeta.size());
+        for (size_t i = 0; i < a.nodeMeta.size(); ++i) {
+            CHECK(a.nodeMeta[i].second.defaultNetType == b.nodeMeta[i].second.defaultNetType);
+            CHECK(a.nodeMeta[i].second.timeScale == b.nodeMeta[i].second.timeScale);
+        }
+        prefix.reset();
+        alias.reset();
+        ast::Compilation actual, expected;
+        actual.addSyntaxTree(combined);
+        expected.addSyntaxTree(native);
+        CHECK(DiagnosticEngine::reportAll(sm, actual.getAllDiagnostics()) ==
+              DiagnosticEngine::reportAll(sm, expected.getAllDiagnostics()));
+        CHECK(combined->root().toString().find("localparam int V=Last") != std::string::npos);
+    }
+}
