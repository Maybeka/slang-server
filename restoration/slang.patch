+void Compilation::setInstanceBodyReuseHooks(
+    std::function<void(Compilation&, InstanceBodySymbol&)> lookup,
+    std::function<void(std::shared_ptr<Compilation>)> publish) {
+    if (finalized)
+        SLANG_THROW(std::logic_error("body reuse hooks must precede elaboration"));
+    if (lookup || publish)
+        enableInstanceBodyReferenceTracking();
+    bodyLookup = std::move(lookup);
+    bodyPublish = std::move(publish);
+}
+
+void Compilation::enableInstanceBodyReferenceTracking(bool complete) {
+    if (finalized)
+        SLANG_THROW(std::logic_error("reference tracking must precede elaboration"));
+    trackBodyReferences = true;
+    completeBodyReferenceTracking |= complete;
+}
