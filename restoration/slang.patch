+TEST_CASE("Parse archives retain optional bounded macro facts and read legacy syntax",
+          "[parse-archive][macro-access]") {
+    const auto root = std::filesystem::canonical(std::filesystem::temp_directory_path()) /
+                      "macro-fact-archive";
+    SourceManager original;
+    PreprocessorOptions tracked;
+    tracked.trackMacroAccesses = true;
+    const auto buffer = original.assignText((root / "uvm_pkg.sv").string(), R"(
+`ifndef ABSENT_FLAG
+`define PRESENT_VALUE 7
+package uvm_pkg; int value = `PRESENT_VALUE; endpackage
+`endif
+)");
+    auto tree = SyntaxTree::fromBuffersWithCheckpoint(std::span(&buffer, 1), original,
+                                                      Bag{tracked});
+    REQUIRE(tree->getPreprocessorMetadata().macroAccessTrackingComplete);
+    REQUIRE(tree->getPreprocessorMetadata().macroAccessEndedAtEof);
+    std::ostringstream output(std::ios::binary);
+    tree->writeParseArchive(output, root);
+    const auto bytes = output.str();
+    auto tail = [](uint64_t flags, const auto& names) {
+        std::ostringstream stream(std::ios::binary);
+        ArchiveWriter writer(stream);
+        writer.number(flags);
+        writer.number(names.size());
+        for (const auto& name : names)
+            writer.text(name);
+        return stream.str();
+    };
+    const auto nativeTail = tail(3, tree->getPreprocessorMetadata().macroAccessNames);
+    REQUIRE(bytes.ends_with(nativeTail));
+    const auto base = bytes.substr(0, bytes.size() - nativeTail.size());
+    struct RestoredFacts {
+        std::set<std::string, std::less<>> names;
+        size_t storageBytes;
+        bool complete, eof;
+        std::string syntax;
+    };
+    auto read = [&](const std::string& data, const PreprocessorOptions& options) {
+        SourceManager destination;
+        std::shared_ptr<SyntaxTree> loaded;
+        {
+            std::istringstream stream(data, std::ios::binary);
+            loaded = SyntaxTree::readParseArchive(stream, destination, root, Bag{options});
+        } // Names must survive destruction of the reader and its borrowed input.
+        const auto& facts = loaded->getPreprocessorMetadata();
+        return RestoredFacts{facts.macroAccessNames, facts.macroAccessStorageBytes,
+                             facts.macroAccessTrackingComplete, facts.macroAccessEndedAtEof,
+                             SyntaxPrinter(destination).print(*loaded).str()};
+    };
+    const auto restored = read(bytes, tracked);
+    CHECK(restored.complete);
+    CHECK(restored.eof);
+    CHECK(restored.names == tree->getPreprocessorMetadata().macroAccessNames);
+    CHECK(restored.names.contains("ABSENT_FLAG"));
+    CHECK(restored.storageBytes <= tracked.maxTrackedMacroAccessBytes);
+    const auto boundary = read(base + tail(1, restored.names), tracked);
+    CHECK(boundary.complete);
+    CHECK_FALSE(boundary.eof);
+    CHECK(boundary.names == restored.names);
+    CHECK(boundary.syntax == restored.syntax);
+    auto exact = tracked;
+    exact.maxTrackedMacroAccessBytes = restored.storageBytes;
+    CHECK(read(bytes, exact).complete);
+
+    auto disabled = read(bytes, PreprocessorOptions{});
+    CHECK_FALSE(disabled.complete);
+    CHECK_FALSE(disabled.eof);
+    CHECK(disabled.names.empty());
+    CHECK(disabled.storageBytes == 0);
+    CHECK(disabled.syntax == restored.syntax);
+    auto small = tracked;
+    small.maxTrackedMacroAccessBytes = 0;
+    const auto exhausted = read(bytes, small);
+    CHECK_FALSE(exhausted.complete);
+    CHECK(exhausted.eof);
+    CHECK(exhausted.names.empty());
+    CHECK(exhausted.storageBytes == 0);
+    CHECK(exhausted.syntax == restored.syntax);
+
+    // Restoring proof annotations must keep the original CST and namespace.
+    SourceManager retainedSources;
+    std::shared_ptr<SyntaxTree> retained;
+    {
+        std::istringstream stream(bytes, std::ios::binary);
+        retained = SyntaxTree::readParseArchive(stream, retainedSources, root);
+    }
+    auto view = retained;
+    for (const auto& requested : {tracked, small, PreprocessorOptions{}, exact, tracked}) {
+        Bag requestedOptions{requested};
+        view = SyntaxTree::sharedPrefixView(view, retainedSources, &requestedOptions);
+        CHECK(&view->root() == &retained->root());
+        CHECK(SyntaxPrinter(retainedSources).print(*view).str() == restored.syntax);
+        const bool complete = requested.trackMacroAccesses && requested.maxTrackedMacroAccessBytes;
+        CHECK(view->getPreprocessorMetadata().macroAccessTrackingComplete == complete);
+        CHECK(view->getPreprocessorMetadata().macroAccessNames.empty() == !complete);
+        CHECK(view->getPreprocessorMetadata().macroAccessStorageBytes <=
+              requested.maxTrackedMacroAccessBytes);
+    }
+    CHECK_FALSE(retained->getPreprocessorMetadata().macroAccessTrackingComplete);
+    CHECK(retained->getPreprocessorMetadata().macroAccessNames.empty());
+    std::ostringstream rewritten(std::ios::binary);
+    retained->writeParseArchive(rewritten, root);
+    CHECK(rewritten.str().ends_with(nativeTail));
+
+    // Version 4 appends the terminal directive state before the macro trace.
+    // This fixture has the default state, whose four fields are varints.
+    std::ostringstream directiveState(std::ios::binary);
+    ArchiveWriter directiveWriter(directiveState);
+    directiveWriter.number(0); // no timescale
+    directiveWriter.number(uint64_t(TokenKind::WireKeyword));
+    directiveWriter.number(uint64_t(TokenKind::Unknown));
+    directiveWriter.number(0); // outside celldefine
+    REQUIRE(base.ends_with(directiveState.str()));
+    auto legacy = base.substr(0, base.size() - directiveState.str().size());
+    const auto magic = legacy.find("slang-uvm-cst-4");
+    REQUIRE(magic != std::string::npos);
+    auto directiveRecord = [](std::initializer_list<uint64_t> fields) {
+        std::ostringstream stream(std::ios::binary);
+        ArchiveWriter writer(stream);
+        for (auto value : fields)
+            writer.number(value);
+        return stream.str();
+    };
+    // Validate raw integers before narrowing token / unit enums. In particular,
+    // a large integer must not wrap back into a valid token kind.
+    const auto archiveBase = legacy;
+    for (const auto& malformed : {
+             directiveRecord({2}),
+             directiveRecord({1, 256, 1, 0, 1}),
+             directiveRecord({1, 3, 2, 4, 1}),
+             directiveRecord({1, 4, 1, 3, 1}),
+             directiveRecord({0, (uint64_t(1) << 32) + uint64_t(TokenKind::WireKeyword), 0, 0}),
+             directiveRecord({0, uint64_t(TokenKind::WireKeyword), 65535, 0}),
+             directiveRecord({0, uint64_t(TokenKind::WireKeyword), 0, 2})}) {
+        CHECK_THROWS_AS(read(archiveBase + malformed + nativeTail, tracked), std::runtime_error);
+    }
+    auto version3 = legacy;
+    version3.replace(magic, std::string_view("slang-uvm-cst-4").size(), "slang-uvm-cst-3");
+    CHECK(read(version3 + nativeTail, tracked).names == restored.names);
+    legacy.replace(magic, std::string_view("slang-uvm-cst-4").size(), "slang-uvm-cst-2");
+    const auto old = read(legacy, tracked);
+    CHECK_FALSE(old.complete);
+    CHECK_FALSE(old.eof);
+    CHECK(old.names.empty());
+    CHECK(old.syntax == restored.syntax);
+    const auto absent = read(base + tail(0, std::vector<std::string>{}), tracked);
+    CHECK_FALSE(absent.complete);
+    CHECK(absent.names.empty());
+
+    for (const auto& bad : {
+             tail(4, std::vector<std::string>{}),
+             tail(0, std::vector<std::string>{"A"}),
+             tail(3, std::vector<std::string>{"A", "A"}),
+             tail(3, std::vector<std::string>{"B", "A"}),
+             tail(3, std::vector<std::string>{""}),
+             nativeTail + "x",
+             nativeTail.substr(0, nativeTail.size() - 1)}) {
+        CHECK_THROWS_AS(read(base + bad, tracked), std::runtime_error);
+        CHECK_THROWS_AS(read(base + bad, PreprocessorOptions{}), std::runtime_error);
+    }
+    CHECK_THROWS_AS(read(legacy + "x", tracked), std::runtime_error);
+}
