+        CHECK_THROWS_AS(evaluation.pushFrame(late, {}, LookupLocation::max), std::runtime_error);
+        CHECK_FALSE(late.bodyHasExternalDependents.load());
+        CHECK_FALSE(compilation.bodySyntaxHasExternalDependents(*late.getSyntax()));
+        const auto& other = method("late_t", "other");
+        CHECK_NOTHROW(compilation.noteBodyExternalDependent(other));
+        CHECK(compilation.bodySyntaxHasExternalDependents(*other.getSyntax()));
+    }
+    CHECK_NOTHROW(BodyQueryEvaluationGuard::check(first));
+    // An unguarded external use must invalidate every context of the same syntax.
+    compilation.noteBodyExternalDependent(second);
+    CHECK(compilation.bodySyntaxHasExternalDependents(*first.getSyntax()));
+    CHECK(second.bodyHasExternalDependents.load());
