+TEST_CASE("Replay updates retain immutable prefix buffers and invalidate edited IDs",
+          "[snapshot-update]") {
+    SnapshotFixture f;
+    SourceManager::SourceSnapshot snapshot;
+    snapshot.cwd = f.dir.string();
+    auto library = (f.dir / "uvm_pkg.sv").string();
+    auto user = (f.dir / "user.sv").string();
+    auto bytes = [](std::string text) {
+        text.push_back('\0');
+        return text;
+    };
+    snapshot.files = {{library, f.dir.string(), "uvm_pkg.sv",
+                       bytes("package uvm_pkg; class base; endclass endpackage\n"), false},
+                      {user, f.dir.string(), "user.sv", bytes("package p; int first; endpackage\n"),
+                       false}};
+    snapshot.lookups = {{library, 1, 0, ""},
+                        {user, 2, 0, ""},
+                        {(f.dir / "absent.svh").string(), 0, ENOENT, "generic"}};
+    SourceManager sm;
+    sm.loadSnapshot(snapshot);
+    auto a = sm.createRootBuffer(1), b = sm.createRootBuffer(2);
+    Bag options;
+    parsing::PreprocessorOptions pp;
+    pp.captureUvmPrefix = true;
+    options.set(pp);
+    auto native = SyntaxTree::fromBuffers(std::vector{a, b}, sm, options);
+    auto prefix = SyntaxTree::preparedUvmPrefix(native);
+    REQUIRE(prefix);
+    auto retained = prefix->getSourceBufferIds();
+    auto next = snapshot;
+    next.files[1].bytes = bytes("package p; int newest; endpackage\n");
+    // Independent parses add generated CLI buffers unrelated to this tree.
+    next.files.push_back(
+        {"<unnamed_buffer91>", "", "<unnamed_buffer91>", bytes("`define UNRELATED 1\n"), true});
+    REQUIRE(sm.tryUpdateSnapshot(next, retained));
+    CHECK(sm.isLatestData(a.id));
+    CHECK_FALSE(sm.isLatestData(b.id));
+    auto latest = sm.createRootBuffer(2);
+    CHECK(latest.id != b.id);
+    CHECK(latest.data == next.files[1].bytes);
+    sm.setSnapshotGeneratedSequence({});
+    auto suffix = SyntaxTree::afterCachedPrefix(prefix, std::vector{latest}, options);
+    sm.finishSnapshotGeneratedSequence();
+    auto composed = SyntaxTree::withCachedPrefix(prefix, suffix);
+    CHECK(composed->root().toString().find("newest") != std::string::npos);
+    CHECK(composed->root().toString().find("first") == std::string::npos);
+
+    SECTION("changed immutable bytes decline without altering current replay") {
+        next.files[0].bytes = bytes("package uvm_pkg; endpackage\n");
+    }
+    SECTION("cwd change declines") {
+        next.cwd += "/other";
+    }
+    SECTION("include lookup topology change declines") {
+        next.lookups.pop_back();
+    }
+    SECTION("failed lookup result change declines") {
+        next.lookups.back().errorValue = EACCES;
+    }
+    SECTION("header request change declines") {
+        next.headerRequests.push_back("new-request");
+    }
+    SECTION("include ordering flag change declines") {
+        next.incDirFirst = true;
+    }
+    SECTION("display identity change declines") {
+        next.files[0].displayName = "other.sv";
+    }
+    SECTION("retained generated classification change declines") {
+        next.files[0].generated = true;
+    }
+    CHECK_FALSE(sm.tryUpdateSnapshot(next, retained));
+    CHECK(sm.isLatestData(a.id));
+    CHECK(sm.isLatestData(latest.id));
+    CHECK(sm.getSourceText(latest.id) == bytes("package p; int newest; endpackage\n"));
+    auto malformed = snapshot;
+    malformed.files.push_back(malformed.files[0]);
+    CHECK_THROWS(sm.tryUpdateSnapshot(malformed, retained));
+    CHECK(sm.isLatestData(latest.id));
+}
