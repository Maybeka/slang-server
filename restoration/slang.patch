+TEST_CASE("Private body replacement recomputes caller and initializer driver effects",
+          "[body-effect-replay]") {
+    const bool reverse = GENERATE(false, true);
+    const bool reuse = GENERATE(false, true);
+    CAPTURE(reverse, reuse);
+    AnalysisOptions options;
+    if (reuse)
+        options.flags |= AnalysisFlags::RetainProcedureSummaries;
+    const std::string prefix = "module top(input logic clk);\n"
+                               "  int shared_value, left_value, right_value, observed;\n";
+    auto function = [](bool writes) {
+        auto statement = std::string(writes ? "shared_value=arg; return arg+right_value;"
+                                            : "return arg+left_value;");
+        statement.resize(64, ' ');
+        return "  function automatic int work(input int arg);\n"
+               "    static int counter=0; counter=arg;\n    " +
+               statement + "\n  endfunction\n";
+    };
+    const std::string suffix =
+        "  function automatic int middle(input int arg); return work(arg); endfunction\n"
+        "  function int peer(input int arg); if (arg) return 3; endfunction\n"
+        "  int initialized=middle(1);\n"
+        "  always_comb observed=middle(2);\n"
+        "  always_ff @(posedge clk) shared_value<=1;\n"
+        "endmodule\n"
+        "module stable; logic spare; always_comb spare=1; endmodule\n";
+    const auto oldText = prefix + function(reverse) + suffix;
+    const auto newText = prefix + function(!reverse) + suffix;
+    auto owner = std::make_shared<Compilation>();
+    AnalysisManager original(options);
+    const auto before = analyze(oldText, *owner, original);
+    const auto oldReport = report(before);
+    const auto& top = owner->getRoot().lookupName<InstanceSymbol>("top");
+    const auto& old = top.body.find<SubroutineSymbol>("work");
+    const auto& shared = top.body.find<VariableSymbol>("shared_value");
+    const auto oldDrivers = original.getDrivers(shared);
+    const auto& stable = owner->getRootNoFinalize().lookupName<InstanceSymbol>("stable");
+    const auto oldBytes = owner->getTotalBytesAllocated();
+
+    auto padding = prefix;
+    for (auto& c : padding)
+        if (c != '\n')
+            c = ' ';
+    auto tree = SyntaxTree::fromText(padding + function(!reverse));
+    const syntax::FunctionDeclarationSyntax* syntax = nullptr;
+    auto find = [&](auto&& self, const syntax::SyntaxNode& node) -> void {
+        if (auto fn = node.as_if<syntax::FunctionDeclarationSyntax>()) {
+            REQUIRE_FALSE(syntax);
+            syntax = fn;
+            return;
+        }
+        for (uint32_t i = 0; i < node.getChildCount(); ++i)
+            if (auto child = node.childNode(i))
+                self(self, *child);
+    };
+    find(find, tree->root());
+    REQUIRE(syntax);
+    Compilation edited;
+    edited.setBodyQueryContext(owner, tree);
+    auto references = std::make_unique<BodyQueryReferenceGuard>(edited);
+    auto& replacement = SubroutineSymbol::createBodyQuery(edited, *syntax, old);
+    edited.forceElaborate(replacement);
+    for (const auto& diagnostic : edited.getBodyQueryDiagnostics())
+        CHECK_FALSE(diagnostic.isError());
+    edited.freeze();
+    references.reset();
+    const AnalysisManager::SubroutineReplacement replacements[] = {{&old, &replacement}};
+    AnalysisManager replay(options);
+    replay.setSubroutineReplacements(replacements);
+    auto baseline = std::shared_ptr<const AnalysisManager>(&original, [](auto*) {});
+    if (reuse)
+        replay.setProcedureReuse(baseline);
+    replay.analyze(*owner);
+    const auto actual = replay.getDiagnostics();
+    if (reuse) {
+        CHECK(replay.getStats().numProceduresReused >= 2);
+        CHECK(replay.getStats().numProceduresRecomputed >= 3);
+        const auto& peer = top.body.find<SubroutineSymbol>("peer");
+        CHECK(replay.getAnalyzedSubroutine(peer) == original.getAnalyzedSubroutine(peer));
+        CHECK(replay.getAnalyzedScope(peer) == original.getAnalyzedScope(peer));
+        CHECK(replay.getAnalyzedScope(stable.body) == original.getAnalyzedScope(stable.body));
+        const auto& spare = stable.body.find<VariableSymbol>("spare");
+        CHECK(replay.getDrivers(spare) == original.getDrivers(spare));
+    }
+    Compilation fresh;
+    AnalysisManager native;
+    const auto expected = analyze(newText, fresh, native);
+    CHECK(report(actual) == report(expected));
+    const auto& freshTop = fresh.getRoot().lookupName<InstanceSymbol>("top");
+    CHECK(replay.getDrivers(shared).size() ==
+          native.getDrivers(freshTop.body.find<VariableSymbol>("shared_value")).size());
+    CHECK(replay.getDrivers(shared).size() != oldDrivers.size());
+    auto sensitivity = [](const AnalysisManager& manager, const InstanceBodySymbol& body) {
+        std::vector<std::vector<std::string>> result;
+        const auto* scope = manager.getAnalyzedScope(body);
+        REQUIRE(scope);
+        for (const auto& procedure : scope->procedures) {
+            std::vector<std::string> names;
+            for (const auto& read : procedure.getSensitivityList().reads)
+                names.emplace_back(read.symbol->name);
+            std::ranges::sort(names);
+            result.push_back(std::move(names));
+        }
+        return result;
+    };
+    CHECK(sensitivity(replay, top.body) == sensitivity(native, freshTop.body));
+    CHECK(replay.getAnalyzedSubroutine(old)->analyzedSymbol == &replacement);
+    CHECK(original.getDrivers(shared) == oldDrivers);
+    CHECK(report(original.getDiagnostics()) == oldReport);
+    CHECK(owner->getTotalBytesAllocated() == oldBytes);
+#if SLANG_ASSERT_ENABLED
+    CHECK(owner->isFrozen());
+#endif
+    CHECK_THROWS_AS(replay.setSubroutineReplacements(replacements), std::logic_error);
+    AnalysisManager cancelled(options);
+    cancelled.setSubroutineReplacements(replacements);
+    if (reuse)
+        cancelled.setProcedureReuse(baseline);
+    cancelled.addListener(
+        [](const AnalyzedProcedure&) { throw std::runtime_error("cancel replay"); });
+    CHECK_THROWS_AS(cancelled.analyze(*owner), std::runtime_error);
+    CHECK(original.getDrivers(shared) == oldDrivers);
+    CHECK(owner->getTotalBytesAllocated() == oldBytes);
+    edited.unfreeze();
+    owner->unfreeze();
+}
