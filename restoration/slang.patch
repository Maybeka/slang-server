+// SPDX-License-Identifier: MIT
+#include "Test.h"
+#include <cerrno>
+#include <fstream>
+
+#include "slang/diagnostics/DiagnosticEngine.h"
+#include "slang/parsing/Preprocessor.h"
+#include "slang/syntax/SyntaxTree.h"
+#include "slang/text/SourceManager.h"
+
+namespace {
+struct SnapshotFixture {
+    fs::path saved = fs::current_path();
+    fs::path dir = fs::temp_directory_path() / "slang-strict-source-snapshot-test";
+    SnapshotFixture() {
+        fs::remove_all(dir);
+        fs::create_directories(dir / "first");
+        fs::create_directories(dir / "second");
+    }
+    ~SnapshotFixture() {
+        fs::current_path(saved);
+        fs::remove_all(dir);
+    }
+    void write(const fs::path& path, std::string_view bytes) {
+        std::ofstream out(dir / path, std::ios::binary);
+        out.write(bytes.data(), std::streamsize(bytes.size()));
+    }
+};
+} // namespace
+
+TEST_CASE("Live source witnesses recheck shared parents, leaves and negative lookups") {
+    SnapshotFixture f;
+    f.write("first/a.sv", "module a; endmodule\n");
+    f.write("first/b.sv", "module b; endmodule\n");
+    f.write("second/a.sv", "module a; endmodule\n");
+    f.write("second/b.sv", "module b; endmodule\n");
+    fs::create_directory_symlink(f.dir / "first", f.dir / "alias");
+    fs::current_path(f.dir);
+    SourceManager original;
+    original.enableSnapshotRecording();
+    REQUIRE(original.readSource("alias/a.sv"));
+    REQUIRE(original.readSource("alias/b.sv"));
+    REQUIRE(original.readSource("first/../alias/a.sv"));
+    REQUIRE(!original.readSource("alias/missing.sv"));
+    CHECK_FALSE(original.sourceWitnessFailure({}));
+    // A second invocation must make fresh observations, including directory and
+    // leaf identity changes whose replacement source bytes happen to be equal.
+    SECTION("directory alias changes to equal contents") {
+        fs::remove(f.dir / "alias");
+        fs::create_directory_symlink(f.dir / "second", f.dir / "alias");
+    }
+    SECTION("ordinary leaf becomes a symlink to equal contents") {
+        fs::remove(f.dir / "first/a.sv");
+        fs::create_symlink(f.dir / "second/a.sv", f.dir / "first/a.sv");
+    }
+    SECTION("previously missing lookup appears") {
+        f.write("first/missing.sv", "module missing; endmodule\n");
+    }
+    SECTION("ordinary leaf disappears") {
+        fs::remove(f.dir / "first/b.sv");
+    }
+    SECTION("same size and timestamp do not prove equal bytes") {
+        auto stamp = fs::last_write_time(f.dir / "first/b.sv");
+        auto size = fs::file_size(f.dir / "first/b.sv");
+        f.write("first/b.sv", "module c; endmodule\n");
+        fs::last_write_time(f.dir / "first/b.sv", stamp);
+        REQUIRE(fs::file_size(f.dir / "first/b.sv") == size);
+    }
+    CHECK(original.sourceWitnessFailure({}));
+}
+
+TEST_CASE("Live negative witnesses preserve canonical identity without readable files") {
+    SnapshotFixture f;
+    fs::current_path(f.dir);
+    SourceManager original;
+    original.enableSnapshotRecording();
+    SECTION("resolved parent alias changes between two absent targets") {
+        fs::create_directory_symlink(f.dir / "first", f.dir / "alias");
+        REQUIRE(!original.readSource("alias/missing.sv"));
+        REQUIRE(!original.readSource("alias/another.sv"));
+        CHECK_FALSE(original.sourceWitnessFailure({}));
+        fs::remove(f.dir / "alias");
+        fs::create_directory_symlink(f.dir / "second", f.dir / "alias");
+        CHECK(original.sourceWitnessFailure({}));
+    }
+    SECTION("previously unresolved parent becomes an alias to an absent target") {
+        REQUIRE(!original.readSource("first/unavailable/missing.sv"));
+        CHECK_FALSE(original.sourceWitnessFailure({}));
+        fs::create_directory_symlink(f.dir / "second", f.dir / "first/unavailable");
+        CHECK(original.sourceWitnessFailure({}));
+    }
+}
+
+TEST_CASE("Cancelling a live witness leaves its source history reusable") {
+    SnapshotFixture f;
+    f.write("first/a.sv", "module a; endmodule\n");
+    SourceManager original;
+    original.enableSnapshotRecording();
+    REQUIRE(original.readSource(f.dir / "first/a.sv"));
+    REQUIRE(!original.readSource(f.dir / "first/missing.sv"));
+    int checks = 0;
+    auto cancel = [&] {
+        if (++checks == 3)
+            throw std::runtime_error("cancel witness");
+    };
+    CHECK_THROWS_AS(original.sourceWitnessFailure({}, cancel), std::runtime_error);
+    CHECK(checks == 3);
+    CHECK_FALSE(original.sourceWitnessFailure({}));
+    f.write("first/missing.sv", "module present; endmodule\n");
+    CHECK(original.sourceWitnessFailure({}));
+}
+
+TEST_CASE("Live directory proofs preserve component order and recheck after reads") {
+    SnapshotFixture f;
+    fs::create_directories(f.dir / "first/nested");
+    fs::create_directories(f.dir / "second/nested");
+    f.write("first/a.sv", "module a; endmodule\n");
+    f.write("second/a.sv", "module a; endmodule\n");
+    fs::current_path(f.dir);
+    SourceManager original;
+    original.enableSnapshotRecording();
+    SECTION("ordinary dot and parent components remain fresh across invocations") {
+        REQUIRE(original.readSource("first/./nested/../a.sv"));
+        REQUIRE(!original.readSource("first/nested/../missing.sv"));
+        CHECK_FALSE(original.sourceWitnessFailure({}));
+        fs::rename(f.dir / "first", f.dir / "saved");
+        fs::create_directory_symlink(f.dir / "second", f.dir / "first");
+        CHECK(original.sourceWitnessFailure({}));
+    }
+    SECTION("a symlink preceding parent traversal cannot be collapsed") {
+        fs::create_directory_symlink(f.dir / "second/nested", f.dir / "first/link");
+        REQUIRE(original.readSource("first/link/../a.sv"));
+        CHECK_FALSE(original.sourceWitnessFailure({}));
+        fs::remove(f.dir / "first/link");
+        fs::create_directories(f.dir / "first/link");
+        CHECK(original.sourceWitnessFailure({}));
+    }
+    SECTION("case-only directory renames retain native canonical identity checks") {
+        REQUIRE(original.readSource("first/a.sv"));
+        CHECK_FALSE(original.sourceWitnessFailure({}));
+        const auto expected = fs::weakly_canonical(f.dir / "first/a.sv");
+        fs::rename(f.dir / "first", f.dir / "FIRST");
+        const bool changed = fs::weakly_canonical(f.dir / "first/a.sv") != expected ||
+                             !fs::is_regular_file(f.dir / "first/a.sv");
+        CHECK(bool(original.sourceWitnessFailure({})) == changed);
+#if defined(__APPLE__)
+        CHECK(changed);
+#endif
+    }
+    SECTION("case-only ordinary leaf renames retain native canonical identity checks") {
+        REQUIRE(original.readSource("first/a.sv"));
+        CHECK_FALSE(original.sourceWitnessFailure({}));
+        const auto expected = fs::weakly_canonical(f.dir / "first/a.sv");
+        fs::rename(f.dir / "first/a.sv", f.dir / "first/A.sv");
+        const bool changed = fs::weakly_canonical(f.dir / "first/a.sv") != expected ||
+                             !fs::is_regular_file(f.dir / "first/a.sv");
+        CHECK(bool(original.sourceWitnessFailure({})) == changed);
+#if defined(__APPLE__)
+        CHECK(changed);
+#endif
+    }
+    SECTION("case-only rename after reads is rechecked on insensitive volumes") {
+        if (fs::exists(f.dir / "FIRST")) {
+            REQUIRE(original.readSource("first/a.sv"));
+            REQUIRE(!original.readSource("first/missing.sv"));
+            int totalChecks = 0;
+            CHECK_FALSE(original.sourceWitnessFailure({}, [&] { ++totalChecks; }));
+            const auto expected = fs::weakly_canonical(f.dir / "first");
+            int checks = 0;
+            auto failure = original.sourceWitnessFailure({}, [&] {
+                if (++checks == totalChecks)
+                    fs::rename(f.dir / "first", f.dir / "FIRST");
+            });
+            const bool changed = fs::weakly_canonical(f.dir / "first") != expected;
+            CHECK(bool(failure) == changed);
+#if defined(__APPLE__)
+            CHECK(changed);
+#endif
+        }
+    }
+    SECTION("a missing intervening component uses native weak canonical semantics") {
+        REQUIRE(original.readSource("first/unavailable/../a.sv"));
+        CHECK_FALSE(original.sourceWitnessFailure({}));
+        fs::create_directories(f.dir / "first/unavailable");
+        CHECK_FALSE(original.sourceWitnessFailure({}));
+        fs::remove(f.dir / "first/unavailable");
+        fs::create_directory_symlink(f.dir / "second/nested", f.dir / "first/unavailable");
+        CHECK(original.sourceWitnessFailure({}));
+    }
+    SECTION("parent identity changes after closed reads are still detected") {
+        REQUIRE(original.readSource("first/a.sv"));
+        REQUIRE(!original.readSource("first/missing.sv"));
+        int totalChecks = 0;
+        CHECK_FALSE(original.sourceWitnessFailure({}, [&] { ++totalChecks; }));
+        REQUIRE(totalChecks == 6); // Entry, two aliases, two reads, one parent.
+        int checks = 0;
+        CHECK(original.sourceWitnessFailure({}, [&] {
+            if (++checks == totalChecks) {
+                fs::rename(f.dir / "first", f.dir / "saved");
+                fs::create_directory_symlink(f.dir / "second", f.dir / "first");
+            }
+        }));
+    }
+}
+
+TEST_CASE("Large live witnesses retain exact reads and recover from cancellation") {
+    SnapshotFixture f;
+    fs::current_path(f.dir);
+    SourceManager original;
+    original.enableSnapshotRecording();
+    for (int i = 0; i < 128; i++) {
+        auto path = "first/a" + std::to_string(i) + ".sv";
+        f.write(path, "module a; endmodule\n");
+        REQUIRE(original.readSource(path));
+    }
+    REQUIRE(!original.readSource("first/missing.sv"));
+    int totalChecks = 0;
+    CHECK_FALSE(original.sourceWitnessFailure({}, [&] { ++totalChecks; }));
+    SECTION("a late cancellation drains in-flight work before returning") {
+        int checks = 0;
+        CHECK_THROWS_AS(original.sourceWitnessFailure({},
+                                                      [&] {
+                                                          if (++checks == totalChecks - 2)
+                                                              throw std::runtime_error(
+                                                                  "cancel large witness");
+                                                      }),
+                        std::runtime_error);
+        CHECK_FALSE(original.sourceWitnessFailure({}));
+        f.write("first/a127.sv", "module b; endmodule\n");
+        CHECK(original.sourceWitnessFailure({}));
+    }
+    SECTION("same metadata cannot hide a change in any read chunk") {
+        for (int index : {0, 31, 64, 95, 127}) {
+            auto path = "first/a" + std::to_string(index) + ".sv";
+            auto stamp = fs::last_write_time(f.dir / path);
+            f.write(path, "module b; endmodule\n");
+            fs::last_write_time(f.dir / path, stamp);
+            CHECK(original.sourceWitnessFailure({}));
+            f.write(path, "module a; endmodule\n");
+            fs::last_write_time(f.dir / path, stamp);
+            CHECK_FALSE(original.sourceWitnessFailure({}));
+        }
+    }
+    SECTION("previous negative becomes readable") {
+        f.write("first/missing.sv", "module missing; endmodule\n");
+        CHECK(original.sourceWitnessFailure({}));
+    }
+}
+
+TEST_CASE("Large live alias witnesses preserve identity and cancellation") {
+    SnapshotFixture f;
+    fs::current_path(f.dir);
+    SourceManager original;
+    original.enableSnapshotRecording();
+    for (int group = 0; group < 4; group++) {
+        fs::create_directories(f.dir / "first" / std::to_string(group));
+        fs::create_directories(f.dir / "second" / std::to_string(group));
+    }
+    for (int i = 0; i < 128; i++) {
+        auto suffix = std::to_string(i % 4) + "/a" + std::to_string(i) + ".sv";
+        f.write("first/" + suffix, "module a; endmodule\n");
+        f.write("second/" + suffix, "module a; endmodule\n");
+        REQUIRE(original.readSource(f.dir / "first" / suffix));
+    }
+    REQUIRE(!original.readSource(f.dir / "first/0/missing.sv"));
+    CHECK_FALSE(original.sourceWitnessFailure({}));
+    SECTION("shared parent becomes a symlink to equal source bytes") {
+        fs::rename(f.dir / "first/0", f.dir / "first/saved");
+        fs::create_directory_symlink(f.dir / "second/0", f.dir / "first/0");
+        CHECK(original.sourceWitnessFailure({}));
+    }
+    SECTION("one ordinary leaf becomes a symlink to equal source bytes") {
+        fs::remove(f.dir / "first/0/a0.sv");
+        fs::create_symlink(f.dir / "second/0/a0.sv", f.dir / "first/0/a0.sv");
+        CHECK(original.sourceWitnessFailure({}));
+    }
+    SECTION("case-only leaf rename follows native canonical identity") {
+        const auto before = fs::weakly_canonical(f.dir / "first/0/a0.sv");
+        fs::rename(f.dir / "first/0/a0.sv", f.dir / "first/0/A0.sv");
+        const bool changed = fs::weakly_canonical(f.dir / "first/0/a0.sv") != before ||
+                             !fs::is_regular_file(f.dir / "first/0/a0.sv");
+        CHECK(bool(original.sourceWitnessFailure({})) == changed);
+    }
+    SECTION("previous failed lookup becomes readable") {
+        f.write("first/0/missing.sv", "module present; endmodule\n");
+        CHECK(original.sourceWitnessFailure({}));
+    }
+    SECTION("cancellation throughout a large witness leaves it reusable") {
+        int totalChecks = 0;
+        CHECK_FALSE(original.sourceWitnessFailure({}, [&] { ++totalChecks; }));
+        REQUIRE(totalChecks > 30);
+        for (const int stop : {1, totalChecks / 2, totalChecks - 15, totalChecks - 2}) {
+            int checks = 0;
+            CHECK_THROWS_AS(original.sourceWitnessFailure({},
+                                                          [&] {
+                                                              if (++checks == stop)
+                                                                  throw std::runtime_error(
+                                                                      "cancel alias witness");
+                                                          }),
+                            std::runtime_error);
+            CHECK_FALSE(original.sourceWitnessFailure({}));
+        }
+        f.write("first/3/a127.sv", "module b; endmodule\n");
+        CHECK(original.sourceWitnessFailure({}));
+    }
+}
+
+TEST_CASE("Strict source snapshots freeze reads, aliases, misses and display context") {
+    SnapshotFixture f;
+    f.write("root.sv",
+            "`include \"header.svh\"\nmodule m; initial $display(`__FILE__); endmodule\n");
+    f.write("second/header.svh", "`line 51 \"virtual.sv\" 0\nBAD SYNTAX\n");
+    fs::create_directory_symlink(f.dir / "second", f.dir / "alias");
+    fs::current_path(f.dir);
+    SourceManager original;
+    original.enableSnapshotRecording();
+    REQUIRE(!original.addUserDirectories("first"));
+    REQUIRE(!original.addUserDirectories("alias"));
+    auto root = original.readSource("root.sv");
+    REQUIRE(root);
+    auto tree = SyntaxTree::fromBuffer(*root, original);
+    auto before = DiagnosticEngine::reportAll(original, tree->diagnostics());
+    REQUIRE(!before.empty());
+    // A cache hit through a symlink/.. alias must still record the raw spelling.
+    auto alias = original.readSource("alias/../second/header.svh");
+    REQUIRE(alias);
+    auto ids = original.getAllBuffers();
+    auto snapshot = original.captureSnapshot(ids);
+    auto rootId = snapshot.graphFileIds.front();
