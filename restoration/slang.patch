+bool SourceManager::tryUpdateSnapshot(const SourceSnapshot& snapshot,
+                                      std::span<const BufferID> retained) {
+    // Reuse fresh-load validation without changing its strict public contract.
+    SourceManager next;
+    next.loadSnapshot(snapshot);
+    std::unique_lock<std::shared_mutex> includeLock(includeDirMutex);
+    std::unique_lock<std::shared_mutex> lock(mutex);
+    auto decline = [](const char* reason) {
+        if (auto* path = std::getenv("SLANG_UVM_WORKER_CACHE_TRACE"))
+            if (auto* file = std::fopen(path, "a")) {
+                std::fprintf(file, "%ld\tsnapshot-%s\n", long(OS::getpid()), reason);
+                std::fclose(file);
+            }
+        return false;
+    };
+    if (!snapshotReplay || snapshotGeneratedSequenceActive || snapshotIncompleteFlag ||
+        retained.empty())
+        return decline("not-idle");
+    if (snapshotCwd != next.snapshotCwd || disableProximatePaths != next.disableProximatePaths ||
+        disableLocalIncludes != next.disableLocalIncludes || incDirFirst != next.incDirFirst)
+        return decline("settings");
+    if (systemDirectories != next.systemDirectories || userDirectories != next.userDirectories)
+        return decline("include-directories");
+    if (snapshotLookups.size() != next.snapshotLookups.size())
+        return decline("lookup-size");
+    if (snapshotHeaderRequests.size() != next.snapshotHeaderRequests.size())
+        return decline("header-size");
+    for (auto& request : snapshotHeaderRequests)
+        if (!next.snapshotHeaderRequests.contains(request))
+            return decline("header-topology");
+    auto sameIdentity = [](const FileData& a, const FileData& b) {
+        return a.fullPath == b.fullPath && a.name == b.name && *a.directory == *b.directory;
+    };
+    for (auto& [path, value] : snapshotLookups) {
+        auto it = next.snapshotLookups.find(path);
+        if (it == next.snapshotLookups.end() || value.second != it->second.second ||
+            bool(value.first) != bool(it->second.first) ||
+            (value.first && !sameIdentity(*value.first, *it->second.first)))
+            return decline("lookup-identity");
+    }
+    flat_hash_map<std::string, std::shared_ptr<FileData>> keep;
+    for (auto id : retained) {
+        auto info = getFileInfo(id, lock);
+        if (!info || !info->data || info->data->isStale || info->library ||
+            info->hasExternalDirectives)
+            return decline("retained-id");
+        auto path = getU8Str(info->data->fullPath);
+        // Unrelated parses can add unnamed generated files to the recording.
+        // Only explicitly retained files carry state into this next parse.
+        if (snapshotGeneratedPaths.contains(path) != next.snapshotGeneratedPaths.contains(path))
+            return decline("retained-generated-identity");
+        auto found = next.lookupCache.find(path);
+        if (found == next.lookupCache.end() || !found->second.first ||
+            !sameIdentity(*info->data, *found->second.first) ||
+            info->data->mem != found->second.first->mem)
