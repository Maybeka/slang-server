+    result->prefixState->extraSourceBytes = ownerSources;
+    if (consumeSuffix && suffix->prefixState && suffix->prefixState->checkpoint &&
+        suffix->prefixState->inheritedMacroOwner == prefix) {
+        // Move the capture with the donated arena. Preparing a separate view
+        // before this handoff would retain the suffix and force a full clone.
+        auto checkpoint = std::move(*suffix->prefixState->checkpoint);
+        std::vector<BufferID> ids;
+        for (auto id : prefix->getSourceBufferIds())
+            if (isRoot(id))
+                ids.push_back(id);
+        checkpoint.roots.insert(checkpoint.roots.begin(), ids.begin(), ids.end());
