+    auto result = new SyntaxTree(owner->rootNode, owner->library, sm, std::move(arena),
+                                 Diagnostics(owner->diagnosticsBuffer),
+                                 ParserMetadata(owner->metadata),
+                                 PreprocessorMetadata(owner->preprocessorMetadata),
+                                 owner->options_);
