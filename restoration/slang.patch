+                    for (const auto variable : instance.localVars) {
+                        if (!isLocal(*variable) || !isFixedIntegralType(variable->getType())) {
+                            reject("assertion-local-variable-context", variable->name);
+                            return;
+                        }
+                        variable->visit(visitor);
+                    }
+                    // Sequence/property wrapper types are not runtime values.
+                    // Audit their complete expanded clock, disable and body
+                    // expressions through the normal visitor instead.
+                    visitor.visitDefault(node);
+                    return;
+                }
+                if (node.kind == ExpressionKind::NewClass && node.type->isVoid() &&
+                    node.template as<NewClassExpression>().isSuperClass) {
+                    // super.new is a void wrapper, not a value. Its actual
+                    // constructor call and every argument still pass through
+                    // the ordinary closed-function and dependency checks.
+                    visitor.visitDefault(node);
+                    return;
+                }
+                if (node.kind == ExpressionKind::Call) {
+                    const auto& call = node.template as<CallExpression>();
+                    if (diagnosticCall(call) || runtimeFormatCall(call) ||
+                        localScopeRandomizeCall(call) ||
+                        localContainerCall(call) || localStringCall(call) || fixedCoverageCall(call) ||
+                        (call.isSystemCall() && !call.thisClass() &&
+                         call.getKnownSystemName() == parsing::KnownSystemName::Cast &&
+                         call.arguments().size() == 2 &&
+                         isLocal(std::get<1>(call.subroutine).scope->asSymbol()))) {
+                        visitor.visitDefault(node);
+                        return;
+                    }
+                    if (!(call.isSystemCall() ? fixedSystemCall(call)
+                                              : (closedFunction(*std::get<0>(call.subroutine)) ||
+                                                 fixedForeignCall(*std::get<0>(call.subroutine))))) {
+                        reject("unproven-call", call.getSubroutineName());
+                        return;
+                    }
+                    if (!call.isSystemCall()) {
+                        const auto& function = *std::get<0>(call.subroutine);
+                        // The immutable package owns this function's bound graph.
+                        // Only the call use belongs to this retained body; copying
+                        // the package's aggregate usage would leak old callers.
+                        if (!isLocal(function))
+                            if (auto syntax = function.getSyntax())
+                                certificate.references[syntax].first = true;
+                        if (function.getReturnType().isVoid()) {
+                            visitor.visitDefault(node);
+                            return;
+                        }
+                    }
+                }
+                if (node.kind == ExpressionKind::Streaming) {
+                    const auto& stream = node.template as<StreamingConcatenationExpression>();
+                    // The wrapper has void type. Its operands / selections are
+                    // audited here; the native binder separately records the
+                    // slice-size expression before it is folded to a width.
+                    if (!stream.isFixedSize()) {
+                        reject("dynamic-streaming-size");
+                        return;
+                    }
+                    visitor.visitDefault(node);
+                    return;
+                }
+                if (node.kind == ExpressionKind::StringLiteral)
+                    return; // immutable literal data
+                if (node.kind == ExpressionKind::NullLiteral ||
+                    node.kind == ExpressionKind::UnboundedLiteral ||
+                    node.kind == ExpressionKind::EmptyArgument)
+                    return;
+                if (node.kind == ExpressionKind::ValueRange ||
+                    node.kind == ExpressionKind::Dist ||
+                    (node.kind == ExpressionKind::Replication && node.type->isVoid())) {
+                    // These constraint wrappers deliberately have void type.
+                    // Audit all bounds, items and distribution weights; only
+                    // their bindings are retained, never a randomized result.
+                    visitor.visitDefault(node);
+                    return;
+                }
+                if (node.kind == ExpressionKind::TypeReference) {
+                    if (!isFixedIntegralType(
+                            node.template as<TypeReferenceExpression>().targetType))
+                        reject("type-reference-dependency");
+                    return;
+                }
+                if (node.kind == ExpressionKind::HierarchicalValue) {
+                    const auto& ref = node.template as<HierarchicalValueExpression>().ref;
+                    if (!ref.target || !isLocal(*ref.target) || ref.isUpward() ||
+                        ref.isViaIfacePort() ||
+                        std::ranges::any_of(ref.path, [&](const auto& element) {
+                            return !isLocal(*element.symbol);
+                        })) {
+                        reject("outside-hierarchy",
+                               ref.target ? ref.target->getHierarchicalPath() : "missing");
+                        return;
+                    }
+                }
+                if (node.kind == ExpressionKind::ArbitrarySymbol) {
+                    const auto& ref = node.template as<ArbitrarySymbolExpression>();
+                    const auto vif = node.type->getCanonicalType().template as_if<VirtualInterfaceType>();
+                    if (!vif || !vif->isRealIface || ref.symbol->kind != SymbolKind::Instance ||
+                        ref.symbol != &vif->iface || !isLocal(*ref.symbol) ||
+                        ref.hierRef.isUpward() || ref.hierRef.isViaIfacePort() ||
+                        std::ranges::any_of(ref.hierRef.path, [&](const auto& element) {
+                            return !isLocal(*element.symbol);
+                        }) || !isFixedBodyValueType(*node.type, true))
+                        reject("outside-interface-handle");
+                    return;
+                }
+                if (!isFixedBodyValueType(*node.type, true)) {
+                    reject("expression-kind-or-type",
+                           fmt::format("{} / {}", toString(node.kind),
+                                       toString(node.type->getCanonicalType().kind)));
+                    return;
+                }
+                if (auto reference = node.getSymbolReference(/* allowPacked */ false);
+                    reference && !isLocal(*reference)) {
+                    auto scope = reference->getParentScope();
+                    const bool fixedRuntimeVariable = isFixedRuntimeBinding(*reference);
+                    if (fixedRuntimeVariable && !completeBodyReferenceTracking) {
+                        certificate.requiresFreshOwner = true;
+                        reject("fixed-reference-tracking", reference->name);
+                        return;
+                    }
+                    if (!scope || !isFixedCompilation(scope->getCompilation()) ||
+                        (reference->kind != SymbolKind::Parameter &&
+                         reference->kind != SymbolKind::EnumValue && !fixedRuntimeVariable)) {
+                        reject("outside-expression-reference", reference->name);
+                        return;
+                    }
+                    // A retained package / class variable's binding is fixed,
+                    // not its runtime value. Complete cross-reference tracking below replays the
+                    // actual subtree reads / writes without taking aggregate
+                    // usage from unrelated callers. Constants are simple reads.
+                    if (!fixedRuntimeVariable)
+                        if (auto syntax = reference->getSyntax())
+                            certificate.references[syntax].first = true;
+                }
+            }
+            if constexpr (std::same_as<T, ParameterSymbol>) {
+                if (!node.getValue().isInteger()) {
+                    size_t storageBytes = 0;
+                    // Finite integral arrays have an owned deep value. Their
+                    // dimensions, nominal element types and actual values must
+                    // also match at import, including ordinary root overrides.
+                    // Audit defaults and internal initializers below as for
+                    // scalar parameters; an outside override is detached only
+                    // after the complete subtree certificate succeeds.
+                    if (!fixedArrayConstant(fixedArrayConstant, node.getType(), node.getValue(),
+                                            storageBytes)) {
+                        reject("noninteger-parameter", node.name);
+                        return;
+                    }
+                    certificate.constantStorageBytes += storageBytes;
+                }
+                // A localparam (or a parameter inside this retained subtree)
+                // can query a local signal's fixed type without reading its
+                // runtime value. Keep the bound operand in the normal graph
+                // audit, but distinguish it from evaluated initializer inputs.
+                // Public root defaults still have to bind in parameter-only
+                // mode and must not depend on later ports or members.
+                const auto parameterBody = node.getParentScope()->getContainingInstance();
+                const bool allowTypeQuery = node.isLocalParam() || parameterBody != &retained;
+                auto fixedTypeQuery = [&](const CallExpression& call) {
+                    if (!allowTypeQuery || !fixedSystemCall(call) || call.arguments().empty() ||
+                        !call.arguments()[0]->type->isFixedSize() ||
+                        !isFixedIntegralType(*call.arguments()[0]->type))
+                        return false;
+                    using parsing::KnownSystemName;
+                    switch (call.getKnownSystemName()) {
+                        case KnownSystemName::Bits:
+                        case KnownSystemName::Low:
+                        case KnownSystemName::High:
+                        case KnownSystemName::Left:
+                        case KnownSystemName::Right:
+                        case KnownSystemName::Size:
+                        case KnownSystemName::Increment:
+                        case KnownSystemName::Dimensions:
+                        case KnownSystemName::UnpackedDimensions:
+                            return std::get<1>(call.subroutine).subroutine->isArgUnevaluated(0) &&
+                                   call.arguments()[0]->syntax;
+                        default:
+                            return false;
+                    }
+                };
+                flat_hash_set<const SyntaxNode*> typeQuerySyntax;
+                SmallVector<const Expression*, 8> queryExpressions;
+                auto queries = makeVisitor([&](auto& visitor, const auto& expression) {
+                    using E = std::remove_cvref_t<decltype(expression)>;
+                    if constexpr (std::same_as<E, CallExpression>) {
+                        if (fixedTypeQuery(expression)) {
+                            auto syntax = makeSyntaxVisitor([&](auto& self, const auto& part) {
+                                typeQuerySyntax.emplace(&part);
+                                self.visitDefault(part);
+                            });
+                            expression.arguments()[0]->syntax->visit(syntax);
+                        }
+                    }
+                    if constexpr (std::same_as<E, BinaryExpression>) {
+                        queryExpressions.push_back(&expression.right());
+                        queryExpressions.push_back(&expression.left());
+                    }
+                    else {
+                        visitor.visitDefault(expression);
+                    }
+                });
+                if (allowTypeQuery)
+                    if (auto initializer = node.getInitializer())
+                        queryExpressions.push_back(initializer);
+                while (!queryExpressions.empty()) {
+                    const auto expression = queryExpressions.back();
+                    queryExpressions.pop_back();
+                    expression->visit(queries);
+                }
+                // Even overridden defaults are name-checked natively. Replay
+                // their actual fixed declaration uses (functions, types, enums)
+                // so a body hit does not invent unused-package diagnostics.
+                auto sourceUsage = makeSyntaxVisitor([&](auto& syntaxVisitor, const auto& syntax) {
+                    using S = std::remove_cvref_t<decltype(syntax)>;
+                    if constexpr (std::same_as<S, AssignmentPatternItemSyntax>) {
+                        // Named pattern keys are field metadata, not value names.
+                        syntax.expr->visit(syntaxVisitor);
+                    }
+                    else if constexpr (std::derived_from<S, NameSyntax>) {
+                        ASTContext context(*node.getParentScope(), LookupLocation::before(node));
+                        LookupResult result;
+                        Lookup::name(syntax, context, LookupFlags::ForceHierarchical, result);
+                        if (auto symbol = result.found) {
+                            auto scope = symbol->getParentScope();
+                            const auto value = symbol->template as_if<ValueSymbol>();
+                            const bool localType = typeQuerySyntax.contains(&syntax) &&
+                                                   isLocal(*symbol) && value &&
+                                                   isFixedIntegralType(value->getType());
+                            if (localType || (isLocal(*symbol) &&
+                                 (symbol->kind == SymbolKind::Parameter ||
+                                  symbol->kind == SymbolKind::TypeParameter ||
+                                  (symbol->kind == SymbolKind::TypeAlias &&
+                                   (isFixedInstanceBodyTypeArgument(symbol->as<Type>(), retained) ||
+                                    (closedClasses.contains(scope) &&
+                                     isFixedIntegralType(symbol->as<Type>())))))) ||
+                                (scope && isFixedCompilation(scope->getCompilation()))) {
+                                // The symbol audit records the native read /
+                                // write flags for type-only operands; do not
+                                // manufacture a value read for this query.
+                                if (!localType)
+                                    if (auto declaration = symbol->getSyntax())
+                                        certificate.references[declaration].first = true;
+                            }
+                            else {
+                                reject("parameter-default-dependency", symbol->name);
+                            }
+                        }
+                        for (const auto& selector : result.selectors)
+                            if (auto selection = std::get_if<0>(&selector))
+                                (*selection)->visit(syntaxVisitor);
+                    }
+                    else {
+                        syntaxVisitor.visitDefault(syntax);
+                    }
+                });
+                if (auto syntax = node.isOverridden()
+                                      ? node.defaultValSyntax
+                                      : node.getDeclaredType()->getInitializerSyntax())
+                    syntax->visit(sourceUsage);
+                // Overrides are independently evaluated in the current parent;
+                // only their immutable value enters the retained body signature.
+                if (!node.isOverridden() || parameterBody != &retained) {
+                    SmallVector<const Expression*, 8> pendingInitializers;
+                    auto probe = makeVisitor([&](auto& inner, const auto& expression) {
+                        using E = std::remove_cvref_t<decltype(expression)>;
+                        if constexpr (std::same_as<E, CallExpression>) {
+                            if (fixedTypeQuery(expression)) {
+                                pendingExpressions.push_back(expression.arguments()[0]);
+                                for (auto argument : expression.arguments().subspan(1))
+                                    pendingInitializers.push_back(argument);
+                                return;
+                            }
+                        }
+                        if constexpr (std::derived_from<E, Expression>) {
+                            if (auto reference = expression.getSymbolReference()) {
+                                auto scope = reference->getParentScope();
+                                if (isLocal(*reference) && reference->kind != SymbolKind::Parameter)
+                                    reject("parameter-dependency");
+                                else if (!isLocal(*reference) && scope &&
+                                         std::ranges::none_of(importedCompilations,
+                                                              [&](const auto& imported) {
+                                                                  return imported.get() ==
+                                                                         &scope->getCompilation();
+                                                              }))
+                                    reject("parameter-dependency");
+                            }
+                        }
+                        if constexpr (std::same_as<E, BinaryExpression>) {
+                            pendingInitializers.push_back(&expression.right());
+                            pendingInitializers.push_back(&expression.left());
+                        }
+                        else {
+                            inner.visitDefault(expression);
+                        }
+                    });
+                    if (auto initializer = node.getInitializer())
+                        pendingInitializers.push_back(initializer);
+                    while (independent && !pendingInitializers.empty()) {
+                        const auto* expression = pendingInitializers.back();
+                        pendingInitializers.pop_back();
+                        expression->visit(probe);
+                    }
+                    // System type queries can erase the operand's value expression
+                    // from the bound tree ($bits(signal), for example). Inspect the
+                    // fixed declaration syntax as well before using a parameter-only
+                    // name map during the current consumer's signature evaluation.
+                    auto names = makeSyntaxVisitor([&](auto& syntaxVisitor, const auto& syntax) {
+                        using S = std::remove_cvref_t<decltype(syntax)>;
+                        if constexpr (std::same_as<S, IdentifierNameSyntax> ||
+                                      std::same_as<S, IdentifierSelectNameSyntax>) {
+                            if (typeQuerySyntax.contains(&syntax))
+                                return;
+                            if (auto symbol = node.getParentScope()->find(
+                                    syntax.identifier.valueText());
+                                symbol && symbol->kind != SymbolKind::Parameter &&
+                                symbol->kind != SymbolKind::TypeParameter)
+                                reject("parameter-deferred-name");
+                        }
+                        syntaxVisitor.visitDefault(syntax);
+                    });
+                    if (!node.isOverridden()) {
+                        if (auto syntax = node.getDeclaredType()->getInitializerSyntax())
+                            syntax->visit(names);
+                        if (auto syntax = node.getDeclaredType()->getTypeSyntax())
+                            syntax->visit(names);
+                    }
+                }
+                return;
+            }
+            if constexpr (std::same_as<T, BinaryExpression>) {
+                // Long associative expressions are common in RTL. Keep the
+                // audit of every operand, type and reference, without one large
+                // Expression::visit dispatch frame per binary-tree level.
+                pendingExpressions.push_back(&node.right());
+                pendingExpressions.push_back(&node.left());
+            }
+            else {
+                visitor.visitDefault(node);
+            }
+        });
+        auto drainExpressions = [&] {
+            while (independent && !pendingExpressions.empty()) {
+                const auto* expression = pendingExpressions.back();
+                pendingExpressions.pop_back();
+                expression->visit(audit);
+            }
+        };
+        retained.visit(audit);
+        drainExpressions();
+        for (const auto& [scope, expression] : defaultDisableMap) {
+            if (isLocal(scope->asSymbol())) {
+                expression->visit(audit);
+                drainExpressions();
+                certificate.defaultDisables.emplace_back(scope, expression);
+            }
+        }
+        for (const auto& [scope, clocking] : defaultClockingMap)
+            if (isLocal(*scope))
+                certificate.defaultClockings.emplace_back(scope, clocking);
+        for (const auto& [scope, expression] : bodyElaborationControls)
+            if (isLocal(scope->asSymbol())) {
+                expression->visit(audit);
+                drainExpressions();
+            }
+        auto auditVirtualArguments = [&](const InstanceSymbol& instance) {
+            for (auto parameter : instance.body.getParameters()) {
+                const auto& symbol = parameter->symbol;
+                if (const auto value = symbol.as_if<ParameterSymbol>();
+                    value && value->isOverridden()) {
+                    if (auto expression = value->getInitializer())
+                        expression->visit(audit);
+                    if (auto syntax = value->getDeclaredType()->getInitializerSyntax())
+                        declarationNames(*syntax, *value, instance.getParentScope());
+                }
+                else if (const auto type = symbol.as_if<TypeParameterSymbol>();
+                         type && type->isOverridden()) {
+                    if (auto syntax = type->targetType.getTypeSyntax())
+                        declarationNames(*syntax, *type, instance.getParentScope());
+                }
+            }
+        };
+        size_t typeIndex = 0, prototypeIndex = 0, siteIndex = 0;
+        while (independent && (typeIndex < pendingTypes.size() ||
+                               prototypeIndex < pendingVirtualPrototypes.size() ||
+                               siteIndex < bodyVirtualIfaceSites.size())) {
+            if (typeIndex < pendingTypes.size())
+                pendingTypes[typeIndex++]->visit(audit);
+            else if (prototypeIndex < pendingVirtualPrototypes.size()) {
+                const auto* body = pendingVirtualPrototypes[prototypeIndex++];
+                auditVirtualArguments(*body->parentInstance);
+                body->visit(audit);
+            }
+            else {
+                const auto* instance = bodyVirtualIfaceSites[siteIndex++];
+                if (isLocal(*instance))
+                    auditVirtualArguments(*instance);
+            }
+            drainExpressions();
+        }
+        if (independent) {
+            // Visiting later children can bind port expressions that refer to
+            // declarations visited earlier. Snapshot their final local usage
+            // only after the complete subtree and its dependencies are bound.
+            for (const auto& [symbol, usage] : bodyReferenceStatus) {
+                if (isLocal(*symbol)) {
+                    if (auto syntax = symbol->getSyntax()) {
+                        auto& profile = certificate.references[syntax];
+                        profile.first |= usage.first;
+                        profile.second |= usage.second;
+                    }
+                }
+            }
+            for (const auto& [binding, usage] : bodyCrossReferences) {
+                if (!isLocal(binding.first->asSymbol()))
+                    continue;
+                auto targetScope = binding.second->getParentScope();
+                if (!isLocal(*binding.second) &&
+                    (!targetScope || !isFixedCompilation(targetScope->getCompilation())))
+                    continue;
+                if (auto syntax = binding.second->getSyntax()) {
+                    auto& profile = certificate.references[syntax];
+                    profile.first |= usage.first;
+                    profile.second |= usage.second;
+                }
+            }
+        }
+        for (const auto& [scope, definition] : bodyDefinitionSites)
+            if (isLocal(scope->asSymbol()))
+                certificate.instantiationSites.push_back(definition);
+        flat_hash_set<const DefinitionSymbol*> subtreeDefinitions{&retained.getDefinition()};
+        subtreeDefinitions.insert(virtualPrototypeDefinitions.begin(),
+                                   virtualPrototypeDefinitions.end());
+        for (auto body : certificate.descendants)
+            subtreeDefinitions.emplace(&body->getDefinition());
+        // Keep raw occurrences: producer coalescing has already discarded instance
+        // identity and counts, and must never be replayed in a different consumer.
+        auto fixedLocation = [&](SourceLocation location) {
+            if (!location)
+                return true;
+            // The frozen invocation owns the expanded code. Its spelling can
+            // reside in an included macro header outside any module declaration.
+            // Keep ordinary caller locations outside this boundary rejected.
+            location = sourceManager->getFullyExpandedLoc(location);
+            for (auto definition : subtreeDefinitions) {
+                auto range = definition->getSyntax()->sourceRange();
+                if (location.buffer() == range.start().buffer() &&
+                    location.offset() >= range.start().offset() &&
+                    location.offset() <= range.end().offset())
+                    return true;
+            }
+            for (auto type : certificate.classes)
+                if (auto syntax = type->getSyntax()) {
+                    const auto range = syntax->sourceRange();
+                    if (location.buffer() == range.start().buffer() &&
+                        location.offset() >= range.start().offset() &&
+                        location.offset() <= range.end().offset())
+                        return true;
+                }
+            return false;
+        };
+        auto fixedAssertionTargetError = [&](const Diagnostic& diagnostic) {
+            if (diagnostic.code != diag::ExpectedScopeOrAssert || !diagnostic.symbol)
+                return false;
+            const auto syntax = diagnostic.symbol->getSyntax();
+            if (!syntax)
+                return false;
+            bool literalTarget = false;
+            auto visitor = makeSyntaxVisitor([&](auto& self, const auto& node) {
+                using T = std::remove_cvref_t<decltype(node)>;
+                if constexpr (std::same_as<T, InvocationExpressionSyntax>) {
+                    if (node.left->kind != SyntaxKind::SystemName || !node.arguments ||
+                        node.arguments->parameters.size() != 2 || !node.attributes.empty())
+                        return;
+                    const auto name = node.left->template as<SystemNameSyntax>()
+                                          .systemIdentifier.valueText();
+                    if (name != "$asserton" && name != "$assertoff" && name != "$assertkill")
+                        return;
+                    auto argument = [&](size_t index) -> const ExpressionSyntax* {
+                        const auto ordered = node.arguments->parameters[index]
+                                                 ->template as_if<OrderedArgumentSyntax>();
+                        if (!ordered || ordered->expr->kind != SyntaxKind::SimplePropertyExpr)
+                            return nullptr;
+                        const auto& sequence = ordered->expr->template as<SimplePropertyExprSyntax>();
+                        const auto simple = sequence.expr->template as_if<SimpleSequenceExprSyntax>();
+                        return simple && !simple->repetition ? simple->expr : nullptr;
+                    };
+                    const auto level = argument(0), target = argument(1);
+                    // Native rejects a string literal as a scope target before
+                    // doing any hierarchy lookup. With a literal level as well,
+                    // this exact error cannot depend on a mutable caller. Keep
+                    // and replay it; other errors and dynamic arguments decline.
+                    if (level && target && level->kind == SyntaxKind::IntegerLiteralExpression &&
+                        target->kind == SyntaxKind::StringLiteralExpression &&
+                        target->sourceRange().start() == diagnostic.location)
+                        literalTarget = true;
+                }
+                else
+                    self.visitDefault(node);
+            });
+            syntax->visit(visitor);
+            return literalTarget;
+        };
+        auto fixedDiagnostic = [&](auto&& self, const Diagnostic& diagnostic) -> bool {
+            if ((diagnostic.isError() && !fixedAssertionTargetError(diagnostic)) || diagnostic.coalesceCount ||
+                !fixedLocation(diagnostic.location) ||
+                (diagnostic.symbol && !isLocal(*diagnostic.symbol)))
+                return false;
+            for (auto range : diagnostic.ranges)
+                if (!fixedLocation(range.start()) || !fixedLocation(range.end()))
+                    return false;
+            for (const auto& note : diagnostic.notes)
+                if (!self(self, note))
+                    return false;
+            return true;
+        };
+        diagMap.visitRaw([&](const Diagnostic& diagnostic) {
+            if (!independent)
+                return;
+            if (!diagnostic.symbol) {
+                reject("unscoped-semantic-diagnostic");
+                return;
+            }
+            if (!isLocal(*diagnostic.symbol))
+                return; // Outside root port / parameter connections are rebound.
+            if (!fixedDiagnostic(fixedDiagnostic, diagnostic)) {
+                if (std::getenv("SLANG_SCOPE_BODY_TRACE")) {
+                    Diagnostics one;
+                    one.push_back(diagnostic);
+                    auto text = DiagnosticEngine::reportAll(*sourceManager, one);
+                    std::replace(text.begin(), text.end(), '\n', ' ');
+                    fmt::print(stderr, "scope-body decline-diagnostic\t{}\t{}\n",
+                               retained.getHierarchicalPath(), text);
+                }
+                reject("mutable-diagnostic-context");
+                return;
+            }
+            certificate.diagnostics.push_back(diagnostic);
+        });
+
+        // Reference profiles contain only body-local binding origins. Current
+        // callers re-evaluate their outside uses; no old-consumer walk is needed.
+        certificate.independent = independent;
+    }
+    return certificate.independent;
+}
+
+bool Compilation::instanceBodyReuseRequiresFreshOwner(const InstanceBodySymbol& body) const {
+    auto found = bodyReuseCertificates.find(&body);
+    return found != bodyReuseCertificates.end() && !found->second->independent &&
+           found->second->requiresFreshOwner;
+}
+
+bool Compilation::hasUncertifiedInstanceBodyErrors() {
+    if (!isElaborated() || hasFatalErrors() ||
+        std::ranges::any_of(getParseDiagnostics(),
+                           [](const Diagnostic& diagnostic) { return diagnostic.isError(); }))
+        return true;
+    if (!hasIssuedErrors())
+        return false;
+    using Occurrence = std::tuple<DiagCode, SourceLocation, const Symbol*>;
+    flat_hash_set<Occurrence> certified;
+    for (const auto& [_, certificate] : bodyReuseCertificates)
+        if (certificate->independent)
+            for (const auto& diagnostic : certificate->diagnostics)
+                if (diagnostic.isError())
+                    certified.emplace(diagnostic.code, diagnostic.location, diagnostic.symbol);
+    // The compiler's error counter counts code/location groups, while coverage
+    // must account for every instance occurrence within each group.
+    flat_hash_set<std::tuple<DiagCode, SourceLocation>> errors;
+    bool unclaimed = false;
+    diagMap.visitRaw([&](const Diagnostic& diagnostic) {
+        if (diagnostic.isError()) {
+            errors.emplace(diagnostic.code, diagnostic.location);
+            unclaimed |= !certified.contains(
+                Occurrence{diagnostic.code, diagnostic.location, diagnostic.symbol});
+        }
+    });
+    return unclaimed || errors.size() != numErrors;
+}
+
+bool Compilation::hasMatchingInstanceBodyParameters(const InstanceBodySymbol& retained,
+                                                    const InstanceBodySymbol& target) const {
+    if (&target.getCompilation() != this || retained.parameters.size() != target.parameters.size())
+        return false;
+    // Reentrant default-parameter lookups see the already constructed parameter
+    // declarations, without elaborating ports / members or escaping an index.
+    const auto previousMode = target.parameterLookupMode;
+    target.parameterLookupMode = true;
+    auto restore = ScopeGuard([&] { target.parameterLookupMode = previousMode; });
+    const auto& provider = retained.getCompilation();
+    const auto proof = provider.bodyReuseCertificates.find(&retained);
+    const bool certified = proof != provider.bodyReuseCertificates.end() &&
+                           proof->second->independent &&
+                           &retained.getDefinition() == &target.getDefinition();
+    auto origin = [](const Symbol& x, const Symbol& y) {
+        if (x.isType() && y.isType()) {
+            const auto& xt = x.as<Type>();
+            const auto& yt = y.as<Type>();
+            auto xs = xt.getParentScope(), ys = yt.getParentScope();
+            if (xs && ys) {
+                const auto& xc = xs->getCompilation();
+                const auto& yc = ys->getCompilation();
+                if (xc.fixedBodyTypeOrigins.contains(&xt)) {
+                    auto key = xc.instanceBodyTypeOrigin(xt);
+                    if (!key.empty() && key == yc.instanceBodyTypeOrigin(yt))
+                        return true;
+                }
+            }
+        }
+        if (!x.getSyntax() || x.getSyntax() != y.getSyntax() || x.name != y.name)
+            return false;
+        auto xs = x.getParentScope();
+        auto ys = y.getParentScope();
+        auto xb = xs ? xs->getContainingInstance() : nullptr;
+        auto yb = ys ? ys->getContainingInstance() : nullptr;
+        return xb && yb && &xb->getDefinition() == &yb->getDefinition() &&
+               xb->getHierarchicalPath() == yb->getHierarchicalPath();
+    };
+    auto sameType = [&](auto&& self, const Type& x, const Type& y) -> bool {
+        if (&x == &y)
+            return true;
+        auto transparent = [](const Type& type) {
+            auto scope = type.getParentScope();
+            auto view = scope ? scope->getCompilation().getInstanceBodyTypePresentation(type)
+                              : nullptr;
+            return view && view->transparent;
+        };
+        if (x.kind == SymbolKind::TypeAlias && transparent(x))
+            return self(self, x.as<TypeAliasType>().targetType.getType(), y);
+        if (y.kind == SymbolKind::TypeAlias && transparent(y))
+            return self(self, x, y.as<TypeAliasType>().targetType.getType());
+        if (x.kind != y.kind)
+            return false;
+        if (x.kind == SymbolKind::TypeAlias) {
+            if (!origin(x, y))
+                return false;
+            return self(self, x.as<TypeAliasType>().targetType.getType(),
+                        y.as<TypeAliasType>().targetType.getType());
+        }
+        if (x.kind == SymbolKind::FixedSizeUnpackedArrayType)
+            return x.as<FixedSizeUnpackedArrayType>().range ==
+                       y.as<FixedSizeUnpackedArrayType>().range &&
+                   self(self, *x.getArrayElementType(), *y.getArrayElementType());
+        if (x.isString())
+            return y.isString();
+        if (!x.isIntegral() || !y.isIntegral() || x.getBitWidth() != y.getBitWidth() ||
+            x.isSigned() != y.isSigned() || x.isFourState() != y.isFourState())
+            return false;
+        if (x.kind == SymbolKind::PackedArrayType)
+            return x.as<PackedArrayType>().range == y.as<PackedArrayType>().range &&
+                   self(self, *x.getArrayElementType(), *y.getArrayElementType());
+        if (x.kind == SymbolKind::EnumType) {
+            if (!origin(x, y))
+                return false;
+            const auto& a = x.as<EnumType>();
+            const auto& b = y.as<EnumType>();
+            if (!self(self, a.baseType, b.baseType))
+                return false;
+            auto av = a.values();
+            auto bv = b.values();
+            auto ai = av.begin();
+            auto bi = bv.begin();
+            for (; ai != av.end() && bi != bv.end(); ++ai, ++bi)
+                if (ai->name != bi->name || ai->getValue() != bi->getValue())
+                    return false;
+            return ai == av.end() && bi == bv.end();
+        }
+        if (x.kind == SymbolKind::PackedStructType || x.kind == SymbolKind::PackedUnionType) {
+            if (!origin(x, y))
+                return false;
+            auto fields = [](const Type& t) -> const Scope& {
+                return t.kind == SymbolKind::PackedStructType
+                           ? static_cast<const Scope&>(t.as<PackedStructType>())
+                           : static_cast<const Scope&>(t.as<PackedUnionType>());
+            };
+            auto av = fields(x).template membersOfType<FieldSymbol>();
+            auto bv = fields(y).template membersOfType<FieldSymbol>();
+            auto ai = av.begin();
+            auto bi = bv.begin();
+            for (; ai != av.end() && bi != bv.end(); ++ai, ++bi)
+                if (ai->name != bi->name || !self(self, ai->getType(), bi->getType()))
+                    return false;
+            return ai == av.end() && bi == bv.end();
+        }
+        return x.name == y.name && x.isMatching(y);
+    };
+    bool preparedEnums = false;
+    for (size_t i = 0; i < target.parameters.size(); ++i) {
+        const auto& left = retained.parameters[i]->symbol;
+        const auto& right = target.parameters[i]->symbol;
+        if (left.kind != right.kind)
+            return false;
+        // A certified localparam is derived entirely from the fixed declaration,
+        // closed type dependencies and the public parameters checked below. It
+        // cannot be overridden. Rebinding it could require ports / members while
+        // this lookup must remain reentrant and parameter-only.
+        if (certified && retained.parameters[i]->isLocalParam() &&
+            target.parameters[i]->isLocalParam() && left.getSyntax() &&
+            left.getSyntax() == right.getSyntax() && left.name == right.name)
+            continue;
+        if (left.kind == SymbolKind::TypeParameter) {
+            if (!preparedEnums) {
+                target.elaborate(); // enum previews only while parameterLookupMode is set
+                preparedEnums = true;
+            }
+            const auto& a = left.as<TypeParameterSymbol>();
+            const auto& b = right.as<TypeParameterSymbol>();
+            const auto& at = a.targetType.getType();
+            const auto& bt = b.targetType.getType();
+            if (a.isOverridden() != b.isOverridden() || a.typeRestriction != b.typeRestriction ||
+                (!isFixedInstanceBodyTypeArgument(bt, target) &&
+                 !retained.getCompilation().fixedBodyTypeOrigins.contains(
+                     &at.getCanonicalType())) ||
+                !sameType(sameType, at, bt)) {
+                if (std::getenv("SLANG_SCOPE_BODY_TRACE")) {
+                    const auto& ac = at.getCanonicalType();
+                    const auto& bc = bt.getCanonicalType();
+                    auto as = ac.getParentScope(), bs = bc.getParentScope();
+                    fmt::print(stderr, "scope-body type-signature\t{}\t{} | {}\t{} | {}\n",
+                               left.name, at.toString(), bt.toString(),
+                               as ? as->getCompilation().instanceBodyTypeOrigin(ac) : "",
+                               bs ? bs->getCompilation().instanceBodyTypeOrigin(bc) : "");
+                }
+                return false;
+            }
+            continue;
+        }
+        if (left.kind != SymbolKind::Parameter)
+            return false;
+        const auto& a = left.as<ParameterSymbol>();
+        const auto& b = right.as<ParameterSymbol>();
+        const auto& at = a.getType();
+        const auto& bt = b.getType();
+        const bool scalar = at.isIntegral() && bt.isIntegral() && a.getValue().isInteger() &&
+                            b.getValue().isInteger();
+        const bool string = at.isString() && bt.isString() &&
+                            retainableStringConstant(a.getValue()) &&
+                            retainableStringConstant(b.getValue());
+        // Shape, nominal elements and every array element form the signature,
+        // whether the value came from a default or a current-parent override.
+        const bool fixedArray =
+            at.getCanonicalType().kind == SymbolKind::FixedSizeUnpackedArrayType &&
+            bt.getCanonicalType().kind == SymbolKind::FixedSizeUnpackedArrayType &&
+            isFixedInstanceBodyTypeArgument(bt, target) && a.getValue().isUnpacked() &&
+            b.getValue().isUnpacked();
+        if ((!scalar && !string && !fixedArray) || a.isLocalParam() != b.isLocalParam() ||
+            !sameType(sameType, at, bt) || a.isOverridden() != b.isOverridden() ||
+            a.getValue() != b.getValue() || a.isImplicitString({}) != b.isImplicitString({}))
+            return false;
+    }
+    return true;
+}
+
+void Compilation::detachRetainedParameterInitializers(InstanceBodySymbol& body) {
+    SLANG_ASSERT(&body.getCompilation() == this && !body.borrowedMembers &&
+                 bodyReuseCertificates.contains(&body));
+    for (auto parameter : body.parameters) {
+        if (parameter->symbol.kind != SymbolKind::Parameter)
+            continue;
+        auto& value = const_cast<ParameterSymbol&>(parameter->symbol.as<ParameterSymbol>());
+        if (value.isOverridden()) {
+            auto range = SourceRange(value.location, value.location + value.name.length());
+            auto ownedLiteral = [&](auto&& self, const Type& type,
+                                     const ConstantValue& constant) -> Expression* {
+                if (constant.isInteger())
+                    return emplace<IntegerLiteral>(*this, type, constant.integer(), false, range);
+                if (constant.isString()) {
+                    SLANG_ASSERT(retainableStringConstant(constant));
+                    const auto& value = constant.str();
+                    auto valueBytes = copyFrom<char>(std::span(value.data(), value.size()));
+                    const auto raw = quoteSVString(value);
+                    auto rawBytes = copyFrom<char>(std::span(raw.data(), raw.size()));
+                    auto integer = constant.convertToInt();
+                    auto& literalType = getType(integer.integer().getBitWidth(),
+                                                IntegralFlags::Unsigned);
+                    auto literal = emplace<StringLiteral>(
+                        literalType, std::string_view(valueBytes.data(), valueBytes.size()),
+                        std::string_view(rawBytes.data(), rawBytes.size()),
+                        *allocConstant(std::move(integer)), range);
+                    return emplace<ConversionExpression>(type, ConversionKind::Implicit, *literal,
+                                                          range);
+                }
+                const auto& array = type.getCanonicalType().as<FixedSizeUnpackedArrayType>();
+                SmallVector<const Expression*> elements;
+                for (const auto& element : std::get<ConstantValue::Elements>(constant.getVariant()))
+                    elements.push_back(self(self, array.elementType, element));
+                return emplace<SimpleAssignmentPatternExpression>(
+                    type, false, elements.copy(*this), range);
+            };
+            auto literal = ownedLiteral(ownedLiteral, value.getType(), value.getValue());
+            value.getDeclaredType()->setRetainedInitializer(*literal, value.location);
+        }
+    }
+}
+
+void Compilation::setInstanceBodyReuseHooks(
+    std::function<void(Compilation&, InstanceBodySymbol&)> lookup,
+    std::function<void(std::shared_ptr<Compilation>)> publish) {
+    if (finalized)
+        SLANG_THROW(std::logic_error("body reuse hooks must precede elaboration"));
+    if (lookup || publish)
+        enableInstanceBodyReferenceTracking();
+    bodyLookup = std::move(lookup);
+    bodyPublish = std::move(publish);
+}
+
+void Compilation::enableInstanceBodyReferenceTracking(bool complete) {
+    if (finalized)
+        SLANG_THROW(std::logic_error("reference tracking must precede elaboration"));
+    trackBodyReferences = true;
+    completeBodyReferenceTracking |= complete;
+}
+
+void Compilation::setInstanceBodyCacheContext(bool inheritedBindTarget) {
+    if (finalized || options.topModules.size() != 1 || !options.paramOverrides.empty())
+        SLANG_THROW(
+            std::logic_error("body cache context requires one explicit top without CLI overrides"));
+    instanceBodyCacheContext = true;
+    instanceBodyCacheBindTarget = inheritedBindTarget;
+}
+
+void Compilation::tryReuseInstanceBodyOnLookup(InstanceBodySymbol& body) {
+    if (bodyLookup && !body.membersExposed && !body.borrowedMembers)
+        bodyLookup(*this, body);
+}
+
+void Compilation::offerInstanceBodies(std::shared_ptr<Compilation> owner) {
+    if (bodyPublish && !bodiesPublished && owner.get() == this && isElaborated() && !isFrozen()) {
+        bodiesPublished = true;
+        bodyPublish(std::move(owner));
+    }
+}
+
+size_t Compilation::getInstanceBodyReuseMemoryUsage() const {
+    // Charge reserved hash slots and control / alignment space, not just live entries.
+    auto mapBytes = [](const auto& map) {
+        using Map = std::remove_cvref_t<decltype(map)>;
+        return map.bucket_count() * (sizeof(typename Map::value_type) + 16);
+    };
+    size_t result = mapBytes(bodyReferenceStatus) + mapBytes(bodyCrossReferences) +
+                    mapBytes(bodyReuseCertificates) + mapBytes(importedBodyCanonicalInstances) +
+                    mapBytes(fixedBodyTypeOrigins) + mapBytes(importedBodyTypeIdentities) +
+                    mapBytes(fixedBodyTypePresentations) + mapBytes(forcedImportedWildcardScopes) +
+                    mapBytes(bodyVirtualIfaceProofs);
+    {
+        std::lock_guard lock(bodyDependencyMutex);
+        result += mapBytes(externalBodyDependencySyntax);
+    }
+    for (const auto& [_, display] : fixedBodyTypePresentations)
+        result += display.name.capacity() + display.scope.capacity() + 2;
+    for (const auto& [_, origin] : fixedBodyTypeOrigins)
+        result += origin.capacity() + 1;
+    result += bodyDefinitionSites.capacity() * sizeof(decltype(bodyDefinitionSites)::value_type);
+    result += bodyVirtualIfaceSites.capacity() * sizeof(const InstanceSymbol*);
+    result += importedVirtualIfaceOverrides.capacity() *
+              sizeof(std::unique_ptr<HierarchyOverrideNode>);
+    for (const auto& overrides : importedVirtualIfaceOverrides) {
+        result += sizeof(HierarchyOverrideNode) + mapBytes(overrides->paramOverrides) +
+                  mapBytes(overrides->childNodes) +
+                  overrides->binds.capacity() * sizeof(decltype(overrides->binds)::value_type);
+        for (const auto& [_, argument] : overrides->paramOverrides)
+            if (auto value = std::get_if<HierarchyOverrideNode::ValueParamOverride>(&argument))
+                result += fixedOverrideStorage(value->value).value_or(0);
+    }
+    result += bodyElaborationControls.capacity() *
+              sizeof(decltype(bodyElaborationControls)::value_type);
+    result += bodyReuseCertificates.size() * sizeof(BodyReuseCertificate);
+    for (const auto& [_, certificate] : bodyReuseCertificates) {
+        result += mapBytes(certificate->references);
+        result += certificate->constantStorageBytes;
+        result += certificate->descendants.capacity() * sizeof(const InstanceBodySymbol*);
+        result += certificate->classes.capacity() * sizeof(const Type*);
+        result += certificate->instantiationSites.capacity() * sizeof(const DefinitionSymbol*);
+        result += certificate->diagnostics.capacity() * sizeof(Diagnostic);
+        for (const auto& diagnostic : certificate->diagnostics)
+            result += retainedDiagnosticStorage(diagnostic);
+        result += certificate->defaultDisables.capacity() *
+                  sizeof(decltype(certificate->defaultDisables)::value_type);
+        result += certificate->defaultClockings.capacity() *
+                  sizeof(decltype(certificate->defaultClockings)::value_type);
+    }
+    result += importedBodyClasses.capacity() * sizeof(const Type*);
+    result += mapBytes(certifiedBodyClassStates);
+    for (const auto& [_, state] : certifiedBodyClassStates)
+        result += sizeof(detail::ClassSpecializationState) + mapBytes(state->instantiated) +
+                  mapBytes(state->uninstantiated);
+    return result;
+}
+
+const InstanceBodySymbol& Compilation::getCurrentInstanceBody(
+    const InstanceBodySymbol& body) const {
+    auto it = importedBodyFrames.find(&body);
+    return it == importedBodyFrames.end() ? body : *it->second;
+}
+
+bool Compilation::isImportedInstanceBody(const InstanceBodySymbol& body) const {
+    return importedBodyViews.contains(&body);
+}
+
+std::vector<std::string> Compilation::getImportedInstanceBodyPaths() const {
+    std::vector<std::string> result;
+    for (auto certificate : importedBodyCertificates)
+        result.push_back(certificate->root->getHierarchicalPath());
+    std::ranges::sort(result);
+    result.erase(std::unique(result.begin(), result.end()), result.end());
+    return result;
+}
+
+const InstanceBodySymbol* Compilation::getCanonicalInstanceBody(
+    const InstanceSymbol& instance) const {
+    if (auto found = importedBodyCanonicalInstances.find(&instance);
+        found != importedBodyCanonicalInstances.end())
+        return found->second;
+    return instance.getCanonicalBody();
+}
+
+void Compilation::noteDefinitionInstantiated(const DefinitionSymbol& definition,
+                                             const Scope* scope) {
+    if (trackBodyReferences && scope)
+        bodyDefinitionSites.emplace_back(scope, &definition);
+    if (importedDefinitions.contains(&definition))
+        ++importedDefinitionInstanceCounts[&definition];
+    else
+        definition.noteInstantiated();
+}
+
+size_t Compilation::getDefinitionInstanceCount(const DefinitionSymbol& definition) const {
+    if (bodyQueryContext)
+        return bodyQueryContext->getDefinitionInstanceCount(definition);
+    if (importedDefinitions.contains(&definition)) {
+        auto it = importedDefinitionInstanceCounts.find(&definition);
+        return it == importedDefinitionInstanceCounts.end() ? 0 : it->second;
+    }
+    return definition.getInstanceCount();
+}
+
+void Compilation::noteDefinitionBind(const DefinitionSymbol& definition,
+                                     const BindDirectiveInfo& info) {
+    SLANG_ASSERT(!isFrozen());
+    if (!importedDefinitions.contains(&definition)) {
+        const_cast<DefinitionSymbol&>(definition).bindDirectives.push_back(info);
+        return;
+    }
+    auto [it, inserted] = importedDefinitionBinds.try_emplace(&definition);
+    if (inserted)
+        it->second = definition.bindDirectives;
+    it->second.push_back(info);
+}
+
+std::span<const BindDirectiveInfo> Compilation::getDefinitionBinds(
+    const DefinitionSymbol& definition) const {
+    if (auto it = importedDefinitionBinds.find(&definition); it != importedDefinitionBinds.end())
+        return it->second;
+    return definition.bindDirectives;
+}
+
+detail::ClassSpecializationState& Compilation::getImportedClassState(
+    const GenericClassDefSymbol& symbol) {
+    auto& state = importedClassStates[&symbol];
+    if (!state)
+        state = std::make_unique<detail::ClassSpecializationState>();
+    return *state;
+}
+
+std::vector<const Type*> Compilation::getImportedClassSpecializations() const {
+    std::vector<const Type*> result = importedBodyClasses;
+    for (const auto& [_, state] : importedClassStates)
+        for (const auto& [key, type] : state->instantiated)
+            if (std::ranges::find(importedBodyClasses, type) == importedBodyClasses.end())
+                result.push_back(type);
+    return result;
+}
+
+const detail::ClassSpecializationState* Compilation::findRetainedBodyClassState(
+    const GenericClassDefSymbol& symbol) const {
+    if (bodyQueryContext && bodyQueryContext->isElaborated()) {
+        auto found = bodyQueryContext->importedClassStates.find(&symbol);
+        if (found != bodyQueryContext->importedClassStates.end())
+            return found->second.get();
+    }
+    return nullptr;
+}
+
+const Type* Compilation::findCertifiedBodyClass(const GenericClassDefSymbol& symbol,
+                                                const detail::ClassSpecializationKey& key,
+                                                bool uninstantiated) const {
+    for (const Compilation* context : {this, static_cast<const Compilation*>(bodyQueryContext.get())}) {
+        if (!context)
+            continue;
+        auto found = context->certifiedBodyClassStates.find(&symbol);
+        if (found == context->certifiedBodyClassStates.end())
+            continue;
+        const auto& cache = uninstantiated ? found->second->uninstantiated
+                                          : found->second->instantiated;
+        for (const auto& [existing, type] : cache)
+            if (key.matchesArguments(existing) && canReuseBodyClassSpecialization(*type))
+                return type;
+    }
+    return nullptr;
+}
+
+bool Compilation::canReuseBodyClassSpecialization(const Type& type) const {
+    if (!bodyQueryContext)
+        return true;
+    const auto* cls = type.as_if<ClassType>();
+    return !cls || cls->hasCompletedSemanticAnalysis();
+}
+
+void Compilation::addSyntaxTree(std::shared_ptr<SyntaxTree> tree, bool reuseImportedPackages) {
+    bodyBindContextCompatible.reset();
+    SLANG_ASSERT(!isFrozen());
+
+    if (!tree)
+        SLANG_THROW(std::invalid_argument("tree cannot be null"));
+
+    if (finalized)
+        SLANG_THROW(std::logic_error("The compilation has already been finalized"));
+
+    if (&tree->sourceManager() != sourceManager) {
+        if (!sourceManager)
+            sourceManager = &tree->sourceManager();
+        else {
+            SLANG_THROW(std::logic_error(
+                "All syntax trees added to the compilation must use the same source manager"));
+        }
+    }
+
+    auto lib = tree->getSourceLibrary();
+    if (lib) {
+        auto& entry = libraryNameMap[lib->name];
+        SLANG_ASSERT(entry == nullptr || entry == lib);
+        entry = lib;
+    }
+    else {
+        lib = defaultLibPtr;
+    }
+
+    const SyntaxNode& node = tree->root();
+    const SyntaxNode* topNode = &node;
+    while (topNode->parent)
+        topNode = topNode->parent;
+
+    auto unit = emplace<CompilationUnitSymbol>(*this, *lib);
+    unit->setSyntax(*topNode);
+    root->addMember(*unit);
+    compilationUnits.push_back(unit);
+
+    if (reuseImportedPackages && !importedUnitDeclarations.empty()) {
+        std::vector<const Symbol*> fixed;
+        for (const auto& [_, symbols] : importedUnitDeclarations)
+            fixed.insert(fixed.end(), symbols.begin(), symbols.end());
+        std::stable_sort(fixed.begin(), fixed.end(),
+                         [](auto a, auto b) { return a->getIndex() < b->getIndex(); });
+        for (auto symbol : fixed) {
+            Symbol* wrapper;
+            if (symbol->kind == SymbolKind::WildcardImport) {
+                auto import = emplace<WildcardImportSymbol>(
+                    symbol->as<WildcardImportSymbol>().packageName, symbol->location);
+                wrapper = import;
+                unit->addWildcardImport(*import);
+            }
+            else if (symbol->kind == SymbolKind::ExplicitImport) {
+                const auto& import = symbol->as<ExplicitImportSymbol>();
+                wrapper = emplace<ExplicitImportSymbol>(import.packageName, import.importName,
+                                                        import.location);
+            }
+            else {
+                wrapper = emplace<TransparentMemberSymbol>(*symbol);
+            }
+            if (auto syntax = symbol->getSyntax())
+                wrapper->setSyntax(*syntax);
+            if (auto attributes = attributeMap.find(symbol); attributes != attributeMap.end())
+                attributeMap.emplace(wrapper, attributes->second);
+            unit->addMember(*wrapper);
+        }
+    }
+
+    for (auto& [n, meta] : tree->getMetadata().nodeMeta) {
+        SyntaxMetadata result;
+        result.tree = tree.get();
+        result.defaultNetType = &getNetType(meta.defaultNetType);
+        result.timeScale = meta.timeScale;
+
+        switch (meta.unconnectedDrive) {
+            case TokenKind::Pull0Keyword:
+                result.unconnectedDrive = UnconnectedDrive::Pull0;
+                break;
+            case TokenKind::Pull1Keyword:
+                result.unconnectedDrive = UnconnectedDrive::Pull1;
+                break;
+            default:
+                result.unconnectedDrive = UnconnectedDrive::None;
+                break;
+        }
+
+        result.cellDefine = meta.cellDefine;
+
+        syntaxMetadata[n] = result;
+    }
+
+    for (auto& inst : tree->getMetadata().globalInstances)
+        globalInstantiations.emplace(inst->type.valueText());
+
+    auto addMember = [&](const SyntaxNode& member) {
+        if (reuseImportedPackages && !importedUnitDeclarations.empty()) {
+            auto original = importedUnitDeclarations.find(&member);
+            if (original == importedUnitDeclarations.end()) {
+                // Source views can reparse a provider. Match its fixed physical
+                // declaration, never a same-named declaration in another file.
+                auto location = sourceManager->getFullyExpandedLoc(
+                    member.getFirstToken().location());
+                const auto& path = sourceManager->getFullPath(location.buffer());
+                original = std::ranges::find_if(importedUnitDeclarations, [&](const auto& entry) {
+                    if (entry.first->kind != member.kind)
+                        return false;
+                    auto old = sourceManager->getFullyExpandedLoc(
+                        entry.first->getFirstToken().location());
+                    return !path.empty() && old.offset() == location.offset() &&
+                           sourceManager->getFullPath(old.buffer()) == path;
+                });
+            }
+            if (original != importedUnitDeclarations.end()) {
+                return;
+            }
+        }
+        if (reuseImportedPackages && member.kind == SyntaxKind::PackageDeclaration) {
+            auto& declaration = member.as<ModuleDeclarationSyntax>();
+            auto package = getPackage(declaration.header->name.valueText());
+            if (package && importedPackages.contains(package)) {
+                const auto* original = package->getSyntax();
+                auto path = sourceManager->getFullPath(
+                    sourceManager->getFullyExpandedLoc(declaration.header->name.location())
+                        .buffer());
+                // Editing a mixed root can retire its old buffer in the consumer.
+                // The retained package's namespace still owns that original location.
+                const auto* ownerSources = package->getCompilation().getSourceManager();
+                auto ownerPath = ownerSources->getFullPath(
+                    ownerSources->getFullyExpandedLoc(package->location).buffer());
+                if (original == &member || (!path.empty() && path == ownerPath))
+                    return;
+            }
+        }
+        unit->addMembers(member);
+    };
+    if (node.kind == SyntaxKind::CompilationUnit) {
+        for (auto member : node.as<CompilationUnitSyntax>().members)
+            addMember(*member);
+    }
+    else if (node.kind == SyntaxKind::LibraryMap) {
+        for (auto member : node.as<LibraryMapSyntax>().members)
+            unit->addMembers(*member);
+    }
