+        "`define LIB_VALUE 41\npackage uvm_pkg; int member; endpackage\n");
+    auto prefix = syntax::SyntaxTree::fromBuffersWithCheckpoint(std::vector{library}, owner);
+    Bag options;
+    options.set(syntax::PrecompiledUvmSyntax{prefix,
+        owner.getFullPath(library.id).parent_path(), owner.getFullPath(library.id), false});
+    SourceManager live;
+    live.inheritImmutablePrefix(owner.captureImmutablePrefix({}));
+    for (int edit = 0; edit < 8; ++edit) {
+        auto consumer = live.assignText("user" + std::to_string(edit) + ".sv",
+            "module user; localparam int N=`LIB_VALUE; endmodule\n");
+        auto tree = syntax::SyntaxTree::fromBuffers(std::vector{library, consumer}, live, options);
+        CHECK(&tree->sourceManager() == &live);
+        CHECK(tree->diagnostics().empty());
+        CHECK(tree->root().toString().find("41") != std::string::npos);
+    }
+    SourceManager unrelated;
+    auto other = unrelated.assignText("other.sv", "module other; endmodule\n");
+    CHECK_THROWS(syntax::SyntaxTree::fromBuffers(std::vector{other}, unrelated, options));
+}
