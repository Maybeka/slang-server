+void AnalysisManager::setProcedureReuse(std::shared_ptr<const AnalysisManager> baseline) {
+    if (sourceCompilation || reuseOwner || !baseline || !baseline->analysisComplete ||
+        !hasFlag(AnalysisFlags::RetainProcedureSummaries) ||
+        !baseline->hasFlag(AnalysisFlags::RetainProcedureSummaries) ||
+        baseline->customDFAProvider || customDFAProvider || baseline->reuseOwner ||
+        !baseline->subroutineReplacements.empty() || baseline->referenceUsageProvider ||
+        baseline->classViewConfigured || options.flags != baseline->options.flags ||
