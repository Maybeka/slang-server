+TEST_CASE("Diagnostic settings snapshots own global settings") {
+    Compilation initializeBuiltins;
+    DiagnosticEngine::SettingsSnapshot snapshot;
+    {
+        SourceManager sourceManager;
+        DiagnosticEngine engine(sourceManager);
+        engine.setSeverity(diag::ExpectedClosingQuote, DiagnosticSeverity::Warning);
+        engine.setBaselineSeverity(diag::UnknownSystemName, DiagnosticSeverity::Error);
+        engine.setMessage(diag::ExpectedClosingQuote, "snapshot message");
+        engine.setErrorLimit(3);
+        engine.setIgnoreAllWarnings(true);
+        engine.setIgnoreAllNotes(true);
+        engine.setWarningsAsErrors(true);
+        engine.setErrorsAsFatal(true);
+        engine.setFatalsAsErrors(true);
+        REQUIRE(!engine.addIgnorePaths(".../generated/..."));
+        REQUIRE(!engine.addIgnoreMacroPaths(".../macros/..."));
+        snapshot = engine.captureSettings();
+        engine.setMessage(diag::ExpectedClosingQuote, "changed after capture");
+        engine.clearMappings();
+    }
+
+    SourceManager freshSourceManager;
+    DiagnosticEngine replay(freshSourceManager);
+    replay.applySettings(snapshot);
+    CHECK(replay.getMessage(diag::ExpectedClosingQuote) == "snapshot message");
+    CHECK(replay.getSeverity(diag::ExpectedClosingQuote, {}) == DiagnosticSeverity::Warning);
+    CHECK(replay.getSeverity(diag::UnknownSystemName, {}) == DiagnosticSeverity::Error);
+    CHECK(replay.getSeverity(diag::RealLiteralUnderflow, {}) == DiagnosticSeverity::Ignored);
+    CHECK(replay.getSeverity(diag::NoteImportedFrom, {}) == DiagnosticSeverity::Ignored);
+    CHECK(replay.getSeverity(diag::DotOnType, {}) == DiagnosticSeverity::Fatal);
+    CHECK(replay.getNumErrors() == 0);
+    CHECK(replay.getNumWarnings() == 0);
+
+    auto copied = replay.captureSettings();
+    CHECK(copied.baselineSeverityTable.at(diag::UnknownSystemName) == DiagnosticSeverity::Error);
+    CHECK(copied.ignoreWarnPatterns == snapshot.ignoreWarnPatterns);
+    CHECK(copied.ignoreMacroWarnPatterns == snapshot.ignoreMacroWarnPatterns);
+    CHECK(copied.errorLimit == 3);
+    CHECK(copied.ignoreAllWarnings);
+    CHECK(copied.ignoreAllNotes);
+    CHECK(copied.warningsAsErrors);
+    CHECK(copied.errorsAsFatal);
+    CHECK(copied.fatalsAsErrors);
+    CHECK(copied.useBuiltinTypeFormatter);
+    CHECK(copied.useBuiltinSymbolPath);
+
+    // The replay formatter must not alias the process-wide mutable formatter.
+    DiagnosticEngine other(freshSourceManager);
+    CHECK(replay.getFormatters().at(SLANG_TYPEOF(const Type*)) !=
+          other.getFormatters().at(SLANG_TYPEOF(const Type*)));
+
+    // Subsequent warning options still consult the preserved baseline table.
+    REQUIRE(replay.setWarningOptions(std::vector{"none"s}).empty());
+    CHECK(replay.getSeverity(diag::UnknownSystemName, {}) == DiagnosticSeverity::Error);
+}
