+    std::vector<BufferID> ids;
+    auto isRoot = [&](BufferID id) { return !sm.getIncludedFrom(id).valid(); };
+    for (auto id : suffix->getSourceBufferIds())
+        if (isRoot(id))
+            ids.push_back(id);
+    for (auto id : prefix->getSourceBufferIds())
+        if (isRoot(id))
+            ids.push_back(id);
+    for (auto id : prefix->getSourceBufferIds())
+        if (!isRoot(id))
+            ids.push_back(id);
+    for (auto id : suffix->getSourceBufferIds())
+        if (!isRoot(id))
+            ids.push_back(id);
+    pp.sourceBufferIds = std::move(ids);
+    auto diagnostics = prefix->diagnosticsBuffer;
+    for (auto& d : suffix->diagnosticsBuffer)
+        diagnostics.push_back(d);
+    auto* result = new SyntaxTree(&root, prefix->library, sm, std::move(alloc),
+                                  std::move(diagnostics), std::move(metadata), std::move(pp),
+                                  prefix->options_);
+    result->isLibraryUnit = prefix->isLibraryUnit;
+    auto ownerBytes = prefix->getRetainedSyntaxBytes() + suffix->getRetainedSyntaxBytes();
+    auto ownerSources = prefix->getRetainedSourceBytes() + suffix->getRetainedSourceBytes();
+    result->prefixState = std::make_unique<PrefixState>();
+    result->prefixState->extraBytes = ownerBytes;
+    result->prefixState->extraSourceBytes = ownerSources;
+
+    // Metadata points into both original trees. Their arenas remain pinned to this tree only.
+    auto pins = sm.retainBuffers(result->getSourceBufferIds());
+    auto macroPins = sm.retainBuffers(result->getPredefineBufferIds());
+    return std::shared_ptr<SyntaxTree>(result, [prefix, suffix, pins = std::move(pins),
+                                                macroPins = std::move(macroPins)](SyntaxTree* p) {
+        delete p;
+    });
+}
 
