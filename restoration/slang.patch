+TEST_CASE("Donated suffix checkpoints retain their combined owner without a full clone",
+          "[source-snapshot][root-checkpoint][owned-suffix]") {
+    SourceManager sm;
+    auto fixed = sm.assignText("donated-base.sv", "`define N 3\npackage base; endpackage\n");
+    auto shared = sm.assignText("donated-shared.sv",
+                               "`pragma protect begin\npackage shared_pkg; class C; int field; "
+                               "endclass endpackage\n`pragma protect end\n`define N2 9\n");
+    auto user = sm.assignText("donated-user.sv",
+                              "module top; localparam int V=`N+`N2; endmodule\n");
+    auto base = SyntaxTree::fromBuffersWithCheckpoint(std::vector{fixed}, sm);
+    auto suffix = SyntaxTree::afterCachedPrefixWithCheckpoint(base, std::vector{shared, user}, 1);
+    const auto* parsedRoot = &suffix->root();
+    auto combined = SyntaxTree::withCachedPrefixOwnedSuffix(base, std::move(suffix));
+    CHECK_FALSE(suffix);
+    CHECK(&combined->root() == parsedRoot);
+    auto cached = SyntaxTree::preparedSourcePrefix(combined);
+    REQUIRE(cached);
+    REQUIRE(cached->isPrefixResumeSafe() == true);
+    REQUIRE(cached->root().as<CompilationUnitSyntax>().members.size() == 2);
+    std::weak_ptr<SyntaxTree> owner = combined;
+    combined.reset(); base.reset();
+    REQUIRE_FALSE(owner.expired());
+    const std::string currentText = "module top; shared_pkg::C c; localparam int V=`N+`N2+1; endmodule\n";
+    SmallVector<char> bytes(currentText.begin(), currentText.end());
+    bytes.push_back('\0');
+    auto current = sm.replaceBuffer(user.id, std::move(bytes));
+    for (auto id : cached->getSourceBufferIds())
+        CHECK(sm.isLatestData(id));
+    auto tail = SyntaxTree::afterCachedPrefix(cached, std::vector{current}, {});
+    auto final = SyntaxTree::withCachedPrefixOwnedSuffix(cached, std::move(tail));
+    auto native = SyntaxTree::fromBuffers(std::vector{fixed, shared, current}, sm);
+    {
+        Compilation actual, expected;
+        actual.addSyntaxTree(final);
+        expected.addSyntaxTree(native);
+        CHECK(actual.getAllDiagnostics().empty());
+        CHECK(expected.getAllDiagnostics().empty());
+        CHECK(actual.getRoot().topInstances.front()->body.find("V")
+                  ->as<ParameterSymbol>().getValue() ==
+              expected.getRoot().topInstances.front()->body.find("V")
+                  ->as<ParameterSymbol>().getValue());
+    }
+    final.reset(); cached.reset();
+    CHECK(owner.expired());
+}
