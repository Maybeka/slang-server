+TEST_CASE("Immutable location projection requires complete matching macro provenance",
+          "[source-namespace]") {
+    SourceManager original;
+    auto definition = original.assignText("definition.svh", "payload");
+    auto invocation = original.assignText("wrapper.sv", "invoke(arg)");
+    const SourceLocation def(definition.id, 0), site(invocation.id, 0);
+    auto body = original.createExpansionLoc(def, {site, site + 11}, "PAYLOAD");
+    auto arg = original.createArgExpansionLoc(site + 7, {body, body + 3});
+    auto nested = original.createExpansionLoc(arg, {arg, arg + 2}, "INNER");
+    auto prefix = original.captureImmutablePrefix(std::vector{definition.id, invocation.id});
+    SourceManager current;
+    current.inheritImmutablePrefix(prefix);
+    auto newDefinition = current.assignQueryText("definition.svh", "payload");
+    auto newInvocation = current.assignQueryText("wrapper.sv", "invoke(arg)");
+    const SourceLocation newDef(newDefinition.id, 0), newSite(newInvocation.id, 0);
+    auto newBody = current.createExpansionLoc(newDef, {newSite, newSite + 11}, "PAYLOAD");
+    auto newArg = current.createArgExpansionLoc(newSite + 7, {newBody, newBody + 3});
+    auto newNested = current.createExpansionLoc(newArg, {newArg, newArg + 2}, "INNER");
+    CHECK(current.projectImmutableOriginalLocation(newBody + 2) == body + 2);
+    CHECK(current.projectImmutableOriginalLocation(newArg + 1) == arg + 1);
+    CHECK(current.projectImmutableOriginalLocation(newNested + 1) == nested + 1);
+    const std::vector locations{newBody + 2, newArg + 1, newNested + 1, newNested + 1};
+    CHECK(current.projectImmutableOriginalLocations(locations) ==
+          std::vector{body + 2, arg + 1, nested + 1, nested + 1});
+    auto project = [&](SourceLocation location) {
+        return current.projectImmutableOriginalLocation(location);
+    };
+    CHECK_FALSE(project(current.createExpansionLoc(newDef, {newSite, newSite + 11}, "OTHER")));
+    CHECK_FALSE(
+        project(current.createExpansionLoc(newDef + 1, {newSite, newSite + 11}, "PAYLOAD")));
+    CHECK_FALSE(project(current.createExpansionLoc(newDef, {newSite, newSite + 10}, "PAYLOAD")));
+    CHECK_FALSE(project(current.createExpansionLoc(newSite + 7, {newBody, newBody + 3}, "")));
+    auto changed = current.assignQueryText("definition.svh", "changed");
+    CHECK_FALSE(
+        project(current.createExpansionLoc({changed.id, 0}, {newSite, newSite + 11}, "PAYLOAD")));
+    auto remapped = current.assignQueryText("wrapper.sv", "invoke(arg)");
+    current.addLineDirective({remapped.id, 0}, 90, "other.sv", 0);
+    CHECK_FALSE(project(
+        current.createExpansionLoc(newDef, {{remapped.id, 0}, {remapped.id, 11}}, "PAYLOAD")));
+    CHECK_FALSE(project({}));
+    auto retained = project(newNested + 1);
+    REQUIRE(retained);
+    CHECK(current.releaseQueryText(newDefinition.id));
+    CHECK(current.releaseQueryText(newInvocation.id));
+    CHECK(current.getMacroName(*retained) == "INNER");
+    CHECK_FALSE(project(newNested + 1));
+    CHECK_FALSE(current.projectImmutableOriginalLocations(locations));
+}
