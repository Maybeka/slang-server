+`ifndef UVM_PKG_SV
+`define UVM_PKG_SV
+`define WIDTH 32
+package uvm_pkg;
+ class object;
+   string label="escaped\ntext";
+   logic [`WIDTH-1:0] bits=32'h12345678;
+   logic [127:0] four_state=128'hx123z;
+   string file=`__FILE__;
+   function real value(); return 1.25; endfunction
+ endclass
+endpackage
+`endif
+)");
+    auto tree = SyntaxTree::fromBuffersWithCheckpoint(std::span(&buffer, 1), original);
+    std::ostringstream output(std::ios::binary);
+    tree->writeParseArchive(output, root);
+    REQUIRE(!output.str().empty());
+    SourceManager restored;
+    restored.assignText("prior configuration buffer");
+    const auto base = restored.getSourceLocationEntryCount() - 1;
+    std::istringstream input(output.str(), std::ios::binary);
+    auto loaded = SyntaxTree::readParseArchive(input, restored, root);
+    const auto print = [](const auto& tree) {
+        return SyntaxPrinter(tree->sourceManager())
+            .setIncludeDirectives(true)
+            .setExpandIncludes(true)
+            .setExpandMacros(true)
+            .print(*tree)
+            .str();
+    };
+    CHECK(print(tree) == print(loaded));
+    struct Integers : SyntaxVisitor<Integers> {
+        std::vector<SVInt> values;
+        void visitToken(parsing::Token token) {
+            if (token.kind == parsing::TokenKind::IntegerLiteral)
+                values.push_back(token.intValue());
+        }
+    };
+    Integers before, after;
+    tree->root().visit(before);
+    loaded->root().visit(after);
+    REQUIRE(before.values.size() == after.values.size());
+    for (size_t i = 0; i < before.values.size(); ++i) {
+        CHECK(exactlyEqual(before.values[i], after.values[i]));
+        CHECK(before.values[i].getBitWidth() == after.values[i].getBitWidth());
+        CHECK(before.values[i].isSigned() == after.values[i].isSigned());
+    }
+    REQUIRE(
+        std::ranges::any_of(after.values, [](const auto& value) { return value.hasUnknown(); }));
+    REQUIRE(tree->getDefinedMacros().size() == loaded->getDefinedMacros().size());
+    REQUIRE(tree->getSourceBufferIds().size() == loaded->getSourceBufferIds().size());
