+            break;
+        case TokenKind::IntegerLiteral: {
+            auto value = tok.intValue();
+            number(value.getBitWidth());
+            number(value.isSigned());
+            number(value.hasUnknown());
+            for (size_t i = 0; i < value.getNumWords(); ++i)
+                number(value.getRawPtr()[i]);
+            break;
+        }
+        case TokenKind::RealLiteral:
+        case TokenKind::TimeLiteral:
+            number(std::bit_cast<uint64_t>(tok.realValue()));
+            number(tok.numericFlags().raw);
+            break;
+        case TokenKind::IntegerBase:
+            number(tok.numericFlags().raw);
+            break;
+        case TokenKind::UnbasedUnsizedLiteral:
+            number(tok.bitValue().value);
+            break;
+        case TokenKind::Directive:
+            number(uint64_t(tok.directiveKind()));
