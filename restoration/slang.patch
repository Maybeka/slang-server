+    auto poll = [&] {
+        if (checkpoint)
+            checkpoint();
+    };
+    poll();
+    {
+        std::lock_guard lock(baseline->reuseMutex);
+        if (!baseline->completedReuseState) {
+            auto snapshot = std::make_shared<ProcedureReuseState>();
+            size_t steps = 0;
+            auto add = [&](const AnalyzedProcedure& procedure) {
+                if ((++steps & 255u) == 0)
+                    poll();
+                const auto symbol = procedure.analyzedSymbol.get();
+                snapshot->procedures.emplace(symbol, &procedure);
+                for (const auto call : procedure.getCallExpressions()) {
+                    if ((++steps & 255u) == 0)
+                        poll();
+                    if (!call->isSystemCall()) {
+                        auto target = std::get<const SubroutineSymbol*>(call->subroutine);
+                        snapshot->callers[target].push_back(symbol);
+                    }
