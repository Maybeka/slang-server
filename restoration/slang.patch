+    auto library = std::make_shared<Compilation>();
+    library->addSyntaxTree(libraryTree);
+    REQUIRE(library->getAllDiagnostics().empty());
+    auto prefix = librarySources.captureImmutablePrefix(libraryTree->getSourceBufferIds());
+    const auto fixedBytes = library->getTotalBytesAllocated();
+    auto report = [](Compilation& compilation) {
+        auto diagnostics = compilation.getSemanticDiagnostics();
+        analysis::AnalysisOptions options;
+        options.flags = analysis::AnalysisFlags::CheckUnused;
+        analysis::AnalysisManager manager(options);
+        compilation.freeze();
+        manager.analyze(compilation);
+        compilation.unfreeze();
+        diagnostics.append_range(manager.getDiagnostics());
+        diagnostics.sort(*compilation.getSourceManager());
+        return DiagnosticEngine::reportAll(*compilation.getSourceManager(), diagnostics);
+    };
+    for (auto method : {"used", "other", "used"}) {
+        std::string text = "package user_pkg; class Test extends uvm_pkg::Object; "
+                           "function int check(); return " +
+                           std::string(method) + "(); endfunction endclass endpackage";
