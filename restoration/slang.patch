+    out.text("slang-uvm-cst-2");
+    sourceMan.writeParseArchive(out, rootPath);
+    out.node(rootNode);
+    auto writeDiag = [&](auto&& self, const Diagnostic& d) -> void {
+        if (d.symbol || d.coalesceCount)
+            throw std::runtime_error("unsupported archive diagnostic context");
+        out.number(uint64_t(d.code.getSubsystem()));
+        out.number(d.code.getCode());
+        out.location(d.location);
+        out.number(d.args.size());
+        for (auto& arg : d.args) {
+            out.number(arg.index());
+            std::visit(
+                [&](const auto& value) {
+                    using T = std::decay_t<decltype(value)>;
+                    if constexpr (std::is_same_v<T, std::string>)
+                        out.text(value);
+                    else if constexpr (std::is_integral_v<T>)
+                        out.number(uint64_t(value));
+                    else
+                        throw std::runtime_error("unsupported archive diagnostic argument");
+                },
+                arg);
+        }
+        out.number(d.ranges.size());
+        for (auto& range : d.ranges) {
+            out.location(range.start());
+            out.location(range.end());
+        }
+        out.number(d.notes.size());
+        for (auto& note : d.notes)
+            self(self, note);
+    };
+    out.number(diagnosticsBuffer.size());
+    for (auto& d : diagnosticsBuffer)
+        writeDiag(writeDiag, d);
+    const auto& pp = preprocessorMetadata;
+    auto nodes = [&](const auto& list) {
+        out.number(list.size());
+        for (auto node : list)
+            out.node(node);
+    };
+    nodes(pp.definedMacros);
+    out.number(pp.includeDirectives.size());
+    for (const auto& inc : pp.includeDirectives) {
+        out.node(inc.syntax);
+        out.text(inc.path);
+        out.number(inc.buffer.id.getId());
+        out.number(inc.isSystem);
+    }
+    out.number(pp.macroRefs.size());
+    for (const auto& ref : pp.macroRefs) {
+        out.node(ref.syntax);
+        out.node(ref.definition);
+    }
+    auto buffers = [&](const auto& list) {
+        out.number(list.size());
+        for (auto id : list)
+            out.number(id.getId());
+    };
+    buffers(pp.sourceBufferIds);
+    buffers(pp.predefineBufferIds);
+    // Store guards as physical-file indices rather than process-local char pointers.
+    out.number(prefixState->guards.size());
+    for (const auto& [key, value] : prefixState->guards) {
+        BufferID match;
+        for (auto id : pp.sourceBufferIds)
+            if (sourceMan.getSourceText(id).data() == key) {
+                match = id;
+                break;
+            }
+        if (!match)
+            throw std::runtime_error("unmapped archive header guard");
+        out.number(match.getId());
+        out.text(value);
+    }
+    // Persist the metadata and parent identities already established by parsing.
+    // Restoring must not walk the full expanded tree to rediscover either one.
+    out.number(metadata.nodeMeta.size());
+    for (const auto& [node, value] : metadata.nodeMeta) {
+        out.node(node);
+        out.number(uint64_t(value.defaultNetType));
+        out.number(uint64_t(value.unconnectedDrive));
+        out.number(value.cellDefine);
+        out.number(value.timeScale.has_value());
+        if (value.timeScale) {
+            out.number(uint64_t(value.timeScale->base.unit));
+            out.number(uint64_t(value.timeScale->base.magnitude));
+            out.number(uint64_t(value.timeScale->precision.unit));
+            out.number(uint64_t(value.timeScale->precision.magnitude));
+        }
+    }
+    nodes(metadata.globalInstances);
+    nodes(metadata.classPackageNames);
+    nodes(metadata.packageImports);
+    nodes(metadata.classDecls);
+    nodes(metadata.interfacePorts);
+    nodes(metadata.virtualInterfaceTypes);
+    nodes(metadata.namedPortTypes);
+    out.token(metadata.eofToken);
+    out.number(metadata.hasDefparams);
+    out.number(metadata.hasBindDirectives);
+    out.writeParents();
+    const auto& summary = *prefixState->wholeTreeDirectives;
+    out.number(summary.sourceEffects | (summary.resumeSafe << 1) | (summary.defparams << 2) |
+               (summary.binds << 3));
+}
+std::shared_ptr<SyntaxTree> SyntaxTree::readParseArchive(std::istream& stream, SourceManager& sm,
+                                                         const std::filesystem::path& rootPath,
+                                                         const Bag& options,
+                                                         bool allowExternalPaths) {
+    BumpAllocator arena;
+    ArchiveReader in(stream, arena, uint32_t(sm.getSourceLocationEntryCount() - 1), &sm);
+    in.allowExternalPaths = allowExternalPaths;
+    if (in.text() != "slang-uvm-cst-2")
+        throw std::runtime_error("incompatible UVM parse archive");
+    {
+        TimeTraceScope scope("restoreUvmSources", "");
+        sm.readParseArchive(in, rootPath);
+    }
+    SyntaxNode* root;
+    {
+        TimeTraceScope scope("restoreUvmSyntax", "");
+        root = in.node();
+    }
+    if (!root || root->kind != SyntaxKind::CompilationUnit)
+        throw std::runtime_error("invalid archive root");
+    auto readDiag = [&](auto&& self) -> Diagnostic {
+        auto subsystem = DiagSubsystem(in.number());
+        auto code = uint16_t(in.number());
+        auto location = in.location();
+        Diagnostic d(DiagCode(subsystem, code), location);
+        auto n = in.count();
+        for (size_t i = 0; i < n; ++i) {
+            switch (in.number()) {
+                case 0:
+                    d.args.emplace_back(in.text());
+                    break;
+                case 1:
+                    d.args.emplace_back(std::bit_cast<int64_t>(in.number()));
+                    break;
+                case 2:
+                    d.args.emplace_back(in.number());
+                    break;
+                case 3:
+                    d.args.emplace_back(char(in.number()));
+                    break;
+                default:
+                    throw std::runtime_error("unsupported archive diagnostic argument");
+            }
+        }
+        n = in.count();
+        for (size_t i = 0; i < n; ++i) {
+            auto a = in.location();
+            auto b = in.location();
+            d.ranges.emplace_back(a, b);
+        }
+        n = in.count();
+        for (size_t i = 0; i < n; ++i)
+            d.notes.push_back(self(self));
+        return d;
+    };
+    Diagnostics diagnostics;
+    auto diagnosticCount = in.count();
+    for (size_t i = 0; i < diagnosticCount; ++i)
+        diagnostics.push_back(readDiag(readDiag));
+    PreprocessorMetadata pp;
+    auto n = in.count();
+    for (size_t i = 0; i < n; ++i)
+        pp.definedMacros.push_back(in.field<const DefineDirectiveSyntax*>());
+    n = in.count();
+    for (size_t i = 0; i < n; ++i) {
+        auto syntax = in.field<const IncludeDirectiveSyntax*>();
+        auto path = in.string();
+        auto id = in.buffer();
+        auto system = in.number();
+        pp.includeDirectives.push_back(
+            {syntax, path, SourceBuffer{sm.getSourceText(id), nullptr, id}, bool(system)});
+    }
+    n = in.count();
+    for (size_t i = 0; i < n; ++i) {
+        auto use = in.node();
+        auto def = in.field<const DefineDirectiveSyntax*>();
+        pp.macroRefs.push_back({use, def});
+    }
+    n = in.count();
+    for (size_t i = 0; i < n; ++i)
+        pp.sourceBufferIds.push_back(in.buffer());
+    n = in.count();
+    for (size_t i = 0; i < n; ++i)
+        pp.predefineBufferIds.push_back(in.buffer());
+    auto state = std::make_unique<PrefixState>();
+    n = in.count();
+    for (size_t i = 0; i < n; ++i) {
+        auto id = in.buffer();
+        auto name = in.string();
+        state->guards.emplace_back(sm.getSourceText(id).data(), name);
+    }
+    ParserMetadata metadata;
+    {
+        TimeTraceScope scope("restoreUvmMetadata", "");
+        n = in.count();
+        metadata.nodeMeta.reserve(n);
+        for (size_t i = 0; i < n; ++i) {
+            auto* node = in.field<const ModuleDeclarationSyntax*>();
+            ParserMetadata::Node value;
+            value.defaultNetType = TokenKind(in.number());
+            value.unconnectedDrive = TokenKind(in.number());
+            value.cellDefine = bool(in.number());
+            if (in.number()) {
+                TimeScale scale;
+                scale.base.unit = TimeUnit(in.number());
+                scale.base.magnitude = TimeScaleMagnitude(in.number());
+                scale.precision.unit = TimeUnit(in.number());
+                scale.precision.magnitude = TimeScaleMagnitude(in.number());
+                value.timeScale = scale;
+            }
+            metadata.nodeMeta.emplace_back(node, value);
+        }
+        auto readNodes = [&]<typename T>(std::vector<const T*>& list) {
+            auto size = in.count();
+            list.reserve(size);
+            for (size_t i = 0; i < size; ++i)
+                list.push_back(in.field<const T*>());
+        };
+        readNodes(metadata.globalInstances);
+        readNodes(metadata.classPackageNames);
+        readNodes(metadata.packageImports);
+        readNodes(metadata.classDecls);
+        readNodes(metadata.interfacePorts);
+        readNodes(metadata.virtualInterfaceTypes);
+        readNodes(metadata.namedPortTypes);
+        metadata.eofToken = in.token();
+        metadata.hasDefparams = bool(in.number());
+        metadata.hasBindDirectives = bool(in.number());
+    }
+    {
+        TimeTraceScope scope("restoreUvmAncestry", "");
+        in.restoreParents();
+    }
+    const auto flags = in.number();
+    if (flags > 15)
+        throw std::runtime_error("invalid archive directive summary");
+    DirectiveSummary summary{bool(flags & 1), bool(flags & 2), bool(flags & 4), bool(flags & 8)};
+    state->wholeTreeDirectives = summary;
+    state->cwd = std::filesystem::current_path().string();
+    auto result = std::shared_ptr<SyntaxTree>(
+        new SyntaxTree(root, nullptr, sm, std::move(arena), std::move(diagnostics),
+                       std::move(metadata), std::move(pp), options));
+    result->prefixState = std::move(state);
+    if (!in.atEnd())
+        throw std::runtime_error("trailing bytes in UVM parse archive");
+    return result;
+}
