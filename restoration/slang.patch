+TEST_CASE("Independent body cache context avoids unrelated provisional definitions",
+          "[trusted-package][body-cache-context]") {
+    SourceManager sources;
+    auto tree = SyntaxTree::fromText(R"(
+module leaf; wire local_value; endmodule
+module unrelated; missing_module invalid(); endmodule
+)",
+                                     sources, "provider.sv");
+    CompilationOptions libraryOptions;
+    libraryOptions.flags = CompilationFlags::PackageAnalysis;
+    auto library = std::make_shared<Compilation>(libraryOptions);
+    library->addSyntaxTree(tree);
+    REQUIRE(library->getAllDiagnostics().empty());
+    auto prefix = sources.captureImmutablePrefix(tree->getSourceBufferIds());
+    for (const bool projected : {false, true}) {
+        SourceManager consumerSources;
+        consumerSources.inheritImmutablePrefix(prefix);
+        CompilationOptions options;
+        options.topModules.emplace("top");
+        auto consumer = std::make_shared<Compilation>(options);
+        if (projected)
+            consumer->setInstanceBodyCacheContext();
+        consumer->importDefinition(library, "leaf", consumerSources);
+        consumer->importDefinition(library, "unrelated", consumerSources);
+        consumer->addSyntaxTree(
+            SyntaxTree::fromText("module top; leaf u(); endmodule", consumerSources, "context.sv"));
+        const auto& diagnostics = consumer->getSemanticDiagnostics();
+        if (projected)
+            CHECK(diagnostics.empty());
+        // Native uninstantiated bodies can suppress their errors; inspect the
+        // actual provisional instances rather than inferring them from errors.
+        size_t provisional = 0;
+        for (const auto& member : consumer->getRoot().members())
+            if (member.kind == SymbolKind::Instance &&
+                member.as<InstanceSymbol>().getDefinition().name == "unrelated")
+                ++provisional;
+        CHECK(provisional == (projected ? 0 : 1));
+        REQUIRE(consumer->getRoot().topInstances.size() == 1);
+        auto& body =
+            consumer->getRoot().topInstances.front()->body.find("u")->as<InstanceSymbol>().body;
+        CHECK(body.find("local_value"));
+        CHECK(consumer->getOptions() == options);
+        CHECK_THROWS(consumer->setInstanceBodyCacheContext());
+    }
+    Compilation invalid;
+    CHECK_THROWS(invalid.setInstanceBodyCacheContext());
+}
