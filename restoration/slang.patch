+TEST_CASE("Temporary body import lookups do not retain query origins in Native",
+          "[body-class-reference-view][body-query-origin-lifetime]") {
+    CompilationOptions options;
+    options.flags |= CompilationFlags::TrackSubroutineBodyDependencies;
+    auto owner = std::make_shared<Compilation>(options);
+    owner->addSyntaxTree(
+        SyntaxTree::fromText("package source; int imported_value; endpackage "
+                             "package p; import source::*; class Probe #(type T=int); endclass "
+                             "function automatic void work(); endfunction endpackage\n"));
+    (void)owner->getSemanticDiagnostics();
+    const auto before = owner->getReferenceUsageExcludingBodies({});
+    REQUIRE(before);
+    const auto& work = owner->getPackage("p")->find<SubroutineSymbol>("work");
+    const auto findFunction = [](const SyntaxTree& tree) {
+        const FunctionDeclarationSyntax* result = nullptr;
+        auto find = [&](auto&& self, const SyntaxNode& node) -> void {
+            if (auto fn = node.as_if<FunctionDeclarationSyntax>()) {
+                result = fn;
+                return;
+            }
+            for (uint32_t i = 0; i < node.getChildCount(); ++i)
+                if (auto child = node.childNode(i))
+                    self(self, *child);
+        };
+        find(find, tree.root());
+        return result;
+    };
+    {
+        auto tree = SyntaxTree::fromText(
+            "function automatic void work(); int local_value=imported_value; endfunction\n");
+        Compilation query(options);
+        query.setBodyQueryContext(owner, tree);
+        // Lazy shallow lookups need ownership routing even without a diagnostic
+        // BodyQueryReferenceGuard. This entire query is destroyed before replay.
+        const auto* syntax = findFunction(*tree);
+        REQUIRE(syntax);
+        auto& fn = SubroutineSymbol::createBodyQuery(query, *syntax, work);
+        query.forceElaborate(fn);
+    }
+    const auto after = owner->getReferenceUsageExcludingBodies({});
+    REQUIRE(after);
+    CHECK(*after == *before);
+    auto tree = SyntaxTree::fromText(
+        "function automatic void work(); p::Probe#(int) box; endfunction\n");
+    Compilation edited(options);
+    edited.setBodyQueryContext(owner, tree);
+    const auto* syntax = findFunction(*tree);
+    REQUIRE(syntax);
+    BodyQueryReferenceGuard references(edited);
+    auto& fn = SubroutineSymbol::createBodyQuery(edited, *syntax, work);
+    edited.forceElaborate(fn);
+    const SubroutineSymbol* originals[] = {&work};
+    auto view = edited.getBodyQuerySemanticView(fn, originals, {});
+    REQUIRE(view.references);
+    CHECK(report(view.diagnostics) == report(owner->getSemanticDiagnostics()));
+}
