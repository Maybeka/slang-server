+    CHECK(std::count(filtered.begin(), filtered.end(), diag::WidthTruncate) == 2);
+    CHECK(std::count(filtered.begin(), filtered.end(), diag::IntBoolConv) == 2);
+    CHECK(std::count(filtered.begin(), filtered.end(), diag::UnknownMember) == 1);
+    CHECK(run(true, true) == filtered);
+}
