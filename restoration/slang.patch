+TEST_CASE("Prepared prefixes preserve neutral plain protection without accepting pragma state",
+          "[source-snapshot][prefix-protection]") {
+    const std::vector<std::pair<std::string, bool>> cases = {
+        {"`pragma protect begin\npackage p; endpackage\n`pragma protect end\n", true},
+        {"package p; `pragma protect begin\nclass C; endclass\n"
+         "`pragma protect end\nendpackage\n", true},
+        {"`pragma protect begin\npackage p; endpackage\n", false},
+        {"`pragma protect end\npackage p; endpackage\n", false},
+        {"`pragma protect begin\n`pragma protect begin\npackage p; endpackage\n"
+         "`pragma protect end\n`pragma protect end\n", false},
+        {"`pragma protect begin_protected\npackage p; endpackage\n"
+         "`pragma protect end_protected\n", false},
+        {"`pragma protect encoding=(enctype=\"base64\")\npackage p; endpackage\n", false},
+        {"`pragma diagnostic push\npackage p; endpackage\n`pragma diagnostic pop\n", false},
+        {"`pragma protect begin=1\npackage p; endpackage\n`pragma protect end\n", false},
+        {"`pragma protect \"begin\"\npackage p; endpackage\n`pragma protect end\n", false},
+    };
+    for (const auto& [text, safe] : cases) {
+        INFO(text);
+        SourceManager sm;
+        auto first = sm.assignText("protection-first.sv", "`define INHERITED 37\n");
+        auto fixed = sm.assignText("protection-fixed.sv", text);
+        auto user = sm.assignText("protection-user.sv",
+                                  "module top; localparam int V=`INHERITED; endmodule\n");
+        auto prefix = SyntaxTree::fromBuffersWithCheckpoint(std::vector{first, fixed}, sm);
+        CHECK(prefix->isPrefixResumeSafe() == safe);
+        CHECK(prefix->getPrefixSourceEffects() == true);
+        if (!safe) {
+            CHECK_THROWS(SyntaxTree::afterCachedPrefix(prefix, std::vector{user}, {}));
+            continue;
+        }
+        REQUIRE(prefix->diagnostics().empty());
+        auto suffix = SyntaxTree::afterCachedPrefix(prefix, std::vector{user}, {});
+        auto combined = SyntaxTree::withCachedPrefixOwnedSuffix(prefix, std::move(suffix));
+        auto native = SyntaxTree::fromBuffers(std::vector{first, fixed, user}, sm);
+        CHECK(combined->diagnostics().size() == native->diagnostics().size());
+        Compilation a, b;
+        a.addSyntaxTree(combined);
+        b.addSyntaxTree(native);
+        CHECK(a.getAllDiagnostics().empty());
+        CHECK(b.getAllDiagnostics().empty());
+        CHECK(a.getRoot().topInstances.front()->body.find("V")
+                  ->as<ParameterSymbol>().getValue() ==
+              b.getRoot().topInstances.front()->body.find("V")
+                  ->as<ParameterSymbol>().getValue());
+        auto ending = sm.assignText("protection-ending.sv", "`pragma protect end\n");
+        auto after = SyntaxTree::afterCachedPrefix(prefix, std::vector{ending}, {});
+        auto direct = SyntaxTree::fromBuffers(std::vector{first, fixed, ending}, sm);
+        REQUIRE(after->diagnostics().size() == 1);
+        REQUIRE(direct->diagnostics().size() == 1);
+        CHECK(after->diagnostics()[0].code == direct->diagnostics()[0].code);
+    }
+}
