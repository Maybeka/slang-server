+)");
+    auto defparam = SyntaxTree::fromText("defparam target.missing_parameter = 3;");
+
+    SECTION("Declaration analysis") {
+        CompilationOptions options;
+        options.flags |= CompilationFlags::PackageAnalysis;
+        Compilation compilation(options);
+        compilation.addSyntaxTree(tree);
+        compilation.addSyntaxTree(defparam);
+        NO_COMPILATION_ERRORS;
+        CHECK(compilation.getRoot().topInstances.empty());
+    }
+
+    SECTION("Ordinary compilation") {
+        Compilation compilation;
+        compilation.addSyntaxTree(tree);
+        compilation.addSyntaxTree(defparam);
+        auto& diagnostics = compilation.getSemanticDiagnostics();
+        CHECK(std::ranges::any_of(diagnostics,
+                                  [](auto& d) { return d.code == diag::UnknownModule; }));
+        CHECK(std::ranges::any_of(diagnostics, [](auto& d) {
+            return d.code == diag::UndeclaredIdentifier ||
+                   d.code == diag::CouldNotResolveHierarchicalPath;
+        }));
+    }
+}
