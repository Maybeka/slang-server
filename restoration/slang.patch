+std::shared_ptr<SyntaxTree> SyntaxTree::sharedPrefixView(const std::shared_ptr<SyntaxTree>& owner,
+                                                         SourceManager& sm) {
+    if (!owner || !sm.sharesImmutablePrefix(owner->sourceMan))
