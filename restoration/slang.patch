+std::string quoteSVString(std::string_view value) {
+    std::string result = "\"";
+    for (unsigned char c : value) {
+        if (c == '"' || c == '\\') {
+            result += '\\';
+            result += char(c);
+        }
+        else if (c < 32 || c > 126) {
+            result += '\\';
+            result += char('0' + (c >> 6));
+            result += char('0' + ((c >> 3) & 7));
+            result += char('0' + (c & 7));
+        }
+        else
+            result += char(c);
+    }
+    result += '"';
+    return result;
+}
