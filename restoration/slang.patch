+        if (auto file = std::get_if<FileInfo>(&entry)) {
+            if (!file->data || file->data->queryText)
+                throw std::runtime_error("released or private query buffers cannot be archived");
+            if (file->getLibrary())
+                throw std::runtime_error(
+                    "library and line directives are unsupported in parse archives");
