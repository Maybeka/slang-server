+                        if constexpr (std::same_as<S, IdentifierNameSyntax> ||
+                                      std::same_as<S, IdentifierSelectNameSyntax>) {
+                            if (auto symbol = node.getParentScope()->find(
+                                    syntax.identifier.valueText());
+                                symbol && symbol->kind != SymbolKind::Parameter &&
+                                symbol->kind != SymbolKind::TypeParameter)
+                                reject("parameter-deferred-name");
+                        }
+                        syntaxVisitor.visitDefault(syntax);
+                    });
+                    if (!node.isOverridden()) {
+                        if (auto syntax = node.getDeclaredType()->getInitializerSyntax())
+                            syntax->visit(names);
+                        if (auto syntax = node.getDeclaredType()->getTypeSyntax())
+                            syntax->visit(names);
+                    }
+                }
+                return;
+            }
+            visitor.visitDefault(node);
+        });
+        retained.visit(audit);
+        for (const auto& [scope, expression] : bodyElaborationControls)
+            if (isLocal(scope->asSymbol()))
+                expression->visit(audit);
+        for (size_t index = 0; independent && index < pendingTypes.size(); ++index)
+            pendingTypes[index]->visit(audit);
+        if (independent) {
+            for (const auto& [binding, usage] : bodyCrossReferences) {
+                if (!isLocal(binding.first->asSymbol()))
+                    continue;
+                auto targetScope = binding.second->getParentScope();
+                if (!isLocal(*binding.second) &&
+                    (!targetScope || !isFixedCompilation(targetScope->getCompilation())))
+                    continue;
+                if (auto syntax = binding.second->getSyntax()) {
+                    auto& profile = certificate.references[syntax];
+                    profile.first |= usage.first;
+                    profile.second |= usage.second;
+                }
+            }
+        }
+        for (const auto& [scope, definition] : bodyDefinitionSites)
+            if (isLocal(scope->asSymbol()))
+                certificate.instantiationSites.push_back(definition);
+        flat_hash_set<const DefinitionSymbol*> subtreeDefinitions{&retained.getDefinition()};
+        for (auto body : certificate.descendants)
+            subtreeDefinitions.emplace(&body->getDefinition());
+        // Keep raw occurrences: producer coalescing has already discarded instance
+        // identity and counts, and must never be replayed in a different consumer.
+        auto fixedLocation = [&](SourceLocation location) {
+            if (!location)
+                return true;
+            location = sourceManager->getFullyOriginalLoc(location);
+            for (auto definition : subtreeDefinitions) {
+                auto range = definition->getSyntax()->sourceRange();
+                if (location.buffer() == range.start().buffer() &&
+                    location.offset() >= range.start().offset() &&
+                    location.offset() <= range.end().offset())
+                    return true;
+            }
+            for (auto type : certificate.classes)
+                if (auto syntax = type->getSyntax()) {
+                    const auto range = syntax->sourceRange();
+                    if (location.buffer() == range.start().buffer() &&
+                        location.offset() >= range.start().offset() &&
+                        location.offset() <= range.end().offset())
+                        return true;
+                }
+            return false;
+        };
+        auto fixedDiagnostic = [&](auto&& self, const Diagnostic& diagnostic) -> bool {
+            if (diagnostic.isError() || diagnostic.coalesceCount ||
+                !fixedLocation(diagnostic.location) ||
+                (diagnostic.symbol && !isLocal(*diagnostic.symbol)))
+                return false;
+            for (auto range : diagnostic.ranges)
+                if (!fixedLocation(range.start()) || !fixedLocation(range.end()))
+                    return false;
+            for (const auto& note : diagnostic.notes)
+                if (!self(self, note))
+                    return false;
+            return true;
+        };
+        diagMap.visitRaw([&](const Diagnostic& diagnostic) {
+            if (!independent)
+                return;
+            if (!diagnostic.symbol) {
+                reject("unscoped-semantic-diagnostic");
+                return;
+            }
+            if (!isLocal(*diagnostic.symbol))
+                return; // Outside root port / parameter connections are rebound.
+            if (!fixedDiagnostic(fixedDiagnostic, diagnostic)) {
+                reject("mutable-diagnostic-context");
+                return;
+            }
+            certificate.diagnostics.push_back(&diagnostic);
+        });
+
+        // Reference profiles contain only body-local binding origins. Current
+        // callers re-evaluate their outside uses; no old-consumer walk is needed.
+        certificate.independent = independent;
+    }
+    return certificate.independent;
+}
+
+bool Compilation::instanceBodyReuseRequiresFreshOwner(const InstanceBodySymbol& body) const {
+    auto found = bodyReuseCertificates.find(&body);
+    return found != bodyReuseCertificates.end() && !found->second->independent &&
+           found->second->requiresFreshOwner;
+}
+
+bool Compilation::hasMatchingInstanceBodyParameters(const InstanceBodySymbol& retained,
+                                                    const InstanceBodySymbol& target) const {
+    if (&target.getCompilation() != this || retained.parameters.size() != target.parameters.size())
+        return false;
+    // Reentrant default-parameter lookups see the already constructed parameter
+    // declarations, without elaborating ports / members or escaping an index.
+    const auto previousMode = target.parameterLookupMode;
+    target.parameterLookupMode = true;
+    auto restore = ScopeGuard([&] { target.parameterLookupMode = previousMode; });
+    auto origin = [](const Symbol& x, const Symbol& y) {
+        if (x.isType() && y.isType()) {
+            const auto& xt = x.as<Type>();
+            const auto& yt = y.as<Type>();
+            auto xs = xt.getParentScope(), ys = yt.getParentScope();
+            if (xs && ys) {
+                const auto& xc = xs->getCompilation();
+                const auto& yc = ys->getCompilation();
+                if (xc.fixedBodyTypeOrigins.contains(&xt)) {
+                    auto key = xc.instanceBodyTypeOrigin(xt);
+                    if (!key.empty() && key == yc.instanceBodyTypeOrigin(yt))
+                        return true;
+                }
+            }
+        }
+        if (!x.getSyntax() || x.getSyntax() != y.getSyntax() || x.name != y.name)
+            return false;
+        auto xs = x.getParentScope();
+        auto ys = y.getParentScope();
+        auto xb = xs ? xs->getContainingInstance() : nullptr;
+        auto yb = ys ? ys->getContainingInstance() : nullptr;
+        return xb && yb && &xb->getDefinition() == &yb->getDefinition() &&
+               xb->getHierarchicalPath() == yb->getHierarchicalPath();
+    };
+    auto sameType = [&](auto&& self, const Type& x, const Type& y) -> bool {
+        if (&x == &y)
+            return true;
+        auto transparent = [](const Type& type) {
+            auto scope = type.getParentScope();
+            auto view = scope ? scope->getCompilation().getInstanceBodyTypePresentation(type)
+                              : nullptr;
+            return view && view->transparent;
+        };
+        if (x.kind == SymbolKind::TypeAlias && transparent(x))
+            return self(self, x.as<TypeAliasType>().targetType.getType(), y);
+        if (y.kind == SymbolKind::TypeAlias && transparent(y))
+            return self(self, x, y.as<TypeAliasType>().targetType.getType());
+        if (x.kind != y.kind)
+            return false;
+        if (x.kind == SymbolKind::TypeAlias) {
+            if (!origin(x, y))
+                return false;
+            return self(self, x.as<TypeAliasType>().targetType.getType(),
+                        y.as<TypeAliasType>().targetType.getType());
+        }
+        if (x.kind == SymbolKind::FixedSizeUnpackedArrayType)
+            return x.as<FixedSizeUnpackedArrayType>().range ==
+                       y.as<FixedSizeUnpackedArrayType>().range &&
+                   self(self, *x.getArrayElementType(), *y.getArrayElementType());
+        if (!x.isIntegral() || !y.isIntegral() || x.getBitWidth() != y.getBitWidth() ||
+            x.isSigned() != y.isSigned() || x.isFourState() != y.isFourState())
+            return false;
+        if (x.kind == SymbolKind::PackedArrayType)
+            return x.as<PackedArrayType>().range == y.as<PackedArrayType>().range &&
+                   self(self, *x.getArrayElementType(), *y.getArrayElementType());
+        if (x.kind == SymbolKind::EnumType) {
+            if (!origin(x, y))
+                return false;
+            const auto& a = x.as<EnumType>();
+            const auto& b = y.as<EnumType>();
+            if (!self(self, a.baseType, b.baseType))
+                return false;
+            auto av = a.values();
+            auto bv = b.values();
+            auto ai = av.begin();
+            auto bi = bv.begin();
+            for (; ai != av.end() && bi != bv.end(); ++ai, ++bi)
+                if (ai->name != bi->name || ai->getValue() != bi->getValue())
+                    return false;
+            return ai == av.end() && bi == bv.end();
+        }
+        if (x.kind == SymbolKind::PackedStructType || x.kind == SymbolKind::PackedUnionType) {
+            if (!origin(x, y))
+                return false;
+            auto fields = [](const Type& t) -> const Scope& {
+                return t.kind == SymbolKind::PackedStructType
+                           ? static_cast<const Scope&>(t.as<PackedStructType>())
+                           : static_cast<const Scope&>(t.as<PackedUnionType>());
+            };
+            auto av = fields(x).template membersOfType<FieldSymbol>();
+            auto bv = fields(y).template membersOfType<FieldSymbol>();
+            auto ai = av.begin();
+            auto bi = bv.begin();
+            for (; ai != av.end() && bi != bv.end(); ++ai, ++bi)
+                if (ai->name != bi->name || !self(self, ai->getType(), bi->getType()))
+                    return false;
+            return ai == av.end() && bi == bv.end();
+        }
+        return x.name == y.name && x.isMatching(y);
+    };
+    bool preparedEnums = false;
+    for (size_t i = 0; i < target.parameters.size(); ++i) {
+        const auto& left = retained.parameters[i]->symbol;
+        const auto& right = target.parameters[i]->symbol;
+        if (left.kind != right.kind)
+            return false;
+        if (left.kind == SymbolKind::TypeParameter) {
+            if (!preparedEnums) {
+                target.elaborate(); // enum previews only while parameterLookupMode is set
+                preparedEnums = true;
+            }
+            const auto& a = left.as<TypeParameterSymbol>();
+            const auto& b = right.as<TypeParameterSymbol>();
+            const auto& at = a.targetType.getType();
+            const auto& bt = b.targetType.getType();
+            if (a.isOverridden() != b.isOverridden() || a.typeRestriction != b.typeRestriction ||
+                (!isFixedInstanceBodyTypeArgument(bt, target) &&
+                 !retained.getCompilation().fixedBodyTypeOrigins.contains(
+                     &at.getCanonicalType())) ||
+                !sameType(sameType, at, bt)) {
+                if (std::getenv("SLANG_SCOPE_BODY_TRACE")) {
+                    const auto& ac = at.getCanonicalType();
+                    const auto& bc = bt.getCanonicalType();
+                    auto as = ac.getParentScope(), bs = bc.getParentScope();
+                    fmt::print(stderr, "scope-body type-signature\t{}\t{} | {}\t{} | {}\n",
+                               left.name, at.toString(), bt.toString(),
+                               as ? as->getCompilation().instanceBodyTypeOrigin(ac) : "",
+                               bs ? bs->getCompilation().instanceBodyTypeOrigin(bc) : "");
+                }
+                return false;
+            }
+            continue;
+        }
+        if (left.kind != SymbolKind::Parameter)
+            return false;
+        const auto& a = left.as<ParameterSymbol>();
+        const auto& b = right.as<ParameterSymbol>();
+        const auto& at = a.getType();
+        const auto& bt = b.getType();
+        const bool scalar = at.isIntegral() && bt.isIntegral() && a.getValue().isInteger() &&
+                            b.getValue().isInteger();
+        // Body localparams also appear in the native parameter vector. They
+        // cannot be overridden, but their shape and deep value still form part
+        // of the certificate for a new parameterization of this instance.
+        const bool localArray =
+            a.isLocalParam() && b.isLocalParam() &&
+            at.getCanonicalType().kind == SymbolKind::FixedSizeUnpackedArrayType &&
+            bt.getCanonicalType().kind == SymbolKind::FixedSizeUnpackedArrayType &&
+            isFixedInstanceBodyTypeArgument(bt, target) && a.getValue().isUnpacked() &&
+            b.getValue().isUnpacked();
+        if ((!scalar && !localArray) || a.isLocalParam() != b.isLocalParam() ||
+            !sameType(sameType, at, bt) || a.isOverridden() != b.isOverridden() ||
+            a.getValue() != b.getValue() || a.isImplicitString({}) != b.isImplicitString({}))
+            return false;
+    }
+    return true;
+}
+
+void Compilation::detachRetainedParameterInitializers(InstanceBodySymbol& body) {
+    SLANG_ASSERT(&body.getCompilation() == this && !body.borrowedMembers &&
+                 bodyReuseCertificates.contains(&body));
+    for (auto parameter : body.parameters) {
+        if (parameter->symbol.kind != SymbolKind::Parameter)
+            continue;
+        auto& value = const_cast<ParameterSymbol&>(parameter->symbol.as<ParameterSymbol>());
+        if (value.isOverridden()) {
+            auto range = SourceRange(value.location, value.location + value.name.length());
+            auto literal = emplace<IntegerLiteral>(*this, value.getType(),
+                                                   value.getValue().integer(), false, range);
+            value.getDeclaredType()->setRetainedInitializer(*literal, value.location);
+        }
+    }
+}
