+    bool foundBody = false;
+    for (auto scope = &origin; scope; scope = scope->asSymbol().getParentScope()) {
+        const auto& symbol = scope->asSymbol();
+        if (!foundBody) {
+            if (auto fn = symbol.as_if<SubroutineSymbol>()) {
+                foundBody = true;
+                if (fn == bodyReferenceOrigin)
