+    std::string freshText = "module replacement; endmodule\n";
+    freshText.push_back('\0');
+    replacement.insert(replacement.end(), freshText.begin(), freshText.end());
+    const auto fresh = manager->replaceBuffer(original.id, std::move(replacement));
+    CHECK_THROWS(manager->captureSnapshotView(std::array{original.id}));
+    const auto freshView = manager->captureSnapshotView(std::array{fresh.id});
+    CHECK(freshView.files.at(freshView.graphFileIds.at(0) - 1).bytes == freshText);
+    CHECK(retained.bytes == expected);
+    manager.reset();
+    CHECK(managerLifetime.expired());
+    CHECK_FALSE(bytesLifetime.expired());
+    CHECK(retained.bytes == expected);
+    view.files.clear();
+    retained.storage.reset();
+    CHECK(bytesLifetime.expired());
+}
