+// SPDX-License-Identifier: MIT
+#pragma once
+#include <array>
+#include <bit>
+#include <cstring>
+#include <istream>
+#include <ostream>
+#include <sstream>
+#include <unordered_map>
+
+#include "slang/syntax/AllSyntax.h"
+#include "slang/util/BumpAllocator.h"
+namespace slang {
+class SourceManager;
+}
+namespace slang::syntax {
+using Token = parsing::Token;
+class SLANG_EXPORT ArchiveWriter {
+public:
+    explicit ArchiveWriter(std::ostream& out, const SourceManager* sources = nullptr) :
+        sources(sources), out(out) {}
+    const SourceManager* sources;
+    bool allowExternalPaths = false;
+    void number(uint64_t n) {
+        do {
+            auto byte = uint8_t(n & 127);
+            n >>= 7;
+            if (out.rdbuf()->sputc(char(byte | (n ? 128 : 0))) == EOF)
+                throw std::runtime_error("cannot write parse archive");
+        } while (n);
+    }
+    void text(std::string_view s) {
+        number(s.size());
+        if (out.rdbuf()->sputn(s.data(), std::streamsize(s.size())) != std::streamsize(s.size()))
+            throw std::runtime_error("cannot write parse archive text");
+    }
+    void location(SourceLocation l) {
+        number(l.buffer().getId());
+        number(l.offset());
+    }
+    void token(parsing::Token);
+    void node(const SyntaxNode*);
+    void writeParents() {
+        std::vector<const SyntaxNode*> ordered(nodes.size());
+        for (auto [node, id] : nodes)
+            ordered[id - 1] = node;
+        number(ordered.size());
+        for (auto node : ordered) {
+            if (!node->parent)
+                number(0);
+            else {
+                auto parent = nodes.find(node->parent);
+                if (parent == nodes.end())
+                    throw std::runtime_error("archive parent escapes prefix");
+                number(parent->second);
+            }
+        }
+    }
+    template<class T>
+    void field(const T& value) {
+        if constexpr (std::is_same_v<T, parsing::Token>)
+            token(value);
+        else if constexpr (std::is_pointer_v<T>)
+            node(value);
+        else if constexpr (is_syntax_list_v<T>) {
+            number(value.getChildCount());
+            for (size_t i = 0; i < value.getChildCount(); ++i) {
+                auto e = value.getChild(i);
+                number(e.isToken());
+                if (e.isToken())
+                    token(e.token());
+                else
+                    node(e.node());
+            }
+        }
+        else if constexpr (requires { value.get(); })
+            node(value.get());
+        else
+            node(&value);
+    }
+
+private:
+    std::ostream& out;
+    std::unordered_map<const SyntaxNode*, uint64_t> nodes;
+};
+class SLANG_EXPORT ArchiveReader {
+public:
+    ArchiveReader(std::istream& in, BumpAllocator& arena, uint32_t base = 0,
+                  SourceManager* sources = nullptr) : arena(arena), sources(sources), base(base) {
+        // An in-memory stream already owns a contiguous payload. Borrow it during
+        // decoding; all surviving strings are copied into the tree's arena.
+        if (auto* buffer = dynamic_cast<std::stringbuf*>(in.rdbuf())) {
+            auto position = buffer->pubseekoff(0, std::ios::cur, std::ios::in);
+            auto data = buffer->view();
+            if (position < 0 || uint64_t(position) > data.size())
+                throw std::runtime_error("invalid parse archive stream position");
+            bytes = data.substr(size_t(position));
+            if (bytes.size() > 128 * 1024 * 1024)
+                throw std::runtime_error("parse archive exceeds size limit");
+            buffer->pubseekoff(0, std::ios::end, std::ios::in);
+            return;
+        }
+        // Read in blocks once; scalar decoding never enters iostream machinery.
+        std::array<char, 65536> block;
+        while (auto n = in.rdbuf()->sgetn(block.data(), block.size())) {
+            if (storage.size() + size_t(n) > 128 * 1024 * 1024)
+                throw std::runtime_error("parse archive exceeds size limit");
+            storage.append(block.data(), size_t(n));
+        }
+        bytes = storage;
+    }
+    bool atEnd() const { return offset == bytes.size(); }
+    uint64_t number() {
+        uint64_t result = 0;
+        for (unsigned shift = 0; shift < 64; shift += 7) {
+            if (atEnd())
+                throw std::runtime_error("truncated archive integer");
+            auto c = uint8_t(bytes[offset++]);
+            if (shift == 63 && (c & 254))
+                throw std::runtime_error("invalid archive integer");
+            result |= uint64_t(c & 127) << shift;
+            if (!(c & 128))
+                return result;
+        }
+        throw std::runtime_error("invalid archive integer");
+        return result;
+    }
+    size_t count() {
+        auto n = number();
+        if (n > 16000000)
+            throw std::runtime_error("parse archive count exceeds limit");
+        return size_t(n);
+    }
+    std::string text() { return std::string(view()); }
+    std::string_view string() { return copy(view()); }
+    std::string_view copy(std::string_view s) {
+        auto b = arena.copyFrom<char>(s);
+        return {b.data(), b.size()};
+    }
+    BufferID buffer() {
+        auto id = number();
+        if (id >= 0xfffffff)
+            return BufferID(uint32_t(id), "");
+        return BufferID(id ? uint32_t(id) + base : 0, "");
+    }
+    SourceLocation location() {
+        auto id = buffer();
+        auto offset = number();
+        return SourceLocation(id, offset);
+    }
+    parsing::Token token();
+    SyntaxNode* node();
+    void restoreParents() {
+        if (count() != nodes.size())
+            throw std::runtime_error("invalid archive parent graph size");
+        for (auto node : nodes) {
+            auto parent = number();
+            if (!node || parent > nodes.size())
+                throw std::runtime_error("invalid archive parent reference");
+            node->parent = parent ? nodes[size_t(parent) - 1] : nullptr;
+        }
+    }
+    template<class T>
+    T field() {
+        if constexpr (std::is_same_v<T, parsing::Token>)
+            return token();
+        else if constexpr (is_syntax_list_v<T>) {
+            SmallVector<TokenOrSyntax> children;
+            auto n = count();
+            for (size_t i = 0; i < n; ++i) {
+                auto isToken = number();
+                if (isToken)
+                    children.emplace_back(token());
+                else
+                    children.emplace_back(node());
+            }
+            return T(arena, std::span<const TokenOrSyntax>(children));
+        }
+        else if constexpr (std::is_pointer_v<T>) {
+            auto n = node();
+            using N = std::remove_pointer_t<T>;
+            if (n && !N::isKind(n->kind))
+                throw std::runtime_error("invalid parse archive node type");
+            return static_cast<T>(n);
+        }
+        else {
+            static_assert(!sizeof(T), "unsupported archive field");
+        }
+    }
+    BumpAllocator& arena;
+    SourceManager* sources;
+    bool allowExternalPaths = false;
+
+private:
+    std::string_view view() {
+        const auto size = count();
+        if (size > bytes.size() - offset)
+            throw std::runtime_error("truncated parse archive string");
+        auto result = std::string_view(bytes).substr(offset, size);
+        offset += size;
+        return result;
+    }
+    std::string storage;
+    std::string_view bytes;
+    size_t offset = 0;
+    uint32_t base;
+    std::vector<SyntaxNode*> nodes;
+};
+} // namespace slang::syntax
diff --git a/include/slang/util/CwdCoordinator.h b/include/slang/util/CwdCoordinator.h
new file mode 100644
index 000000000..2512673c7
--- /dev/null
+++ b/include/slang/util/CwdCoordinator.h
@@ -0,0 +1,37 @@
+// SPDX-License-Identifier: MIT
+#pragma once
+#include <atomic>
+#include <filesystem>
+#include <mutex>
+
+#include "slang/util/Util.h"
+namespace slang {
+/// Coordinates internal command-file cwd writers with trusted analysis phases.
+/// Does not protect the filesystem namespace against other processes.
+class SLANG_EXPORT CwdCoordinator {
+public:
+    class SLANG_EXPORT WriteLease {
+    public:
+        WriteLease();
+
+    private:
+        std::unique_lock<std::recursive_mutex> lock;
+    };
+    class SLANG_EXPORT AnalysisLease {
+    public:
+        AnalysisLease();
+        ~AnalysisLease();
+        AnalysisLease(const AnalysisLease&) = delete;
+        AnalysisLease& operator=(const AnalysisLease&) = delete;
+
+    private:
+        std::unique_lock<std::recursive_mutex> lock;
+    };
+    static void setCurrentPath(const std::filesystem::path& path, std::error_code& ec);
+
+private:
+    static std::recursive_mutex mutex;
+    static std::atomic<unsigned> activeAnalyses;
+    static thread_local unsigned localAnalyses;
+};
+} // namespace slang
diff --git a/source/util/CwdCoordinator.cpp b/source/util/CwdCoordinator.cpp
new file mode 100644
index 000000000..f9e9cae53
--- /dev/null
+++ b/source/util/CwdCoordinator.cpp
@@ -0,0 +1,36 @@
+// SPDX-License-Identifier: MIT
+#include "slang/util/CwdCoordinator.h"
+
+#include <stdexcept>
+namespace slang {
+std::recursive_mutex CwdCoordinator::mutex;
+std::atomic<unsigned> CwdCoordinator::activeAnalyses{0};
+thread_local unsigned CwdCoordinator::localAnalyses = 0;
+CwdCoordinator::WriteLease::WriteLease() : lock(mutex, std::defer_lock) {
+    // Fail before waiting: a parser callback can run on a pool worker while the
+    // phase owner is waiting for that worker. Waiting here would deadlock.
+    if (activeAnalyses.load())
+        SLANG_THROW(std::runtime_error("internal cwd mutation during fast analysis is forbidden"));
+    lock.lock();
+    if (activeAnalyses.load())
+        SLANG_THROW(std::runtime_error("internal cwd mutation during fast analysis is forbidden"));
+}
+CwdCoordinator::AnalysisLease::AnalysisLease() : lock(mutex, std::defer_lock) {
+    // Workers borrow an existing phase, never recursively acquire it. Reject
+    // accidental acquisition before locking so owner->pool waits cannot cycle.
+    if (activeAnalyses.load() && !localAnalyses)
+        SLANG_THROW(std::runtime_error(
+            "fast analysis phases must be owned by one state thread; workers borrow the phase"));
+    lock.lock();
+    ++localAnalyses;
+    ++activeAnalyses;
+}
+CwdCoordinator::AnalysisLease::~AnalysisLease() {
+    --localAnalyses;
+    --activeAnalyses;
+}
+void CwdCoordinator::setCurrentPath(const std::filesystem::path& path, std::error_code& ec) {
+    WriteLease lease;
+    std::filesystem::current_path(path, ec);
+}
+} // namespace slang
