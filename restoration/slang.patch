+TEST_CASE("Requested root checkpoints reject cross-root declarations callbacks and cancellation",
+          "[source-snapshot][root-checkpoint]") {
+    SourceManager sm;
+    auto baseBuffer = sm.assignText("base.sv", "`define VALUE 1\npackage p; endpackage\n");
+    auto a = sm.assignText("a.sv", "package crossing;\n");
+    auto b = sm.assignText("b.sv", "endpackage\nmodule top; endmodule\n");
+    auto base = SyntaxTree::fromBuffersWithCheckpoint(std::vector{baseBuffer}, sm);
+    auto parsed = SyntaxTree::afterCachedPrefixWithCheckpoint(base, std::vector{a, b}, 1);
+    REQUIRE(parsed->diagnostics().empty());
+    CHECK_FALSE(SyntaxTree::preparedSourcePrefix(parsed));
+    CHECK_FALSE(SyntaxTree::preparedSourcePrefix({}));
+    CHECK_THROWS(SyntaxTree::afterCachedPrefixWithCheckpoint(base, std::vector{a, b}, 0));
+    CHECK_THROWS(SyntaxTree::afterCachedPrefixWithCheckpoint(base, std::vector{a, b}, 2));
+    Bag callbacks;
+    unsigned events = 0;
+    callbacks.insertOrGet<PreprocessorOptions>().bufferChangeCB =
+        [&](BufferID, bool, bool) { ++events; };
+    CHECK_THROWS(SyntaxTree::afterCachedPrefixWithCheckpoint(base, std::vector{a, b}, 1, callbacks));
+    CHECK(events == 0);
+    Bag cancelled;
+    cancelled.insertOrGet<PreprocessorOptions>().parseCheckpoint = [] {
+        throw std::runtime_error("cancelled parse");
+    };
+    CHECK_THROWS_WITH(SyntaxTree::afterCachedPrefixWithCheckpoint(base, std::vector{a, b}, 1, cancelled),
+                      "cancelled parse");
+    auto retry = SyntaxTree::afterCachedPrefixWithCheckpoint(base, std::vector{a, b}, 1);
+    CHECK(retry->diagnostics().empty());
+}
