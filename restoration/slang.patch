+TEST_CASE("Declaration member views preserve warnings in includes without sibling leakage",
+          "[trusted-package][scope-member-view]") {
+    TempFile body("localparam int Included=32'd4294967297;\n", ".svh");
+    SourceManager sources;
+    auto text = fmt::format("package kept;\n`include \"{}\"\nendpackage\n"
+                            "package other; localparam int O=32'd4294967297; endpackage\n",
