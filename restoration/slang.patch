+std::shared_ptr<SourceManager> SourceManager::forkRetainedNamespace(
+    std::span<const BufferID> requiredBuffers) const {
+    auto result = std::make_shared<SourceManager>();
+    result->inheritIncludeConfiguration(getIncludeConfiguration());
+    std::shared_lock lock(mutex);
+    if (!immutablePrefix)
+        SLANG_THROW(std::invalid_argument("retained namespace requires an immutable base"));
+    for (auto id : requiredBuffers) {
+        auto file = getFileInfo(id, lock);
+        if (!file || !file->data || file->data->queryText)
+            SLANG_THROW(std::invalid_argument("retained namespace requires native buffers"));
+    }
+    result->immutablePrefix = immutablePrefix;
+    result->bufferEntries = bufferEntries;
+    result->lookupCache = lookupCache;
+    result->unnamedBufferCount.store(unnamedBufferCount.load());
+    result->diagDirectives = diagDirectives;
+    for (size_t i = 0; i < result->bufferEntries.size(); ++i) {
+        if (auto file = std::get_if<FileInfo>(&std::as_const(result->bufferEntries)[i])) {
+            if (file->data && file->data->queryText) {
+                result->bufferEntries[i] = FileInfo{};
+                result->diagDirectives.erase(BufferID{uint32_t(i), ""});
+                continue;
+            }
+            result->trackSourceData(file->data);
+            result->sourceEntryAuxBytes += file->metadataBytes();
+        }
+    }
+    for (auto it = result->lookupCache.begin(); it != result->lookupCache.end();) {
+        if (it->second.first && it->second.first->queryText)
+            it = result->lookupCache.erase(it);
+        else
+            ++it;
+    }
+    for (const auto& [_, value] : result->lookupCache)
+        result->trackSourceData(value.first);
+    for (auto& [_, directives] : result->diagDirectives)
+        for (auto& directive : directives)
+            directive.name = *result->retainedSourceNames.emplace(directive.name).first;
+    result->retainSourceNames();
+    return result;
+}
