+    compilation.unfreeze();
+    const auto* scope = cls ? &compilation.getPackage("p")->find<ClassType>("C")
+                            : static_cast<const Scope*>(compilation.getPackage("p"));
+    const auto& work = scope->find<SubroutineSymbol>("work");
+    const SubroutineSymbol* bodies[] = {&work};
+    const auto outside = compilation.getReferenceUsageExcludingBodies(bodies);
+    REQUIRE(outside);
+    for (const auto name : {"word_t", "helper"}) {
