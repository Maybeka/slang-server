+bool Compilation::isFixedInstanceBodyTypeArgument(const Type& type,
+                                                  const InstanceBodySymbol& rootBody) const {
+    auto fixed = [&](const Type& candidate) {
+        if (fixedBodyTypeOrigins.contains(&candidate))
+            return true;
+        auto scope = candidate.getParentScope();
+        return scope && std::ranges::any_of(importedCompilations, [&](const auto& owner) {
+                   return owner.get() == &scope->getCompilation();
+               });
+    };
+    auto local = [&](const Symbol& candidate) {
+        for (auto scope = candidate.getParentScope(); scope;) {
+            if (scope == &rootBody)
+                return true;
+            const auto& symbol = scope->asSymbol();
+            if (symbol.kind == SymbolKind::InstanceBody) {
+                auto instance = symbol.as<InstanceBodySymbol>().parentInstance;
+                scope = instance ? instance->getParentScope() : nullptr;
+            }
+            else
+                scope = symbol.getParentScope();
+        }
+        return false;
+    };
+    auto check = [&](auto&& self, const Type& candidate) -> bool {
+        if (candidate.kind == SymbolKind::TypeAlias) {
+            if (!local(candidate) && !fixed(candidate))
+                return false;
+            return self(self, candidate.as<TypeAliasType>().targetType.getType());
+        }
+        const auto& canonical = candidate.getCanonicalType();
+        if (canonical.kind == SymbolKind::PackedArrayType ||
+            canonical.kind == SymbolKind::FixedSizeUnpackedArrayType)
+            return self(self, *canonical.getArrayElementType());
+        if (canonical.kind == SymbolKind::EnumType ||
+            canonical.kind == SymbolKind::PackedStructType ||
+            canonical.kind == SymbolKind::PackedUnionType) {
+            if (fixed(canonical))
+                return true;
+            if (!canonical.getSyntax() || !local(canonical))
+                return false;
+            if (canonical.kind == SymbolKind::EnumType)
+                return self(self, canonical.as<EnumType>().baseType);
+            const Scope& fields = canonical.kind == SymbolKind::PackedStructType
+                                      ? static_cast<const Scope&>(canonical.as<PackedStructType>())
+                                      : static_cast<const Scope&>(canonical.as<PackedUnionType>());
+            for (auto& field : fields.membersOfType<FieldSymbol>())
+                if (!self(self, field.getType()))
+                    return false;
+            return true;
+        }
+        return canonical.isSimpleBitVector();
+    };
+    return check(check, type);
+}
