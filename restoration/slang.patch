+// Invocation-local only. Darwin obtains the resolved directory spelling from a
+// descriptor; other platforms prove ordinary prefixes once instead of walking
+// shared ancestors repeatedly. Unsupported paths use native weak canonical
+// resolution. Inspect components before handling '..': lexical normalization
+// could incorrectly erase a symlink or a missing intervening directory.
+class DirectoryWitness {
+public:
+    explicit DirectoryWitness(const fs::path& cwd) : cwd(cwd) {}
+
+    fs::path resolve(const fs::path& path, std::error_code& error) {
+#if defined(__APPLE__)
+        // Darwin's realpath also recovers actual component spelling on
+        // case-insensitive filesystems. Directory status alone cannot prove
+        // that spelling: an ordinary directory can be renamed in case only.
+        // Query an opened directory's current resolved path instead of walking
+        // all its ancestors. Missing/unreadable/long paths use native resolution.
+        const int fd = ::open(path.c_str(), O_RDONLY | O_DIRECTORY | O_CLOEXEC);
+        if (fd >= 0) {
+            char resolved[MAXPATHLEN];
+            const int result = ::fcntl(fd, F_GETPATH, resolved);
+            ::close(fd);
+            if (result == 0) {
+                error.clear();
+                return fs::path(resolved);
+            }
+        }
+#else
+        auto absolute = path.is_absolute() ? path : cwd / path;
+        if (absolute.root_name().empty() && absolute.has_root_directory()) {
+            fs::path prefix = absolute.root_path();
+            bool ordinary = check(prefix);
+            for (const auto& component : absolute.relative_path()) {
+                if (!ordinary)
+                    break;
+                if (component.empty() || component == ".")
+                    continue;
+                if (component == "..") {
+                    prefix = prefix.parent_path();
+                    continue;
+                }
+                prefix /= component;
+                ordinary = check(prefix);
+            }
+            if (ordinary) {
+                error.clear();
+                return prefix;
+            }
+        }
+#endif
+        return fs::weakly_canonical(path, error);
+    }
+
+private:
+    bool check(const fs::path& path) {
+        auto key = getU8Str(path);
+        if (directories.contains(key))
+            return true;
+        std::error_code error;
+        if (!fs::is_directory(fs::symlink_status(path, error)) || error)
+            return false;
+        directories.emplace(std::move(key));
+        return true;
+    }
+
+    [[maybe_unused]] const fs::path& cwd;
+    flat_hash_set<std::string> directories;
+};
+
+struct LeafWitness {
+    bool regular = false;
+    bool missing = false;
+};
+
+LeafWitness inspectLeaf(const fs::path& requested, [[maybe_unused]] const fs::path& expected) {
+#if defined(__APPLE__)
+    // Like directories, ordinary leaves can change canonical spelling on a
+    // case-insensitive volume without changing their bytes. One no-follow
+    // metadata query obtains both type and actual name; status alone is weaker.
+    struct LeafAttributes {
+        uint32_t length;
+        attrreference_t name;
+        fsobj_type_t type;
+        char storage[MAXPATHLEN];
+    } attributes{};
+    struct attrlist list{};
+    list.bitmapcount = ATTR_BIT_MAP_COUNT;
+    list.commonattr = ATTR_CMN_NAME | ATTR_CMN_OBJTYPE;
+    if (::getattrlist(requested.c_str(), &list, &attributes, sizeof(attributes), FSOPT_NOFOLLOW))
+        return {false, errno == ENOENT};
+    const auto offset = int64_t(offsetof(LeafAttributes, name)) + attributes.name.attr_dataoffset;
+    const auto length = attributes.name.attr_length;
+    if (attributes.type != VREG || attributes.length > sizeof(attributes) ||
+        offset < int64_t(offsetof(LeafAttributes, storage)) || size_t(offset) > attributes.length ||
+        !length || length > attributes.length - size_t(offset))
+        return {};
+    const auto* name = reinterpret_cast<const char*>(&attributes) + offset;
+    return {name[length - 1] == '\0' &&
+                std::string_view(name, length - 1) == getU8Str(expected.filename()),
+            false};
+#else
+    std::error_code error;
+    auto status = fs::symlink_status(requested, error);
+    return {fs::is_regular_file(status) && !error,
+            status.type() == fs::file_type::not_found &&
+                (!error || error == std::errc::no_such_file_or_directory)};
+#endif
+}
+#if defined(SLANG_USE_THREADS)
+ThreadPool& sourceWitnessPool() {
+    static ThreadPool pool(4);
+    return pool;
+}
+#endif
+} // namespace
+
+std::optional<std::string> SourceManager::sourceWitnessFailure(
+    std::span<const fs::path> overlayPaths, function_ref<void()> checkCancelled) const {
+    if (checkCancelled)
+        checkCancelled();
+    std::error_code cwdError;
+    auto cwd = fs::current_path(cwdError);
+    std::shared_lock includeLock(includeDirMutex);
+    std::shared_lock lock(mutex);
+    if (cwdError || !snapshotRecording || snapshotReplay || snapshotConflict ||
+        getU8Str(cwd) != snapshotCwd)
+        return "source context cannot provide a current filesystem witness";
+    auto overlay = [&](const fs::path& path) {
+        return std::find(overlayPaths.begin(), overlayPaths.end(), path) != overlayPaths.end();
+    };
+    for (const auto& witness : includeDirectoryWitnesses) {
+        if (checkCancelled)
+            checkCancelled();
+        if (!witness.literal && witness.base.empty())
+            return "source context cannot witness its original include directory base";
+        SmallVector<fs::path> matches;
+        std::error_code error;
+        if (witness.literal) {
+            auto path = fs::canonical(witness.pattern, error);
+            if (!error && fs::is_directory(path, error))
+                matches.push_back(path);
+        }
+        else
+            svGlob(witness.base, witness.pattern, GlobMode::Directories, matches, false, error);
+        if (error != witness.error || !std::ranges::equal(matches, witness.matches))
+            return "include directory resolution changed: " + witness.pattern;
+    }
+    // Resolve original requests again, even when two targets happen to have equal
+    // bytes: physical source identity affects locations and nested include lookup.
+    // Most positive lookups are ordinary files sharing a few directories. Resolve
+    // each parent once in this invocation, but still inspect every leaf (a file
+    // can become a symlink) and read every closed source below. Nothing survives
+    // across witnesses. A missing leaf also permits sharing its weakly canonical
+    // parent (including missing suffixes); its failed read is still checked below.
+    // Leaf symlinks and resolution errors use the full native resolution. Recheck
+    // parents before accepting, including those whose directories did not exist.
+    using ParentProofs = flat_hash_map<std::string, fs::path>;
+    ParentProofs resolvedParents;
+    auto validateLookup = [&](const auto& lookup,
+                              auto&& resolveParent) -> std::optional<std::string> {
+        const auto& [alias, value] = lookup;
+        const auto& targets = snapshotLookupTargets;
+        auto target = targets.find(alias);
+        if (target == targets.end())
+            return "source lookup has no recorded resolution: " + alias;
+        std::error_code error;
+        fs::path requested(alias);
+        bool resolved = false;
+        if (!disableProximatePaths && !target->second.empty()) {
+            fs::path expected(target->second);
+            auto leaf = requested.filename();
+            if (!leaf.empty() && leaf != "." && leaf != ".." && leaf == expected.filename()) {
+                const auto witness = inspectLeaf(requested, expected);
+                if (witness.regular || witness.missing) {
+                    auto parent = requested.parent_path();
+                    if (parent.empty())
+                        parent = ".";
+                    if (const auto* canonical = resolveParent(parent))
+                        resolved = *canonical / leaf == expected;
+                }
+            }
+        }
+        if (resolved)
+            return std::nullopt;
+        error.clear();
+        auto current = disableProximatePaths ? requested : fs::weakly_canonical(requested, error);
+        if (error && !value.first && value.second == error && target->second.empty())
+            return std::nullopt; // An unchanged failure during canonicalization is itself a
+                                 // negative witness.
+        if (error || getU8Str(current) != target->second)
+            return "source lookup resolution changed: " + alias;
+        return std::nullopt;
+    };
+#if defined(SLANG_USE_THREADS)
+    if (snapshotLookups.size() >= 64) {
+        using Lookup = decltype(snapshotLookups)::value_type;
+        using PlannedParents = flat_hash_map<std::string, std::optional<fs::path>>;
+        using PlannedParent = PlannedParents::value_type;
+        PlannedParents plannedParents;
+        DirectoryWitness directories(cwd);
+        std::vector<const Lookup*> lookups;
+        lookups.reserve(snapshotLookups.size());
+        const auto& targets = snapshotLookupTargets;
+        for (const auto& lookup : snapshotLookups) {
+            if (checkCancelled)
+                checkCancelled();
+            lookups.push_back(&lookup);
+            const auto target = targets.find(lookup.first);
+            if (disableProximatePaths || target == targets.end() || target->second.empty())
+                continue;
+            fs::path requested(lookup.first), expected(target->second);
+            const auto leaf = requested.filename();
+            if (leaf.empty() || leaf == "." || leaf == ".." || leaf != expected.filename())
+                continue;
+            auto parent = requested.parent_path();
+            if (parent.empty())
+                parent = ".";
+            auto key = getU8Str(parent);
+            if (plannedParents.contains(key))
+                continue;
+            std::error_code error;
+            auto canonical = directories.resolve(parent, error);
+            plannedParents.emplace(std::move(key),
+                                   error ? std::nullopt : std::optional(std::move(canonical)));
+        }
+        // The table is immutable while workers run. Each worker records only
+        // the parents it actually used, so irrelevant symlink parents do not
+        // introduce extra invalidations at the final recheck.
+        const auto& parentTable = plannedParents;
+        std::vector<const PlannedParent*> usedParents(lookups.size());
+        std::array<std::future<std::optional<std::string>>, 4> pending;
+        std::atomic<bool> stopped = false;
+        struct DrainAliases {
+            decltype(pending)& jobs;
+            std::atomic<bool>& stopped;
+            ~DrainAliases() {
+                stopped = true;
+                for (auto& job : jobs) {
+                    if (job.valid())
+                        job.wait();
+                }
+            }
+        } drain{pending, stopped};
+        auto& pool = sourceWitnessPool();
+        size_t tasks = 0;
+        for (size_t start = 0, step = (lookups.size() + 3) / 4; start < lookups.size();
+             start += step) {
+            if (checkCancelled)
+                checkCancelled();
+            const auto end = std::min(start + step, lookups.size());
+            pending[tasks++] = pool.submit_task([&, start, end]() -> std::optional<std::string> {
+                for (size_t i = start; i < end && !stopped.load(); i++) {
+                    auto resolveParent = [&](const fs::path& parent) -> const fs::path* {
+                        const auto found = parentTable.find(getU8Str(parent));
+                        if (found == parentTable.end())
+                            throw std::logic_error("source parent missing from witness plan");
+                        usedParents[i] = &*found;
+                        return found->second ? &*found->second : nullptr;
+                    };
+                    if (auto failure = validateLookup(*lookups[i], resolveParent))
+                        return failure;
+                }
+                return std::nullopt;
+            });
+        }
+        for (size_t i = 0; i < tasks; i++) {
+            if (checkCancelled)
+                checkCancelled();
+            if (auto failure = pending[i].get())
+                return failure;
+        }
+        for (const auto* parent : usedParents) {
+            if (!parent)
+                continue;
+            if (!parent->second)
+                return "source lookup parent cannot be certified: " + parent->first;
+            resolvedParents.emplace(parent->first, *parent->second);
+        }
+    }
+    else
+#endif
+    {
+        DirectoryWitness directories(cwd);
+        auto resolveParent = [&](const fs::path& parent) -> const fs::path* {
+            auto key = getU8Str(parent);
+            auto found = resolvedParents.find(key);
+            if (found == resolvedParents.end()) {
+                std::error_code error;
+                auto canonical = directories.resolve(parent, error);
+                if (!error)
+                    found = resolvedParents.emplace(std::move(key), std::move(canonical)).first;
+            }
+            return found == resolvedParents.end() ? nullptr : &found->second;
+        };
+        for (const auto& lookup : snapshotLookups) {
+            if (checkCancelled)
+                checkCancelled();
+            if (auto failure = validateLookup(lookup, resolveParent))
+                return failure;
+        }
+    }
+    struct ReadWitness {
+        const std::string* path;
+        const FileData* file;
+        std::error_code error;
+    };
+    auto changed = [](const ReadWitness& witness) {
+        SmallVector<char> bytes;
+        auto error = OS::readFile(fs::path(*witness.path), bytes);
+        return error != witness.error ||
+               (!error &&
+                (!witness.file || witness.file->isStale ||
+                 std::string_view(bytes.data(), bytes.size()) !=
+                     std::string_view(witness.file->mem.data(), witness.file->mem.size())));
+    };
+    std::vector<ReadWitness> reads;
+    for (const auto& [path, value] : lookupCache) {
+        if (snapshotGeneratedPaths.contains(path) ||
+            (value.first && overlay(value.first->fullPath)))
+            continue;
+        reads.push_back({&path, value.first.get(), value.second});
+    }
+#if defined(SLANG_USE_THREADS)
+    if (reads.size() >= 64) {
+        // Fixed, bounded I/O concurrency, independent of graph size. No worker
+        // touches mutable source or AST state; the caller holds both read locks.
+        auto& pool = sourceWitnessPool();
+        std::vector<std::future<std::optional<size_t>>> pending;
+        pending.reserve(4);
+        struct Drain {
+            decltype(pending)& jobs;
+            ~Drain() {
+                // A cancelled caller / failed submission must not release its
+                // locks or captured storage while any worker still uses them.
+                for (auto& job : jobs) {
+                    if (job.valid())
+                        job.wait();
+                }
+            }
+        } drain{pending};
+        for (size_t start = 0, step = (reads.size() + 3) / 4; start < reads.size(); start += step) {
+            if (checkCancelled)
+                checkCancelled();
+            const auto end = std::min(start + step, reads.size());
+            pending.push_back(pool.submit_task([&, start, end]() -> std::optional<size_t> {
+                for (size_t i = start; i < end; i++) {
+                    if (changed(reads[i]))
+                        return i;
+                }
+                return std::nullopt;
+            }));
+        }
+        // Consume in original lookup order, preserving the first failure.
+        for (auto& job : pending) {
+            if (checkCancelled)
+                checkCancelled();
+            if (auto index = job.get())
+                return "source bytes or failed lookup changed: " + *reads[*index].path;
+        }
+    }
+    else
+#endif
+    {
+        for (const auto& read : reads) {
+            if (checkCancelled)
+                checkCancelled();
+            if (changed(read))
+                return "source bytes or failed lookup changed: " + *read.path;
+        }
+    }
+    // Fresh prefix proofs after reading closed files, independent of the first
+    // phase. This retains the existing parent-identity recheck boundary.
+    DirectoryWitness finalDirectoryWitness(cwd);
+    for (const auto& [parent, expected] : resolvedParents) {
+        if (checkCancelled)
+            checkCancelled();
+        std::error_code error;
+        if (finalDirectoryWitness.resolve(parent, error) != expected || error)
+            return "source lookup parent resolution changed: " + parent;
+    }
+    return std::nullopt;
+}
+
+SourceManager::SourceSnapshot SourceManager::captureSnapshot(
+    std::span<const BufferID> graphBuffers) const {
+    if (snapshotReplay)
+        SLANG_THROW(std::runtime_error("cannot capture a replay manager"));
+    const auto cwd = getU8Str(fs::current_path());
+    std::shared_lock<std::shared_mutex> includeLock(includeDirMutex);
+    std::shared_lock<std::shared_mutex> lock(mutex);
+    if (!snapshotRecording || snapshotReplay || snapshotConflict || cwd != snapshotCwd)
+        SLANG_THROW(std::runtime_error("source snapshot has unsupported or conflicting context"));
+    constexpr size_t maxCapturedFiles = 100000;
+    constexpr size_t maxCapturedEntries = 500000;
+    constexpr size_t maxCapturedFileBytes = 64 * 1024 * 1024;
+    if (snapshotLookups.size() > maxCapturedEntries ||
+        snapshotHeaderRequests.size() > maxCapturedEntries)
+        SLANG_THROW(std::runtime_error("source snapshot exceeds 500000 recorded-entry limit"));
+    SourceSnapshot result;
+    result.cwd = snapshotCwd;
+    result.disableProximatePaths = disableProximatePaths;
+    result.disableLocalIncludes = disableLocalIncludes;
+    result.incDirFirst = incDirFirst;
+    for (auto& dir : systemDirectories)
+        result.systemDirectories.push_back(getU8Str(dir));
+    for (auto& dir : userDirectories)
+        result.userDirectories.push_back(getU8Str(dir));
+    size_t capturedFileBytes = 0;
+    flat_hash_map<const FileData*, uint32_t> ids;
+    auto addFile = [&](const std::shared_ptr<FileData>& fd) -> uint32_t {
+        if (!fd || fd->isStale)
+            SLANG_THROW(std::runtime_error("source snapshot contains stale source data"));
+        if (fd->mem.empty() || fd->mem.back() != '\0')
+            SLANG_THROW(std::runtime_error("source snapshot buffer is missing its sentinel"));
+        if (auto it = ids.find(fd.get()); it != ids.end())
+            return it->second;
+        if (result.files.size() >= maxCapturedFiles)
+            SLANG_THROW(std::runtime_error("source snapshot exceeds 100000 unique-file limit"));
+        if (fd->mem.size() > maxCapturedFileBytes - capturedFileBytes)
+            SLANG_THROW(std::runtime_error("source snapshot exceeds 64 MiB file-byte limit"));
+        const auto id = uint32_t(result.files.size() + 1);
+        ids.emplace(fd.get(), id);
+        capturedFileBytes += fd->mem.size();
+        result.files.push_back({getU8Str(fd->fullPath), getU8Str(*fd->directory), fd->name,
+                                std::string(fd->mem.data(), fd->mem.size()),
+                                snapshotGeneratedPaths.contains(getU8Str(fd->fullPath))});
+        return id;
+    };
+    flat_hash_set<BufferID> visited;
+    std::function<void(BufferID)> validateBuffer = [&](BufferID id) {
+        if (!id || id.getId() >= bufferEntries.size())
+            SLANG_THROW(std::runtime_error("source snapshot graph has unknown buffer"));
+        if (!visited.insert(id).second)
+            return;
+        if (auto info = getFileInfo(id, lock)) {
+            if (info->library || info->bufferKind == BufferKind::LibraryFile ||
+                info->bufferKind == BufferKind::LibraryMap)
+                SLANG_THROW(std::runtime_error("source library contexts are unsupported"));
+            if (info->hasExternalDirectives)
+                SLANG_THROW(
+                    std::runtime_error("externally injected source directives are unsupported"));
+            addFile(info->data);
+            if (info->includedFrom.valid())
+                validateBuffer(info->includedFrom.buffer());
+        }
+        else {
+            auto& expansion = std::get<ExpansionInfo>(bufferEntries[id.getId()]);
+            if (expansion.originalLoc.valid())
+                validateBuffer(expansion.originalLoc.buffer());
+            if (expansion.expansionRange.start().valid())
+                validateBuffer(expansion.expansionRange.start().buffer());
+            if (expansion.expansionRange.end().valid())
+                validateBuffer(expansion.expansionRange.end().buffer());
+        }
+    };
+    for (auto id : graphBuffers) {
+        validateBuffer(id);
+        if (!id || id.getId() >= bufferEntries.size())
+            SLANG_THROW(std::runtime_error("source snapshot graph has unknown buffer"));
+        auto info = getFileInfo(id, lock);
+        if (info) {
+            if (info->library)
+                SLANG_THROW(std::runtime_error("source libraries are unsupported in snapshots"));
+            result.graphFileIds.push_back(addFile(info->data));
+        }
+        else {
+            result.graphFileIds.push_back(0);
+        }
+    }
+    // Include generated/predefine buffers too: the fresh preprocessor recreates their
+    // locations and directives but must receive the same owned bytes and display names.
+    for (auto& entry : bufferEntries) {
+        if (auto info = std::get_if<FileInfo>(&entry); info && info->library)
+            SLANG_THROW(std::runtime_error("source libraries are unsupported in snapshots"));
+    }
+    for (auto& [key, value] : lookupCache) {
+        if (value.first)
+            addFile(value.first);
+    }
+    for (auto& [key, value] : snapshotLookups) {
+        SourceSnapshot::Lookup lookup;
+        lookup.path = key;
+        if (value.first)
+            lookup.fileId = addFile(value.first);
+        else {
+            if (!value.second)
+                SLANG_THROW(std::runtime_error("source snapshot contains an incomplete lookup"));
+            lookup.errorValue = value.second.value();
+            lookup.errorCategory = value.second.category().name();
+            if (value.second.category() != std::generic_category() &&
+                value.second.category() != std::system_category())
+                SLANG_THROW(std::runtime_error("unsupported source error category"));
+        }
+        result.lookups.push_back(std::move(lookup));
+    }
+    result.headerRequests.assign(snapshotHeaderRequests.begin(), snapshotHeaderRequests.end());
+    return result;
+}
+
+void SourceManager::loadSnapshot(const SourceSnapshot& snapshot) {
+    std::unique_lock<std::shared_mutex> includeLock(includeDirMutex);
+    std::unique_lock<std::shared_mutex> lock(mutex);
+    if (bufferEntries.size() != 1 || !lookupCache.empty() || !systemDirectories.empty() ||
+        !userDirectories.empty() || snapshotRecording || snapshotReplay ||
+        snapshot.schemaVersion != SourceSnapshot::SchemaVersion)
+        SLANG_THROW(std::runtime_error("snapshot load requires a fresh manager and known schema"));
+    // Validate before changing any state.
+    flat_hash_set<std::string> paths;
+    for (auto& file : snapshot.files) {
+        if (file.bytes.empty() || file.bytes.back() != '\0' || !paths.insert(file.fullPath).second)
+            SLANG_THROW(std::runtime_error("invalid or conflicting snapshot file"));
+    }
+    paths.clear();
+    for (auto& lookup : snapshot.lookups) {
+        if (!paths.insert(lookup.path).second || lookup.fileId > snapshot.files.size() ||
+            (lookup.fileId && (lookup.errorValue || !lookup.errorCategory.empty())) ||
+            (!lookup.fileId && (!lookup.errorValue || (lookup.errorCategory != "generic" &&
+                                                       lookup.errorCategory != "system"))))
+            SLANG_THROW(std::runtime_error("invalid snapshot lookup"));
+    }
+    for (auto id : snapshot.graphFileIds) {
+        if (id > snapshot.files.size())
+            SLANG_THROW(std::runtime_error("invalid snapshot graph file ID"));
+    }
+    snapshotCwd = snapshot.cwd;
+    disableProximatePaths = snapshot.disableProximatePaths;
+    disableLocalIncludes = snapshot.disableLocalIncludes;
+    incDirFirst = snapshot.incDirFirst;
+    for (auto& dir : snapshot.systemDirectories)
+        systemDirectories.emplace_back(dir);
+    for (auto& dir : snapshot.userDirectories)
+        userDirectories.emplace_back(dir);
+    snapshotFiles.push_back(nullptr);
+    for (auto& file : snapshot.files) {
+        SmallVector<char> bytes;
+        bytes.insert(bytes.end(), file.bytes.begin(), file.bytes.end());
+        auto directory = &*directories.insert(fs::path(file.directory)).first;
+        auto fd = std::make_shared<FileData>(directory, file.displayName, std::move(bytes),
+                                             fs::path(file.fullPath));
+        snapshotFiles.push_back(fd);
+        if (file.generated)
+            snapshotGeneratedPaths.insert(file.fullPath);
+        lookupCache.emplace(file.fullPath, std::pair{fd, std::error_code{}});
+    }
+    for (auto& lookup : snapshot.lookups) {
+        std::pair<std::shared_ptr<FileData>, std::error_code> value;
+        if (lookup.fileId)
+            value.first = snapshotFiles[lookup.fileId];
+        else
+            value.second = std::error_code(lookup.errorValue, lookup.errorCategory == "generic"
+                                                                  ? std::generic_category()
+                                                                  : std::system_category());
+        snapshotLookups.emplace(lookup.path, std::move(value));
+    }
+    snapshotHeaderRequests.insert(snapshot.headerRequests.begin(), snapshot.headerRequests.end());
+    snapshotReplay = true;
+}
+
+bool SourceManager::tryUpdateSnapshot(const SourceSnapshot& snapshot,
+                                      std::span<const BufferID> retained) {
+    // Reuse fresh-load validation without changing its strict public contract.
+    SourceManager next;
+    next.loadSnapshot(snapshot);
+    std::unique_lock<std::shared_mutex> includeLock(includeDirMutex);
+    std::unique_lock<std::shared_mutex> lock(mutex);
+    auto decline = [](const char* reason) {
+        if (auto* path = std::getenv("SLANG_UVM_WORKER_CACHE_TRACE"))
+            if (auto* file = std::fopen(path, "a")) {
+                std::fprintf(file, "%ld\tsnapshot-%s\n", long(OS::getpid()), reason);
+                std::fclose(file);
+            }
+        return false;
+    };
+    if (!snapshotReplay || snapshotGeneratedSequenceActive || snapshotIncompleteFlag ||
+        retained.empty())
+        return decline("not-idle");
+    if (snapshotCwd != next.snapshotCwd || disableProximatePaths != next.disableProximatePaths ||
+        disableLocalIncludes != next.disableLocalIncludes || incDirFirst != next.incDirFirst)
+        return decline("settings");
+    if (systemDirectories != next.systemDirectories || userDirectories != next.userDirectories)
+        return decline("include-directories");
+    if (snapshotLookups.size() != next.snapshotLookups.size())
+        return decline("lookup-size");
+    if (snapshotHeaderRequests.size() != next.snapshotHeaderRequests.size())
+        return decline("header-size");
+    for (auto& request : snapshotHeaderRequests)
+        if (!next.snapshotHeaderRequests.contains(request))
+            return decline("header-topology");
+    auto sameIdentity = [](const FileData& a, const FileData& b) {
+        return a.fullPath == b.fullPath && a.name == b.name && *a.directory == *b.directory;
+    };
+    for (auto& [path, value] : snapshotLookups) {
+        auto it = next.snapshotLookups.find(path);
+        if (it == next.snapshotLookups.end() || value.second != it->second.second ||
+            bool(value.first) != bool(it->second.first) ||
+            (value.first && !sameIdentity(*value.first, *it->second.first)))
+            return decline("lookup-identity");
+    }
+    flat_hash_map<std::string, std::shared_ptr<FileData>> keep;
+    for (auto id : retained) {
+        auto info = getFileInfo(id, lock);
+        if (!info || !info->data || info->data->isStale || info->library ||
+            info->hasExternalDirectives)
+            return decline("retained-id");
+        auto path = getU8Str(info->data->fullPath);
+        // Unrelated parses can add unnamed generated files to the recording.
+        // Only explicitly retained files carry state into this next parse.
+        if (snapshotGeneratedPaths.contains(path) != next.snapshotGeneratedPaths.contains(path))
+            return decline("retained-generated-identity");
