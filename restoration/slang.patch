+void freezeDirectiveAncestry(SyntaxNode& node, DirectiveSummary& summary);
+void freezeDirectiveTrivia(std::span<const Trivia> trivia, SyntaxNode& parent,
+                           DirectiveSummary& summary) {
+    for (const auto& entry : trivia) {
+        if (entry.kind == TriviaKind::Directive) {
+            auto& directive = *entry.syntax();
+            freezeDirectiveAncestry(directive, summary);
+            directive.parent = &parent;
