+    child.inheritImmutablePrefix(prefix);
+    REQUIRE(original.getLineDirectives(buffer.id).size() == 2);
+    REQUIRE(child.getLineDirectives(buffer.id).size() == 1);
+    CHECK(child.getBufferKind(buffer.id) == SourceManager::BufferKind::DesignFile);
+    child.setBufferKind(buffer.id, SourceManager::BufferKind::LibraryMap);
+    child.addLineDirective(SourceLocation(buffer.id, 4), 90, "child-map.sv", 0, true);
+    CHECK(original.getBufferKind(buffer.id) == SourceManager::BufferKind::DesignFile);
+    CHECK(child.getBufferKind(buffer.id) == SourceManager::BufferKind::LibraryMap);
+    CHECK(original.getLineDirectives(buffer.id).back().name.ends_with("original-map.sv"));
+    CHECK(child.getLineDirectives(buffer.id).back().name.ends_with("child-map.sv"));
+    CHECK(original.getFileName(SourceLocation(buffer.id, 6)).ends_with("original-map.sv"));
+    CHECK(child.getFileName(SourceLocation(buffer.id, 6)).ends_with("child-map.sv"));
+    SourceManager::StorageUsageAccumulator usage;
+    usage.add(original);
+    usage.add(child);
+    auto shared = usage.usage();
+    CHECK(shared.source.dataBytes == original.getMemoryUsageDetails().dataBytes);
+    CHECK(shared.locationTableBytes ==
+          original.getSourceLocationTableBytes() + child.getSourceLocationTableBytes());
+    CHECK(shared.immutableTableBytes > plainBytes);
+}
