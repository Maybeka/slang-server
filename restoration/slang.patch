+            // Module-target binds can affect every occurrence. Hierarchical
+            // targets require current elaboration and stay native conservatively.
+            compatible =
+                node.target->kind == SyntaxKind::IdentifierName &&
+                !definitions.contains(
+                    node.target->template as<IdentifierNameSyntax>().identifier.valueText());
+        }
+        else
+            self.visitDefault(node);
+    });
+    for (const auto& tree : syntaxTrees)
+        if (tree->getMetadata().hasBindDirectives)
+            tree->root().visit(visitor);
+    bodyBindContextCompatible = compatible;
+    return compatible;
+}
+
+bool Compilation::recordInstanceBodyTypeDependency(const Type& replacement, const Type& source) {
+    if (!instanceBodyCacheContext || !isElaborated() || hasFatalErrors())
+        return false;
+    std::vector<std::pair<const Type*, std::string>> staged;
+    std::vector<std::pair<const Type*, InstanceBodyTypePresentation>> presentations;
+    std::vector<std::pair<const Type*, const Type*>> nominalNames;
+    auto presentation = [](const Type& type) {
+        InstanceBodyTypePresentation result;
+        if (auto scope = type.getParentScope()) {
+            if (auto stored = scope->getCompilation().getInstanceBodyTypePresentation(type))
+                return *stored;
+            const auto& symbol = scope->asSymbol();
+            if (symbol.kind != SymbolKind::CompilationUnit) {
+                result.scope = symbol.getLexicalPath();
+                result.scope += symbol.kind == SymbolKind::Package ||
+                                        symbol.kind == SymbolKind::ClassType ||
+                                        symbol.kind == SymbolKind::CovergroupType
+                                    ? "::"
+                                    : ".";
+            }
+        }
+        result.name = type.name;
+        return result;
+    };
+    std::vector<std::pair<const Symbol*, const Symbol*>> sourceSymbols;
+    size_t visited = 0;
+    auto record = [&](auto&& self, const Type& left, const Type& right, unsigned depth) -> bool {
+        if (depth > 64 || ++visited > 4096)
+            return false;
+        if (&left == &right)
+            return true;
+        if (left.kind == SymbolKind::TypeAlias) {
+            auto scope = left.getParentScope();
+            if (!scope || &scope->getCompilation() != this)
+                return false;
+            std::string aliasOrigin;
+            if (right.kind == SymbolKind::TypeAlias && right.getParentScope())
+                aliasOrigin = right.getParentScope()->getCompilation().instanceBodyTypeOrigin(
+                    right);
+            staged.emplace_back(&left, std::move(aliasOrigin));
+            if (right.kind == SymbolKind::TypeAlias)
+                sourceSymbols.emplace_back(&left, &right);
+            auto display = presentation(right);
+            display.transparent |= right.kind != SymbolKind::TypeAlias;
+            presentations.emplace_back(&left, std::move(display));
+            return self(self, left.as<TypeAliasType>().targetType.getType(),
+                        right.kind == SymbolKind::TypeAlias
+                            ? right.as<TypeAliasType>().targetType.getType()
+                            : right,
+                        depth + 1);
+        }
+        if (right.kind == SymbolKind::TypeAlias)
+            return self(self, left, right.as<TypeAliasType>().targetType.getType(), depth + 1);
+        const auto& x = left.getCanonicalType();
+        const auto& y = right.getCanonicalType();
+        if (&x == &y)
+            return true;
+        if (x.kind != y.kind)
+            return false;
+        if (x.kind == SymbolKind::FixedSizeUnpackedArrayType) {
+            const auto& a = x.as<FixedSizeUnpackedArrayType>();
+            const auto& b = y.as<FixedSizeUnpackedArrayType>();
+            return a.range == b.range && self(self, a.elementType, b.elementType, depth + 1);
+        }
+        if (!x.isIntegral() || x.getBitWidth() != y.getBitWidth() || x.isSigned() != y.isSigned() ||
+            x.isFourState() != y.isFourState())
+            return false;
+        if (x.kind == SymbolKind::PackedArrayType) {
+            const auto& a = x.as<PackedArrayType>();
+            const auto& b = y.as<PackedArrayType>();
+            return a.range == b.range && self(self, a.elementType, b.elementType, depth + 1);
+        }
+        const bool nominal = x.kind == SymbolKind::EnumType ||
+                             x.kind == SymbolKind::PackedStructType ||
+                             x.kind == SymbolKind::PackedUnionType;
+        if (nominal) {
+            auto scope = y.getParentScope();
+            if (!scope || !x.getParentScope() || &x.getParentScope()->getCompilation() != this)
+                return false;
+            auto origin = scope->getCompilation().instanceBodyTypeOrigin(y);
+            if (origin.empty())
+                return false;
+            staged.emplace_back(&x, std::move(origin));
+            presentations.emplace_back(&x, presentation(y));
+            nominalNames.emplace_back(&x, &y);
+            sourceSymbols.emplace_back(&x, &y);
+        }
+        if (x.kind == SymbolKind::EnumType) {
+            const auto& a = x.as<EnumType>();
+            const auto& b = y.as<EnumType>();
+            if (!self(self, a.baseType, b.baseType, depth + 1))
+                return false;
+            auto av = a.values(), bv = b.values();
+            auto ai = av.begin(), bi = bv.begin();
+            for (; ai != av.end() && bi != bv.end(); ++ai, ++bi)
+                if (ai->name != bi->name || ai->getValue() != bi->getValue())
+                    return false;
+                else
+                    sourceSymbols.emplace_back(&*ai, &*bi);
+            return ai == av.end() && bi == bv.end();
+        }
+        if (x.kind == SymbolKind::PackedStructType || x.kind == SymbolKind::PackedUnionType) {
+            if (x.kind == SymbolKind::PackedUnionType &&
+                (x.as<PackedUnionType>().isTagged != y.as<PackedUnionType>().isTagged ||
+                 x.as<PackedUnionType>().isSoft != y.as<PackedUnionType>().isSoft))
+                return false;
+            auto fields = [](const Type& value) -> const Scope& {
+                return value.kind == SymbolKind::PackedStructType
+                           ? static_cast<const Scope&>(value.as<PackedStructType>())
+                           : static_cast<const Scope&>(value.as<PackedUnionType>());
+            };
+            auto av = fields(x).template membersOfType<FieldSymbol>();
+            auto bv = fields(y).template membersOfType<FieldSymbol>();
+            auto ai = av.begin(), bi = bv.begin();
+            for (; ai != av.end() && bi != bv.end(); ++ai, ++bi)
+                if (ai->name != bi->name || !self(self, ai->getType(), bi->getType(), depth + 1))
+                    return false;
+                else
+                    sourceSymbols.emplace_back(&*ai, &*bi);
+            return ai == av.end() && bi == bv.end();
+        }
+        return x.isSimpleBitVector() && x.isMatching(y);
+    };
+    if (!record(record, replacement, source, 0))
+        return false;
+    // Detached syntax and physical locations belong to the immutable source
+    // prefix, never the old consumer's arena or recyclable expansion buffers.
+    flat_hash_map<const SyntaxNode*, SyntaxNode*> syntaxCopies;
+    std::vector<std::tuple<Symbol*, SourceLocation, const SyntaxNode*>> sourceCopies;
+    for (auto [target, original] : sourceSymbols) {
+        auto scope = original->getParentScope();
+        auto manager = scope ? scope->getCompilation().getSourceManager() : nullptr;
+        if (!manager || !sourceManager || !manager->sharesImmutablePrefix(*sourceManager))
+            return false;
+        auto location = manager->projectImmutableOriginalLocation(original->location);
+        if (!location)
+            return false;
+        const SyntaxNode* syntax = original->getSyntax();
+        if (syntax && !syntaxCopies.contains(syntax)) {
+            auto root = syntax;
+            if (root->parent && (root->kind == SyntaxKind::Declarator ||
+                                 root->parent->kind == SyntaxKind::TypedefDeclaration ||
+                                 root->parent->kind == SyntaxKind::TypeParameterDeclaration))
+                root = root->parent;
+            auto copy = syntax::deepClone(*root, *this);
+            auto project = [&](auto&& self, const SyntaxNode& from, SyntaxNode& to) -> bool {
+                syntaxCopies.emplace(&from, &to);
+                for (size_t i = 0; i < from.getChildCount(); ++i) {
+                    if (auto child = from.childNode(i)) {
+                        if (!self(self, *child, *to.childNode(i)))
+                            return false;
+                    }
+                    else if (auto token = to.childTokenPtr(i); token && *token) {
+                        auto projected = manager->projectImmutableOriginalLocation(
+                            token->location());
+                        if (!projected)
+                            return false;
+                        *token = token->withLocation(*this, *projected);
+                    }
+                }
+                return true;
+            };
+            if (!project(project, *root, *copy))
+                return false;
+        }
+        sourceCopies.emplace_back(const_cast<Symbol*>(target), *location,
+                                  syntax ? syntaxCopies.at(syntax) : nullptr);
+    }
+    for (auto [target, location, syntax] : sourceCopies) {
+        target->location = location;
+        if (syntax)
+            target->setSyntax(*syntax);
+    }
+    for (auto& [type, origin] : staged)
+        fixedBodyTypeOrigins.insert_or_assign(type, std::move(origin));
+    for (auto& [type, display] : presentations)
+        fixedBodyTypePresentations.insert_or_assign(type, std::move(display));
+    for (auto [type, original] : nominalNames) {
+        auto text = copyFrom<char>(std::span(original->name.data(), original->name.size()));
+        auto& target = const_cast<Type&>(*type);
+        target.name = std::string_view(text.data(), text.size());
+        if (type->kind == SymbolKind::EnumType)
+            target.as<EnumType>().systemId = original->as<EnumType>().systemId;
+        else if (type->kind == SymbolKind::PackedStructType)
+            target.as<PackedStructType>().systemId = original->as<PackedStructType>().systemId;
+        else if (type->kind == SymbolKind::PackedUnionType)
+            target.as<PackedUnionType>().systemId = original->as<PackedUnionType>().systemId;
+    }
+    return true;
+}
+
+const Type* Compilation::getInstanceBodyTypeIdentity(const Type& type) const {
+    auto found = importedBodyTypeIdentities.find(&type);
+    return found == importedBodyTypeIdentities.end() ? &type : found->second;
+}
+
+bool Compilation::tryImportInstanceBody(std::shared_ptr<Compilation> owner,
+                                        const InstanceBodySymbol& retained,
+                                        InstanceBodySymbol& target) {
+    if (!owner || owner.get() == this || isElaborated() || isFrozen() || !owner->isElaborated() ||
+        !isInstanceBodyBindContextCompatible() || !owner->importedBodyFrames.empty() ||
+        &retained.getCompilation() != owner.get() || &target.getCompilation() != this ||
+        !sourceManager || !owner->sourceManager ||
+        !sourceManager->sharesImmutablePrefix(*owner->sourceManager) || stdPkg != owner->stdPkg ||
+        options != owner->options || target.membersExposed || target.borrowedMembers ||
+        !retained.parentInstance || !target.parentInstance ||
+        &retained.getDefinition() != &target.getDefinition() ||
+        retained.getHierarchicalPath() != target.getHierarchicalPath() ||
+        retained.flags != target.flags || importedBodyFrames.contains(&retained) ||
+        !InstanceCacheKey::isEligibleForCaching(*retained.parentInstance) ||
+        !InstanceCacheKey::isEligibleForCaching(*target.parentInstance)) {
+        if (owner && std::getenv("SLANG_SCOPE_BODY_TRACE"))
+            fmt::print(stderr,
+                       "scope-body import-context-mismatch\t{}\tprefix={} options={} members={} "
+                       "borrowed={} flags={} definitions={} frames={}\n",
+                       target.parentInstance ? target.getHierarchicalPath() : "",
+                       sourceManager && owner->sourceManager &&
+                           sourceManager->sharesImmutablePrefix(*owner->sourceManager),
+                       options == owner->options, target.membersExposed, target.borrowedMembers,
+                       retained.flags == target.flags,
+                       &retained.getDefinition() == &target.getDefinition(),
+                       owner->importedBodyFrames.size());
+        return false;
+    }
+
+    if (getDefaultDisable(target) && !defaultDisableMap.contains(&target))
+        return false;
+    if (!owner->prepareInstanceBodyReuse(retained))
+        return false;
+    if (!hasMatchingInstanceBodyParameters(retained, target)) {
+        if (std::getenv("SLANG_SCOPE_BODY_TRACE"))
+            fmt::print(stderr, "scope-body import parameter-mismatch\t{}\n",
+                       target.getHierarchicalPath());
+        return false;
+    }
+    auto& certificate = *owner->bodyReuseCertificates.at(&retained);
+    if (!certificate.descendants.empty() && !owner->completeBodyReferenceTracking)
+        return false;
+    // Constructor-time parameter type resolution can elaborate native children.
+    // Do not replace such a graph and double-count the already created occurrences.
+    for (auto member = target.firstMember; member; member = member->getNextSibling()) {
+        if (member->kind == SymbolKind::Instance || member->kind == SymbolKind::InstanceArray ||
+            member->kind == SymbolKind::GenerateBlock ||
+            member->kind == SymbolKind::GenerateBlockArray)
+            return false;
+    }
+    std::vector<std::pair<const Type*, const Type*>> typeIdentities;
+    auto mapTypes = [&](auto&& self, const Type& oldType, const Type& newType) -> bool {
+        const auto& a = oldType.getCanonicalType();
+        const auto& b = newType.getCanonicalType();
+        if (&a == &b)
+            return true;
+        if (owner->fixedBodyTypeOrigins.contains(&a)) {
+            auto scope = b.getParentScope();
+            // An immutable imported package must not acquire consumer-local
+            // identity annotations. Such fields must use that package directly.
+            if (!scope || &scope->getCompilation() != this)
+                return false;
+            // Separate independent owners can capture the same current nominal
+            // declaration. Never overwrite a prior validated identity: the next
+            // body stays native and shares the first body's identity annotation.
+            if (auto found = importedBodyTypeIdentities.find(&b);
+                found != importedBodyTypeIdentities.end() && found->second != &a) {
+                if (std::getenv("SLANG_SCOPE_BODY_TRACE"))
+                    fmt::print(stderr, "scope-body prior-identity-conflict\t{}\n",
+                               target.getHierarchicalPath());
+                return false;
+            }
+            for (auto [current, identity] : typeIdentities)
+                if (current == &b && identity != &a) {
+                    if (std::getenv("SLANG_SCOPE_BODY_TRACE"))
+                        fmt::print(stderr, "scope-body staged-identity-conflict\t{}\n",
+                                   target.getHierarchicalPath());
+                    return false;
+                }
+            typeIdentities.emplace_back(&b, &a);
+        }
+        if (a.kind == SymbolKind::PackedArrayType ||
+            a.kind == SymbolKind::FixedSizeUnpackedArrayType)
+            return self(self, *a.getArrayElementType(), *b.getArrayElementType());
+        if (a.kind == SymbolKind::EnumType)
+            return self(self, a.as<EnumType>().baseType, b.as<EnumType>().baseType);
+        if (a.kind == SymbolKind::PackedStructType || a.kind == SymbolKind::PackedUnionType) {
+            auto fields = [](const Type& value) -> const Scope& {
+                return value.kind == SymbolKind::PackedStructType
+                           ? static_cast<const Scope&>(value.as<PackedStructType>())
+                           : static_cast<const Scope&>(value.as<PackedUnionType>());
+            };
+            auto av = fields(a).template membersOfType<FieldSymbol>();
+            auto bv = fields(b).template membersOfType<FieldSymbol>();
+            auto bi = bv.begin();
+            for (auto ai = av.begin(); ai != av.end(); ++ai, ++bi)
+                if (!self(self, ai->getType(), bi->getType()))
+                    return false;
+        }
+        return true;
+    };
+    for (size_t i = 0; i < target.parameters.size(); ++i) {
+        const auto& a = retained.parameters[i]->symbol;
+        const auto& b = target.parameters[i]->symbol;
+        if (a.kind == SymbolKind::TypeParameter &&
+            !mapTypes(mapTypes, a.as<TypeParameterSymbol>().targetType.getType(),
+                      b.as<TypeParameterSymbol>().targetType.getType()))
+            return false;
+    }
+    SmallVector<const Expression*> boundaryInitializers;
+    for (auto parameter : target.parameters) {
+        if (parameter->symbol.kind != SymbolKind::Parameter)
+            continue;
+        const auto& value = parameter->symbol.as<ParameterSymbol>();
+        if (value.isOverridden())
+            if (auto initializer = value.getInitializer())
+                boundaryInitializers.push_back(initializer);
+    }
+    target.boundaryParameterInitializers = boundaryInitializers.copy(*this);
+    for (auto [type, identity] : typeIdentities)
+        importedBodyTypeIdentities.insert_or_assign(type, identity);
+
+    // No symbol is reparented and no borrowed map / member link may be mutated.
+    // The wrapper keeps the current instance and compilation as its boundary.
+    // A body lease must not import the old consumer's unrelated usage flags or
+    // metadata. Only the validated body's declaration-reference profile is shared.
+    if (std::ranges::find(importedBodyOwners, owner) == importedBodyOwners.end())
+        importedBodyOwners.push_back(std::move(owner));
+    importedBodyCertificates.push_back(&certificate);
+    for (auto type : certificate.classes)
+        if (std::ranges::find(importedBodyClasses, type) == importedBodyClasses.end())
+            importedBodyClasses.push_back(type);
+    // Fold the immutable profile once at import. Unused / shadow analysis asks
+    // about many declarations; scanning every retained subtree for each query
+    // makes analysis cost grow with the number of disjoint cached bodies.
+    for (const auto& [syntax, usage] : certificate.references) {
+        if (!usage.first && !usage.second)
+            continue;
+        auto& status = referenceStatusMap[syntax];
+        status.first |= usage.first;
+        status.second |= usage.second;
+    }
+    target.nameMap = retained.nameMap;
+    target.firstMember = retained.firstMember;
+    target.lastMember = retained.lastMember;
+    target.importData = retained.importData;
+    target.needsElaboration = false;
+    target.needsPrepass = false;
+    target.borrowedMembers = true;
+    target.portList = retained.portList;
+    target.parameters = retained.parameters;
+    importedBodyFrames.emplace(&retained, &target);
+    importedBodyViews.emplace(&target);
+    for (auto descendant : certificate.descendants) {
+        // Internal children keep immutable internal connections. Only the root
+        // gets a new outside boundary. Record ownership without reparenting.
+        importedBodyViews.emplace(descendant);
+    }
+    for (auto definition : certificate.instantiationSites)
+        noteDefinitionInstantiated(*definition);
+    return true;
+}
+
+bool Compilation::prepareInstanceBodyReuse(const InstanceBodySymbol& retained) {
+    auto owner = this;
+    auto decline = [&](std::string_view reason, std::string_view detail = {}) {
+        if (auto trace = std::getenv("SLANG_SCOPE_BODY_TRACE"); trace && *trace) {
+            fmt::print(stderr, "scope-body decline\t{}\t{}\t{}\n",
+                       retained.parentInstance ? retained.getHierarchicalPath()
+                                               : std::string(retained.getDefinition().name),
+                       reason, detail);
+        }
+        return false;
+    };
+    if (!isElaborated() || hasFatalErrors() || retained.borrowedMembers ||
+        &retained.getCompilation() != this || !retained.parentInstance ||
+        !InstanceCacheKey::isEligibleForCaching(*retained.parentInstance))
+        return decline("body-context");
+    if (getDefaultDisable(retained) && !defaultDisableMap.contains(&retained))
+        return decline("outside-default-disable");
+    if (auto found = bodyReuseCertificates.find(&retained); found != bodyReuseCertificates.end())
+        return found->second->independent;
+    if (auto it = owner->instanceSideEffectMap.find(&retained);
+        it != owner->instanceSideEffectMap.end() &&
+        (it->second->cannotCache || !it->second->upwardNames.empty()))
+        return decline("upward-side-effect");
+
+    // The complete bound subtree, including internal argument expressions and
+    // concrete child definitions, must be independent of the old consumer.
+    auto [certificateIt, inserted] = owner->bodyReuseCertificates.try_emplace(&retained);
+    if (inserted)
+        certificateIt->second = std::make_unique<BodyReuseCertificate>();
+    auto& certificate = *certificateIt->second;
+    certificate.root = &retained;
+    if (inserted) {
+        bool independent = true;
+        auto reject = [&](std::string_view reason, std::string_view detail = {}) {
+            if (independent)
+                decline(reason, detail);
+            independent = false;
+        };
+        flat_hash_set<const Scope*> closedClasses;
+        auto isLocal = [&](const Symbol& symbol) {
+            const Scope* scope = symbol.kind == SymbolKind::InstanceBody
+                                     ? &symbol.as<InstanceBodySymbol>()
+                                 : symbol.kind == SymbolKind::ClassType ? &symbol.as<ClassType>()
+                                                                        : symbol.getParentScope();
+            while (scope) {
+                if (scope == &retained || closedClasses.contains(scope))
+                    return true;
+                const auto& container = scope->asSymbol();
+                if (container.kind == SymbolKind::InstanceBody) {
+                    auto instance = container.as<InstanceBodySymbol>().parentInstance;
+                    scope = instance ? instance->getParentScope() : nullptr;
+                }
+                else {
+                    scope = container.getParentScope();
+                }
+            }
+            return false;
+        };
+        auto isFixedCompilation = [&](const Compilation& compilation) {
+            return std::ranges::any_of(importedCompilations, [&](const auto& imported) {
+                return imported.get() == &compilation;
+            });
+        };
+        flat_hash_set<const Type*> queuedTypes;
+        std::vector<const Type*> pendingTypes;
+        auto fixedBitVector = [&](auto&& self, const Type& type, bool recordUse = true) -> bool {
+            if (type.kind == SymbolKind::TypeAlias) {
+                auto scope = type.getParentScope();
+                if (!scope || (!isLocal(type) && !isFixedCompilation(scope->getCompilation()) &&
+                               !fixedBodyTypeOrigins.contains(&type)))
+                    return false;
+                if (recordUse)
+                    if (auto syntax = type.getSyntax())
+                        certificate.references[syntax].first = true;
+                return self(self, type.as<TypeAliasType>().targetType.getType());
+            }
+            const auto& canonical = type.getCanonicalType();
+            if (canonical.kind == SymbolKind::PackedArrayType ||
+                canonical.kind == SymbolKind::FixedSizeUnpackedArrayType)
+                return self(self, *canonical.getArrayElementType());
+            auto localNominal = [&](const auto& nominal) {
+                if (fixedBodyTypeOrigins.contains(&nominal))
+                    return true;
+                if (isFixedCompilation(nominal.getCompilation()))
+                    return true;
+                if (!isLocal(nominal))
+                    return false;
+                if (queuedTypes.emplace(&nominal).second)
+                    pendingTypes.push_back(&nominal);
+                return true;
+            };
+            if (canonical.kind == SymbolKind::EnumType) {
+                const auto& enumeration = canonical.as<EnumType>();
+                return localNominal(enumeration) && self(self, enumeration.baseType);
+            }
+            if (canonical.kind == SymbolKind::PackedStructType ||
+                canonical.kind == SymbolKind::PackedUnionType) {
+                auto checkFields = [&](const auto& aggregate) {
+                    if (!localNominal(aggregate))
+                        return false;
+                    for (auto& field : aggregate.template membersOfType<FieldSymbol>())
+                        if (!self(self, field.getType()))
+                            return false;
+                    return true;
+                };
+                return canonical.kind == SymbolKind::PackedStructType
+                           ? checkFields(canonical.as<PackedStructType>())
+                           : checkFields(canonical.as<PackedUnionType>());
+            }
+            return canonical.isSimpleBitVector();
+        };
+        auto isFixedIntegralType = [&](const Type& type) {
+            return fixedBitVector(fixedBitVector, type);
+        };
+        auto fixedStringType = [&](auto&& self, const Type& type, bool recordUse) -> bool {
+            if (type.kind == SymbolKind::TypeAlias) {
+                auto scope = type.getParentScope();
+                if (!scope || (!isLocal(type) && !isFixedCompilation(scope->getCompilation())))
+                    return false;
+                if (recordUse)
+                    if (auto syntax = type.getSyntax())
+                        certificate.references[syntax].first = true;
+                return self(self, type.as<TypeAliasType>().targetType.getType(), true);
+            }
+            return type.getCanonicalType().kind == SymbolKind::StringType;
+        };
+        std::function<bool(const Type&, bool)> isFixedBodyValueType;
+        isFixedBodyValueType = [&](const Type& type, bool recordUse) {
+            if (fixedBitVector(fixedBitVector, type, recordUse) ||
+                fixedStringType(fixedStringType, type, recordUse))
+                return true;
+            if (type.kind == SymbolKind::TypeAlias) {
+                auto scope = type.getParentScope();
+                if (!scope || (!isLocal(type) && !isFixedCompilation(scope->getCompilation())))
+                    return false;
+                if (recordUse)
+                    if (auto syntax = type.getSyntax())
+                        certificate.references[syntax].first = true;
+                return isFixedBodyValueType(type.as<TypeAliasType>().targetType.getType(), true);
+            }
+            const auto& canonical = type.getCanonicalType();
+            if (canonical.kind == SymbolKind::QueueType ||
+                canonical.kind == SymbolKind::DynamicArrayType ||
+                canonical.kind == SymbolKind::FixedSizeUnpackedArrayType)
+                return isFixedBodyValueType(*canonical.getArrayElementType(), true);
+            if (canonical.kind == SymbolKind::AssociativeArrayType) {
+                const auto& array = canonical.as<AssociativeArrayType>();
+                return isFixedBodyValueType(array.elementType, true) &&
+                       (!array.indexType || isFixedBodyValueType(*array.indexType, true));
+            }
+            if (canonical.kind == SymbolKind::FloatingType)
+                return true;
+            if (canonical.kind != SymbolKind::ClassType)
+                return false;
+            const auto& cls = canonical.as<ClassType>();
