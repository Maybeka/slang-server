+std::optional<SourceLocation> SourceManager::projectImmutableOriginalLocation(
+    SourceLocation location) const {
+    const auto result = projectImmutableOriginalLocations(std::span(&location, 1));
+    return result ? std::optional(result->front()) : std::nullopt;
+}
+
+std::optional<std::vector<SourceLocation>> SourceManager::projectImmutableOriginalLocations(
+    std::span<const SourceLocation> locations) const {
+    std::shared_lock lock(mutex);
+    if (!immutablePrefix)
+        return std::nullopt;
+    // Reparsed declarations can have new expansion IDs even when their complete
+    // origin graph already exists in the prefix. Match that graph, including
+    // arguments, definitions, invocation ranges and file / line provenance.
+    // Never retain or copy a tail entry into the immutable namespace.
+    flat_hash_map<uint32_t, std::optional<SourceLocation>> projected;
+    auto project = [&](auto&& self, SourceLocation value,
+                       unsigned depth) -> std::optional<SourceLocation> {
+        const auto id = value.buffer().getId();
+        if (!value || id >= bufferEntries.size() || depth > 64)
+            return std::nullopt;
+        if (id < immutablePrefix->entries.size())
+            return value;
+        if (auto found = projected.find(id); found != projected.end())
+            return found->second ? std::optional(*found->second + value.offset()) : std::nullopt;
+        if (projected.size() >= 4096)
+            return std::nullopt;
+        // Also bounds malformed cycles; only a completed base replaces null.
+        projected.emplace(id, std::nullopt);
+        auto finish = [&](BufferID buffer) -> std::optional<SourceLocation> {
+            const SourceLocation base(buffer, 0);
+            projected.at(id) = base;
+            return base + value.offset();
+        };
+        if (auto file = std::get_if<FileInfo>(&bufferEntries[id])) {
+            if (!file->data)
+                return std::nullopt;
+            auto includedFrom = file->includedFrom.valid()
+                                    ? self(self, file->includedFrom, depth + 1)
+                                    : std::optional(SourceLocation{});
+            if (!includedFrom)
+                return std::nullopt;
+            for (size_t i = 1; i < immutablePrefix->entries.size(); ++i) {
+                auto previous = std::get_if<FileInfo>(&immutablePrefix->entries[i]);
+                if (previous && previous->data &&
+                    previous->data->fullPath == file->data->fullPath &&
+                    previous->includedFrom == *includedFrom &&
+                    previous->getBufferKind() == file->getBufferKind() &&
+                    previous->hasExternalDirectives() == file->hasExternalDirectives() &&
+                    std::ranges::equal(previous->getLineDirectives(), file->getLineDirectives(),
+                                       [](const auto& a, const auto& b) {
+                                           return a.name == b.name &&
+                                                  a.lineInFile == b.lineInFile &&
+                                                  a.lineOfDirective == b.lineOfDirective &&
+                                                  a.level == b.level;
+                                       }) &&
+                    previous->data->mem.size() == file->data->mem.size() &&
+                    std::ranges::equal(previous->data->mem, file->data->mem))
+                    return finish(BufferID(uint32_t(i), previous->data->name));
+            }
+            return std::nullopt;
+        }
+        const auto& expansion = std::get<ExpansionInfo>(bufferEntries[id]);
+        const auto original = self(self, expansion.originalLoc, depth + 1);
+        const auto start = self(self, expansion.expansionRange.start(), depth + 1);
+        const auto end = self(self, expansion.expansionRange.end(), depth + 1);
+        if (!original || !start || !end)
+            return std::nullopt;
+        for (size_t i = 1; i < immutablePrefix->entries.size(); ++i) {
+            auto previous = std::get_if<ExpansionInfo>(&immutablePrefix->entries[i]);
+            if (previous && previous->originalLoc == *original &&
+                previous->expansionRange.start() == *start &&
+                previous->expansionRange.end() == *end &&
+                previous->isMacroArg == expansion.isMacroArg &&
+                previous->macroName == expansion.macroName)
+                return finish(BufferID(uint32_t(i), previous->macroName));
+        }
+        return std::nullopt;
+    };
+    std::vector<SourceLocation> result;
+    result.reserve(locations.size());
+    for (const auto location : locations) {
+        auto mapped = project(project, location, 0);
+        if (!mapped)
+            return std::nullopt;
+        result.push_back(*mapped);
+    }
+    return result;
+}
