+    CHECK(report(original.getDiagnostics()) == expected);
+    CHECK(owner.getTotalBytesAllocated() == allocated);
+    CHECK_THROWS_AS(cancelled.setCheckpoint([] {}), std::logic_error);
+    AnalysisManager retried;
+    unsigned retryPolls = 0;
+    retried.setCheckpoint([&] { ++retryPolls; });
+    retried.analyze(owner);
+    CHECK(retryPolls > 3);
+    CHECK(report(retried.getDiagnostics()) == expected);
