+SourceManager::IncludeConfiguration SourceManager::getIncludeConfiguration() const {
+    std::shared_lock includeLock(includeDirMutex);
+    std::shared_lock sourceLock(mutex);
+    IncludeConfiguration result{{}, {}, disableProximatePaths, disableLocalIncludes, incDirFirst};
+    for (const auto& path : userDirectories)
