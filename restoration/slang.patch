+    std::string body;
+    for (unsigned i = 0; i < 2000; ++i)
+        body += "result += arg;\n";
+    if (shape == 1)
+        body = "for (int i=0; i<20000; ++i) result += arg;\n";
+    if (shape == 2)
+        body = "for (int i=0; i<2; ++i) begin\n" + body + "end\n";
+    const auto text = "module top(input int arg); int result; always_comb begin\n"
+                      "result=arg;\n" +
