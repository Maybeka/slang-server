+    auto baseline = std::make_shared<AnalysisManager>(options);
+    const auto expected = report(analyze(text, *owner, *baseline));
+    const auto allocated = owner->getTotalBytesAllocated();
+    AnalysisManager cancelled(options);
+    unsigned polls = 0;
+    cancelled.setCheckpoint([&] {
+        if (++polls == 2)
+            throw std::runtime_error("cancel dependency snapshot");
+    });
+    CHECK_THROWS_AS(cancelled.setProcedureReuse(baseline), std::runtime_error);
+    CHECK(polls == 2);
+    CHECK(report(baseline->getDiagnostics()) == expected);
+    CHECK(owner->getTotalBytesAllocated() == allocated);
+    AnalysisManager retried(options);
+    unsigned retryPolls = 0;
+    retried.setCheckpoint([&] { ++retryPolls; });
+    retried.setProcedureReuse(baseline);
+    CHECK(retryPolls >= 3);
+    retried.analyze(*owner);
+    CHECK(retried.getProcedureReuseCounts().first == 300);
+    CHECK(retried.getProcedureReuseCounts().second == 0);
+    CHECK(report(retried.getDiagnostics()) == expected);
+    CHECK(owner->getTotalBytesAllocated() == allocated);
+}
