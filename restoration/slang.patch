+std::optional<Diagnostics> AnalysisManager::getTaskTimingDiagnostics(
+    std::span<const AnalyzedProcedure* const> callers, const SubroutineSymbol& original,
+    const AnalyzedProcedure& replacement, function_ref<void()> checkpoint) const {
+    const TaskTimingReplacement entry{&original, &replacement};
+    return getTaskTimingDiagnostics(callers, {&entry, 1}, checkpoint);
+}
+
+std::optional<Diagnostics> AnalysisManager::getTaskTimingDiagnostics(
+    std::span<const AnalyzedProcedure* const> callers,
+    std::span<const TaskTimingReplacement> replacements, function_ref<void()> checkpoint) const {
+    Diagnostics diagnostics;
+    bool complete = true;
+    for (auto caller : callers) {
+        checkpoint();
+        std::unordered_set<const SubroutineSymbol*> visited;
+        auto walk = [&](auto&& self, const CallExpression& call) -> const Statement* {
+            checkpoint();
+            auto task = timingTask(call);
+            if (!task || !visited.insert(task).second)
+                return nullptr;
+            const AnalyzedProcedure* summary = nullptr;
+            for (const auto& entry : replacements) {
+                checkpoint();
+                if (task == entry.original || task == entry.replacement->analyzedSymbol) {
+                    summary = entry.replacement;
+                    break;
+                }
+            }
+            if (!summary)
+                summary = getAnalyzedSubroutine(*task);
+            if (!summary) {
+                complete = false;
+                return nullptr;
+            }
+            auto timings = summary->getTimingControls();
+            if (!timings.empty())
+                return timings.front();
+            for (auto next : summary->getCallExpressions())
+                if (auto result = self(self, *next))
+                    return result;
+            return nullptr;
+        };
+        caller->reportTaskTimingDiagnostics(
+            [&]() -> std::pair<const CallExpression*, const Statement*> {
+                for (auto call : caller->getCallExpressions())
+                    if (auto result = walk(walk, *call))
+                        return {call, result};
+                return {nullptr, nullptr};
+            },
+            diagnostics);
+    }
+    if (!complete)
+        return std::nullopt;
+    ASTDiagMap map;
+    for (auto& diagnostic : diagnostics) {
+        bool inserted;
+        map.add(std::move(diagnostic), inserted);
+    }
+    return map.coalesce(sourceManager, sourceCompilation);
+}
