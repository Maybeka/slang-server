+        auto candidate = std::make_unique<Compilation>(options);
+        candidate->importPackage(library, "uvm_pkg", consumerSources);
+        candidate->addSyntaxTree(suffix);
+        size_t visits = 0;
+        CHECK_THROWS_AS(candidate->getDisposableSemanticDiagnostics([&] {
+            if (++visits == 3) {
+                CHECK_FALSE(candidate->getImportedClassSpecializations().empty());
+                throw SemanticTraversalCancelled{};
+            }
+        }),
+                        SemanticTraversalCancelled);
+        candidate.reset();
+        CHECK(library->getPackage("uvm_pkg") == package);
+        CHECK(library->getSemanticDiagnostics().empty());
+        CHECK(generic.numSpecializations() == fixedSpecializations);
+        CHECK(library->getTotalBytesAllocated() == bytes);
+        Compilation retry(options);
+        retry.importPackage(library, "uvm_pkg", consumerSources);
+        retry.addSyntaxTree(suffix);
+        CHECK(retry.getSemanticDiagnostics().empty() == !broken);
+        CHECK(generic.numSpecializations() == fixedSpecializations);
+        CHECK(library->getTotalBytesAllocated() == bytes);
+    }
+}
+
+TEST_CASE("Imported virtual interfaces complete diagnostics in each current consumer",
+          "[trusted-package][imported-virtual-interface-diagnostics]") {
+    const bool transitive = GENERATE(false, true);
+    CAPTURE(transitive);
+    SourceManager sources;
+    TempFile provider(R"(
+interface diagnostic_bus #(parameter int WIDTH=4);
+    logic [WIDTH-1:0] data;
+    task check_body();
+        $assertoff(0, "top");
+        $display($root.top.limit);
+        if (int'(data)) $display("active");
+    endtask
+endinterface
+package fixed_interfaces;
+    class Holder;
+        virtual diagnostic_bus#(4) a;
+        virtual diagnostic_bus#(8) b;
+    endclass
+endpackage
+)", ".sv");
+    auto parsed = SyntaxTree::fromFile(provider.path.generic_string(), sources);
+    REQUIRE(parsed);
+    auto tree = *parsed;
+    CompilationOptions libraryOptions;
+    libraryOptions.flags = CompilationFlags::PackageAnalysis;
+    auto owner = std::make_shared<Compilation>(libraryOptions);
+    owner->addSyntaxTree(tree);
+    REQUIRE(owner->getSemanticDiagnostics().empty());
+    auto exported = owner;
+    std::shared_ptr<SyntaxTree> facadeTree;
+    std::vector<BufferID> graph(tree->getSourceBufferIds().begin(), tree->getSourceBufferIds().end());
+    if (transitive) {
+        auto facade = std::make_shared<Compilation>(libraryOptions);
+        facade->importPackage(owner, "fixed_interfaces", sources);
+        facadeTree = SyntaxTree::fromText(
+            "package facade; typedef fixed_interfaces::Holder Holder; endpackage", sources,
+            "facade.sv", "");
+        facade->addSyntaxTree(facadeTree);
+        REQUIRE(facade->getSemanticDiagnostics().empty());
+        graph.insert(graph.end(), facadeTree->getSourceBufferIds().begin(),
+                     facadeTree->getSourceBufferIds().end());
+        exported = facade;
+    }
+    const auto prefix = sources.captureImmutablePrefix(graph);
+    CompilationOptions options;
+    options.topModules.emplace("top");
+    for (bool hasLimit : {true, false, true}) {
+        CAPTURE(hasLimit);
+        SourceManager currentSources, nativeSources;
+        currentSources.inheritImmutablePrefix(prefix);
+        nativeSources.inheritImmutablePrefix(prefix);
+        auto currentBuffers = currentSources.retainBuffers(tree->getSourceBufferIds());
+        auto nativeBuffers = nativeSources.retainBuffers(tree->getSourceBufferIds());
+        Compilation current(options), native(options);
+        current.importPackage(exported, transitive ? "facade" : "fixed_interfaces", currentSources);
+        if (!transitive)
+            current.importDefinition(owner, "diagnostic_bus", currentSources);
+        native.addSyntaxTree(SyntaxTree::sharedPrefixView(tree, nativeSources));
+        if (facadeTree)
+            native.addSyntaxTree(SyntaxTree::sharedPrefixView(facadeTree, nativeSources));
+        const std::string text = std::string("module top; ") +
+                                 (hasLimit ? "int limit;" : "int another;") +
+                                 (transitive ? "facade::Holder holder; endmodule"
+                                             : "fixed_interfaces::Holder holder; endmodule");
+        current.addSyntaxTree(SyntaxTree::fromText(text, currentSources, "consumer.sv", ""));
+        native.addSyntaxTree(SyntaxTree::fromText(text, nativeSources, "consumer.sv", ""));
+        const auto expected = DiagnosticEngine::reportAll(nativeSources,
+                                                         native.getSemanticDiagnostics());
+        REQUIRE_FALSE(expected.empty());
+        CHECK(expected.find("expected scope or assertion name") != std::string::npos);
+        CHECK(DiagnosticEngine::reportAll(currentSources, current.getSemanticDiagnostics()) ==
+              expected);
+        CHECK(owner->getSemanticDiagnostics().empty());
+    }
+}
