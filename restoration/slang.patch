+TEST_CASE("Macro absence traces decline after storage exhaustion or before EOF",
+          "[preprocessor][macro-access]") {
+    PreprocessorOptions options;
+    options.trackMacroAccesses = true;
+    options.maxTrackedMacroAccessBytes = 0;
+    Preprocessor bounded(getSourceManager(), alloc, diagnostics, Bag{options});
+    bounded.pushSource("`ifdef UNSEEN\n42\n`endif\n");
+    while (bounded.next().kind != TokenKind::EndOfFile) {}
+    auto exhausted = bounded.getMetadata();
+    CHECK_FALSE(exhausted.macroAccessTrackingComplete);
+    CHECK(exhausted.macroAccessEndedAtEof);
+    CHECK(exhausted.macroAccessNames.empty());
+    CHECK(exhausted.macroAccessStorageBytes == 0);
+
+    options.maxTrackedMacroAccessBytes = 1024 * 1024;
+    Preprocessor partial(getSourceManager(), alloc, diagnostics, Bag{options});
+    partial.pushSource("42\n`ifdef LATER_READ\n43\n`endif\n");
+    REQUIRE(partial.next().kind == TokenKind::IntegerLiteral);
+    CHECK(partial.getMetadata().macroAccessTrackingComplete);
+    CHECK_FALSE(partial.getMetadata().macroAccessEndedAtEof);
+    while (partial.next().kind != TokenKind::EndOfFile) {}
+    CHECK(partial.getMetadata().macroAccessNames.contains("LATER_READ"));
+    CHECK(partial.getMetadata().macroAccessEndedAtEof);
+    partial.pushSource("44\n");
+    CHECK_FALSE(partial.getMetadata().macroAccessEndedAtEof);
+    REQUIRE(partial.next().kind == TokenKind::IntegerLiteral);
+    while (partial.next().kind != TokenKind::EndOfFile) {}
+    CHECK(partial.getMetadata().macroAccessTrackingComplete);
+    CHECK(partial.getMetadata().macroAccessEndedAtEof);
+
+    options.maxTrackedMacroAccessBytes = 65536;
+    Preprocessor growing(getSourceManager(), alloc, diagnostics, Bag{options});
+    REQUIRE(growing.getMetadata().macroAccessTrackingComplete);
+    for (size_t i = 0; i < 1024; ++i)
+        CHECK_FALSE(growing.isDefined("missing_name_" + std::to_string(i)));
+    CHECK_FALSE(growing.getMetadata().macroAccessTrackingComplete);
+    CHECK(growing.getMetadata().macroAccessNames.empty());
+    CHECK(growing.getMetadata().macroAccessStorageBytes == 0);
+    CHECK_FALSE(growing.isDefined("another_name"));
+    CHECK_FALSE(growing.getMetadata().macroAccessTrackingComplete);
+}
