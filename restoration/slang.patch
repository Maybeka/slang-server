+TEST_CASE("Class reference snapshots remove fields signatures and bodies together",
+          "[body-class-reference-origin]") {
+    const bool independent = GENERATE(false, true);
+    const bool early = GENERATE(false, true);
+    const bool nested = GENERATE(false, true);
+    CAPTURE(independent, early, nested);
+    const std::string declarations =
+        "typedef int field_t; typedef int formal_t; typedef int return_t; typedef int local_t;\n"
+        "int init_ref, default_ref, body_ref;\n";
+    const std::string members =
+        "field_t field; static int seed=init_ref;\n"
+        "function return_t read(input formal_t arg=default_ref); "
+        "local_t local_value=body_ref; body_ref=arg; return local_value; endfunction\n";
+    const std::string fixed = independent ? "field_t fixed_field; function automatic return_t "
+                                            "fixed_use(input formal_t arg=default_ref); "
+                                            "local_t fixed_local=body_ref+init_ref; body_ref=arg; "
+                                            "return fixed_local; endfunction\n"
+                                          : "";
+    const std::string classText = "class Box #(int N=1);\n" +
+                                  (nested ? "class Inner #(int M=2);\n" + members +
+                                                "endclass Inner#(2) inner_ref;\n"
+                                          : members) +
+                                  "endclass\n";
+    const std::string text =
+        "package p;\n" + declarations + classText + fixed +
+        "function automatic void edited(); Box#(1) local_box; endfunction\nendpackage\n";
+    CompilationOptions options;
+    options.flags |= CompilationFlags::TrackSubroutineBodyDependencies;
+    Compilation compilation(options);
+    compilation.addSyntaxTree(SyntaxTree::fromText(text));
+    const auto& pkg = *compilation.getPackage("p");
+    const auto& edited = pkg.find<SubroutineSymbol>("edited");
+    const auto& box = edited.find<VariableSymbol>("local_box").getType().as<ClassType>();
+    if (early) {
+        const auto& target = nested
+                                 ? box.find<VariableSymbol>("inner_ref").getType().as<ClassType>()
+                                 : box;
+        (void)target.find<VariableSymbol>("field").getType();
+        const auto& read = target.find<SubroutineSymbol>("read");
+        (void)read.getReturnType();
+        (void)read.getArguments();
+    }
+    for (const auto& diagnostic : compilation.getAllDiagnostics())
+        CHECK_FALSE(diagnostic.isError());
+    const SubroutineSymbol* bodies[] = {&edited};
+    const ClassType* classes[] = {&box};
+    const auto bytes = compilation.getTotalBytesAllocated();
+    auto outside = compilation.getReferenceUsageExcludingBodies(bodies, {}, classes);
+    REQUIRE(outside);
+    auto withClasses = compilation.getReferenceUsageExcludingBodies(bodies);
+    REQUIRE(withClasses);
+    Compilation fresh(options);
+    fresh.addSyntaxTree(
+        SyntaxTree::fromText("package p;\n" + declarations + fixed +
+                             "function automatic void edited(); endfunction\nendpackage\n"));
+    for (const auto& diagnostic : fresh.getAllDiagnostics())
+        CHECK_FALSE(diagnostic.isError());
+    auto usage = [&](const Compilation::ReferenceUsageMap& profile, const Symbol& symbol) {
+        auto found = profile.find(symbol.getSyntax());
+        return found == profile.end() ? std::pair<bool, bool>{} : found->second;
+    };
+    for (const auto* name :
+         {"field_t", "formal_t", "return_t", "local_t", "init_ref", "default_ref", "body_ref"}) {
+        CAPTURE(name);
+        const auto& symbol = *pkg.find(name);
+        const auto expected = fresh.isReferenced(*fresh.getPackage("p")->find(name)->getSyntax());
+        CHECK(usage(*outside, symbol) == expected);
+        CHECK(usage(*withClasses, symbol).first);
+        CHECK(expected.first == independent);
+        CHECK(compilation.isReferenced(*symbol.getSyntax()).first);
+    }
+    unsigned polls = 0;
+    CHECK_THROWS_AS(compilation.getReferenceUsageExcludingBodies(
+                        bodies,
+                        [&] {
+                            if (++polls == 2)
+                                throw std::runtime_error("cancel class reference view");
+                        },
+                        classes),
+                    std::runtime_error);
+    CHECK(polls == 2);
+    const auto retry = compilation.getReferenceUsageExcludingBodies(bodies, {}, classes);
+    REQUIRE(retry);
+    CHECK(*retry == *outside);
+    CHECK(compilation.getTotalBytesAllocated() == bytes);
+    Compilation foreign(options);
+    CHECK_FALSE(foreign.getReferenceUsageExcludingBodies({}, {}, classes));
+    Compilation untracked;
+    CHECK_FALSE(untracked.getReferenceUsageExcludingBodies({}, {}, classes));
+}
