+TEST_CASE("Fixed compilation-unit imports report one warning in initial and resumed consumers",
+          "[trusted-package][scope-import-diagnostics]") {
+    SourceManager sources;
+    TempFile provider("package fixed_pkg; localparam int N=4; endpackage\n"
+                      "import fixed_pkg::*;\nimport fixed_pkg::*;\n",
+                      ".sv");
+    auto parsed = SyntaxTree::fromFile(provider.path.generic_string(), sources);
+    REQUIRE(parsed);
+    auto tree = *parsed;
+    CompilationOptions options;
+    options.flags = CompilationFlags::PackageAnalysis;
+    auto owner = std::make_shared<Compilation>(options);
+    owner->addSyntaxTree(tree);
+    const auto& original = owner->getSemanticDiagnostics();
+    REQUIRE(original.size() == 1);
+    REQUIRE(original[0].code == diag::DuplicateImport);
+    auto prefix = sources.captureImmutablePrefix(tree->getSourceBufferIds());
+    for (int variant : {0, 1, 2}) {
+        SourceManager consumerSources;
+        consumerSources.inheritImmutablePrefix(prefix);
+        auto retained = consumerSources.retainBuffers(tree->getSourceBufferIds());
+        Compilation consumer(options);
+        consumer.importPackage(owner, "fixed_pkg", consumerSources);
+        if (variant == 1)
+            consumer.addSyntaxTree(SyntaxTree::sharedPrefixView(tree, consumerSources), true);
+        else if (variant == 2) {
+            auto loaded = consumerSources.readSource(
+                sources.getFullPath(original[0].location.buffer()));
+            REQUIRE(loaded);
+            auto buffer = *loaded;
+            REQUIRE(buffer.id != original[0].location.buffer());
+            consumer.addSyntaxTree(SyntaxTree::fromBuffers(std::span(&buffer, 1), consumerSources),
+                                   true);
+        }
+        consumer.addSyntaxTree(SyntaxTree::fromText(
+            "package user_pkg; import fixed_pkg::*; import fixed_pkg::*; endpackage",
+            consumerSources, "consumer.sv", "consumer.sv"));
+        const auto& diagnostics = consumer.getSemanticDiagnostics();
+        std::string observed;
+        for (const auto& d : diagnostics)
+            observed += std::string(toString(d.code)) + "@" +
+                        consumerSources.getFullPath(d.location.buffer()).string() + ";";
+        CAPTURE(variant, observed);
+        REQUIRE(diagnostics.size() == 2);
+        CHECK(std::ranges::count_if(diagnostics, [&](const Diagnostic& d) {
+                  return d.code == diag::DuplicateImport &&
+                         consumerSources.getFullPath(d.location.buffer()) ==
+                             sources.getFullPath(original[0].location.buffer());
+              }) == 1);
+        CHECK(diagnostics[0].code == diag::DuplicateImport);
+        CHECK(diagnostics[1].code == diag::DuplicateImport);
+    }
+}
