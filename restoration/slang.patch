+            prefix->preprocessorMetadata.includeDirectives.begin(),
+            prefix->preprocessorMetadata.includeDirectives.end());
+        checkpoint.pp.macroRefs.insert(checkpoint.pp.macroRefs.begin(),
+            prefix->preprocessorMetadata.macroRefs.begin(), prefix->preprocessorMetadata.macroRefs.end());
+        checkpoint.pp.predefineBufferIds.insert(checkpoint.pp.predefineBufferIds.begin(),
+            prefix->getPredefineBufferIds().begin(), prefix->getPredefineBufferIds().end());
+        auto summary = *suffix->prefixState->capturedPackageDirectives;
+        const auto& fixed = *prefix->prefixState->wholeTreeDirectives;
+        summary.resumeSafe &= fixed.resumeSafe && fixed.plainProtectDepth == 0;
+        summary.sourceEffects |= fixed.sourceEffects;
+        summary.defparams |= fixed.defparams;
+        summary.binds |= fixed.binds;
