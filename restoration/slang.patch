+        const auto& entry = bufferEntries[i];
+        out.number(entry.index());
+        if (auto file = std::get_if<FileInfo>(&entry)) {
+            if (file->library)
+                throw std::runtime_error(
+                    "library and line directives are unsupported in parse archives");
