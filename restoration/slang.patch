+void SourceManager::inheritIncludeConfiguration(const IncludeConfiguration& config) {
+    std::unique_lock includeLock(includeDirMutex);
+    std::unique_lock sourceLock(mutex);
+    if (bufferEntries.size() != 1 || snapshotReplay || snapshotRecording ||
+        !userDirectories.empty() || !systemDirectories.empty())
+        throw std::runtime_error("include configuration requires an empty source manager");
+    for (const auto& path : config.userDirectories)
+        userDirectories.emplace_back(path);
+    for (const auto& path : config.systemDirectories)
+        systemDirectories.emplace_back(path);
+    disableProximatePaths = config.disableProximatePaths;
+    disableLocalIncludes = config.disableLocalIncludes;
+    incDirFirst = config.incDirFirst;
+}
