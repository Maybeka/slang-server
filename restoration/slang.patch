+TEST_CASE("Retained body certification handles deep expressions on a worker thread",
+          "[body-reuse-deep-expression]") {
+    const bool parameter = GENERATE(false, true);
+    const bool unsafeCall = GENERATE(false, true);
+    CAPTURE(parameter, unsafeCall);
+    std::string expression = parameter ? "1" : "a";
+    for (unsigned i = 0; i < 256; ++i)
+        expression += parameter ? " | 1" : " + a";
+    if (!parameter && unsafeCall)
+        expression += " + $signed($urandom(seed))";
+    auto definitions = std::make_shared<Compilation>();
+    auto tree = SyntaxTree::fromText(
+        "module stable(input int a, output int y); int seed=1; " +
+        (parameter ? "localparam int MASK=" + expression + "; assign y=a^MASK" +
+                         (unsafeCall ? " + $signed($urandom(seed));" : ";")
+                   : "assign y=" + expression + ";") +
+        " endmodule\n");
+    definitions->addSyntaxTree(tree);
+    INFO(report(definitions->getSemanticDiagnostics()));
+    REQUIRE(definitions->getSemanticDiagnostics().empty());
+    Compilation owner;
+    owner.importDefinition(definitions, "stable", tree->sourceManager());
+    owner.enableInstanceBodyReferenceTracking();
+    owner.addSyntaxTree(SyntaxTree::fromText("module top; int a,y; stable u(.*); endmodule\n",
+                                             tree->sourceManager()));
+    REQUIRE(owner.getSemanticDiagnostics().empty());
+    const auto& body = owner.getRoot().topInstances[0]->body.find<InstanceSymbol>("u").body;
+    bool reusable = false;
+    std::thread worker([&] { reusable = owner.prepareInstanceBodyReuse(body); });
+    worker.join();
+    CHECK(reusable == !unsafeCall);
+    CHECK(owner.getSemanticDiagnostics().empty());
+}
