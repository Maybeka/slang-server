+TEST_CASE("Requested root checkpoints capture macros guards and immutable preceding members",
+          "[source-snapshot][root-checkpoint]") {
+    SnapshotFixture files;
+    fs::current_path(files.dir);
+    files.write("guard.svh", "`ifndef SEEN\n`define SEEN\n"
+                             "typedef int Guarded;\n`endif\n");
+    SourceManager sm;
+    sm.enableSnapshotRecording();
+    auto baseBuffer = sm.assignText("base.sv", "`define BASE 3\npackage base; endpackage\n");
+    auto a = sm.assignText("a.sv", "`pragma protect begin\npackage a;\n"
+                                  "`include \"guard.svh\"\nclass C; int x; endclass\n"
+                                  "endpackage\n`pragma protect end\n");
+    auto b = sm.assignText("b.sv", "package b; endpackage\n`undef BASE\n`define BASE 9\n");
+    auto user = sm.assignText("user.sv", "module top; localparam int V=`BASE; endmodule\n");
+    auto base = SyntaxTree::fromBuffersWithCheckpoint(std::vector{baseBuffer}, sm);
+    auto parsed = SyntaxTree::afterCachedPrefixWithCheckpoint(base, std::vector{a, b, user}, 2);
+    REQUIRE(parsed->diagnostics().empty());
+    std::weak_ptr<SyntaxTree> parsedOwner = parsed;
+    const auto* first = parsed->root().as<CompilationUnitSyntax>().members.front();
+    const SyntaxNode* parent = first->parent;
+    auto view = SyntaxTree::preparedSourcePrefix(parsed);
+    REQUIRE(view);
+    REQUIRE(view->isPrefixResumeSafe() == true);
+    CHECK(view->getPrefixSourceEffects() == true);
+    REQUIRE(view->root().as<CompilationUnitSyntax>().members.size() == 2);
+    CHECK(view->root().as<CompilationUnitSyntax>().members.front() == first);
+    CHECK(first->parent == parent);
+    // The current user source does not enter the prefix's validity graph.
+    for (auto id : view->getSourceBufferIds())
+        CHECK(sm.getFullPath(id).filename() != "user.sv");
+    auto extended = SyntaxTree::preparedSourcePrefix(parsed, base);
+    REQUIRE(extended);
+    CHECK(extended->isPrefixResumeSafe() == true);
+    auto other = SyntaxTree::fromBuffersWithCheckpoint(
+        std::vector{sm.assignText("other.sv", "package other; endpackage\n")}, sm);
+    CHECK_FALSE(SyntaxTree::preparedSourcePrefix(parsed, other));
+    auto replace = [&](SourceBuffer old, std::string_view text) {
+        SmallVector<char> bytes(text.begin(), text.end());
+        bytes.push_back('\0');
+        return sm.replaceBuffer(old.id, std::move(bytes));
+    };
+    auto current = replace(user, "`include \"guard.svh\"\n"
+                                 "module top; localparam int V=`BASE+1; endmodule\n");
+    auto delayed = SyntaxTree::preparedSourcePrefix(parsed, base);
+    REQUIRE(delayed);
+    CHECK(delayed->isPrefixResumeSafe() == true);
+    for (auto id : extended->getSourceBufferIds())
+        CHECK(sm.isLatestData(id));
+    std::weak_ptr<SyntaxTree> macroOwner = base;
+    base.reset(); parsed.reset(); view.reset();
+    REQUIRE_FALSE(macroOwner.expired());
+    auto suffix = SyntaxTree::afterCachedPrefix(extended, std::vector{current}, {});
+    auto combined = SyntaxTree::withCachedPrefixOwnedSuffix(extended, std::move(suffix));
+    auto native = SyntaxTree::fromBuffers(std::vector{baseBuffer, a, b, current}, sm);
+    CHECK(combined->diagnostics().empty());
+    CHECK(native->diagnostics().empty());
+    Compilation actual, expected;
+    actual.addSyntaxTree(combined);
+    expected.addSyntaxTree(native);
+    CHECK(actual.getAllDiagnostics().empty());
+    CHECK(expected.getAllDiagnostics().empty());
+    CHECK(actual.getRoot().topInstances.front()->body.find("V")
+              ->as<ParameterSymbol>().getValue() ==
+          expected.getRoot().topInstances.front()->body.find("V")
+              ->as<ParameterSymbol>().getValue());
+    auto earlier = replace(a, "package a; endpackage\n");
+    (void)earlier;
+    REQUIRE_FALSE(parsedOwner.expired());
+    CHECK_FALSE(SyntaxTree::preparedSourcePrefix(parsedOwner.lock()));
+    CHECK(std::ranges::any_of(extended->getSourceBufferIds(),
+                             [&](auto id) { return !sm.isLatestData(id); }));
+}
