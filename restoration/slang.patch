+std::shared_ptr<SyntaxTree> SyntaxTree::sharedPrefixView(const std::shared_ptr<SyntaxTree>& owner,
+                                                         SourceManager& sm, const Bag* options) {
+    if (!owner || !sm.sharesImmutablePrefix(owner->sourceMan))
+        throw std::runtime_error("precompiled library source namespace mismatch");
+    BumpAllocator arena;
+    auto result = std::shared_ptr<SyntaxTree>(new SyntaxTree(
+        owner->rootNode, owner->library, sm, std::move(arena),
+        Diagnostics(owner->diagnosticsBuffer), ParserMetadata(owner->metadata),
+        PreprocessorMetadata(owner->preprocessorMetadata), options ? *options : owner->options_));
+    if (auto prefix = result->options_.get<PrecompiledUvmSyntax>();
+        prefix && prefix->tree && &prefix->tree->sourceManager() != &sm) {
+        if (prefix->tree == owner)
+            throw std::runtime_error("self-referencing precompiled syntax options");
+        auto view = *prefix;
+        view.tree = sharedPrefixView(prefix->tree, sm);
+        result->options_.set(std::move(view));
+    }
+    // Namespace views also apply to ordinary non-resumable declaration trees.
+    result->isLibraryUnit = owner->isLibraryUnit;
+    result->prefixState = owner->prefixState ? std::make_unique<PrefixState>(*owner->prefixState)
+                                             : std::make_unique<PrefixState>();
+    // Namespace wrappers borrow the same nodes; pin the actual tree rather than
+    // retaining a chain of wrappers across context retirement.
+    result->prefixState->namespaceOwner = owner->prefixState && owner->prefixState->namespaceOwner
+                                              ? owner->prefixState->namespaceOwner
+                                              : owner;
+    result->prefixState->extraBytes = result->prefixState->namespaceOwner->getRetainedSyntaxBytes();
+    if (options) {
+        const auto requested = options->getOrDefault<PreprocessorOptions>();
+        const auto previous = owner->options_.getOrDefault<PreprocessorOptions>();
+        if (requested.trackMacroAccesses != previous.trackMacroAccesses ||
+            requested.maxTrackedMacroAccessBytes != previous.maxTrackedMacroAccessBytes) {
+            auto& facts = result->preprocessorMetadata;
+            if (auto encoded = result->prefixState->macroAccessArchive) {
+                std::istringstream stream(*encoded, std::ios::binary);
+                BumpAllocator temporary;
+                ArchiveReader reader(stream, temporary);
+                readMacroAccessTrace(reader, facts, requested);
+                SLANG_ASSERT(reader.atEnd());
+            }
+            else if (!requested.trackMacroAccesses ||
+                     facts.macroAccessStorageBytes > requested.maxTrackedMacroAccessBytes) {
+                facts.macroAccessTrackingComplete = false;
+                facts.macroAccessEndedAtEof = false;
+                facts.macroAccessNames.clear();
+                facts.macroAccessStorageBytes = 0;
+            }
+        }
+    }
+    return result;
+}
