+    REQUIRE(owner->diagnostics().size() == 2);
+    const auto& unit = owner->root().as<CompilationUnitSyntax>();
+    std::array<const MemberSyntax*, 1> selected{unit.members[0]};
+    auto view = SyntaxTree::selectCompilationUnitMembers(owner, selected);
+    REQUIRE(view->diagnostics().size() == 1);
+    CHECK(view->diagnostics()[0].location == owner->diagnostics()[0].location);
+
+    TempFile packages("package kept; localparam int K=32'd4294967297; endpackage\n"
+                      "package other; localparam int O=32'd4294967297; endpackage\n",
+                      ".svh");
+    auto included = SyntaxTree::fromText(
+        fmt::format("`include \"{}\"\n", packages.path.generic_string()), sources, "packages.sv");
+    REQUIRE(included->diagnostics().size() == 2);
+    selected[0] = included->root().as<CompilationUnitSyntax>().members[0];
+    auto includedView = SyntaxTree::selectCompilationUnitMembers(included, selected);
+    REQUIRE(includedView->diagnostics().size() == 1);
+    CHECK(includedView->diagnostics()[0].location == included->diagnostics()[0].location);
+}
