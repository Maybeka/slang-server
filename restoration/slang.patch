+TEST_CASE("Frozen source namespaces append locations without doubling the frozen table",
+          "[source-namespace-growth]") {
+    SourceManager provider;
+    auto fixed = provider.assignText("fixed.sv", "module fixed; endmodule\n");
+    const SourceLocation original(fixed.id, 0);
+    const SourceRange range(original, original + 6);
+    for (size_t i = 0; i < 8192; ++i)
+        provider.createExpansionLoc(original, range, "FIXED");
+    auto prefix = provider.captureImmutablePrefix(std::vector{fixed.id});
+    SourceManager editor;
+    editor.inheritImmutablePrefix(prefix);
+    const auto initialBytes = editor.getSourceLocationTableBytes();
+    const auto initialCount = editor.getSourceLocationEntryCount();
+    const auto first = editor.createExpansionLoc(original, range, "EDIT");
+    CHECK(first.buffer().getId() == initialCount);
+    CHECK(editor.getSourceLocationTableBytes() < initialBytes + initialBytes / 4);
+    std::vector<SourceLocation> locations{first};
+    for (size_t i = 0; i < 3072; ++i) {
+        auto loc = i % 2 ? editor.createArgExpansionLoc(original, range)
+                         : editor.createExpansionLoc(original, range, "EDIT");
+        REQUIRE(loc.buffer().getId() == initialCount + locations.size());
+        locations.push_back(loc);
+    }
+    auto text = editor.assignText("user.sv", "module user; endmodule\n");
+    CHECK(editor.getSourceText(text.id).starts_with("module user;"));
+    CHECK(editor.getSourceLocationTableBytes() < initialBytes * 2);
+    for (auto location : locations)
+        CHECK(editor.getFullyOriginalLoc(location) == original);
+    CHECK(editor.getMacroName(first) == "EDIT");
+    CHECK(provider.getSourceLocationEntryCount() == initialCount);
+}
